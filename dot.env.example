# Modèle du fichier .env (chargé par dotenv). Copier en `.env` et renseigner.
# `.env` est gitignoré et ne se committe jamais ; ce modèle ne porte que des noms.
# Noms relevés dans le code (ENV[...]) le 2026-09-22.

# --- Application
APP_INSTANCE=                       # "demo" sur le serveur de démonstration (bandeau et comportements de démo)
APP_HOSTS=                          # production : hôtes autorisés, séparés par des virgules (config.hosts)
APP_CORS_ORIGINS=                   # origines CORS autorisées, séparées par des virgules
HOST_URL=                           # production : hôte public des liens de mail et des URL absolues
SUPER_ADMIN=                        # emails des super-administrateurs, séparés par des virgules
BCC_NOTIFICATION_EMAILS=            # copie cachée de toutes les notifications
EXCEPTION_NOTIFICATION_RECIPIENTS=  # destinataires des rapports d'erreur (exception_notification)
RAILS_LOG_LEVEL=                    # production, optionnel
RAILS_MASTER_KEY=                   # production, si config/master.key est absent

# --- Base de données
COOPCOM_DATABASE_PASSWORD=
MY_APP_DATABASE_URL=                # production : URL complète, si utilisée à la place du mot de passe

# --- Jobs (Solid Queue)
SOLID_QUEUE_IN_PUMA=                # laisser vide en développement : bin/dev lance déjà le worker (Procfile.dev)

# --- Mail (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
DELIVERY_METHOD=                    # développement : letter_opener par défaut ; "mailgun" pour envoyer réellement

# --- SMS et WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                  # sert aussi à vérifier la signature du webhook entrant
TWILIO_PHONE_NUMBER=
TWILIO_PERSONAL_NUMBER=
CONTENT_SID=                        # modèle de message WhatsApp

# --- Stockage (S3)
BUCKETEER_AWS_ACCESS_KEY_ID=
BUCKETEER_AWS_SECRET_ACCESS_KEY=
BUCKETEER_AWS_REGION=
BUCKETEER_BUCKET_NAME=
AWS_REGION=                         # bin/setup_s3_cors.rb

# --- Google
GOOGLE_MAPS_FRONTEND_API_KEY=       # cartes et autocomplétion d'adresse dans le navigateur
GOOGLE_MAPS_BACKEND_API_KEY=        # calcul des trajets (FetchRoutesInfos)
GOOGLE_OAUTH_CLIENT_ID=             # connexion Google, désactivée aujourd'hui
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ANALYTICS_ID=
MAPBOX_TOKEN=                       # carte des outils
MAPS_CENTER_LAT=                    # centre par défaut des cartes (formulaires utilisateur et entrepôt)
MAPS_CENTER_LNG=

# --- Météo Concept
METEO_API_KEY=
METEO_INSEE_CODE=

# --- IA
MISTRAL_AI_API_KEY=

# --- Développement et tests
DEV_CACHE=                          # active le cache en développement
PARALLEL_WORKERS=                   # nombre de processus de test ; 1 pour un run séquentiel (bin/coverage)
CAPYBARA_MAX_WAIT=                  # budget d'attente des tests système, en secondes
REGENERER_INSTANTANE=               # tests : régénère les instantanés de référence
