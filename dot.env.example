PGHOST=db
PGUSER=postgres
PGPASSWORD=changeme

# Identifie l'instance. Mettre "demo" sur le serveur de démonstration pour afficher
# le bandeau « INSTANCE DE DÉMONSTRATION » et le préfixe [DÉMO] dans le titre de l'onglet.
# Laisser vide (ou toute autre valeur) en production.
APP_INSTANCE=

# Hôtes autorisés en production (protection Host header / DNS rebinding).
# Liste séparée par des virgules, ex. : coopcomm.example.fr,www.coopcomm.example.fr
# Laisser vide pour désactiver la restriction (non recommandé).
APP_HOSTS=

# Origines CORS autorisées sur les endpoints Active Storage (vide = aucune
# origine étrangère ; suffisant tant que le front est servi par le même domaine).
APP_CORS_ORIGINS=
