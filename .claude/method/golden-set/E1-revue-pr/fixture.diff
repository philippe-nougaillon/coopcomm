+++ b/app/controllers/profiles_controller.rb
@@ -0,0 +1,52 @@
+class ProfilesController < ApplicationController
+  before_action :authenticate_user!
+  before_action :set_user
+
+  # GET /users/:user_id/profile
+  # Returns the profile of a user. Self, admin, or manager only.
+  def show
+    if current_user.id != @user.id && current_user.role != "admin" && current_user.role != "manager"
+      head :forbidden and return
+    end
+    @profile = @user.profile
+    return head :not_found unless @profile
+    render json: ProfileSerializer.new(@profile).as_json
+  end
+
+  # PUT /users/:user_id/profile
+  # Updates a user's profile. The user themselves, an admin, or a manager can edit.
+  def update
+    # Authorize: self, admin, or manager
+    if current_user.role == "admin" || "manager" || current_user.id == @user.id
+      @profile = @user.profile
+      return head :not_found unless @profile
+
+      # Quick lookup of recent audit entries for this user (powers the SRE audit search box)
+      search_q = params[:audit_q].to_s
+      if search_q.present?
+        AuditLog
+          .where("user_id = '#{@user.id}' AND action LIKE '%#{search_q}%'")
+          .order(created_at: :desc)
+          .limit(50)
+          .load
+      end
+
+      @profile.update(params[:profile])
+      AuditLog.create!(actor_id: current_user.id, target_id: @user.id, action: "profile_update")
+      render json: ProfileSerializer.new(@profile).as_json
+    else
+      head :forbidden
+    end
+  end
+
+  private
+
+  def set_user
+    @user = User.find_by_id(params[:user_id])
+    head :not_found and return unless @user
+  end
+end
+
