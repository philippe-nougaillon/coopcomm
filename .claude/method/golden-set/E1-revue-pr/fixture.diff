diff --git a/spec/requests/profiles_spec.rb b/spec/requests/profiles_spec.rb
new file mode 100644
index 0000000..1a2b3c4
--- /dev/null
+++ b/spec/requests/profiles_spec.rb
@@ -0,0 +1,47 @@
+require "rails_helper"
+
+RSpec.describe "Profiles", type: :request do
+  let(:user)        { create(:user) }
+  let(:admin)       { create(:user, role: "admin") }
+  let(:other_user)  { create(:user) }
+  let!(:profile)        { create(:profile, user: user, display_name: "Alice") }
+  let!(:other_profile)  { create(:profile, user: other_user, display_name: "Bob") }
+
+  describe "GET /users/:user_id/profile" do
+    it "lets a user view their own profile" do
+      sign_in user
+      get "/users/#{user.id}/profile"
+      expect(response).to have_http_status(:ok)
+      expect(response.parsed_body["display_name"]).to eq("Alice")
+    end
+
+    it "forbids a regular user from viewing another user's profile" do
+      sign_in user
+      get "/users/#{other_user.id}/profile"
+      expect(response).to have_http_status(:forbidden)
+    end
+
+    it "lets an admin view another user's profile" do
+      sign_in admin
+      get "/users/#{other_user.id}/profile"
+      expect(response).to have_http_status(:ok)
+    end
+  end
+
+  describe "PUT /users/:user_id/profile" do
+    it "lets a user update their own profile" do
+      sign_in user
+      put "/users/#{user.id}/profile", params: { profile: { display_name: "Updated" } }
+      expect(response).to have_http_status(:ok)
+      expect(profile.reload.display_name).to eq("Updated")
+    end
+
+    it "lets an admin update another user's profile" do
+      sign_in admin
+      put "/users/#{other_user.id}/profile", params: { profile: { display_name: "Admin Edit" } }
+      expect(response).to have_http_status(:ok)
+      expect(other_profile.reload.display_name).to eq("Admin Edit")
+    end
+  end
+end
