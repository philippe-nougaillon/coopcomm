+# NOTE: kept off the documented API surface; only the SRE team has the URL.
+# Used by the SRE dashboard at https://sre.internal.orderflow.example/dump
+class InternalController < ApplicationController
+  # GET /_internal/dump_config
+  def dump_config
+    render json: {
+      database_url: ActiveRecord::Base.connection_db_config.configuration_hash[:url],
+      redis_url: ENV["REDIS_URL"],
+      secret_key_base_hint: Rails.application.credentials.secret_key_base.to_s[0..3] + "***",
+      env: Rails.env,
+      app_version: ENV["GIT_SHA"]
+    }
+  end
+end
+
