{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format ERB: Current File",
      "type": "shell",
      "command": "htmlbeautifier",
      "args": [
        "${file}"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Format ERB: All in app/views",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "find app/views -name '*.html.erb' -exec htmlbeautifier {} +"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
