<tr class="hover:bg-base-200/60 transition-colors duration-150 border-b border-slate-100 align-middle">
  <td class="px-4 py-3 text-lg font-semibold text-primary">
    <%= link_to facture.ref, facture, class: "hover:underline" %>
  </td>
  <td class="px-4 py-3">
    <span class="badge text-nowrap font-bold <%= facture.style %>"><%= facture.workflow_state.humanize %></span>
  </td>
  <td class="px-4 py-3"><%= facture.adherent&.nom_prénom %></td>
  <td class="px-4 py-3"><%= facture.service&.nom %></td>
  <td class="px-4 py-3"><%= facture.intitulé %></td>
  <td class="px-4 py-3 text-nowrap"><%= l(facture.date_livraison_souhaitée, format: :long) if facture.date_livraison_souhaitée %></td>
  <td class="px-4 py-3 text-right font-medium"><%= number_to_currency(facture.total_ht) %></td>
  <td class="px-2 py-3 text-center">
    <%= link_to facture, class: "btn btn-sm btn-ghost text-info hover:bg-info/20 gap-1" do %>
      Voir <i class="ti ti-eye"></i>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(facture).envoyer? && facture.can_envoyer? %>
      <%= button_to "Envoyer", envoyer_facture_path(facture), class: "btn btn-sm btn-info btn-outline hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(facture).valider? && facture.can_valider? %>
      <%= button_to "Valider", valider_facture_path(facture), class: "btn btn-sm btn-success btn-outline hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(facture).refuser? && facture.can_refuser? %>
      <%= button_to "Refuser", refuser_facture_path(facture), class: "btn btn-sm btn-error btn-outline hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(facture).pdf? %>
      <%= link_to pdf_facture_path(facture, filename: facture.pdf_filename),
                  class: "btn btn-sm", target: "_blank", title: "Générer le PDF", data: { turbo: false } do %>
        <span class="material-symbols-outlined">picture_as_pdf</span>
      <% end %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(facture).update? %>
      <%= link_to edit_facture_path(facture), class: "btn btn-sm btn-ghost hover:!border-gray-700", title: "Modifier" do %>
        <%= embedded_svg "icons/edit.svg", class: "w-4 h-4 fill-current transition-colors duration-200" %>
        <span class="hidden lg:inline">Modifier</span>
      <% end %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(facture).destroy? %>
      <button class="btn btn-sm btn-ghost text-error border border-transparent hover:!bg-error/20 hover:!border-error/40" 
          onclick="delete_facture_modal_<%= facture.id %>.showModal()" 
          title="Supprimer">
        <span class="material-symbols-outlined">delete</span>
      </button>
      <dialog id="delete_facture_modal_<%= facture.id %>" class="modal">
        <div class="modal-box">
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
          </form>
          <h3 class="text-lg font-bold text-error flex items-center gap-2">
            <%= embedded_svg "icons/warning.svg", title: "Supprimer la facture" %>
            Supprimer la facture
          </h3>
          <p class="py-4 text-sm text-slate-600 text-left">
            Êtes-vous certain(e) de vouloir supprimer cette facture ?
            Cette action est irréversible.
          </p>
          <div class="modal-action">
            <form method="dialog">
              <button class="btn btn-ghost">Annuler</button>
            </form>
            <%= button_to facture_path(facture),
                      method: :delete,
                      class: "btn btn-error text-white" do %>
              Oui, supprimer
            <% end %>
          </div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>Fermer</button>
        </form>
      </dialog>
    <% end %>
  </td>
</tr>
