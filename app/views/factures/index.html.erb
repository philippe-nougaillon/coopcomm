<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!("Factures") %></h1>
  </div>
  <%= form_tag factures_path, method: :get, class: "pt-6", data: { turbo_action: "advance" } do %>
    <%= champs_tri_caches %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4 w-full bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="w-full md:flex-1">
        <%= label_tag :search, "Rechercher", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= text_field_tag :search, params[:search], class: "input input-bordered input-md w-full",
                           placeholder: "Réf, intitulé", onchange: "this.form.submit()" %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :adhérent_ids, "Adhérents", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1"  %>
        <%= select_tag :adhérent_ids,
                      options_from_collection_for_select(@adhérents || [], 'id', 'nom_prénom', params[:adhérent_ids]),                       multiple: true,
                      class: 'slim-select w-full h-10',
                      data: { placeholder: 'Tous les adhérents',
                              max_values_shown_desktop: 2,
                              max_values_shown_mobile: 2 
                            },
                      onchange: 'this.form.requestSubmit()' %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :service_ids, "Services", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1"  %>
        <%= select_tag :service_ids,
                      options_from_collection_for_select(@services || [], 'id', 'nom', params[:service_ids]),                       class: 'slim-select w-full h-10',
                      data: { placeholder: 'Tous les services'},
                      onchange: 'this.form.requestSubmit()' %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :workflow_state, "Statut", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :workflow_state,
                       options_for_select(Facture.workflow_state_humanized, params[:workflow_state]),
                       include_blank: "Tous", class: "slim-select w-full h-10",
                       onchange: "this.form.submit()" %>
      </div>
    </div>
  <% end %>
</div>
<hr class="mt-6 mb-6">
<div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
</div>
<div class="flex flex-col bg-white border-x border-b border-slate-200 shadow-sm overflow-hidden <%= 'rounded-b-xl' unless @pagy&.pages.to_i > 1 %>">
  <div class="overflow-x-auto">
    <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
      <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
      <span>Faire glisser pour voir plus</span>
    </div>
    <table class="table table-sm w-full border-none">
      <thead class="bg-slate-100">
        <tr>
          <%= th_tri 'Réf', colonne: 'factures.ref', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Statut', colonne: 'factures.workflow_state', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Adhérent', colonne: 'factures.adherent', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Service', colonne: 'factures.service', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Intitulé', colonne: 'factures.intitulé', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Livraison', colonne: 'factures.date_livraison_souhaitée', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center' %>
          <%= th_tri 'Total HT', colonne: 'factures.total_ht', class: ' py-3 font-semibold text-slate-500 uppercase tracking-wider text-right w-10' %>
        </tr>
      </thead>
      <tbody>
        <% if @factures.any? %>
          <%= render partial: "facture", collection: @factures, locals: { last_mail_logs: @last_mail_logs } %>
        <% else %>
          <tr>
            <td colspan="15" class="text-center py-8 text-slate-400 text-base italic">
              Aucune facture.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy&.pages.to_i > 1 %>
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
      <div class="hidden sm:block sm:flex-1"></div>
      <div class="w-full sm:w-auto sm:flex-1 order-1 sm:order-2 flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class="text-base font-semibold text-slate-500 text-center sm:text-right w-full sm:flex-1 order-2 sm:order-3">
        <%= pagy_info(@pagy, item_name: "factures").html_safe %>
      </div>
    </div>
  <% end %>
</div>