<div class="mx-auto lg:w-2/3 w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold">
      <%= page_title!(@service.nom) %>
    </h1>
  </div>

  <p class="my-2 hover:cursor-help" title="Calcul de distance sur les interventions du service à partir de l'équipe de l'adhérent">
    <strong class="block text-slate-400 mb-1">Calcul distances ?</strong>
    <% if @service.calculate_distance %>
    <span class="material-symbols-outlined text-success">
      check_small
    </span>
    <% else %>
      <span class="material-symbols-outlined text-error">
        cancel
      </span>
    <% end %>
  </p>

  <div class="flex flex-wrap gap-2 mt-8">
    <% if policy(@service).edit? %>
      <%= link_to "Modifier", edit_service_path(@service), class: "btn" %>
    <% end %>
    <% if policy(@service).destroy? %>
      <%= button_to service_path(@service), method: :delete, id: "supprimer_service", data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer ce service ?" }, class: "btn", 'data-testid': "Supprimer le service" do %>
          <span class="material-symbols-outlined">
            delete
          </span>
      <% end %>
    <% end %>
    <%= link_to "Retour", admin_parametres_path, class: "btn" %>
  </div>
</div>