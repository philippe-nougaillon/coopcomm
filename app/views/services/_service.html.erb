<tr id="<%= dom_id service %>" class="hover:bg-base-300">
  <td class="px-4 py-3 uppercase text-primary font-semibold text-lg">
    <%= link_to service.nom, service, class: ' hover:underline' %>
  </td>
  <td class="px-4 py-3 text-center">
    <% users = service.users.to_a %>
    <% visible = users.first(3) %>
    <% overflow_users = users.size - visible.size %>
    <div class="flex flex-wrap gap-1.5 items-center">
      <% visible.each do |u| %>
        <span class="inline-block bg-white border border-slate-200 text-slate-600 text-sm px-2.5 py-1 rounded-full whitespace-nowrap shadow-sm">
          <%= u.nom_prénom %>
        </span>
      <% end %>
      <% if overflow_users > 0 %>
  <div class="relative inline-block" data-controller="dropdown">
    <button type="button"
            data-action="click->dropdown#togglePortal"
            class="inline-flex bg-white border border-slate-200 text-slate-600 text-sm px-2.5 py-1 rounded-full shadow-sm select-none cursor-pointer hover:bg-slate-50">
      + <%= overflow_users %>
    </button>

    <div data-dropdown-target="menu"
         class="hidden flex-col p-4 shadow-2xl bg-white border border-slate-200 rounded-xl w-58 max-h-60 overflow-y-auto">
      <span class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 px-1 block text-left">
        Autres utilisateurs (<%= overflow_users %>)
      </span>
      <div class="flex flex-col gap-1">
        <% users.drop(3).each do |u| %>
          <span class="text-sm text-slate-600 bg-white border border-slate-200 px-2.5 py-1 rounded-lg whitespace-normal break-words text-left">
            <%= u.nom_prénom %>
          </span>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
    </div>
  </td>
  <td class="px-4 py-3 text-center">
    <span class=" text-sm text-slate-600 whitespace-nowrap"><%= service.users.size %></span>
  </td>
  <td class="px-4 py-3 text-center">
    <% if service.calculate_distance %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium
                                   bg-green-50 text-green-700 border border-green-700">
        <%= embedded_svg "icons/check_small.svg", class: "text-sm", title: "Calcul activé" %>
        Activé
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium
                                   bg-slate-100 text-slate-400 border border-slate-700">
        <%= embedded_svg "icons/close_small.svg", class: "text-sm", title: "Calcul activé" %>
        Inactif
      </span>
    <% end %>
  </td>
</tr>
