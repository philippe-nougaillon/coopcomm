<tr id="<%= dom_id service %>" class="hover:bg-base-300">
  <td class="text-lg sm:text-2xl text-primary">
    <%= link_to service.nom, service, class: 'text-primary hover:underline' %>
  </td>
  <td class="text-sm">
    <%= service.users.ordered.map { |user| link_to(user.nom_prenom_role, user, class: 'hover:underline') }.join(', ').html_safe %>
  </td>
  <td class="text-sm">
    <%= service.users.count %>
  </td>
  <td class="text-sm">
    <% if service.calculate_distance %>
      <%= embedded_svg "icons/check_small.svg", class: "icon text-success", title: "Confirmer que la distance a été calculée" %>
    <% else %>
      <%= embedded_svg "icons/cancel.svg", class: "icon text-error", title: "Annuler que la distance n'a pas été calculée" %>
    <% end %>
  </td>
</tr>
