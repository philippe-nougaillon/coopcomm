<%= form_with(model: service, class: "contents", html: { autocomplete: "off", class: 'flex flex-col gap-2' }) do |form| %>
  <% if service.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2 class="font-black!">
        <%= pluralize(service.errors.count, "erreur") %> empêche(nt) ce service d'être sauvegardé :
      </h2>

      <ul class="list-disc list-inside">
        <% service.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="w-full">
    <%= form.label :nom, style: "display: block" %>
    <%= form.text_field :nom, class: 'input input-sm w-full', required: true %>
  </div>
  
  <%= form.submit "Enregistrer", id:"enregistrer_utilisateur", class: "btn btn-primary mt-4" %>
<% end %>
