<tr class="border-b border-slate-100 hover:bg-base-200/60 transition-colors">
  <td class="px-4 py-3 whitespace-nowrap">
    <%= time_tag(audit.created_at, format: :long) { "Il y a #{time_ago_in_words(audit.created_at)}" } %>
    <br>
    <span class="text-slate-400 text-xs">(<%= l(audit.created_at, format: :long) %>)</span>
  </td>
  <td class="px-4 py-3">
    <% if audit.user_id %>
      <% if audit.user %>
        <%= audit.user.email %>
        (#<%= audit.user.id %>)
        <br>
        <span class="text-slate-400 text-xs"><%= audit.user.rôle.humanize %></span>
      <% end %>
    <% else %>
      SYSTEM CONSOLE
    <% end %>
  </td>
  <td class="px-4 py-3"><%= audit.auditable_type %></td>
  <td class="px-4 py-3"><%= audit.action.humanize %></td>
  <td class="px-4 py-3">
    <% unless audit.comment %>
      <%= audit_changes_list(audit, current_user) %>
    <% else %>
      <%= audit.comment %>
    <% end %>
  </td>
</tr>
