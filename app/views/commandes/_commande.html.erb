<tr class="hover:bg-base-200/60 transition-colors duration-150 align-middle">
  <td class="pl-4 whitespace-nowrap py-3 text-lg font-semibold text-primary">
    <%= link_to commande.ref, commande, class: "hover:underline" %>
  </td>
  <td class="px-4 py-3">
    <span class="badge text-nowrap min-w-20 font-bold <%= commande.style %>"><%= commande.workflow_state.humanize %></span>
  </td>
  <td class="px-4 py-3 text-base"><%= commande.adherent&.nom_prénom %></td>
  <td class="px-4 py-3 text-base">
    <% services = commande.respond_to?(:services) ? commande.services.pluck(:nom) : [commande.service&.nom].compact %>
    <% shown = services.first(2) %>
    <% extra = services.size - shown.size %>
    <div class="flex flex-wrap gap-1.5 items-center">
      <% shown.each do |s| %>
        <span class="inline-block bg-white border border-slate-200 text-slate-600 text-sm px-2.5 py-1 rounded-full whitespace-nowrap shadow-sm">
          <%= s %>
        </span>
      <% end %>
      <% if extra > 0 %>
        <div class="relative inline-block" data-controller="dropdown">
          <button type="button"
                  data-action="click->dropdown#togglePortal"
            class="inline-flex bg-white border border-slate-200 text-slate-600 text-sm px-2.5 py-1 rounded-full shadow-sm select-none cursor-pointer hover:bg-slate-50">
            + <%= extra %>
          </button>
          <div data-dropdown-target="menu"
               class="hidden absolute z-50 flex-col p-4 shadow-2xl bg-white border border-slate-200 rounded-xl w-58 max-h-60 overflow-y-auto mt-1 left-0">
            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 px-1 block text-left">
              Autres services (<%= extra %>)
            </span>
            <div class="flex flex-col gap-1">
              <% services.drop(2).each do |extra_service| %>
                <span class="text-sm text-slate-600 bg-white border border-slate-200 px-2.5 py-1 rounded-lg whitespace-normal break-words text-left">
                  <%= extra_service %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <% if services.empty? %>
        <span class="text-slate-400 italic text-sm">—</span>
      <% end %>
    </div>
  </td>
  <td class="px-4 py-3 text-base first-letter:capitalize"><%= commande.intitulé %></td>
  <td class="px-4 py-3 text-nowrap text-center text-base">
    <% if commande.date_livraison_souhaitée.present? %>
      <% formatted_date = l(commande.date_livraison_souhaitée, format: :long) %>
      <span class="block max-w-48 truncate text-slate-500 cursor-help" title="<%= formatted_date %>">
        <%= formatted_date %>
      </span>
    <% else %>
      <span class="text-slate-400 flex justify-center">—</span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-right  font-medium text-sm "><%= number_to_currency(commande.total_ht) %></td>
</tr>
