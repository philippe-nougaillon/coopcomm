<div class="mx-auto w-full max-w-xl ">
  <h1 class="text-primary font-bold text-2xl md:text-4xl text-center my-8">
    <%= page_title!(t "devise.invitations.edit.header") %>
  </h1>

  <div class="max-w-3xl mx-auto bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-100/50 p-6 md:p-8">
    <%= form_with(model: resource, scope: resource_name, url: invitation_path(resource_name), method: :put, class: "contents", html: { autocomplete: "off", class: 'flex flex-col gap-2' }) do |form| %>
      <% if resource.errors.any? %>
        <div id="error_explanation" class="bg-red-50 text-red-500 px-4 py-3 font-medium rounded-lg mb-2 border border-red-200">
          <h2 class="font-black mb-2 text-sm md:text-base">
            <%= pluralize(resource.errors.count, "erreur") %> empêche(nt) cet utilisateur d'être sauvegardé :
          </h2>
          <ul class="list-disc list-inside text-xs opacity-90">
            <% resource.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form.hidden_field :invitation_token, readonly: true %>

      <%# Permet au navigateur d'enregistrer le mdp avec l'email %>
      <div class="sr-only" aria-hidden="true">
        <%= form.label :email, class: "label font-semibold text-slate-700 pt-0" %>
        <%= form.email_field :email, autocomplete: "username", tabindex: "-1", class: 'input input-bordered input-sm w-full focus:input-primary' %>
      </div>

      <div data-controller="password-strength">

        <div class="w-full">
          <%= form.label :password, class: "label font-semibold text-slate-700" do %>
            Mot de passe <span class="text-red-500">*</span>
          <% end %>
          <div data-controller="password-visibility" class="relative w-full">
            <%= form.password_field :password,
              class: 'input input-bordered w-full focus:input-primary pr-10',
              required: true,
              autocomplete: "new-password",
              data: {
                password_visibility_target: "input",
                password_strength_target: "input",
                action: "input->password-strength#check"
              } %>
            <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-700">
              <span data-password-visibility-target="showIcon" class="block">
                <%= embedded_svg "icons/visibility_off.svg", class: "text-base" %>
              </span>
              <span data-password-visibility-target="hideIcon" class="hidden">
                <%= embedded_svg "icons/visibility.svg", class: "text-base" %>
              </span>
            </button>
          </div>
        </div>

        <div class="w-full my-2">
          <%= form.label :password_confirmation, class: "label font-semibold text-slate-700" do %>
            Confirmation du mot de passe <span class="text-red-500">*</span>
          <% end %>
          <div data-controller="password-visibility" class="relative w-full">
            <%= form.password_field :password_confirmation,
                  class: 'input input-bordered w-full focus:input-primary',
                  required: true,
                  data: {
                  password_visibility_target: "input",
                  password_strength_target: "input",
                  action: "input->password-strength#check"
                } %>
              <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-700">
                <span data-password-visibility-target="showIcon" class="block">
                  <%= embedded_svg "icons/visibility_off.svg", class: "text-base" %>
                </span>
                <span data-password-visibility-target="hideIcon" class="hidden">
                  <%= embedded_svg "icons/visibility.svg", class: "text-base" %>
                </span>
              </button>
            </div>
          </div>

        <ul class="text-sm mb-6 space-y-1.5 bg-slate-50 border border-slate-100 rounded-xl p-4">
          <p class="text-slate-400">Votre mot de passe doit contenir au moins : </p>
          <li data-password-strength-target="ruleLength" class="flex items-center gap-2 text-slate-400 transition-colors">
            <span class="rule-icon">○</span> 12 caractères minimum
          </li>
          <li data-password-strength-target="ruleUpper" class="flex items-center gap-2 text-slate-400 transition-colors">
            <span class="rule-icon">○</span> 1 majuscule
          </li>
          <li data-password-strength-target="ruleLower" class="flex items-center gap-2 text-slate-400 transition-colors">
            <span class="rule-icon">○</span> 1 minuscule
          </li>
          <li data-password-strength-target="ruleDigit" class="flex items-center gap-2 text-slate-400 transition-colors">
            <span class="rule-icon">○</span> 1 chiffre
          </li>
          <li data-password-strength-target="ruleSymbol" class="flex items-center gap-2 text-slate-400 transition-colors">
            <span class="rule-icon">○</span> 1 symbole
          </li>
        </ul>

      </div>

      <div class="flex flex-row gap-3 mt-4 pt-4">
        <%= button_tag "Annuler", type: "button", onclick: "history.back();", class: "btn w-1/3 sm:w-1/4 shrink-0" %>
        <%= form.submit t("devise.invitations.edit.submit_button"), id: "definir_mot_de_passe",  class: "btn btn-primary text-white font-bold flex-1 shadow-md hover:shadow-lg transition-all" %>
       </div>
    <% end %>
  </div>
</div>
