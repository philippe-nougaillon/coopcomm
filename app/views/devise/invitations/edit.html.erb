<div class="hero min-h-screen">
  <div class="mx-auto w-full lg:w-96 card shadow bg-base-100 p-8">
    <h1 class="text-2xl font-bold border-b border-gray-400 pb-4 w-full text-center my-4"><%= page_title!(t "devise.invitations.edit.header") %></h1>

    <p>Votre mot de passe doit contenir au moins : </p>
    <ul class="list-disc list-inside">
      <li>12 caractères</li>
      <li>1 majuscule</li>
      <li>1 minuscule</li>
      <li>1 chiffre</li>
      <li>1 symbole</li>
    </ul>
    <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :invitation_token, readonly: true %>

      <div class="field mb-4">
        <%= f.label :email, "Adresse email" %><br />
        <%= f.email_field :email, class: 'input input-sm w-full bg-base-200 text-gray-500', readonly: true, autocomplete: "username" %>
      </div>

      <% if f.object.class.require_password_on_accepting %>
        <div class="field">
          <%= f.label :password %><br />
          <%= f.password_field :password, class:'input input-sm w-full', required: true %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation %><br />
          <%= f.password_field :password_confirmation, class:'input input-sm w-full', required: true %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit t("devise.invitations.edit.submit_button"), class: 'btn btn-outline lg:btn-lg rounded btn-primary hover:text-white! w-full my-4' %>
      </div>
    <% end %>
  </div>
</div>