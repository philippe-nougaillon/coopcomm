<div class="hero min-h-screen">
  <div class="mx-auto w-full lg:w-96 card shadow bg-base-100 p-8">
    <h1 class="text-2xl font-bold border-b border-gray-400 pb-4 w-full text-center my-4">
      <%= page_title!(t "devise.invitations.edit.header") %></h1>
    <p>Votre mot de passe doit contenir au moins : </p>
    <ul class="list-disc list-inside">
      <li>12 caractères</li>
      <li>1 majuscule</li>
      <li>1 minuscule</li>
      <li>1 chiffre</li>
      <li>1 symbole</li>
    </ul>
    <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :invitation_token, readonly: true %>
      <%# Permet au navigateur d'enregistrer le mdp avec l'email %>
      <div class="sr-only" aria-hidden="true">
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: "username", tabindex: "-1" %>
      </div>
      <% if f.object.class.require_password_on_accepting %>
        <div class="w-full">
          <%= f.label :password, style: "display: block" %>
          <div data-controller="password-visibility" class="relative w-full">
            <%= f.password_field :password, 
                  class: 'input input-bordered w-full focus:input-primary pr-10', 
                  required: true, 
                  autocomplete: "new-password",
                  data: { password_visibility_target: "input" } %>
            <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-700">
              <svg data-password-visibility-target="showIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <svg data-password-visibility-target="hideIcon" class="hidden w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
              </svg>
            </button>
          </div>
        </div>
        <div class="field">
          <%= f.label :password_confirmation %><br />
          <%= f.password_field :password_confirmation, class:'input input-bordered w-full focus:input-primary', required: true %>
        </div>
      <% end %>
      <div class="actions">
        <%= f.submit t("devise.invitations.edit.submit_button"), class: 'btn btn-outline lg:btn-lg rounded btn-primary hover:text-white! w-full my-4' %>
      </div>
    <% end %>
  </div>
</div>
