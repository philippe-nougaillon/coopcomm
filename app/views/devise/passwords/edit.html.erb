<div class="hero min-h-screen">
  <div class="mx-auto w-full lg:w-96 card shadow bg-base-100 p-8">
    <h1 class="text-2xl font-bold border-b border-gray-400 pb-4 w-full text-center my-4">
      Changer de mot de passe
    </h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <%= f.label :password, "Nouveau mot de passe" %><br />
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class:'input input-sm input-bordered w-full', required: true %>
        <% if @minimum_password_length %>
          <div class="label">
            <span class="label-text-alt">(<%= @minimum_password_length %> caractères minimum)</span>
          </div>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirmation mot de passe" %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class:'input input-sm input-bordered w-full', required: true %>
      </div>

      <div class="actions">
        <%= f.submit "Changer mon mot de passe", class: 'btn btn-outline lg:btn-lg rounded btn-primary hover:text-white! w-full my-4' %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>