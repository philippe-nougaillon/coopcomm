<% user_name = @resource.email.split('@').first.capitalize %>

<h2 style="margin-top: 0; color: #0f172a; font-size: 18px;">
  <%= t('.greeting', recipient: user_name) %>
</h2>

<p style="color: #475569; margin-bottom: 24px; font-size: 15px; line-height: 1.6;">
  <%= t('.instruction') %>
</p>

<p style="margin: 32px 0; text-align: center;">
  <%= link_to t('.action'), 
              confirmation_url(@resource, confirmation_token: @token), 
              style: "background-color: #691E9A; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600; display: inline-block; font-size: 14px;" %>
</p>

<div style="background-color: #f8fafc; border-left: 4px solid #3b82f6; padding: 12px 16px; border-radius: 0 4px 4px 0;">
  <p style="margin: 0; font-size: 13px; color: #64748b;">
    En cas d'erreur, rapprochez-vous de votre gestionnaire.
  </p>
</div>