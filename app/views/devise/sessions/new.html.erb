<div class="hero min-h-screen">
  <div class="mx-auto w-full lg:w-96 card shadow bg-base-100 p-8">
    <h1 class="text-2xl font-bold border-b border-gray-400 pb-4 w-full text-center my-4">Connexion</h1>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class:'input input-sm input-bordered w-full', required: true %>
      </div>

      <div class="field my-4">
        <%= f.label :password %><br />
        <%= f.password_field :password, autocomplete: "current-password", class:'input input-sm input-bordered w-full', required: true %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Se connecter", class: 'btn btn-outline lg:btn-lg rounded btn-primary hover:!text-white w-full my-4', :data => { :"test" => "login-submit" } %>
      </div>
    <% end %>
    <%= render "devise/shared/links" %>
  </div>
</div>