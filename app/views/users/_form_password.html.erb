<%= form_with(model: user, url: update_password_user_path(user), method: :patch, class: "contents", html: { autocomplete: "off", class: 'flex flex-col gap-2' }) do |form| %>
  <% if user.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3 mb-4">
      <h2 class="font-black!">
        <%= pluralize(user.errors.count, "erreur") %> empêche(nt) cet utilisateur d'être sauvegardé :
      </h2>
      <ul class="list-disc list-inside">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%# Permet au navigateur d'enregistrer le mdp avec l'email %>
  <div class="sr-only" aria-hidden="true">
    <%= form.label :email %>
    <%= form.email_field :email, autocomplete: "username", tabindex: "-1" %>
  </div>
  <div class="w-full">
    <%= form.label :password, style: "display: block" %>
    <div data-controller="password-visibility" class="relative w-full">
      <%= form.password_field :password, 
              class: 'input input-sm w-full pr-10', 
              required: true, 
              autocomplete: "new-password",
              data: { password_visibility_target: "input" } %>
      <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-700">
        <svg data-password-visibility-target="showIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <svg data-password-visibility-target="hideIcon" class="hidden w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
        </svg>
      </button>
    </div>
  </div>
  <div class="w-full">
    <%= form.label :password_confirmation, style: "display: block" %>
    <%= form.password_field :password_confirmation, class: 'input input-sm w-full', required: true %>
  </div>
  <div class="flex gap-2 mt-4 w-full">
    <% if current_user.manager_or_admin? %>
      <%= link_to "Annuler",
      users_path,
      class: "btn flex-1" %>
      <%= form.submit "Enregistrer",
      id: "enregistrer_utilisateur",
      class: "btn btn-primary flex-1" %>
    <% end %>
  </div>
<% end %>
<div class="my-10">
  <%= link_to user_path(@user), class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition" do %>
    
    <%= embedded_svg "icons/arrow_back.svg", class: "icon text-base", title: "Retour à la fiche utilisateur" %>
    Retour à la fiche utilisateur
  <% end %>
</div>