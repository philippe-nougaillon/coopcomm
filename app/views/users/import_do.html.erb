<div class="mx-auto w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16 mb-8">
    <h1 class="text-primary font-bold text-3xl sm:text-4xl whitespace-nowrap">
      <%= page_title!("Résultat de l'import") %>
    </h1>
  </div>

  
  <% if @rapport.interrompu? %>
  <div class="max-w-3xl bg-white border border-red-200 rounded-2xl shadow-sm flex items-start gap-3" style="padding: 1.25rem;">
    <%= embedded_svg "icons/warning.svg", class: "text-error shrink-0 mt-0.5", title: "Import interrompu" %>
    <div>
      <p class="text-xs font-medium text-error uppercase tracking-wide mb-1">Import interrompu</p>
      <p class="font-medium text-slate-800 text-sm"><%= @rapport.message_interruption %></p>
    </div>
  </div>
<% else %>
  <% unless @rapport.appliqué %>
    <div class="max-w-4xl bg-amber-50 border border-amber-200 rounded-2xl mb-6 flex items-center gap-3" style="padding: 0.75rem 1.25rem;">
      <%= embedded_svg "icons/info.svg", class: "text-amber-600 shrink-0", title: "Mode test" %>
      <p class="font-medium text-amber-800 text-sm">
        Simulation : les modifications n'ont pas été enregistrées.
      </p>
    </div>
  <% end %>

    <%
      if @rapport.en_erreur > 0
        card_classes         = "bg-white"
        text_classes         = "text-amber-800"
        title_text           = @rapport.appliqué ? "Importation partielle exécutée" : "Simulation terminée (avec des erreurs)"
        subtitle_text        = "Consultez les motifs d'erreur pour ajuster le fichier Excel et relancer l'importation."
        icon_svg             = "icons/warning.svg"
        erreur_number_class  = "text-error"
      else
        card_classes         = "bg-white"
        text_classes         = "text-emerald-800"
        title_text           = @rapport.appliqué ? "Importation exécutée avec succès !" : "Simulation réussie !"
        subtitle_text        = @rapport.appliqué ? "Toutes les données ont été enregistrées et les utilisateurs ont été notifiés par e-mail." : "Aucune donnée n'a été ajoutée ou modifiée."
        icon_svg             = "icons/check.svg"
        erreur_number_class  = "text-slate-800"
      end
    %>

    <div class="max-w-4xl mb-10 p-5 border border-slate-200 rounded-2xl shadow-sm <%= card_classes %>" data-testid="bilan_import">
      <p class="text-xl text-black font-semibold uppercase tracking-wide mb-3 opacity-70">Bilan</p>

      <div class="flex gap-3">
        <div class="bg-white rounded-lg px-4 py-3 flex-1 border border-slate-100">
          <p class="text-xl font-semibold text-slate-800"><%= @rapport.importés %></p>
          <p class="text-sm text-slate-500">Ligne(s) importées</p>
        </div>
        <div class="bg-white rounded-lg px-4 py-3 flex-1 border border-slate-100">
          <p class="text-xl font-semibold <%= erreur_number_class %>"><%= @rapport.en_erreur %></p>
          <p class="text-sm text-slate-500">Ligne(s) en erreur</p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-4 pt-4 border-t border-slate-100">
        <div class="flex items-center gap-3 <%= text_classes %>">
          <%= embedded_svg icon_svg, class: "w-5 h-5 shrink-0" %>
          <div>
            <p class="text-sm font-semibold"><%= title_text %></p>
            <p class="text-xs opacity-80 mt-0.5"><%= subtitle_text %></p>
          </div>
        </div>

        <% if @rapport.en_erreur > 0 %>
          <%= link_to import_users_path, class: "btn btn-warning shrink-0 inline-flex items-center gap-2" do %>
            <%= embedded_svg "icons/refresh.svg", class: "w-4 h-4" %>
            <span>Relancer l'importation</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @rapport.succès.any? %>
      <h2 class="text-2xl text-secondary font-semibold mb-4">Lignes importées</h2>

      <div class="block md:hidden flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
      </div>
      <div class="overflow-x-auto border-x border-b border-slate-200 shadow-sm bg-white rounded-b-xl md:rounded-xl mb-10">
        <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
          <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
          <span>Faire glisser pour voir plus</span>
        </div>
        <table class="table text-sm w-full" data-testid="tableau_succes">
          <thead class="bg-slate-100 text-slate-600 font-semibold">
            <tr>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Ligne</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Type</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Nom / Prénom</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Email</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Service</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Changements</th>
            </tr>
          </thead>
          <tbody>
            <% @rapport.succès.each do |ligne| %>
              <tr>
                <td class="px-4 py-3 text-slate-500"><%= ligne.numéro %></td>
                <td class="px-4 py-3 text-slate-800"><%= ligne.type %></td>
                <td class="px-4 py-3 font-medium text-slate-800"><%= ligne.nom %></td>
                <td class="px-4 py-3 text-slate-500 break-all"><%= ligne.email %></td>
                <td class="px-4 py-3 text-slate-500"><%= ligne.service %></td>
                <td class="px-4 py-3 text-slate-500"><%= import_changements(ligne.changements) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @rapport.erreurs.any? %>
      <h2 class="text-2xl text-secondary font-semibold mb-4">Lignes en erreur</h2>

      <div class="block md:hidden flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
      </div>
      <div class="overflow-x-auto border-x border-b border-slate-200 shadow-sm bg-white rounded-b-xl md:rounded-xl mb-10">
        <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
          <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
          <span>Faire glisser pour voir plus</span>
        </div>
        <table class="table text-sm w-full" data-testid="tableau_erreurs">
          <thead class="bg-slate-100 text-slate-600 font-semibold">
            <tr>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Ligne</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Nom / Prénom</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Email</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Service</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Motifs</th>
            </tr>
          </thead>
          <tbody>
            <% @rapport.erreurs.each do |ligne| %>
              <tr>
                <td class="px-4 py-3 text-slate-500"><%= ligne.numéro %></td>
                <td class="px-4 py-3 font-medium text-slate-800"><%= ligne.nom %></td>
                <td class="px-4 py-3 text-slate-500 break-all"><%= ligne.email %></td>
                <td class="px-4 py-3 text-slate-500"><%= ligne.service %></td>
                <td class="px-4 py-3">
                  <span class="text-error"><%= ligne.messages.join(' · ').humanize %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

  <% end %>

  <div class="mb-10">
    <%= link_to users_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste des utilisateurs" %>
      <span>Retour à la liste des utilisateurs</span>
    <% end %>
  </div>
</div>