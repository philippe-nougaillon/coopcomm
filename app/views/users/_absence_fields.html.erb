<%# app/views/absences/_absence_fields.html.erb %>
<% is_half_day = f.object.matin || f.object.après_midi %>

<%# On englobe tout dans "absence-form-container" pour que le JS s'y retrouve %>
<div class="absence-form-container flex flex-col gap-4 w-full">
  
  <%# Champs cachés pour Rails %>
  <%= f.hidden_field :matin, class: "hidden-matin", value: f.object.matin ? '1' : '0' %>
  <%= f.hidden_field :après_midi, class: "hidden-apres-midi", value: f.object.après_midi ? '1' : '0' %>

  <%# Choix du type de journée (f.object_name permet de grouper les radios par absence automatiquement !) %>
  <div class="flex gap-6 mt-1">
    <label class="label cursor-pointer justify-start gap-2">
      <input type="radio" name="<%= f.object_name %>[absence_type]" value="full" class="type-radio radio radio-primary radio-sm" 
             onchange="handleHalfDayChange(this)" <%= 'checked' unless is_half_day %> />
      <span class="label-text">Journée entière</span>
    </label>
    
    <label class="label cursor-pointer justify-start gap-2">
      <input type="radio" name="<%= f.object_name %>[absence_type]" value="half" class="type-radio radio radio-primary radio-sm" 
             onchange="handleHalfDayChange(this)" <%= 'checked' if is_half_day %> />
      <span class="label-text">Demi-journée</span>
    </label>
  </div>

  <%# Dates %>
  <div class="flex flex-wrap gap-4">
    <div class="flex-1 flex flex-col">
      <%= f.label :du, class: "text-sm text-slate-500 mb-1" %>
      <%= f.date_field :du, class: "du-input input input-sm input-bordered w-full", required: true, onchange: "syncDates(this)" %>
    </div>
    <div class="au-container flex-1 flex flex-col <%= 'hidden' if is_half_day %>">
      <%= f.label :au, class: "text-sm text-slate-500 mb-1" %>
      <%= f.date_field :au, class: "au-input input input-sm input-bordered w-full", required: true %>
    </div>
  </div>

  <%# Radios Matin / Après-midi %>
  <div class="half-days-container <%= is_half_day ? '' : 'hidden' %> flex gap-6 p-3 bg-base-200/50 rounded-box border border-base-200">
    <label class="label cursor-pointer justify-start gap-2">
      <input type="radio" name="<%= f.object_name %>[period]" value="matin" class="period-radio radio radio-secondary radio-sm"
             onchange="updateHiddenPeriods(this)" <%= 'checked' if f.object.matin %> />
      <span class="label-text font-medium">Matin</span>
    </label>
    <label class="label cursor-pointer justify-start gap-2">
      <input type="radio" name="<%= f.object_name %>[period]" value="apres_midi" class="period-radio radio radio-secondary radio-sm"
             onchange="updateHiddenPeriods(this)" <%= 'checked' if f.object.après_midi %> />
      <span class="label-text font-medium">Après-midi</span>
    </label>
  </div>

  <%# Motif et Observation %>
  <div class="flex flex-col gap-1">
    <%= f.label :motif, class: "text-sm text-slate-500" %>
    <%= f.select :motif, Absence.motifs.keys.map { |k| [k.humanize, k] }, { selected: f.object.motif }, class: 'select select-sm select-bordered w-full', required: true %>
  </div>

  <div class="flex flex-col gap-1">
    <%= f.label :observation, class: "text-sm text-slate-500" %>
    <%= f.text_area :observation, class: "textarea textarea-bordered w-full h-16" %>
  </div>
</div>