<tr id="" class="hover:bg-base-300">
  <td>
    <%= render partial: 'partials/user_profile_picture', locals: {user: agent} %>
  </td>
  <td class="text-lg sm:text-xl text-primary">
    <%= link_to agent, class: 'hover:underline hover:text-base-content' do %>
      <%= agent.nom_prénom %>
    <% end %>
  </td>

  <td>
    <%= agent.service %>
  </td>

  <% (@date..@date_fin).each do | date | %>
    <td>
      <% interventions = agent.interventions.where(" ? BETWEEN DATE(interventions.début_prévue) AND DATE(interventions.fin_prévue) ", date) %>

      <% absent = agent.current_absence(date) %>

      <% interventions = agent.interventions.where(" ? BETWEEN DATE(interventions.début_prévue) AND DATE(interventions.fin_prévue) ", date) %>
      <% interventions_matin = interventions.where("début_prévue < ?", Time.parse(date.to_s + " 13:00")) %>
      <% interventions_soir = interventions.where("fin_prévue > ?", Time.parse(date.to_s + " 13:00")) %>
    
      <% if interventions_matin.any? || absent %>
        <span class="bg-red-300" style="padding-left: 15px;" title="<%= interventions_matin.pluck(:description) || absent.motif.blank? ? 'Absent' : absent.motif %>"></span>
      <% else %>
        <%= link_to new_intervention_path(agent_ids: agent.id, début_prévue: date, début_prévue_hour: 8, fin_prévue: date, fin_prévue_hour: 13) do %>
        <span class="bg-green-300 hover:bg-blue-500" style="padding-left: 15px;" title="Créer une intervention pour réserver cet agent"></span>
        <% end %>
      <% end %>

      <% if interventions_soir.any? || absent %>
        <span  class="bg-red-300" style="padding-left: 15px; margin-left: 5px;" title="<%= interventions_soir.pluck(:description) || absent.motif.blank? ? 'Absent' : absent.motif %>"></span>
      <% else %>
        <%= link_to new_intervention_path(agent_ids: agent.id, début_prévue: date, début_prévue_hour: 13, début_prévue_minute: 5, fin_prévue: date, fin_prévue_hour: 18) do %>
          <span class="bg-green-300 hover:bg-blue-500" style="padding-left: 15px; margin-left: 5px;" title="Créer une intervention pour réserver cet agent"></span>
        <% end %>
      <% end %>
    </td>
  <% end %>
</tr>