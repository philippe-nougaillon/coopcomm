<tr id="" class="hover:bg-base-300">
  <td>
    <%= render partial: 'partials/user_profile_picture', locals: {user: agent} %>
  </td>
  <td class="text-lg sm:text-xl text-primary">
    <%= link_to agent, class: 'hover:underline hover:text-base-content' do %>
      <%= agent.nom_prénom %>
    <% end %>
  </td>

  <td>
    <%= agent.services.pluck(:nom).join(", ") %>
  </td>

  <% (@date..@date_fin).each do | date | %>
    <td class="text-center <%= 'bg-yellow-50' if date == Date.today %>">
      <% interventions = agent.interventions.where(" ? BETWEEN DATE(interventions.début_prévue) AND DATE(interventions.fin_prévue) ", date) %>

      <% absence_matin = agent.current_absence(date, :matin) %>
      <% absence_soir = agent.current_absence(date, :apres_midi) %>

      <% interventions = agent.interventions.where(" ? BETWEEN DATE(interventions.début_prévue) AND DATE(interventions.fin_prévue) ", date) %>
      <% interventions_matin = interventions.where("début_prévue < ?", Time.parse(date.to_s + " 13:00")) %>
      <% interventions_soir = interventions.where("fin_prévue > ?", Time.parse(date.to_s + " 13:00")) %>
    
      <% if interventions_matin.any? || absence_matin %>
        <span class="bg-red-300 border-1" style="padding-left: 15px;" title="<%= absence_matin&.motif || interventions_matin.pluck(:description) %>"></span>
      <% else %>
        <%= link_to new_intervention_path(agent_id: agent.id, début_prévue: date, début_prévue_hour: 8, fin_prévue: date, fin_prévue_hour: 13) do %>
        <span class="border-1 hover:bg-green-500" style="padding-left: 15px;" title="Créer une intervention pour réserver cet agent"></span>
        <% end %>
      <% end %>

      <% if interventions_soir.any? || absence_soir %>
        <span  class="bg-red-300 border-1" style="padding-left: 15px; margin-left: 5px;" title="<%= absence_soir&.motif || interventions_soir.pluck(:description) %>"></span>
      <% else %>
        <%= link_to new_intervention_path(agent_id: agent.id, début_prévue: date, début_prévue_hour: 13, début_prévue_minute: 5, fin_prévue: date, fin_prévue_hour: 18) do %>
          <span class="border-1 hover:bg-green-500" style="padding-left: 15px; margin-left: 5px;" title="Créer une intervention pour réserver cet agent"></span>
        <% end %>
      <% end %>
    </td>
  <% end %>
</tr>