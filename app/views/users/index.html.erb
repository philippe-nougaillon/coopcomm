<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!('Utilisateurs') %>
    </h1>
    <%= link_to admin_create_new_user_path,
            data: { testid: "ajouter_utilisateur" },
            class: "btn btn-primary btn-md rounded flex items-center justify-center gap-2 text-sm text-white border border-primary hover:bg-transparent hover:text-primary hover:border-primary",
            title: "Créer un nouvel agent" do %>
      <%= embedded_svg "icons/person_add.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
      <span class="hidden md:block">Ajouter un utilisateur</span>
    <% end %>
  </div>
  <%= form_tag request.path, method: :get, class: "pt-6", data: { turbo_frame: "users_table", turbo_action: "advance" } do %>
    <%= champs_tri_caches %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4 w-full bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="w-full md:flex-1">
        <%= label_tag :search, "Rechercher",class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1"  %>
        <%= text_field_tag :search, params[:search], include_blank: true,
                onchange: 'this.form.requestSubmit()',
                class: 'input input-bordered input-md w-full',
                placeholder: 'Nom / Prénom' %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :rôle, "Rôle", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1"  %>
        <%= select_tag :rôle,
                options_for_select(User.rôles.sort_by { |k, _| I18n.transliterate(k) }, params[:rôle]),
                multiple: true,
                class: 'slim-select w-full h-10',
                data: { placeholder: 'Tous les rôles' },
                onchange: 'this.form.requestSubmit()' %>
      </div>
      <%# Filtre masqué si le current_user n'a qu'un seul service (sauf administrateur). %>
      <% if current_user.administrateur? || @services.size > 1 %>
        <div class="w-full md:flex-1">
          <%= label_tag :services, "Services", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1"  %>
          <%# Champ caché : garantit que `services[]` est TOUJOURS soumis, même filtre
              vidé → le contrôleur distingue « premier affichage » (param absent →
              services présélectionnés) de « filtre vidé » (param présent vide → tout
              le périmètre). Cf. ApplicationController#scoped_services. %>
          <%= hidden_field_tag 'services[]', '', id: nil %>
          <%= select_tag :services,
                  options_from_collection_for_select(@services, 'id', 'nom', @selected_service_ids),
                  multiple: true,
                  class: 'slim-select w-full h-10',
                  data: { placeholder: 'Tous les services' },
                  onchange: 'this.form.requestSubmit()' %>
        </div>
      <% end %>
      <div class="w-full md:flex-1">
        <%= label_tag :user_tag, "Mots clés", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :user_tag,
                options_from_collection_for_select(@users_tags, :name, :name, params[:user_tag]),
                multiple: true,
                class: 'slim-select w-full h-10', 
                data: { placeholder: 'Tous les mots-clés' },
                onchange: 'this.form.requestSubmit()' %>
      </div>



      <div class="flex items-center gap-3 h-10 px-3 border border-slate-200 rounded-lg bg-slate-50 cursor-pointer"
       onclick="document.getElementById('absent').click()">
        <%= check_box_tag :absent, 1, params[:absent],
          id: 'absent',
          class: 'hidden',
          onchange: 'this.form.requestSubmit()' %>
        <div id="toggle-track"
         class="w-8 h-4 rounded-full transition-colors duration-200 flex items-center px-0.5 flex-shrink-0 <%= params[:absent].present? ? 'bg-[#007fcb]' : 'bg-slate-300' %>">
          <div class="w-3 h-3 rounded-full bg-white transition-transform duration-200 <%= params[:absent].present? ? 'translate-x-4' : 'translate-x-0' %>"></div>
        </div>
        <span class="text-sm font-medium text-slate-600 whitespace-nowrap">
          Absents ?
        </span>
      </div>

      
      <div class="flex items-center gap-3 h-10 px-3 border border-slate-200 rounded-lg bg-slate-50 cursor-pointer"
       onclick="document.getElementById('discarded').click()">
        <%= check_box_tag :discarded, 1, params[:discarded],
          id: 'discarded',
          class: 'hidden',
          onchange: 'this.form.requestSubmit()' %>
        <div id="toggle-track"
         class="w-8 h-4 rounded-full transition-colors duration-200 flex items-center px-0.5 flex-shrink-0 <%= params[:discarded].present? ? 'bg-[#007fcb]' : 'bg-slate-300' %>">
          <div class="w-3 h-3 rounded-full bg-white transition-transform duration-200 <%= params[:discarded].present? ? 'translate-x-4' : 'translate-x-0' %>"></div>
        </div>
        <span class="text-sm font-medium text-slate-600 whitespace-nowrap">
          Désactivés ?
        </span>
      </div>
    </div>
  <% end %>
</div>
<hr class="mt-6 mb-6">
<%= tableau_encadré "users_table" do %>
<div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-none md:rounded-t-xl border-t border-x md:border-b-0 border-slate-200">
  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
</div>
<div class="flex flex-col bg-white border border-slate-200 rounded-b-xl rounded-t-none md:rounded-b-xl md:rounded-t-none shadow-sm overflow-hidden">
    <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
      <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
      <span>Faire glisser pour voir plus</span>
    </div>
    <div class="overflow-x-auto">
      <table id="users" class="table table-sm w-full border-none">
        <thead class="bg-slate-100">
          <tr>
            <th class="w-10 px-3 py-3"></th>
            <%= th_tri 'Nom', colonne: 'users.nom', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Rôle', colonne: 'users.rôle', colspan: 2, class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider whitespace-nowrap' %>
            <%= th_tri 'Service', colonne: 'users.service', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Mots clés', colonne: 'users.tags', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Email', colonne: 'users.email', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Absent ?', colonne: 'users.absent', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center' %>
            <%= th_tri 'Évaluation', colonne: 'users.moyenne', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          </tr>
        </thead>
        <tbody>
          <% if @users.any? %>
            <%= render @users %>
          <% else %>
            <tr>
              <td colspan="8" class="text-left md:text-center py-8 text-slate-400 text-base italic">
                Aucun résultat trouvé pour cette recherche.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<div class="flex flex-col bg-white border-x border-b border-slate-200 rounded-b-xl">
  <div class="flex flex-wrap justify-end items-center gap-2 p-4">
    <% if @users.any? %>
      <%= link_to url_for(params.permit(:search, :role, :services, :absent, :discarded).merge(format: :xls)),
              class: "btn btn-primary btn-outline btn-md rounded flex items-center justify-center gap-2 text-base w-full sm:w-auto" do %>
        <%= embedded_svg "icons/download.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
        <span>Exporter en XLS</span>
      <% end %>
    <% end %>
    <%= link_to import_users_path,
            data: { testid: "import_users" },
            'data-turbo': false,
            class: "btn btn-primary btn-outline btn-md rounded flex items-center justify-center gap-2 text-base w-full sm:w-auto" do %>
      <%= embedded_svg "icons/upload.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
      <span>Importer des agents</span>
    <% end %>
  </div>
 <% if @pagy.pages > 1 %>
    <div class=" flex flex-col justify-center  p-4 border-t border-slate-100 bg-slate-50/50 w-full">
      <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class=" text-slate-500 text-center text-sm w-full ">
        <%= pagy_info(@pagy, item_name: "interventions").html_safe %>
      </div>
    <% else %>
      <div></div>
    <% end %>
  </div>
</div>
<% end %>
