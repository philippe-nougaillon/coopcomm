<div class="w-full mb-24">
  <div class="flex flex-wrap justify-between items-center">
    <h1 class="text-4xl text-primary font-bold">Utilisateurs</h1>
    <%= link_to "Ajouter un Utilisateur", admin_create_new_user_path, class: "hidden sm:inline-flex btn btn-primary btn-outline hover:!text-white" %>
    <%= link_to "+", admin_create_new_user_path, class: "inline-flex sm:hidden btn btn-primary btn-outline hover:!text-white" %>
  </div>

  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap items-end gap-4 mt-8">
      <div class="w-full md:w-8/12 lg:w-3/12">
        <%= label_tag :search, "Rechercher" %>
        <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-bordered w-full', placeholder: 'Nom/Prénom/Email' %>
      </div>

      <div class="w-full md:w-5/12 lg:w-2/12">
        <%= label_tag :rôle %>
        <%= select_tag :rôle, 
        options_for_select(User.rôles, 
        params[:rôle]), 
        include_blank:true,
        class: 'select select-bordered w-full', 
        onchange: 'this.form.submit()' 
        %>    
      </div>

      <div class="w-full md:w-5/12 lg:w-2/12">
        <%= label_tag :service %>
        <%= select_tag :service, options_for_select(@services, params[:service]), include_blank: true, class: 'select select-bordered w-full', onchange: 'this.form.submit()' %>
      </div>
    </div>
  <% end %>

  <div class="divider"></div>

  <div class="overflow-x-auto">
    <table id="users" class="table table-sm">
      <thead class="bg-slate-100">
        <tr>
          <th></th>
          <th>Nom Prénom</th>
          <th>Rôle</th>
          <th>Service</th>
          <th>Email</th>
          <th>Évaluation</th>
        </tr>
      </thead>
      <tbody>
        <%= render @users %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan=5></th>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="my-6">
    <%== pagy_info(@pagy) %>
    <%== pagy_nav(@pagy) %>
  </div>

</div>
