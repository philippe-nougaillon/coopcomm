<tr class="hover:bg-base-300 <%= ' text-slate-700 font-medium' if absence.en_cours? %>">
  <td class="text-nowrap">
    <%= l(absence.du, format: :long) %>
    <% if absence.matin %>
      <br>
      Matin
    <% elsif absence.après_midi %>
      <br>
      Après-midi
    <% else %>
      -
      <%= l(absence.au, format: :long) %>
    <% end %>
  </td>
  <td class="capitalize"><%= absence.motif %></td>
  <td><%= absence.observation %></td>
  <td>
    <% if current_user.manager_or_admin? %>
      <button class="btn btn-primary btn-sm" onclick="edit_modal_<%= absence.id %>.showModal()">
        Modifier
      </button>

      <dialog id="edit_modal_<%= absence.id %>" class="modal">
        <div class="modal-box font-normal text-base-content text-left">
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
          </form>
          
<div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-primary">
          event_busy
        </span>
      </div>
 <div>
        <h3 class="text-xl font-bold uppercase text-primary">Modifier l'absence</h3>
        <p class="text-sm text-slate-500">Complétez les informations ci-dessous.</p>
      </div>
    </div>


          <%= render "absence_form", absence: absence %>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>Fermer</button>
        </form>
      </dialog>
    <% end %>
  </td>
</tr>