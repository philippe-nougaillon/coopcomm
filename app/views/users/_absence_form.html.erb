<div class="nested-form-wrapper flex gap-8 mb-4" data-new-record="<%= f.object.new_record? %>">
  <div>
    <%= f.label :du %>
    <%= f.date_field :du, class: 'input input-bordered input-sm ml-1', required: true %>
  </div>
  <div>
    <%= f.label :au %>
    <%= f.date_field :au, class: 'input input-bordered input-sm ml-1', required: true %>
  </div>
  <div>
    <%= f.label :motif %>
    <%= f.text_field :motif, class: 'input input-bordered input-sm ml-1' %>
  </div>

  <button type="button" data-action="nested-form#remove" class="btn btn-outline btn-error btn-sm">X</button>

  <%= f.hidden_field :_destroy %>
</div>