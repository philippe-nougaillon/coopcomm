<% unique_id = absence.id || 'new' %>
<% is_half_day = absence.matin || absence.après_midi %>
<%= form_with(model: @user, id: "absence_form_#{unique_id}") do |f| %>
  <%= hidden_field_tag :from_absence_modal, true %>
  <% errors_list = absence.errors.full_messages.presence || @user.errors.full_messages.select { |m| m.downcase.include?('absence') || m.downcase.include?('chevauche') } %>

  <% if errors_list.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-700 p-3.5 rounded-xl border border-red-200 mt-2 mb-4 text-xs">
      <div class="font-bold text-sm mb-1 flex items-center gap-2 text-red-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Impossible d'enregistrer l'absence :</span>
      </div>
      <ul class="list-disc list-inside space-y-1 pl-1">
        <% errors_list.uniq.each do |msg| %>
          <li><%= msg.gsub(/^Absences\s+/i, '') %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.fields_for :absences, absence do |ff| %>
    <%= render 'users/absence_fields', f: ff %>
  <% end %>
  <div class="modal-action flex flex-wrap items-center w-full border-t border-slate-100 pt-4 mt-6 gap-2 <%= absence.persisted? ? 'justify-between' : 'justify-end' %>">
    <% if absence.persisted? %>
      <button type="button" 
              onclick="delete_absence_modal_<%= unique_id %>.showModal()" 
              class="btn btn-soft btn-error inline-flex items-center gap-2 normal-case w-full sm:w-auto order-last sm:order-first">
        <%= embedded_svg "icons/delete.svg", class: "w-4 h-4 fill-current" %>
        <span>Supprimer</span>
      </button>
    <% end %>
    <div class="flex items-center gap-2 w-full sm:w-auto sm:ml-auto">
      <button type="button" 
              class="btn btn-soft btn-secondary inline-flex items-center gap-2 normal-case flex-1 sm:flex-none justify-center" 
              onclick="this.closest('dialog').close(); this.closest('form').querySelector('#error_explanation')?.remove(); this.closest('form').reset();">
        <span>Annuler</span>
      </button>
      <%= f.button type: :submit, 
                   class: "btn btn-primary inline-flex items-center justify-center gap-2 normal-case px-6 flex-1 sm:flex-none" do %>
        <span>Enregistrer</span>
      <% end %>
    </div>
  </div>
<% end %>
<% if absence.persisted? %>
  <dialog id="delete_absence_modal_<%= unique_id %>" class="modal">
    <div class="modal-box max-w-sm border border-slate-100 shadow-2xl">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <div class="flex flex-col items-center text-center p-2">
        <div class="w-12 h-12 rounded-full bg-red-50 text-red-600 flex items-center justify-center mb-4">
          <%= embedded_svg "icons/delete.svg", class: "w-6 h-6 fill-current" %>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">
          Supprimer l'absence ?
        </h3>
        <p class="text-sm text-slate-500 leading-relaxed mb-6">
          Êtes-vous certain de vouloir supprimer cette absence del <span class="font-semibold text-slate-700"><%= l(absence.du, format: "%e %B %Y") %></span> ? Cette action est irréversible.
        </p>
        <div class="flex items-center gap-3 w-full">
          <form method="dialog" class="flex-1">
            <button class="btn btn-neutral btn-outline w-full normal-case">Annuler</button>
          </form>
          <%= link_to absence_path(absence), data: { turbo_method: :delete }, class: "btn btn-error text-white flex-1 normal-case" do %>
            Oui, supprimer
          <% end %>
        </div>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>Fermer</button>
    </form>
  </dialog>
<% end %>
