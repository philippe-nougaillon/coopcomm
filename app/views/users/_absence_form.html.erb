<div class="nested-form-wrapper flex gap-4 lg:gap-8 w-full mb-4" data-new-record="<%= f.object.new_record? %>">
  <div class="flex items-center">
    <%= f.label :du %>
    <%= f.date_field :du, class: 'input input-bordered input-sm ml-1 bg-orange-50', required: true %>
  </div>
  <div class="flex items-center">
    <%= f.label :au %>
    <%= f.date_field :au, class: 'input input-bordered input-sm ml-1 bg-orange-50', required: true %>
  </div>
  <div class="flex flex-1 items-center">
    <%= f.label :motif, class: "" %>
    <%= f.text_field :motif, class: 'input input-bordered input-sm flex-1 ml-1' %>
  </div>

  <button type="button" data-action="nested-form#remove" class="btn btn-outline btn-error btn-sm">X</button>

  <%= f.hidden_field :_destroy %>
</div>