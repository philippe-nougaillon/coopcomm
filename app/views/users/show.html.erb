<div class="mx-auto lg:w-2/3 w-full mt-8">
  <% page_title!(@user.nom_prénom) %>
  <div class="flex flex-col md:flex-row gap-6">
    <div class="flex flex-col items-center bg-slate-100 border border-slate-200 rounded-2xl py-8 px-6 gap-3" style="flex: 0 0 20%;">
      <div class="avatar avatar-placeholder rounded-full">
        <% if @user.profile_picture.attached? %>
          <div class="avatar">
            <div class="w-24 rounded-full">
              <%= image_tag(@user.profile_picture) %>
            </div>
          </div>
        <% else %>
          <div class="avatar avatar-placeholder">
            <div class="bg-white text-black w-32 rounded-full text-2xl">
              <%= @user.initiales %>
            </div>
          </div>
        <% end %>
      </div>
      <p class="text-center text-base font-medium text-slate-800 mt-1">
        <%= @user.nom %> <%= @user.prénom %>
      </p>
      <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-medium px-3 py-1 rounded-full">
        <%= embedded_svg "icons/#{@user.avatar}.svg", class: "w-6 h-6 fill-current shrink-0" %>
        <%= @user.rôle.upcase %>
      </div>
      <% if @user.tag_list.present? %>
        <div class="flex flex-wrap gap-1 justify-center mt-1">
          <% @user.tag_list.each do |tag| %>
            <span class="bg-white border border-slate-200 text-slate-500 text-xs px-4 py-1 rounded-full"><%= tag %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="flex flex-col gap-4 flex-1">
      <% if @user.agent? && current_user.manager_or_admin? %>
        <div class="flex flex-col md:flex-row gap-4">
          <div class="bg-white border border-slate-200 rounded-2xl flex-1" style="padding: 1.25rem;">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Informations</p>
            <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">
              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                <%= embedded_svg "icons/mail.svg", title: "Email" %> Email
              </div>
              <div class="py-2.5 text-slate-800 border-b border-slate-100 break-all"><%= @user.email %></div>
              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                <%= embedded_svg "icons/call.svg", title: "Téléphone" %> Téléphone
              </div>
              <div class="py-2.5 border-b border-slate-100">
                <% if @user.téléphone.to_s.strip.present? %>
                  <span class="text-slate-800"><%= @user.téléphone %></span>
                <% else %>
                  <span class="text-slate-400 italic text-xs">Non renseigné</span>
                <% end %>
              </div>
              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                <%= embedded_svg "icons/store.svg", class: "text-base", title: "Services" %>
                <%= @user.manager_or_admin? ? "Responsable des services" : "Services" %>
              </div>
              <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @user.services.pluck(:nom).join(", ") %></div>
              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                <%= embedded_svg "icons/sticky_note.svg", class: "text-base", title: "Mémo" %> Mémo
              </div>
              <div class="py-2.5 border-b border-slate-100">
                <% if @user.memo.to_s.strip.present? %>
                  <div class="text-slate-800 italic"><%= @user.memo %></div>
                <% else %>
                  <span class="text-slate-400 italic text-xs">Non renseigné</span>
                <% end %>
              </div>
            </div>
          </div>
          <div class="bg-white border border-slate-200 rounded-2xl flex-1" style="padding: 1.25rem;">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Évaluation</p>
            <% if @user.rated_interventions.any? %>
              <div class="flex justify-between w-32 mb-4">
                <b><%= number_with_precision(@user.moyenne, precision: 2) %> / 5</b>
                <%= pluralize(@user.total_rating, "note") %>
              </div>
            <% else %>
              <p class="text-sm text-slate-400 italic mb-4">Cet agent n'a pas encore reçu d'évaluation.</p>
            <% end %>
            <div class="flex flex-col-reverse">
              <% (5).downto(1) do |i| %>
                <div class="flex items-center">
                  <div class="flex w-36">
                    <% i.times do %>
                      <%= embedded_svg "icons/star.svg", class: "text-slate-400", title: "star", alt: "star" %>
                    <% end %>
                  </div>
                  <progress class="progress progress-primary w-56" value="<%= @user.total_rating > 0 ? @user.star_count(i) : 0 %>" max="100"></progress>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-white border border-slate-200 rounded-2xl" style="padding: 1.25rem;">
          <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Informations</p>
          <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">
            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
              <%= embedded_svg "icons/mail.svg", class: "text-base", title: "Email" %> Email
            </div>
            <div class="py-2.5 text-slate-800 border-b border-slate-100 break-all"><%= @user.email %></div>
            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
              <%= embedded_svg "icons/call.svg", class: "text-base", title: "Téléphone" %> Téléphone
            </div>
            <div class="py-2.5 border-b border-slate-100">
              <% if @user.téléphone.to_s.strip.present? %>
                <span class="text-slate-800"><%= @user.téléphone %></span>
              <% else %>
                <span class="text-slate-400 italic text-xs">Non renseigné</span>
              <% end %>
            </div>
            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
              <%= embedded_svg "icons/store.svg", class: "text-base", title: "Services" %>
              <%= @user.manager_or_admin? ? "Responsable des services" : "Services" %>
            </div>
            <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @user.services.pluck(:nom).join(", ") %></div>
            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
              <%= embedded_svg "icons/sticky_note.svg", class: "text-base", title: "Mémo" %> Mémo
            </div>
            <div class="py-2.5 border-b border-slate-100">
              <% if @user.memo.to_s.strip.present? %>
                <div class="text-slate-800 italic"><%= @user.memo %></div>
              <% else %>
                <span class="text-slate-400 italic text-xs">Non renseigné</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <div class="flex flex-wrap flex-col md:flex-row gap-2 mt-1">
        <% if policy(@user).edit? %>
          <%= link_to edit_user_path(@user), class: "btn" do %>
            <%= embedded_svg "icons/edit.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            Modifier
          <% end %>
        <% end %>
        <% if policy(@user).inviter? %>
          <%= link_to inviter_user_path(@user), class: "btn btn-soft btn-primary", 'data-turbo': false do %>
            <%= embedded_svg "icons/send.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            Renvoyer le lien d'accès
          <% end %>
        <% end %>
        <% if policy(@user).edit_password? %>
          <%= link_to edit_password_user_path(@user), class: "btn" do %>
            <%= embedded_svg "icons/lock.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            Modifier le mot de passe
          <% end %>
        <% end %>
        <% if policy(@user).destroy? %>
          <button class="btn btn-soft btn-error" onclick="delete_user_modal.showModal()">
            <%= embedded_svg "icons/delete.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            Supprimer
          </button>
        <% end %>
      </div>
    </div>
  </div>
  <dialog id="delete_user_modal" class="modal">
    <div class="modal-box">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <h3 class="text-lg font-bold text-error flex items-center gap-2">
        <%= embedded_svg "icons/warning.svg", title: "Supprimer l'utilisateur" %>
        Supprimer l'utilisateur
      </h3>
      <p class="py-4 text-sm text-slate-600">
        Êtes-vous certain(e) de vouloir supprimer cet utilisateur ? Cette action est irréversible.
      </p>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Annuler</button>
        </form>
        <%= link_to user_path(@user), method: :delete, data: { turbo_method: :delete }, class: "btn btn-error text-white" do %>
          Oui, supprimer
        <% end %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>Fermer</button>
    </form>
  </dialog>
  <div class="my-10">
    <%= link_to users_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base", title: "Retour à la liste" %>
      Retour à la liste
    <% end %>
  </div>
  <div id="absences_section">
    <%= render 'absences_section', user: @user, absences: @absences %>
  </div>
  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary font-semibold">Activité</h2>
  </div>
  <div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
  </div>
  <div class="overflow-x-auto border border-slate-200  shadow-sm bg-white ">
    <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
      <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
      <span>Faire glisser pour voir plus</span>
    </div>
    <table class="table text-sm w-full">
      <thead class="bg-slate-100 text-slate-600 font-semibold">
        <tr>
          <th class="py-4 pl-4 pr-2 font-semibold text-left">Date</th>
          <th class="py-4 px-6 font-semibold text-left">Action</th>
          <th class="py-4 px-6 font-semibold text-left">Modifications</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: 'audit', collection: @audits, cached: true %>
      </tbody>
    </table>
  </div>
  <div class="flex flex-col md:flex-row justify-between items-center gap-4 p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
    <% if @pagy.pages > 1 %>
      <div class="hidden sm:block sm:flex-1"></div>
      <div class="w-full sm:w-auto sm:flex-1 order-1 sm:order-2 flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class="text-base font-semibold text-slate-500 text-center sm:text-right w-full sm:flex-1 order-2 sm:order-3">
        <%= pagy_info(@pagy).html_safe %>
      </div>
    <% else %>
      <div></div>
    <% end %>
  </div>
</div>