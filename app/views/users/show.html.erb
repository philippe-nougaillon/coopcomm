<div class="mx-auto lg:w-2/3 w-full mt-8">
  <% page_title!(@user.nom_prénom) %>
  <div class="flex flex-col md:flex-row gap-6">

    <!-- Sidebar -->
    <div class="flex flex-col items-center bg-slate-100 border border-slate-200 rounded-2xl py-8 px-6 gap-3" style="flex: 0 0 20%;">
      <div class="avatar avatar-placeholder w-full flex-1">
        <% if @user.profile_picture.attached? %>
          <div class="avatar">
            <div class="w-full rounded-2xl">
              <%= image_tag(@user.profile_picture) %>
            </div>
          </div>
        <% else %>
          <div class="avatar avatar-placeholder w-full flex-1">
            <div class="bg-white text-black w-full rounded-2xl text-4xl justify-center items-center flex">
              <%= @user.initiales %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="flex flex-col gap-1 flex-1 mt-6 justify-center items-center">
        <p class="text-center text-base font-medium text-slate-800 mt-1">
          <%= @user.nom %> <%= @user.prénom %>
        </p>
        <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-medium px-3 py-1 rounded-full">
          <%= @user.rôle.upcase %>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4 flex-1">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <!-- Identité : visible seulement pour manager/admin, quel que soit le rôle du profil consulté -->
        <% if current_user.manager_or_admin? %>
          <div class="bg-white border border-slate-200 rounded-2xl" style="padding: 1.25rem;">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Identité</p>
            <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">

              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                <%= embedded_svg "icons/person.svg", class: "text-base", title: "Nom" %> Nom
              </div>
              <div class="py-2.5 text-slate-800 border-b border-slate-100 break-all flex items-center"><%= @user.nom %></div>

              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                <%= embedded_svg "icons/person.svg", class: "text-base", title: "Prénom" %> Prénom
              </div>
              <div class="py-2.5 text-slate-800 border-b border-slate-100 break-all flex items-center"><%= @user.prénom %></div>

              <div class="flex items-center gap-2 py-2.5 text-slate-500" style="padding-right: 2rem;">
                <%= embedded_svg "icons/group.svg", class: "text-base", title: "Rôle" %> Rôle
              </div>
              <div class="py-2.5 text-slate-800 break-all flex items-center"><%= @user.rôle.humanize %></div>

            </div>
          </div>
        <% end %>

        <!-- Organisation -->
        <div class="bg-white border border-slate-200 rounded-2xl" style="padding: 1.25rem;">
          <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Organisation</p>
          <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">

            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
              <%= embedded_svg "icons/store.svg", class: "text-base", title: "Services" %>
              <%= @user.manager_or_admin? ? "Responsable des services" : "Services" %>
            </div>
            <div class="py-2.5 text-slate-800 border-b border-slate-100 flex items-center"><%= @user.services.pluck(:nom).join(", ") %></div>

            <% if current_user.manager_or_admin? %>
              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                <%= embedded_svg "icons/key.svg", title: "Mots clés" %> Mots clés
              </div>
              <div class="py-2.5 border-b border-slate-100">
                <% if @user.tag_list.present? %>
                  <span class="text-slate-800 break-all flex items-center"><%= @user.tag_list.join(", ") %></span>
                <% else %>
                  <span class="text-slate-400 italic text-xs">Non renseigné</span>
                <% end %>
              </div>
            <% end %>

            <div class="flex items-center gap-2 py-2.5 text-slate-500" style="padding-right: 2rem;">
              <%= embedded_svg "icons/sticky_note_2.svg", class: "text-base", title: "Mémo" %> Mémo
            </div>
            <div class="py-2.5 flex items-center">
              <% if @user.memo.to_s.strip.present? %>
                <span class="text-slate-800 flex items-center"><%= @user.memo %></span>
              <% else %>
                <span class="text-slate-400 italic text-xs">Non renseigné</span>
              <% end %>
            </div>

          </div>
        </div>

        <!-- Contact -->
        <div class="bg-white border border-slate-200 rounded-2xl" style="padding: 1.25rem;">
          <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Contact</p>
          <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">

            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
              <%= embedded_svg "icons/mail.svg", title: "Email" %> Email
            </div>
            <div class="py-2.5 text-slate-800 border-b border-slate-100 break-all flex items-center"><%= @user.email %></div>

            <div class="flex items-center gap-2 py-2.5 text-slate-500" style="padding-right: 2rem;">
              <%= embedded_svg "icons/call.svg", title: "Téléphone" %> Téléphone
            </div>
            <div class="py-2.5 flex items-center">
              <% if @user.téléphone.to_s.strip.present? %>
                <span class="text-slate-800 flex items-center"><%= @user.téléphone %></span>
              <% else %>
                <span class="text-slate-400 italic text-xs">Non renseigné</span>
              <% end %>
            </div>

          </div>
        </div>

        <!-- Évaluation : uniquement si le profil consulté est agent ET que l'utilisateur courant est manager/admin -->
        <% if @user.agent? && current_user.manager_or_admin? %>
          <div class="bg-white border border-slate-200 rounded-2xl" style="padding: 1.25rem;">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Évaluation</p>
            <% if @user.rated_interventions.any? %>
              <div class="mb-4">
                <b><%= number_with_precision(@user.moyenne, precision: 2) %> / 5</b>
                sur <%= pluralize(@user.total_rating, "note") %>
              </div>
            <% else %>
              <p class="text-sm text-slate-400 italic mb-4">Cet agent n'a pas encore reçu d'évaluation.</p>
            <% end %>
            <div class="flex flex-col-reverse">
              <% (5).downto(1) do |i| %>
                <div class="flex items-center">
                  <div class="flex w-36">
                    <% i.times do %>
                      <%= embedded_svg "icons/star.svg", class: "text-slate-400", title: "star", alt: "star" %>
                    <% end %>
                  </div>
                  <progress class="progress progress-primary w-32" value="<%= @user.total_rating > 0 ? @user.star_count(i) : 0 %>" max="100"></progress>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>

      <div class="flex flex-wrap flex-col md:flex-row gap-2 mt-1">
        <% if policy(@user).edit? %>
          <%= link_to edit_user_path(@user), class: "btn" do %>
            <%= embedded_svg "icons/edit.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            Modifier
          <% end %>
        <% end %>
        <% if policy(@user).inviter? %>
          <%= button_to inviter_user_path(@user), class: "btn btn-soft btn-primary", form: { data: { turbo: false }, class: "contents" } do %>
            <%= embedded_svg "icons/send.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            Renvoyer le lien d'accès
          <% end %>
        <% end %>
        <% if policy(@user).edit_password? %>
          <%= link_to edit_password_user_path(@user), class: "btn" do %>
            <%= embedded_svg "icons/lock.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            Modifier le mot de passe
          <% end %>
        <% end %>
        <% if policy(@user).destroy? %>
          <button class="btn btn-soft btn-error hover:!text-white" onclick="delete_user_modal.showModal()">
            <%= embedded_svg "icons/person_off.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            Désactiver l'utilisateur
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <dialog id="delete_user_modal" class="modal">
    <div class="modal-box">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <h3 class="text-lg font-bold text-error flex items-center gap-2">
        <%= embedded_svg "icons/warning.svg", title: "Désactiver l'utilisateur" %>
        Désactiver l'utilisateur
      </h3>
      <p class="py-4 text-sm text-slate-600">
        Êtes-vous certain(e) de vouloir désactiver cet utilisateur ? Cette action empêchera l'utilisateur de se connecter à son compte, mais vous pourrez le réactiver ultérieurement si nécessaire.
      </p>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Annuler</button>
        </form>
        <%= link_to user_path(@user), method: :delete, data: { turbo_method: :delete }, class: "btn btn-error text-white" do %>
          Oui, désactiver
        <% end %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>Fermer</button>
    </form>
  </dialog>

  <div class="my-10">
    <%= link_to users_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste" %>
      Retour à la liste
    <% end %>
  </div>

  <div id="absences_section">
    <%= render 'absences_section', user: @user, absences: @absences %>
  </div>

  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary font-semibold">Activité</h2>
  </div>
  <div class="block md:hidden flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
  </div>
  <div class="overflow-x-auto border-x border-b border-slate-200 shadow-sm bg-white rounded-b-xl md:rounded-xl mb-8">
    <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
      <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
      <span>Faire glisser pour voir plus</span>
    </div>
    <table class="table text-sm w-full">
      <thead class="bg-slate-100 text-slate-600 font-semibold">
        <tr>
          <%= th_tri 'Date', colonne: 'audits.created_at', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Action', colonne: 'audits.action', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Modifications</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: 'audit', collection: grouper_audits(@audits) %>
      </tbody>
    </table>
  </div>

  <% if @pagy&.pages.to_i > 1 %>
    <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
      <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class="text-slate-500 text-center text-sm w-full mt-2">
        <%= pagy_info(@pagy, item_name: "audits").html_safe %>
      </div>
    </div>
  <% end %>
</div>