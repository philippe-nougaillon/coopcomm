


<div class="mx-auto lg:w-2/3 w-full mt-8">
  <% page_title!(@user.nom_prénom) %>
  <div class="flex flex-col md:flex-row gap-6">
    <div class="flex flex-col items-center bg-slate-100 border border-slate-200 rounded-2xl py-8 px-6 gap-3" style="flex: 0 0 20%;">
      <div class="avatar avatar-placeholder rounded-full">
        <% if @user.profile_picture.attached? %>
          <div class="avatar">
            <div class="w-24 rounded-full">
              <%= image_tag(@user.profile_picture) %>
            </div>
          </div>
        <% else %>
          <div class="avatar avatar-placeholder">
            <div class="bg-white text-black w-32 rounded-full text-2xl">
              <%= @user.initiales %>
            </div>
          </div>
        <% end %>
      </div>
      <p class="text-center text-base font-medium text-slate-800 mt-1">
        <%= @user.nom %> <%= @user.prénom %>
      </p>
      <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-medium px-3 py-1 rounded-full">
        <span class="material-symbols-outlined text-sm"><%= @user.avatar %></span>
        <%= @user.rôle.upcase %>
      </div>
      <% if @user.tag_list.present? %>
        <div class="flex flex-wrap gap-1 justify-center mt-1">
          <% @user.tag_list.each do |tag| %>
            <span class="bg-white border border-slate-200 text-slate-500 text-xs px-4 py-1 rounded-full"><%= tag %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="flex flex-col gap-4 flex-1">
      <% if @user.agent? && current_user.manager_or_admin? %>
        <div class="flex flex-col md:flex-row gap-4">
          <div class="bg-white border border-slate-200 rounded-2xl flex-1" style="padding: 1.25rem;">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Informations</p>
            <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">
              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                <img src="/assets/icons/mail.svg" class="icon" alt="mail"> Email
              </div>
              <div class="py-2.5 text-slate-800 border-b border-slate-100 break-all"><%= @user.email %></div>
                <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                  <img src="/assets/icons/call.svg" class="icon" alt="Téléphone"> Téléphone
            </div>
            <div class="py-2.5 border-b border-slate-100">
              <% if @user.téléphone.to_s.strip.present? %>
                <span class="text-slate-800"><%= @user.téléphone %></span>
              <% else %>
                <span class="text-slate-400 italic text-xs">Non renseigné</span>
              <% end %>
            </div>
              <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
                 <img src="/assets/icons/store.svg"
                      class="icon text-base"
                      alt="Services"
                      title="Services"
                   />
                <%= @user.manager_or_admin? ? "Responsable des services" : "Services" %>
              </div>
              <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @user.services.pluck(:nom).join(", ") %></div>
              <% if @user.memo.present? %>
                <div class="flex items-start gap-2 py-2.5 text-slate-500" style="padding-right: 2rem;">
                   <img
                      src="/assets/icons/note.svg"
                      class="icon text-base"
                      alt="Mémo"
                      title="Mémo"
                    />
                </div>
                <div class="py-2.5 text-slate-800 italic"><%= @user.memo %></div>
              <% end %>
            </div>
          </div>
          <div class="bg-white border border-slate-200 rounded-2xl flex-1" style="padding: 1.25rem;">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Évaluation</p>
            <% if @user.rated_interventions.any? %>
              <div class="flex justify-between w-32 mb-4">
                <b>
                  <%= number_with_precision(@user.moyenne, precision: 2) %> / 5
                </b>
                <%= pluralize(@user.total_rating, "note") %>
              </div>
            <% else %>
              <p class="text-sm text-slate-400 italic mb-4">
                Cet agent n'a pas encore reçu d'évaluation.
              </p>
            <% end %>
            <div class="flex flex-col-reverse">
              <% (5).downto(1) do |i| %>
                <div class="flex items-center">
                  <div class="flex w-36">
                    <% i.times do %>
                      <img
                        src="/assets/icons/star.svg"
                        class="icon text-slate-400"
                        alt="star"
                        title="star"
                      />
                        star
                      </span>
                    <% end %>
                  </div>
                  <progress
                    class="progress progress-primary w-56"
                    value="<%= @user.total_rating > 0 ? @user.star_count(i) : 0 %>"
                    max="100">
                  </progress>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-white border border-slate-200 rounded-2xl" style="padding: 1.25rem;">
          <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Informations</p>
          <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">
            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
              <img
                src="/assets/icons/mail.svg"
                class="icon text-base"
                alt="Email"
                title="Email"
              /> Email
            </div>
            <div class="py-2.5 text-slate-800 border-b border-slate-100 break-all"><%= @user.email %></div>
            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
              <img
                src="/assets/icons/phone.svg"
                class="icon text-base"
                alt="Téléphone"
                title="Téléphone"
              /> Téléphone
            </div>
            <div class="py-2.5 border-b border-slate-100">
              <% if @user.téléphone.to_s.strip.present? %>
                <span class="text-slate-800"><%= @user.téléphone %></span>
              <% else %>
                <span class="text-slate-400 italic text-xs">Non renseigné</span>
              <% end %>
            </div>
            <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
               <img
                  src="/assets/icons/store.svg"
                  class="icon text-base"
                  alt="Services"
                  title="Services"
                />
              <%= @user.manager_or_admin? ? "Responsable des services" : "Services" %>
            </div>
            <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @user.services.pluck(:nom).join(", ") %></div>
            <% if @user.memo.present? %>
              <div class="flex items-start gap-2 py-2.5 text-slate-500" style="padding-right: 2rem;">
                 <img
                  src="/assets/icons/note.svg"
                  class="icon text-base"
                  alt="Mémo"
                  title="Mémo"
                /> Mémo
              </div>
              <div class="py-2.5 text-slate-800 italic"><%= @user.memo %></div>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="flex flex-wrap flex-col md:flex-row gap-2 mt-1">
        <% if policy(@user).edit? %>
          <%= link_to edit_user_path(@user), class: "btn" do %>
            <img
              src="/assets/icons/edit.svg"
              class="icon text-sm"
              alt="Modifier l'utilisateur"
              title="Modifier l'utilisateur"
            /> Modifier
          <% end %>
        <% end %>
        <% if policy(@user).inviter? %>
          <%= link_to inviter_user_path(@user), class: "btn btn-soft btn-primary", 'data-turbo': false do %>
             <img
              src="/assets/icons/send.svg"
              class="icon text-sm"
              alt=" Renvoyer le lien d'accès"
              title=" Renvoyer le lien d'accès"
            /> Renvoyer le lien d'accès
          <% end %>
        <% end %>
        <% if policy(@user).edit_password? %>
          <%= link_to edit_password_user_path(@user), class: "btn" do %>  
             <img
              src="/assets/icons/lock.svg"
              class="icon text-sm"
              alt="Modifier le mot de passe "
              title="Modifier le mot de passe "
            />  Modifier le mot de passe
          <% end %>
        <% end %>
        <% if policy(@user).destroy? %>
          <button class="btn btn-soft btn-error" onclick="delete_user_modal.showModal()">
               <img
                src="/assets/icons/delete.svg"
                class="icon text-sm"
                alt="Supprimer "
                title="Supprimer "
              />  Supprimer
          </button>
        <% end %>
      </div>
    </div>
  </div>
  <dialog id="delete_user_modal" class="modal">
    <div class="modal-box">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <h3 class="text-lg font-bold text-error flex items-center gap-2">
             <img
              src="/assets/icons/warning.svg"
              class="icon"
              alt="Supprimer l'utilisateur"
              title="Supprimer l'utilisateur"
            />   
        Supprimer l'utilisateur
      </h3>
      <p class="py-4 text-sm text-slate-600">
        Êtes-vous certain(e) de vouloir supprimer cet utilisateur ? Cette action est irréversible.
      </p>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Annuler</button>
        </form>
        <%= link_to user_path(@user),
                    method: :delete,
                    data: { turbo_method: :delete },
                    class: "btn btn-error text-white" do %>
          Oui, supprimer
        <% end %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>Fermer</button>
    </form>
  </dialog>
  <div class="my-10">
    <%= link_to users_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition" do %>
      <img
          src="/assets/icons/arrow_back.svg"
          class="icon text-base"
          alt="Retour à la liste"
          title="Retour à la liste"
        /> 
      Retour à la liste
    <% end %>
  </div>
  <% if @user.agent? || @user.manager_or_admin? %>
    <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
      <h2 class="text-2xl text-secondary font-semibold">Absences</h2>
      <% if current_user.manager_or_admin? %>
        <button class="btn btn-outline btn-success hover:text-white!" onclick="absence_modal.showModal()">
          Ajouter une absence
        </button>
        <dialog id="absence_modal" class="modal" <%= 'open' if @user.errors.any? %>>
  <div class="modal-box">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>

    <!-- HEADER MEJORADO -->
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
        <img
          src="/assets/icons/event_busy.svg"
          class="icon text-primary"
          alt="Une absence"
          title="Déclarer une absence"
        /> 
      </div>
      <div>
        <h3 class="text-xl font-bold uppercase text-primary">Déclarer une absence</h3>
        <p class="text-sm text-slate-500">Complétez les informations ci-dessous.</p>
      </div>
    </div>
    <%= render 'absence_form', absence: Absence.new(user_id: @user.id) %>
  </div>
          <form method="dialog" class="modal-backdrop">
            <button>Fermer</button>
          </form>
        </dialog>
      <% end %>
    </div>
    <% if @absences.any? %>
      <div class="flex items-center gap-1 text-xs text-slate-400 mb-2 md:hidden">
           <img
            src="/assets/icons/swipe.svg"
            class="icon text-sm"
            alt="swipe"
            title="Faire glisser"
          /> 
        <span>Faire glisser pour voir plus</span>
      </div>
      <div class="overflow-x-auto border border-slate-200 rounded-xl shadow-sm bg-white">
        <table class="table text-sm w-full">
          <thead class="bg-slate-100 text-slate-600 font-semibold">
            <tr>
              <th class="py-3">Période</th>
              <th class="py-3">Motif</th>
              <th class="py-3">Observations</th>
              <th class="py-3"></th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: 'absence', collection: @absences %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center py-4 text-center border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50/50 mt-4">
             <img
              src="/assets/icons/calendar_today.svg"
              class="icon text-slate-300 text-4xl mb-2"
              alt="Calendrier"
              title="Calendrier des absences"
            />   
        <h3 class="text-sm font-semibold text-slate-700">Aucune absence enregistrée</h3>
        <p class="text-xs text-slate-400 mt-1 max-w-xs leading-normal">
          Cet utilisateur n'a pas d'absences planifiées ou passées pour le moment.
        </p>
      </div>
    <% end %>
    <%= render "absence_form_script" %>
  <% end %>
  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary font-semibold">Activité</h2>
  </div>
  <div class="flex items-center gap-1 text-xs text-slate-400 mb-2 md:hidden">
    <img
    src="/assets/icons/swipe.svg"
    class="icon text-sm"
    alt="swipe"
    title="Faire glisser pour voir plus"
    />   
    <span>Faire glisser pour voir plus</span>
  </div>
  <div class="overflow-x-auto border border-slate-200 rounded-xl shadow-sm bg-white ">
    <table class="table text-sm w-full">
      <thead class="bg-slate-100 text-slate-600 font-semibold">
        <tr>
          <th class="py-3">Date</th>
          <th class="py-3">Type</th>
          <th class="py-3">Id</th>
          <th class="py-3">Action</th>
          <th class="py-3">Modifications</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: 'audit', collection: @audits %>
      </tbody>
    </table>
  </div>
  <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
    <% if @pagy.pages > 1 %>
      <div class="hidden sm:block sm:flex-1"></div>
      <div class="w-full sm:w-auto sm:flex-1 order-1 sm:order-2 flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class="text-base font-semibold text-slate-500 text-center sm:text-right w-full sm:flex-1 order-2 sm:order-3">
        <%= pagy_info(@pagy, ).html_safe %>
      </div>
    <% else %>
      <div >
      </div>
    <% end %>
  </div>
</div>