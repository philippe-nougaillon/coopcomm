<div class="mx-auto lg:w-2/3 w-full mt-8">
  <% page_title!(@user.nom_prénom) %>

  <div class="flex flex-wrap justify-between">
    <div class="flex flex-wrap lg:flex-nowrap shadow rounded-lg lg:max-w-[35vw]">
      <div class="flex flex-col items-center bg-slate-200 w-full lg:w-48 py-8 px-2 lg:rounded-l-lg">
        <div class="avatar avatar-placeholder rounded-full">
          <% if @user.profile_picture.attached? %>
            <div class="avatar">
              <div class="w-24 rounded-full">
                <%= image_tag(@user.profile_picture) %>
              </div>
            </div>
          <% else %>
            <div class="avatar avatar-placeholder">
              <div class="bg-white text-black w-24 rounded-full text-2xl">
                <%= @user.initiales %>
              </div>
            </div>
          <% end %>
        </div>
        <p class="text-center text-lg font-bold mt-4 break-all">
          <%= @user.nom %>
          <br>
          <%= @user.prénom %>
        </p>
        <div class="flex items-center gap-2 my-4">
          <span class="material-symbols-outlined">
            <%= @user.avatar %>
          </span>
          <%= @user.rôle.upcase %> 
        </div>
        <p>
          <%= @user.tag_list %>
        </p>
      </div>
      <div class="rounded-r-lg px-6 py-10">
        <p class="mb-4 break-all">
          <strong class="block text-slate-400">Email</strong>
          <%= @user.email %>
        </p>
        <p class="mb-4">
          <strong class="block text-slate-400">Téléphone</strong>
          <%= @user.téléphone %>
        </p>

        <% if @user.memo %>
          <p class="mt-4">
            <strong class="block text-slate-400 mb-1">Mémo</strong>
            <%= @user.memo %>
          </p>
        <% end %>

        <% if @user.manager_or_admin? %>
          <p class="mt-4">
            <strong class="block text-slate-400 mb-1">Responsable des services</strong>
            <%= @user.services.pluck(:nom).join(", ") %>
          </p>
        <% else %>
          <p class="mt-4">
            <strong class="block text-slate-400 mb-1">Services</strong>
            <%= @user.services.pluck(:nom).join(", ") %>
          </p>
        <% end %>
      </div>
    </div>

    <div>
      <% if @user.agent? && current_user.manager_or_admin? %>
        <div class="flex-1 mt-10">
          <strong class="block text-slate-400 mb-1">Évaluation</strong>
          <div class="flex justify-between w-32">
            <% if @user.moyenne %>
              <b>
                <%= number_with_precision(@user.moyenne, precision: 2, strip_insignificant_zeros: true) %>
                / 5
              </b>
            <% end %>
            <%= pluralize(@user.total_rating, 'note') %>
          </div>
          <div class="flex flex-col-reverse">
            <% (1..5).each do |i| %>
              <div class="flex items-center">
                <div class="flex w-36">
                  <% i.times do %>
                    <span class="material-symbols-outlined text-slate-400">
                      star
                    </span>
                  <% end %>
                </div>
                <progress class="progress progress-primary w-56" value="<%= @user.star_count(i) %>" max="100"></progress>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  </div>

  <div class="flex flex-wrap gap-2 mt-8">
    <%= link_to "Modifier", edit_user_path(@user), class: "btn" %>
    <% if policy(@user).destroy? %>
      <%= button_to user_path(@user), method: :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cet utilisateur ?" }, class: "btn", 'data-testid': "Supprimer l'utilisateur" do %>
        <span class="material-symbols-outlined">
          delete
        </span>
      <% end %>
      <%= link_to "Retour", users_path, class: "btn" %>
    <% end %>
    <% if policy(@user).edit_password? %>
      <%= link_to "Modifier mot de passe", edit_password_user_path(@user), class: "btn" %>
    <% end %>
    <% if policy(@user).inviter? %>
      <%= link_to "Réinviter", inviter_user_path(@user), class: "btn btn-primary", 'data-turbo': false %>
    <% end %>
  </div>

  <% if @user.agent? || @user.manager_or_admin? %>
    <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
      <h2 class="text-2xl text-secondary">
        Absences
      </h2>
      <% if current_user.manager_or_admin? %>
        <button class="btn btn-sm sm:btn-lg btn-outline btn-success hover:text-white!" onclick="absence_modal.showModal()">
          Ajouter une absence
        </button>

        <dialog id="absence_modal" class="modal" <%= 'open' if @user.errors.any? %>>
          <div class="modal-box">
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
            </form>
            <h3 class="font-bold text-lg mb-4">Enregistrer une absence</h3>
            
            <%= render 'absence_form', absence: Absence.new(user_id: @user.id) %>
          </div>
          
          <form method="dialog" class="modal-backdrop">
            <button>Fermer</button>
          </form>
        </dialog>
      <% end %>
    </div>
    <div class="overflow-x-auto mt-4">
      <table class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th>Période</th>
            <th>Motif</th>
            <th>Observation</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <%= render partial: 'absence', collection: @absences %>
        </tbody>
      </table>
    </div>
    <%= render "absence_form_script" %>
  <% end %>

  <h2 class="text-2xl text-secondary mt-8">Activité</h2>
  <div class="overflow-x-auto mt-4">
    <table class="table table-sm">
      <thead class="bg-slate-100">
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>Id</th>
          <th>Action</th>
          <th>Modifications</th>
        </tr>
      </thead>

      <tbody>
        <%= render partial: 'audit', collection: @audits %>
      </tbody>
    </table>
  </div>
  
  <div class="my-6">
    <%== pagy_info(@pagy) %>
    <%== pagy_nav(@pagy) %>
  </div>
</div>