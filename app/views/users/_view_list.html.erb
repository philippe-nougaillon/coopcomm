<div class="overflow-x-auto">
  <table id="agents" class="table table-sm">
    <thead class="bg-slate-100">
    <tr>
      <th></th>
      <th><%= sort_link 'users.nom', 'Nom' %></th>
      <th><%= sort_link 'users.service', 'Service' %></th>
      <% if params[:vue] == 'calendrier' %>
        <% (@date..@date_fin).each do |date| %>
          <th class="text-center h-12 px-2 py-6 <%= 'bg-yellow-100' if date == Date.today %>">
            <%= l(date, format: :calendar).humanize %>
          </th>
        <% end %>
      <% else %>
        <th>Disponible ?</th>
      <% end %>
    </tr>
    </thead>
    <tbody>
      <%= render partial: 'agent', collection: @agents %>
    </tbody>
  </table>
</div>

<div class="my-6">
  <%== pagy_info(@pagy) %>
  <%== pagy_nav(@pagy) %>
</div>