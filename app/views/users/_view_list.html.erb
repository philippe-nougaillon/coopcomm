<div class="overflow-hidden">
  <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
    <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
    <span>Faire glisser pour voir plus</span>
  </div>
  <div class="overflow-x-auto">
    <table id="agents" class="table table-sm w-full border-separate border-spacing-0 border-none">
      <thead class="bg-slate-100">
        <tr>
          <th class="bg-slate-100"></th>
          <%= th_tri 'Nom', colonne: 'users.nom', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-left bg-slate-100' %>
          <%= th_tri 'Service', colonne: 'users.service', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-left bg-slate-100' %>
          <% if params[:vue] == 'calendrier' %>
            <% (@date..@date_fin).each do |date| %>
              <% es_hoy = (date == Date.today) %>
              <th class="text-center p-3 text-xs font-semibold tracking-wider transition-all min-w-[80px]
                         <%= es_hoy ? 'text-purple-700 bg-purple-50/40 border-x-2 border-t border-purple-500 font-bold' : 'text-slate-500 bg-slate-100' %>">
                <span class="first-letter:capitalize"><%= l(date, format: :calendar).humanize %></span>
              </th>
            <% end %>
          <% else %>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider bg-slate-100">Disponible ?</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% if @agents.any? %>
          <%= render partial: 'agent', collection: @agents %>
        <% else %>
          <tr class="relative h-24 bg-white">
            <td class="bg-white border-b border-slate-100"></td>
            <td class="bg-white border-b border-slate-100"></td>
            <td class="bg-white border-b border-slate-100">
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-10">
                <span class="text-slate-400 bg-white text-base italic px-6 py-3 max-w-md text-center pointer-events-auto">
                  Aucun résultat trouvé pour cette recherche.
                </span>
              </div>
            </td>
            <% (@date..@date_fin).each do |date| %>
              <% es_hoy = (date == Date.today) %>
              <td class="p-0 bg-white transition-all
                         <%= es_hoy ? 'border-x-2 border-b-2 border-purple-500 bg-purple-50/10' : 'border-b border-slate-100' %>">
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
    <div class="flex flex-row items-center gap-4  px-4 py-4 border-t border-slate-50  text-xs text-slate-500">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-green-500"></span>Disponible</span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-red-500"></span>Indisponible</span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 border border-2 border-purple-700"></span>Aujourd'hui</span>
    </div>
  <% if @pagy&.pages.to_i > 1 %>
    <div class=" flex flex-col justify-center  p-4 border-t border-slate-100 bg-slate-50/50 w-full">
       
      <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class=" text-slate-500 text-center text-sm w-full ">
        <%= pagy_info(@pagy, item_name: "résultats").html_safe %>
      </div>
    </div>
  <% end %>
