<script>
  if (typeof handleHalfDayChange !== 'function') {

    function getContainer(element) {
      return element.closest('.absence-form-container');
    }

      function refreshPeriodStyles(container) {
      container.querySelectorAll('.period-radio').forEach(r => {
        const label = container.querySelector(`label[for="${r.id}"]`);
        if (!label) return;
        if (r.checked) {
          if (r.value === 'matin') {
            label.style.background  = '#FFFBEB'; // amber-50
            label.style.borderColor = '#F59E0B'; // amber-500
            label.style.color       = '#92400E'; // amber-800
          } else {
            label.style.background  = '#F0FDFA'; // teal-50
            label.style.borderColor = '#0D9488'; // teal-600
            label.style.color       = '#134E4A'; // teal-800
          }
        } else {
          label.style.background  = '#ffffff';
          label.style.borderColor = '#E5E7EB'; // gray-200
          label.style.color       = '#374151'; // gray-700
        }
      });
    }

    function handleHalfDayChange(radio) {
      const container = getContainer(radio);
      const auContainer = container.querySelector('.au-container');
      const halfDaysContainer = container.querySelector('.half-days-container');

        refreshPeriodStyles(container);


      if (radio.value === 'half') {
        auContainer.classList.add('hidden');
        halfDaysContainer.classList.remove('hidden');
        syncDates(radio);

        // Selecciona Matin por defecto si el usuario cambia a Demi-journée y no hay nada marcado
        const periodRadios = container.querySelectorAll('.period-radio');
        const hasSelection = Array.from(periodRadios).some(r => r.checked);
        if (!hasSelection && periodRadios.length > 0) {
          periodRadios[0].checked = true;
          updateHiddenPeriods(periodRadios[0]);
        }
        refreshPeriodStyles(container);
      } else {
        auContainer.classList.remove('hidden');
        halfDaysContainer.classList.add('hidden');
        container.querySelector('.hidden-matin').value = '0';
        container.querySelector('.hidden-apres-midi').value = '0';
        container.querySelectorAll('.period-radio').forEach(r => r.checked = false);
        refreshPeriodStyles(container);
      }
    }

    function updateHiddenPeriods(element) {
      const container = getContainer(element);
      const radios = container.querySelectorAll('.period-radio');
      const hiddenMatin = container.querySelector('.hidden-matin');
      const hiddenApresMidi = container.querySelector('.hidden-apres-midi');

      let selected = null;
      radios.forEach(r => { if (r.checked) selected = r.value; });

      if (selected === 'matin') {
        hiddenMatin.value = '1';
        hiddenApresMidi.value = '0';
      } else if (selected === 'apres_midi') {
        hiddenMatin.value = '0';
        hiddenApresMidi.value = '1';
      }
    refreshPeriodStyles(container);
    }

    function syncDates(element) {
      const container = getContainer(element);
      const halfRadio = container.querySelector('input[value="half"].type-radio');

      if (halfRadio && halfRadio.checked) {
        const duInput = container.querySelector('.du-input');
        const auInput = container.querySelector('.au-input');
        if (duInput && auInput) {
          auInput.value = duInput.value;
        }
      }
    }

    function resetAbsenceForm(form) {
      if (!form) return;

      form.querySelector('#error_explanation')?.remove();

      const container = form.querySelector('.absence-form-container');

      // Fecha / texto / textarea a vacío real
      form.querySelectorAll('input[type="date"], input[type="text"], textarea').forEach(input => {
        input.value = '';
      });

      if (!container) return;

      // Des-marcar todos los radios (tipo día y periodo)
      container.querySelectorAll('.type-radio, .period-radio').forEach(r => r.checked = false);

      // Volver a "Journée entière" por defecto (dispara el handler
      // para ocultar el bloque de medio día y mostrar "Au")
      const fullDayRadio = container.querySelector('.type-radio[value="full"]');
      if (fullDayRadio) {
        fullDayRadio.checked = true;
        handleHalfDayChange(fullDayRadio);
      }

      // Hidden fields matin / après_midi a 0
      container.querySelector('.hidden-matin').value = '0';
      container.querySelector('.hidden-apres-midi').value = '0';

      // Motif al primer valor
      const motif = container.querySelector('select');
      if (motif) motif.selectedIndex = 0;

      refreshPeriodStyles(container);
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.absence-form-container').forEach(container => {
        refreshPeriodStyles(container);
      });
    });
  }
</script>
