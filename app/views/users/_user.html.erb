<tr id="<%= dom_id user %>">
<td>
  <%= render partial: 'partials/user_profile_picture', locals: {user: user} %>
</td>
<%# la couleur du <td> si dessous est nécessaire si la colonne reste affichée en scrollant, sinon les colonnes se superposeront %>
<td class="sticky left-0 top-0 z-10 bg-slate-50 text-lg sm:text-xl text-primary break-words whitespace-normal max-w-[50vw]">
  <%= link_to user.nom_prénom, user, class: 'hover:underline hover:text-base-content' %>

  <% if user.discarded? %>
    <%= link_to reactivate_user_path(user), 
                data: { turbo_method: :patch, turbo_confirm: 'Voulez-vous réactiver ce compte ?' },
                class: "text-success hover:scale-110 transition-transform",
                title: "Réactiver le compte" do %>
      <span class="material-symbols-outlined align-middle">
        undo
      </span>
    <% end %>
  <% end %>
</td>
<td colspan="2" class="text-success font-bold text-xs align-middle">
  <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-base">
      <%= user.avatar %>
    </span>
    <span class="tracking-wider">
      <%= user.rôle.upcase %>
    </span>
  </div>
</td>
<td class="text-sm text-slate-600"><%= user.services.pluck(:nom).join(", ") %></td>
<td class="text-sm text-slate-600"><%= user.tag_list.join(", ") %></td>
<td class="text-sm text-slate-500 font-mono"><%= user.email %></td>
<td>
  <% if user.agent? && user.absent? %>
    <span class="material-symbols-outlined cursor-help" title="Absent du <%= l user.current_absence.du %> au <%= l user.current_absence.au %>, motif : <%= user.current_absence.motif %>">
      person_alert
    </span>
  <% end %>
</td>
<td>
  <% if user.agent? %>
    <%= "#{ number_with_precision(user.moyenne, precision: 2, strip_insignificant_zeros: true) } / 5" if user.moyenne %>
  <% end %>
</td>
</tr>







