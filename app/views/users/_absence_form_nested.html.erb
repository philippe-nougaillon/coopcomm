<div class="nested-form-wrapper bg-slate-100 p-4 rounded border border-slate-300 flex flex-col gap-4 w-full mb-4 relative" data-new-record="<%= f.object.new_record? %>">

  <%= render 'absence_fields', f: f %>

  <div class="flex justify-end mt-2">
    <button type="button" data-action="nested-form#remove" class="btn btn-outline btn-error btn-sm">X Supprimer</button>
  </div>

  <%= f.hidden_field :_destroy %>
</div>