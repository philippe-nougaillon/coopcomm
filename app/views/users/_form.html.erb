<div class="max-w-3xl mx-auto bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-100/50 p-6 md:p-8">
  <%# La création ne passe pas par POST /users : cette route appartient à Devise. %>
  <%= form_with(model: user, url: (user.new_record? ? admin_create_new_user_do_path : user_path(user)), id: dom_id(user), class: "contents", html: { autocomplete: "off", class: 'flex flex-col gap-4' }, data: { controller: 'toggle-role-info' }) do |form| %>
    <% if user.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-500 px-4 py-3 font-medium rounded-lg mb-2 border border-red-200">
        <h2 class="font-black mb-2 text-sm md:text-base">
          <%= pluralize(user.errors.count, "erreur") %> empêche(nt) cet utilisateur d'être sauvegardé :
        </h2>
        <ul class="list-disc list-inside text-xs opacity-90">
          <% user.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <% if current_user.administrateur? %>
      <div class="form-control w-full">
        <%= form.label :rôle, "Rôle", class: "label font-semibold text-slate-700 pt-0" do %>
          <span>Rôle <span class="text-red-500">*</span></span>
        <% end %>
        <%= form.select :rôle,
                        User.rôles.keys,
                        { selected: user.rôle, required: true },
                        class: 'slim-select w-full h-10',
                        data: { controller: 'slim-select',
                                'toggle-role-info-target': 'role',
                                action: 'change->toggle-role-info#change'
                        } %>
      </div>
    <% else %>
      <%= form.hidden_field :rôle, value: (user.new_record? ? 'agent' : user.rôle), data: { 'toggle-role-info-target': 'role' } %>
    <% end %>
    <div class="form-control w-full">
      <%= form.label :nom, class: "label font-semibold text-slate-700" do %>
        <span>Nom <span class="text-red-500">*</span></span>
      <% end %>
      <%= form.text_field :nom, class: 'input input-bordered input-sm w-full focus:input-primary h-10', required: true %>
    </div>
    <%# Pleine largeur : toggle-role-info n'affiche qu'un seul de ces deux champs à la fois. %>
    <div data-toggle-role-info-target="localisation" class="form-control w-full" data-controller="places" data-places-center-lat-value="<%= ENV['MAPS_CENTER_LAT'] %>" data-places-center-lng-value="<%= ENV['MAPS_CENTER_LNG'] %>">
      <%= form.label :address, class: "label font-semibold text-slate-700" do %>
        Localisation <span class="text-red-500">*</span>
      <% end %>
      <%# Quitamos el required nativo aquí por si Stimulus oculta este campo temporalmente en base al rol %>
      <%= form.text_field :address,
          class: 'input input-bordered select-sm w-full focus:input-primary h-10',
          placeholder: 'Commencez à tapez une adresse...',
          data: { places_target: "address" } %>
      <%= form.hidden_field :latitude, data: { places_target: "latitude" } %>
      <%= form.hidden_field :longitude, data: { places_target: "longitude" } %>
    </div>
    <div data-toggle-role-info-target='prenom' class="form-control w-full">
      <%= form.label :prénom, class: "label font-semibold text-slate-700" do %>
        <span>Prénom <span class="text-red-500">*</span></span>
      <% end %>
      <%= form.text_field :prénom, class: 'input input-bordered input-sm w-full focus:input-primary h-10', required: true %>
    </div>
    <hr class="border-slate-100 my-1" />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
      <div class="form-control w-full">
        <%= form.label :téléphone, "Téléphone", class: "label font-semibold text-slate-700" %>
        <%= form.text_field :téléphone, class: 'input input-bordered input-sm w-full focus:input-primary h-10', placeholder: 'ex: 0612345678' %>
      </div>
      <div class="form-control w-full">
        <%= form.label :email, class: "label font-semibold text-slate-700" do %>
          <span>Adresse email <span class="text-red-500">*</span></span>
        <% end %>
        <%= form.email_field :email, class: 'input input-bordered input-sm w-full focus:input-primary h-10', required: true %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 <%= 'md:grid-cols-1' if current_user.manager? %> gap-4 w-full">
      <% if current_user.manager_or_admin? %>
        <div class="form-control w-full">
          <% label_texte = user.rôle == 'adhérent' ? "Secteur" : "Équipe" %>
          <%= form.label :tag_list, label_texte, class: "label font-semibold text-slate-700", data: { 'toggle-role-info-target': 'tagLabel' } %>
          <%
            est_soumission = params[form.object_name].present?
            if est_soumission
              tags_users_soumis = Array(params.dig(form.object_name, :tag_list)).reject(&:blank?)
            else
              tags_users_soumis = user.tags.map(&:name)
            end
            options_users = (@users_tags.map(&:name) + tags_users_soumis).uniq
          %>
          <%= form.select :tag_list, options_for_select(options_users, tags_users_soumis), {}, { multiple: true, class: 'w-full h-10', data: { controller: 'slim-select' } } %>
        </div>
      <% end %>
      <% if current_user.manager_or_admin? %>
        <% if current_user.manager? && user.persisted? %>
          <%# Un manager ne réaffecte pas les services d'une fiche existante : on renvoie
              les siens à l'identique. Un champ par service, sinon le tableau part en
              une seule chaîne que `permit(service_ids: [])` rejette. %>
          <% user.services.ids.each do |service_id| %>
            <%= hidden_field_tag "#{form.object_name}[service_ids][]", service_id, id: nil %>
          <% end %>
        <% else %>
          <div class="form-control w-full">
            <%= form.label :service_ids, class: "label font-semibold text-slate-700" do %>
              <span>Service <span class="text-red-500">*</span></span>
            <% end %>
            <%
              services_assignables = services_assignables_par(current_user)
              services_sélectionnés = user.services.ids
              services_sélectionnés = services_assignables.ids if services_sélectionnés.empty? && services_assignables.size == 1
            %>
            <%# `data-controller` déclaré plutôt que laissé à l'injection d'application.js,
                qui n'écoute que turbo:load/render : sans widget, la CSS de
                `select.slim-select[required]` rend le champ invisible. %>
            <%= form.select :service_ids,
                            options_from_collection_for_select(services_assignables, 'id', 'nom', services_sélectionnés),
                            { required: true },
                            { multiple: true, class: 'slim-select w-full h-10',
                              data: { controller: 'slim-select' } } %>
          </div>
        <% end %>
      <% else %>
        <%# ¡IMPORTANTE! Si el usuario no es admin/manager, enviamos sus service_ids asignados de forma oculta %>
        <%# para que al guardar no falle la validación de presencia de servicios si existe en el modelo %>
        <% user.services.ids.each do |service_id| %>
          <%= hidden_field_tag "#{form.object_name}[service_ids][]", service_id %>
        <% end %>
      <% end %>
    </div>
    <hr class="border-slate-100 my-1" />
    <div class="form-control w-full">
      <%= form.label :memo, "Mémo", class: "label font-semibold text-slate-700" %>
      <%= form.text_area :memo, class: 'textarea textarea-bordered w-full h-24 focus:textarea-primary', placeholder: 'Notes concernant cet utilisateur...' %>
    </div>
    <%= render "shared/file_dropzone", 
               form: form, 
               attribute: :profile_picture,
               placeholder: "Glissez une photo de profil ici ou cliquez pour parcourir",
               label: "Photo de profil" %>
    <div class="flex gap-2 mt-4 w-full">
      <%= button_tag "Annuler", type: "button", onclick: "history.back();", class: "btn flex-1" %>
      <%= form.submit "Enregistrer", id: "enregistrer_utilisateur", class: "btn btn-primary flex-1" %>
    </div>
  <% end %>
  <div class="pt-6 max-w-3xl mx-auto">
    <%= link_to users_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste des utilisateurs" %>
      Retour à la liste des utilisateurs
    <% end %>
  </div>
</div>