<% 
  is_my = defined?(my_message) ? my_message : (message.from_id == current_user.id)
  is_unread = (!is_my && message.read_at.nil?) 
%>
<div id="<%= dom_id message %>" 
     class="mt-2 message-wrapper" 
     data-message-id="<%= message.id %>" 
     data-unread="<%= is_unread ? 'true' : 'false' %>">
  <div class="chat <%= is_my ? "chat-end" : "chat-start" %>">
    <div class="chat-bubble  <%= is_my ? "chat-bubble-info" : "bg-gray-200" %> <%= "font-bold" if is_unread %> max-w-full">
      <div class=" flex flex-row gap-4">
        <p class="text-base break-words mb-0.5 whitespace-pre-line">
          <%= message.moderation %>
        </p>
        <span class="flex flex-end items-end justify-end text-xs <%= is_my ? "text-white/80" : "text-slate-600" %>">
          <%= message.created_at.strftime("%H:%M")%>
        </span>
      </div>
    </div>
  </div>
</div>
