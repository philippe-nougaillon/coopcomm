<% 
  is_my = defined?(my_message) ? my_message : (message.from_id == current_user.id)
  is_unread = (!is_my && message.read_at.nil?) 
%>
<div id="<%= dom_id message %>" 
     class="mt-2 message-wrapper" 
     data-message-id="<%= message.id %>" 
     data-unread="<%= is_unread ? 'true' : 'false' %>">
  <div class="chat <%= is_my ? "chat-end" : "chat-start" %>">
    <div class="chat-bubble  <%= is_my ? "chat-bubble-info" : "bg-gray-200" %> <%= "font-semibold" if is_unread %> max-w-full">
      <div class=" flex flex-col">
        <% text = message.moderation %>
            <p class="text-base break-words mb-0.5">
            <% if text.length > 800 %>
              <% truncated = text.truncate(800, omission: '', separator: ' ') %>
              <span class="truncated-text"><%= truncated %></span>
              <button type="button"
                      class="see-more-btn inline cursor-pointer font-bold hover:underline <%= is_my ? 'text-cyan-200' : 'text-[#191a29]' %>"
                      onclick="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                  Voir plus
              </button>
              <span class="rest-text" style="display:none;"><%= text[truncated.length..-1] %></span>
            <% else %>
              <%= text %>
            <% end %>
          </p>
        <span class="flex flex-end items-end justify-end text-xs <%= is_my ? "text-white/80" : "text-slate-400" %>">
          <%= message.created_at.strftime("%H:%M")%>
        </span>
      </div>
    </div>
  </div>
</div>
