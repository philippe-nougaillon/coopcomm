<%
  is_my = defined?(my_message) ? my_message : (message.from_id == current_user.id)
  is_unread = (!is_my && message.read_at.nil? && message.message?)
%>
<div id="<%= dom_id message %>"
     class="mt-2 message-wrapper"
     data-message-id="<%= message.id %>"
     data-from-id="<%= message.from_id %>"
     data-unread="<%= is_unread ? 'true' : 'false' %>">
  <div class="chat group <%= is_my ? "chat-end" : "chat-start" %>">
    <div class="chat-bubble bg-gray-200 group-[.chat-start]:bg-info group-[.chat-start]:text-info-content <%= "font-semibold" if is_unread %> max-w-full">
      <div class=" flex flex-col">
        <% text = message.moderation %>
        <% if message.from_user&.is_aibot? %>
          <div class="reponse-ia prose max-w-none break-words overflow-x-auto mb-0.5 prose-headings:mt-3 prose-headings:mb-1 prose-p:my-1.5 prose-ul:my-1 prose-ol:my-1 prose-li:my-0 prose-hr:my-3 prose-table:my-2 <%= 'max-h-96 overflow-y-hidden' if text.length > 800 %>"><%= MettreEnFormeReponseIa.call(text) %></div>
          <% if text.length > 800 %>
            <button type="button"
                    class="see-more-btn self-start cursor-pointer font-bold hover:underline text-[#191a29] group-[.chat-start]:text-cyan-200"
                    onclick="this.style.display='none'; this.previousElementSibling.classList.remove('max-h-96', 'overflow-y-hidden');">
                Voir plus
            </button>
          <% end %>
        <% else %>
            <p class="text-base break-words mb-0.5">
            <% if text.length > 800 %>
              <% truncated = text.truncate(800, omission: '', separator: ' ') %>
              <span class="truncated-text"><%= truncated %></span>
              <button type="button"
                      class="see-more-btn inline cursor-pointer font-bold hover:underline text-[#191a29] group-[.chat-start]:text-cyan-200"
                      onclick="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                  Voir plus
              </button>
              <span class="rest-text" style="display:none;"><%= text[truncated.length..-1] %></span>
            <% else %>
              <%= text %>
            <% end %>
          </p>
        <% end %>
        <span class="flex flex-end items-end justify-end text-xs text-slate-400 group-[.chat-start]:text-white/80">
          <%= message.created_at.strftime("%H:%M")%>
        </span>
      </div>
    </div>
  </div>
</div>
