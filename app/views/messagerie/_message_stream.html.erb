<div id="<%= dom_id message %>" 
     class="mt-2 message-wrapper" 
     data-message-id="<%= message.id %>" 
     data-unread="<%= my_message ? 'false' : 'true' %>">
  
  <div class="chat <%= my_message ? "chat-end" : "chat-start" %> mt-2">
    <div class="flex items-end gap-2">
      <div class="avatar <%= my_message ? "order-2" : "order-1" %>">
        <div class="w-10 rounded-full">
          <% if message.from_user.profile_picture.attached? %>
            <%= image_tag url_for(message.from_user.profile_picture) %>
          <% else %>
          <div class="avatar avatar-placeholder">
            <div class="bg-neutral text-neutral-content w-10 rounded">
              <span class="text-xs"><%= message.from_user.initiales %></span>
            </div>
          </div>
          <% end %>
        </div>
      </div>
      <div class="flex flex-col <%= my_message ? "order-1 justify-end" : "order-2" %>">
        <small class="px-2"><i>il y a <%= time_ago_in_words message.created_at %></i></small>
        <div class="chat-bubble rounded bg-gray-200 <%= my_message ? "" : "font-bold" %>">
          <p class="text-xl">
            <%= message.moderation %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>