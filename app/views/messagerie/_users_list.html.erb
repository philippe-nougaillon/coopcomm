<% groupes = users.group_by(&:rôle) %>
<% (%w[administrateur manager adhérent agent] | User.rôles.keys).each do |rôle| %>
  <% membres = groupes.fetch(rôle, []) %>
  <% cookie = "pli_#{rôle.parameterize}" %>
  <% ouvert = params[:query].present? ? membres.any? : cookies[cookie] != 'ferme' %>
  <% non_lus_du_rôle = membres.sum { |membre| non_lus.fetch(membre.id, 0) } %>
  <details class="group/role" data-controller="pli" data-pli-cookie-value="<%= cookie %>" data-action="toggle->pli#memoriser" <%= 'open' if ouvert %>>
    <summary class="flex items-center justify-between gap-2 pl-6 pr-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100 cursor-pointer list-none">
      <%= rôle.humanize %>
      <%= render 'partials/pastille', nombre: non_lus_du_rôle, classes: 'ml-auto group-open/role:hidden bg-primary text-primary-content' %>
      <span class="transition-transform group-open/role:rotate-90">
        <%= embedded_svg "icons/arrow_right.svg", class: "w-5 h-5 fill-current" %>
      </span>
    </summary>
    <% membres.each do |user| %>
      <%= link_to messagerie_conversation_path(user.slug), "data-turbo": false do %>
        <div class="px-3 py-1 whitespace-nowrap hover:bg-slate-100 transition-colors <%= (user.slug == params[:to_user_slug]) ? "bg-gray-200 font-semibold" : "" %>">
          <div class="flex items-center gap-3">
            <%= render partial: 'partials/user_profile_picture', locals: {user:} %>
            <div class="flex flex-col leading-tight font-medium whitespace-nowrap hover:underline">
              <span>
                <%= truncate(user.nom, length: 12, omission: '…') %>
              </span>
              <span class="font-normal">
                <%= truncate(user.prénom, length: 12, omission: '…') %>
              </span>
            </div>
            <%= render('partials/pastille', nombre: non_lus[user.id], classes: 'ml-auto bg-primary text-primary-content') if non_lus[user.id] %>
          </div>
        </div>
      <% end %>
    <% end %>
    <% if membres.empty? %>
      <div class="pl-6 pr-4 py-1 text-sm text-gray-500">Aucun <%= rôle %></div>
    <% end %>
  </details>
<% end %>
<% if users.empty? %>
  <div class="p-4 text-sm text-gray-500 text-center">Aucun utilisateur trouvé.</div>
<% end %>
