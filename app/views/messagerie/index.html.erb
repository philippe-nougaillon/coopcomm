<script>
  let newMessageBadge;

  // 1. Fonction pour scroller à la bonne position au chargement
  function scrollToCorrectPosition() {
    const unreadBanner = document.getElementById('first-unread-banner');
    newMessageBadge = document.getElementById('new-message-badge');

    if (unreadBanner) {
      // S'il y a un séparateur de messages non lus, on va jusqu'à lui
      const y = unreadBanner.getBoundingClientRect().top + window.scrollY - 100;
      window.scrollTo({ top: y, behavior: 'instant' });
    } else {
      // Sinon on va tout en bas
      scrollToBottom('instant');
    }
  }

  // 2. Fonction pour scroller tout en bas
  function scrollToBottom(behavior = 'instant') {
    window.scrollTo({
      top: document.documentElement.scrollHeight,
      behavior: behavior
    });
    if (newMessageBadge) newMessageBadge.classList.add('hidden');
  }

  // 3. Fonction pour surveiller les nouveaux messages (Turbo Streams)
  function setupMessageObserver() {
    const chatContainer = document.getElementById('chat-messages-container');
    newMessageBadge = document.getElementById('new-message-badge');
    if (!chatContainer || !newMessageBadge) return;

    if (window.messageObserver) {
      window.messageObserver.disconnect();
    }

    window.messageObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.addedNodes.length > 0) {
          mutation.addedNodes.forEach((node) => {
            if (node.nodeType === 1) {

              const isMyMessage = node.classList.contains('chat-end') || node.querySelector('.chat-end') !== null;
              const newNodeHeight = node.offsetHeight || 0;
              const scrollPosition = window.innerHeight + window.scrollY;
              const distanceToBottom = document.documentElement.scrollHeight - scrollPosition;
              const distanceBeforeInsertion = distanceToBottom - newNodeHeight;

              const isNearBottom = distanceBeforeInsertion <= 150;

              if (isMyMessage) {
                scrollToBottom('smooth');
              } else {
                if (isNearBottom) {
                  const elementPosition = node.getBoundingClientRect().top + window.scrollY;
                  const offsetPosition = elementPosition - 120;

                  window.scrollTo({
                    top: offsetPosition,
                    behavior: "smooth"
                  });

                  if (newMessageBadge) newMessageBadge.classList.add('hidden');
                } else {
                  newMessageBadge.classList.remove('hidden');
                }

                // NOUVEAU : Si un message arrive en direct et qu'on doit le marquer comme lu plus tard
                if (window.readObserver && node.dataset && node.dataset.unread === 'true') {
                  window.readObserver.observe(node);
                }
              }
            }
          });
        }
      });
    });

    window.messageObserver.observe(chatContainer, { childList: true });

    // Événements pour le badge "Nouveau message"
    newMessageBadge.addEventListener('click', () => scrollToBottom('smooth'));

    window.addEventListener('scroll', () => {
      const scrollPosition = window.innerHeight + window.scrollY;
      const distanceToBottom = document.documentElement.scrollHeight - scrollPosition;

      if (distanceToBottom <= 50 && !newMessageBadge.classList.contains('hidden')) {
        newMessageBadge.classList.add('hidden');
      }
    });
  }

  // 4. Fonction pour marquer les messages comme lus (Intersection Observer)
  function setupReadReceipts() {
    if (window.readObserver) {
      window.readObserver.disconnect();
    }

    window.readObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const messageNode = entry.target;
          const messageId = messageNode.dataset.messageId;

          // Envoi de la requête au serveur pour marquer comme lu
          const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
          fetch(`/messagerie/mark_as_read`, {
            method: 'POST',
            headers: {
              'X-CSRF-Token': csrfToken,
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ id: messageId })
          });

          // On arrête de surveiller ce message
          window.readObserver.unobserve(messageNode);
          messageNode.dataset.unread = 'false';
        }
      });
    }, {
      // LA CORRECTION EST ICI 👇
      threshold: 0, // Déclenche dès qu'une partie du message est visible
      rootMargin: "0px 0px -50px 0px" // Attend que le message rentre d'au moins 50 pixels dans l'écran pour le valider
    });

    // On observe tous les messages non lus
    document.querySelectorAll('.message-wrapper[data-unread="true"]').forEach((msg) => {
      window.readObserver.observe(msg);
    });
  }

  // Initialisation globale
  function initMessagerie() {
    // SÉCURITÉ : On cherche notre ID ultra-spécifique
    const isChatPage = document.getElementById('chat-messages-container');

    // Si l'élément n'existe pas, on est sur une autre page (ou sur l'accueil de la messagerie), on annule tout !
    if (!isChatPage) {
      return;
    }

    scrollToCorrectPosition();
    setupMessageObserver();
    setupReadReceipts();
  }
  // Pour s'assurer qu'on ne garde pas d'anciens écouteurs au changement de page
  document.addEventListener("turbo:before-cache", () => {
    if (window.messageObserver) window.messageObserver.disconnect();
    if (window.readObserver) window.readObserver.disconnect();
  });

  document.addEventListener("DOMContentLoaded", initMessagerie);
  document.addEventListener("turbo:load", initMessagerie);
</script>
