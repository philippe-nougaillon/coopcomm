<% content_for :full_width, true %>
<div class="drawer lg:drawer-open w-full mx-auto">
  <input id="messagerie-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content flex flex-col min-h-screen relative w-full">
    <div class="sticky top-4 lg:top-16 px-4 2xl:px-8 pt-4 pb-4 z-30 bg-slate-50 flex gap-4 items-center justify-between min-h-12 sm:min-h-16 w-full border-b lg:border-none">
      <label for="messagerie-drawer" class="btn btn-sm lg:hidden drawer-button cursor-pointer flex items-center gap-2 bg-primary/10 border border-primary/20 text-primary hover:bg-primary/20 rounded-lg normal-case">
        <%= embedded_svg "icons/group.svg", class: "w-4 h-4 fill-current" %>
        <span class="font-semibold text-sm">Contacts</span>
      </label>
      <h1 class="text-2xl sm:text-4xl text-primary font-bold ml-auto lg:ml-0">
        <%= page_title!('Messagerie') %>
      </h1>
    </div>
    <div class="flex flex-col items-center justify-center flex-1 p-4 lg:p-8 text-center bg-slate-50">
      <div class="max-w-xl w-full">
        <% if @recent_conversations.present? && @recent_conversations.any? %>
          <p class="text-slate-500 mb-8 lg:mt-8">Sélectionnez un contact pour démarrer une discussion, ou reprenez une conversation récente ci-dessous.</p>
          <div class="flex flex-col gap-3 text-left overflow-y-auto mb-20 lg:mb-0">
            <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-2">Discussions récentes</h3>
            <% @recent_conversations.each do |user| %>
              <% last_message = @last_messages[user.id] %>
              <% unread_count = @unread_counts[user.id] || 0 %>
              <%= link_to messagerie_conversation_path(user.slug), "data-turbo": false, class: "card bg-white shadow-sm hover:shadow-md hover:border-primary transition-all border border-slate-200" do %>
                <div class="card-body p-4 flex flex-row items-center gap-4">
                  <%= render partial: 'partials/user_profile_picture', locals: { user: user } %>
                  <div class="flex-1 min-w-0">
                    <span class="text-xs whitespace-nowrap italic <%= unread_count > 0 ? 'text-primary font-bold' : 'text-slate-400' %>">
                        Il y a <%= time_ago_in_words(last_message.created_at) %> 
                      </span>
                      <h4 class="font-bold truncate <%= unread_count > 0 ? 'text-primary' : 'text-slate-800' %>">
                        <%= user.nom_prénom %>
                      </h4>
                    <div class="flex justify-between items-center gap-2">
                      <p class="text-sm truncate <%= unread_count > 0 ? 'text-slate-700 font-semibold' : 'text-slate-500' %>">
                        <% if last_message.from_id == current_user.id %>
                          <span class="text-slate-400 mr-1 font-normal">Vous:</span>
                        <% end %>
                        <%= last_message.moderation %>
                      </p>
                      <% if unread_count > 0 %>
                        <div class="badge badge-primary badge-sm font-bold shadow-sm">
                          <%= unread_count %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="flex flex-col items-center justify-center py-12">
            <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center mb-4 border border-slate-200">
              <%= embedded_svg "icons/chat_bubble.svg", class: "w-5 h-5 fill-current text-slate-400" %>
            </div>
            <p class="text-slate-500">Sélectionnez un contact dans le menu pour démarrer votre première discussion.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <%= render 'sidebar' %>
</div>