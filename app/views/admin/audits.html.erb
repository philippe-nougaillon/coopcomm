<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!('Activité') %>
    </h1>

    <%= link_to notifications_path,
        data: { testid: "mail_logs" },
        class: "btn btn-success btn-outline btn-md rounded flex items-center justify-center gap-2 text-sm ",
        title: "Mail Logs (historique des mails envoyés)" do %>
      <%= embedded_svg "icons/mail.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
      <span class="hidden md:block">Notifications (Mails)</span>
    <% end %>
  </div>

  <%# TRUCO: El turbo_frame permite que al filtrar solo se actualice la tabla, no toda la página %>
  <%= form_tag request.path, method: :get, class: "pt-6", data: { turbo_frame: "audits_table", turbo_action: "advance" } do %>
    <div class="flex flex-col gap-3 w-full bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end w-full">
        <div class="w-full">
          <%= label_tag :search, "Rechercher", class: "block font-semibold text-slate-600 text-sm mb-1" %>    
          <%= text_field_tag :search, params[:search], 
              onchange: 'this.form.requestSubmit()',
              class: 'input input-bordered input-sm w-full bg-white',
              placeholder: 'Rechercher...' %>
        </div> 

        <div class="w-full">
          <%= label_tag :start_date, "Du", class: "block font-semibold text-slate-600 text-sm mb-1" %>    
          <%= text_field_tag :start_date, params[:start_date], 
                  type: 'date', required: true,
                  class: 'input input-bordered input-sm w-full bg-white', 
                  onchange: 'this.form.requestSubmit()' %>
        </div>

        <div class="w-full">
          <%= label_tag :end_date, "Au", class: "block font-semibold text-slate-600 text-sm mb-1" %>    
          <%= text_field_tag :end_date, params[:end_date], 
                  type: 'date', required: true,
                  class: 'input input-bordered input-sm w-full bg-white', 
                  onchange: 'this.form.requestSubmit()' %>
        </div>
      </div>

      <%# --- FILTROS AVANZADOS (Colapsables) --- %>
      <details class="group w-full" <%= 'open' if params[:user_id].present? || params[:type].present? || params[:action_name].present? %>>
        <summary class="flex items-center gap-2 text-primary font-semibold text-sm cursor-pointer select-none list-none w-fit pt-2 hover:underline">
          <%= embedded_svg "icons/tune.svg", class: "w-5 h-5 transition-transform group-open:rotate-180" %>
          <span class="group-open:hidden">Plus de critères de filtrage</span>
          <span class="hidden group-open:inline">Moins de critères de filtrage</span>
        </summary>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end w-full pt-4 mt-2 border-t border-slate-200/60">
          <div class="w-full">
            <%= label_tag :user_id, "Utilisateur", class: "block font-semibold text-slate-600 text-sm mb-1"  %>
            <%= select_tag :user_id, 
              options_from_collection_for_select(@users, 'id', 'nom', params[:user_id]), 
              multiple: true,
              data: { placeholder: 'Tous los utilisateurs' },
              onchange: 'this.form.requestSubmit()',
              class: 'slim-select w-full' %>
          </div>

          <div class="w-full">
            <%= label_tag :type, "Type", class: "block font-semibold text-slate-600 text-sm mb-1" %>
            <%= select_tag :type,
                options_for_select(@types, params[:type]), 
                multiple: true,
                data: { placeholder: 'Tous les types' },
                onchange: 'this.form.requestSubmit()',
                class: 'slim-select w-full' %>
          </div>

          <div class="w-full">
            <%= label_tag :action_name, "Action", class: "block font-semibold text-slate-600 text-sm mb-1" %>
            <%= select_tag :action_name,
                options_for_select(@actions, params[:action_name]), 
                multiple: true,
                data: { placeholder: 'Toutes les actions' },
                onchange: 'this.form.requestSubmit()',
                class: 'slim-select w-full' %>
          </div>
        </div>
      </details>
    </div>
  <% end %>

  <div class="divider"></div>

  <%= turbo_frame_tag "audits_table" do %>
    <div class="overflow-x-auto mt-4">
      <table class="table table-sm w-full">
        <thead class="bg-slate-100">
          <tr>
            <th><%= sort_link 'audits.created_at', 'Date' %></th>
            <th><%= sort_link 'audits.user_id', 'Utilisateur' %></th>
            <th><%= sort_link 'audits.auditable_type', 'Type' %></th>
            <th><%= sort_link 'audits.auditable_id', 'Id' %></th>
            <th><%= sort_link 'audits.action', 'Action' %></th>
            <th><%= sort_link 'audits.audited_changes', 'Modifications' %></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: 'audit', collection: @audits.includes(:user), cached: true %>
        </tbody>
      </table>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
      <div class="hidden sm:block sm:flex-1"></div>
      <div class="w-full sm:w-auto sm:flex-1 order-1 sm:order-2 flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class="text-base font-semibold text-slate-500 text-center sm:text-right w-full sm:flex-1 order-2 sm:order-3">
        <%= pagy_info(@pagy).html_safe %>
      </div>
    </div>
  <% end %>
</div>