<div class="w-full mb-24">

  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!('Activité') %></h1>

    <%= link_to "Notifications", notifications_path, class: "btn btn-primary btn-outline sm:btn-lg rounded hover:text-white!", title: "Mail Logs (historique des mails envoyés)" %>
  </div>

  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap items-end gap-4 mt-8">

      <div class="w-full sm:w-fit pr-4">
        <%= label_tag :search, "Rechercher" %>      
        <%= text_field_tag :search, params[:search], onchange:'this.form.submit()', class:"input input-sm w-full" %>
      </div> 

      <div class="w-full sm:w-min pr-4">
        <%= label_tag :start_date, "Du" %>    
        <%= text_field_tag :start_date, params[:start_date], type:'date', class:"input input-sm w-full" %>
      </div>

      <div class="w-full sm:w-min pr-4">
        <%= label_tag :end_date, "Au" %>    
        <%= text_field_tag :end_date, params[:end_date], type:'date', class:"input input-sm w-full", onchange:'this.form.submit()' %>
      </div>

      <div class="w-full sm:w-fit pr-4">
        <%= label_tag :user_id, "Utilisateur" %>
        <%= select_tag :user_id, options_from_collection_for_select(@users, 'id', 'nom', params[:user_id]), include_blank:true, onchange:'this.form.submit()', class:"select select-sm w-full" %>
      </div>

      <div class="w-full sm:w-fit pr-4">
        <%= label_tag :type, "Type" %>
        <%= select_tag :type,
            options_for_select(@types, params[:type]), include_blank:true, onchange:'this.form.submit()', class:"select select-sm w-full" %>
      </div>

      <div class="w-full sm:w-1/12 min-w-fit pr-4">
        <%= label_tag :action_name, "Action" %>
        <%= select_tag :action_name,
            options_for_select(@actions, params[:action_name]), include_blank:true, onchange:'this.form.submit()', class:"select select-sm w-full" %>
      </div>  
    </div>
  <% end %>

  <div class="divider"></div>

  <div class="overflow-x-auto mt-4">
    <table class="table table-sm">
      <thead class="bg-slate-100">
        <tr>
          <th><%= sort_link 'audits.created_at', 'Date' %></th>
          <th><%= sort_link 'audits.user_id', 'Utilisateur' %></th>
          <th><%= sort_link 'audits.auditable_type', 'Type' %></th>
          <th><%= sort_link 'audits.auditable_id', 'Id' %></th>
          <th><%= sort_link 'audits.action', 'Action' %></th>
          <th><%= sort_link 'audits.audited_changes', 'Modifications' %></th>
        </tr>
      </thead>

      <tbody>
        <%= render partial: 'audit', collection: @audits.includes(:user) %>
      </tbody>

      <tfoot>
        <tr>
          <th colspan=6></th>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="mt-6">
    <%== pagy_info(@pagy) %>
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>    