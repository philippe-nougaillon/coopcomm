<% sent_by_me = (current_user.id == notification.from_id) %>
<div id="<%= dom_id notification %>" class="chat <%= sent_by_me ? 'chat-end' : 'chat-start' %> mt-2">
  <div class="chat-bubble <%= sent_by_me ? '' : 'chat-bubble-info' %> ">
    <% if notification.from_user %>
      <div class="flex items-center gap-2">
        <%= render partial: 'partials/user_profile_picture', locals: {user: notification.from_user} %>
        <div>
          <p>
            <%= notification.from_user.nom_prenom_role %>
          </p>
          <small>
            <i>il y a <%= time_ago_in_words notification.created_at %></i>
          </small>
        </div>
      </div>
      <p class="mt-4 text-xl font-black">
        <%= notification.moderation %>
      </p>
    <% else %>
      utilisateur supprimé
    <% end %>
  </div>
</div>