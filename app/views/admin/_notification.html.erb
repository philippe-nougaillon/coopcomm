<div id="<%= dom_id notification %>">
  <% if (current_user.id == notification.from_id) %>
    <div class="chat chat-end mt-2">
      <div class="flex items-end gap-2">
        <div class="flex flex-col">
          <small><i>il y a <%= time_ago_in_words notification.created_at %></i></small>
          <div class="chat-bubble rounded-full bg-gray-200">
            <p class="text-xl">
              <%= notification.moderation %>
            </p>
          </div>
        </div>
        <%= render partial: 'partials/user_profile_picture', locals: {user: notification.from_user} %>
      </div>
    </div>
  <% else %>
    <div class="chat chat-start mt-2">
      <div class="flex items-end gap-2">
        <%= render partial: 'partials/user_profile_picture', locals: {user: notification.from_user} %>
        <div class="flex flex-col">
          <small class="px-2"><i>il y a <%= time_ago_in_words notification.created_at %></i></small>
          <div class="chat-bubble rounded-full bg-gray-200">
            <p class="text-xl">
              <%= notification.moderation %>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>


