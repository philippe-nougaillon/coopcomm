<div>
  <h1 class="font-bold text-4xl mb-6"><%= page_title!('Stats') %></h1>
  <div class='overflow-x-auto mt-6'>
    <table class='table'>
      <thead>
        <tr>
          <th></th>
          <th>Dernière Connexion</th>
          <th>Rôle</th>
          <th>Co</th>
          <th>Interventions</th>
          <th>Commentaires</th>
          <th>Messagerie</th>
          <th>Créé depuis</th>
        </tr>
      </thead>
      <tbody>
        <% @organisations.each do |organisation| %>
          <% organisation.users.each do |user| %>
            <tr>
              <td><%= user.email %></td>
              <td><%= time_ago_in_words user.current_sign_in_at if user.sign_in_count.positive? %></td>
              <td><%= user.rôle %></td>
              <td class=" <%= user.sign_in_count.positive? ? 'text-danger font-black' : ''  %>"><%= user.sign_in_count %></td>
              <td><%= Intervention.filter_by_service(user.services).by_role_for(user).count %></td>
              <td><%= Intervention.filter_by_service(user.services).by_role_for(user).where.not(commentaires: "").count %></td>
              <td><%= user.messages.count %></td>
              <td><%= time_ago_in_words user.created_at %></td>
              <%# link_to "[X]", user_path(user), 'data-turbo-method': :delete, class:"btn btn-ghost btn-sm" %>
            </tr>
          <% end %>
          <tr>
            <td class="font-bold"><i>Total: <%= organisation.nom %></i></td>
            <td></td>
            <td></td>
            <td><%# organisation.users.count %></td>
            <td class="font-bold"><%= organisation.interventions.count %></td>
            <td class="font-bold"><%= organisation.interventions.where.not(commentaires: "").count %></td>
            <td class="font-bold"><%= organisation.messages.count %></td>
            <td><%= l(organisation.created_at, format: :long) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
