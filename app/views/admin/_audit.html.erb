<tr class="hover:bg-base-300">
  <td class="whitespace-nowrap">
    <b>Il y a <%= time_ago_in_words(audit.created_at) %></b>
    <br>
    <i><%= l(audit.created_at, format: :long) %></i>
  </td>
  <td>
    <% if audit.user_id %>
      <% if user = audit.user %>
        <%= user.email %>
        (#<%= user.id %>)
        <br>
        <%= user.rôle.humanize %>
        <br>
      <% end %>
    <% else %>
      SYSTEM CONSOLE
    <% end %>
  </td>
  <td>
    <%= audit.auditable_type %>
  </td>
  <td style="text-align: right;">
    <%= link_to_if audited_view_path(audit), audit.auditable_id, audited_view_path(audit), class: 'text-primary hover:underline' %>
  </td>
  <td>
    <%= audit.action.humanize %>
  </td>
  <td class="whitespace-nowrap">
    <% unless audit.comment %>
      <%= sanitize prettify(audit, current_user).join('<br>') %>
    <% else %>
      <%= audit.comment %>
    <% end %>
  </td>
</tr>
