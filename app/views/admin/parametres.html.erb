<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!('Paramètres') %>
    </h1>
  </div>
  <%= form_tag request.path, method: :get, class: "pt-6", data: { turbo_frame: "parametres_table", turbo_action: "advance" } do %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4 w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="w-full md:flex-1">
        <%= label_tag :search, "Rechercher", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= text_field_tag :search, params[:search],include_blank: true,
                onchange: 'this.form.requestSubmit()',
                class: 'input input-bordered input-md w-full',
                placeholder: 'Rechercher...' %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :user_id, "Utilisateur", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1"  %>
        <%= select_tag :user_id, options_from_collection_for_select(@users, :id, :nom_prénom, params[:user_id]),
                multiple: true,
                class: 'slim-select w-full h-10',
                data: { placeholder: 'Tous les utilisateurs' },
                onchange: 'this.form.requestSubmit()' %>      </div>
    </div>
  <% end %>




  <div class="mt-6 border-b border-slate-200">
    <nav class="flex gap-1" aria-label="Sections des paramètres">
      <a href="#services"
         class="px-4 py-2.5 text-sm font-medium text-primary border-b-2 border-primary -mb-px"
         data-section-tab="services">
        Services
        <span class="ml-1.5 inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary/10 text-primary text-xs font-semibold">
          <%= @services.size %>
        </span>
      </a>
      <a href="#sites"
         class="px-4 py-2.5 text-sm font-medium text-slate-500 hover:text-slate-800 border-b-2 border-transparent -mb-px transition-colors"
         data-section-tab="sites">
        Sites
        <span class="ml-1.5 inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-100 text-slate-500 text-xs font-semibold">
          <%= @warehouses.size %>
        </span>
      </a>
      <a href="#prestations"
         class="px-4 py-2.5 text-sm font-medium text-slate-500 hover:text-slate-800 border-b-2 border-transparent -mb-px transition-colors"
         data-section-tab="prestations">
        Prestations
        <span class="ml-1.5 inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-100 text-slate-500 text-xs font-semibold">
          <%= @prestations.size %>
        </span>
      </a>
    </nav>
  </div>


  <section id="services" class="mt-6" data-section="services">

    <div class="flex justify-between items-center">
      <h2 class="text-xl font-semibold uppercase text-slate-700">Services</h2>
      <% if policy(Service).new? %>
        <%= link_to new_service_path,
              data: { testid: "ajouter_service" },
                          class: "btn btn-primary btn-outline btn-md rounded flex items-center justify-center gap-2 text-base mb-2 " do %>
                   <%= embedded_svg "icons/add.svg", class: "w-6 h-6 fill-current transition-colors duration-200", title: "Ajouter un service" %>
          Ajouter un service
        <% end %>
      <% end %>
    </div>
  <hr class="mt-2 mb-6">
  <div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
  </div>
  <div class="flex flex-col bg-white  border-x border-b border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto ">
      <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
        <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
        <span>Faire glisser pour voir plus</span>
      </div>

      <table id="parametres" class="table table-sm w-full border-none">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">
              Services</th>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">
              Utilisateurs</th>
             <th class="px-4 py-3 font-semibold text-slate-500 uppercase text-center tracking-wider">
              Nombre d'utilisateurs</th>
           <th class="px-4 py-3  font-semibold text-slate-500 uppercase tracking-wider text-center w-36 cursor-help"
                    title="Calcul de distance sur les interventions du service à partir de l'équipe de l'adhérent">
                  Calcul distances
                  <svg xmlns="http://www.w3.org/2000/svg" class="inline h-3.5 w-3.5 mb-0.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20A10 10 0 0012 2z" />
                  </svg>
                </th>
          </tr>
        </thead>
        <tbody>
          <%= render @services %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary">
      Sites
    </h2>
    <% if policy(Warehouse).new? %>
      <%= link_to "Ajouter un site", new_warehouse_path, data: { 'testid': "ajouter_warehouse_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:text-white!" %>
      <%= link_to "+ Site", new_warehouse_path, data: { 'testid': "ajouter_warehouse_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:text-white!" %>
    <% end %>
  </div>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table id="services" class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th>Nom</th>
            <th>Utilisateurs</th>
            <th>Localisation</th>
          </tr>
        </thead>
        <tbody>
          <%= render @warehouses %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary">
      Catalogue des prestations
    </h2>
    <% if policy(Prestation).new? %>
      <%= link_to "Ajouter une prestation", new_prestation_path, data: { 'testid': "ajouter_prestation_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:text-white!" %>
      <%= link_to "+ Prestation", new_prestation_path, data: { 'testid': "ajouter_prestation_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:text-white!" %>
    <% end %>
  </div>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table id="prestations" class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th>Code</th>
            <th>Libellé</th>
            <th>Catégorie</th>
            <th>Sous-catégorie</th>
            <th>Unité</th>
            <th class="text-right">Tarif HT</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= render @prestations %>
        </tbody>
      </table>
    </div>
  </div>
</div>
































  <section id="sites" class="mt-10" data-section="sites">

    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold text-slate-700">Sites</h2>
      <% if policy(Warehouse).new? %>
        <%= link_to new_warehouse_path,
              data: { testid: "ajouter_warehouse" },
              class: "btn btn-primary btn-outline btn-sm rounded gap-1 hover:text-white!" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Ajouter un site
        <% end %>
      <% end %>
    </div>

    <div class="rounded-xl border border-slate-200 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table id="warehouses-table" class="table table-sm w-full bg-white">
          <thead class="bg-slate-100">
            <tr>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider w-44">Nom</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Utilisateurs</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Localisation</th>
            </tr>
          </thead>
          <tbody>
            <%= render @warehouses %>
          </tbody>
        </table>
      </div>
    </div>

  </section>

  <%# ═══════════════════════════════════════════════════════════════════════════
      SECTION PRESTATIONS
  ═══════════════════════════════════════════════════════════════════════════ %>
  <section id="prestations" class="mt-10 mb-8" data-section="prestations">

    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold text-slate-700">Catalogue des prestations</h2>
      <% if policy(Prestation).new? %>
        <%= link_to new_prestation_path,
              data: { testid: "ajouter_prestation" },
              class: "btn btn-primary btn-outline btn-sm rounded gap-1 hover:text-white!" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Ajouter une prestation
        <% end %>
      <% end %>
    </div>

    <div class="rounded-xl border border-slate-200 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table id="prestations-table" class="table table-sm w-full bg-white">
          <thead class="bg-slate-100">
            <tr>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider w-24">Code</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Libellé</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Catégorie</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Sous-catégorie</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-center w-20">Unité</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right w-28">Tarif HT</th>
              <th class="px-4 py-3 w-24"></th>
            </tr>
          </thead>
          <tbody>
            <%= render @prestations %>
          </tbody>
        </table>
      </div>
    </div>

  </section>

</div>

