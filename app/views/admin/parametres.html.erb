<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!('Paramètres') %>
    </h1>
  </div>

  <% current_tab = params[:tab] || 'services' %>

  <%= form_tag request.path, method: :get, class: "pt-6", data: { turbo_action: "advance" } do %>
    <%= champs_tri_caches %>
    <%= hidden_field_tag :tab, current_tab %>
    <div class="grid grid-cols-1 <%= 'sm:grid-cols-2 lg:flex lg:items-end' if current_tab.in?(%w[services sites]) %> gap-4 w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      
      <div class="w-full md:flex-1">
        <%= label_tag :search, "Rechercher", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= text_field_tag :search, params[:search], include_blank: true,
                    onchange: 'this.form.requestSubmit()',
                    class: 'input input-bordered input-md w-full',
                    placeholder: case current_tab
                                 when 'services' then 'Rechercher un service...'
                                 when 'sites' then 'Rechercher un site...'
                                 when 'prestations' then 'Rechercher par code, libellé...'
                                 else 'Rechercher...'
                                 end %>
      </div>

      <% if current_tab.in?(%w[services sites]) %>
        <div class="w-full md:flex-1">
          <%= label_tag :user_id, "Utilisateur", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
          <%= select_tag :user_id, options_from_collection_for_select(@users, :id, :nom_prénom, params[:user_id]),
                      multiple: true,
                      class: 'slim-select w-full h-10',
                      data: { placeholder: 'Tous les utilisateurs',
                              max_values_shown_desktop: 4,
                              max_values_shown_mobile: 2 
                            },
                      onchange: 'this.form.requestSubmit()' %>
        </div>
      <% end %>

    </div>
  <% end %>

  <div class="mt-6 border-b border-slate-200">
    <nav class="flex gap-1" aria-label="Sections des paramètres">
      <%= link_to url_for(safe_params.merge(tab: 'services')), 
                  class: "px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors #{current_tab == 'services' ? 'text-primary border-primary' : 'text-slate-500 hover:text-slate-800 border-transparent'}" do %>
        Services
        <span class="ml-1.5 inline-flex items-center justify-center w-5 h-5 rounded-full text-xs font-semibold #{current_tab == 'services' ? 'bg-primary/10 text-primary' : 'bg-slate-100 text-slate-500'}">
          <%= @services_count %>
        </span>
      <% end %>

      <%= link_to url_for(safe_params.merge(tab: 'sites')), 
                  class: "px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors #{current_tab == 'sites' ? 'text-primary border-primary' : 'text-slate-500 hover:text-slate-800 border-transparent'}" do %>
        Sites
        <span class="ml-1.5 inline-flex items-center justify-center w-5 h-5 rounded-full text-xs font-semibold #{current_tab == 'sites' ? 'bg-primary/10 text-primary' : 'bg-slate-100 text-slate-500'}">
          <%= @warehouses_count %>
        </span>
      <% end %>

      <%= link_to url_for(safe_params.merge(tab: 'prestations')), 
                  class: "px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors #{current_tab == 'prestations' ? 'text-primary border-primary' : 'text-slate-500 hover:text-slate-800 border-transparent'}" do %>
        Prestations
        <span class="ml-1.5 inline-flex items-center justify-center w-5 h-5 rounded-full text-xs font-semibold #{current_tab == 'prestations' ? 'bg-primary/10 text-primary' : 'bg-slate-100 text-slate-500'}">
          <%= @prestations_count %>
        </span>
      <% end %>
    </nav>
  </div>

  <div class="mt-6">
    <% case current_tab %>
    <% when 'services' %>
      <section id="services" class="animate-fade-in">
        <div class="flex justify-between items-center mb-4">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats (<%= @services.size %>)</span>
          <% if policy(Service).new? %>
            <%= link_to new_service_path(tab: current_tab), data: { testid: "ajouter_service" }, 
                class: "btn btn-primary btn-md rounded flex items-center justify-center gap-2 text-sm text-white border border-primary hover:bg-transparent hover:text-primary hover:border-primary" do %>
              <%= embedded_svg "icons/add.svg", class: "w-6 h-6 fill-current transition-colors duration-200", title: "Ajouter un service" %>
              <span class="hidden md:block">Ajouter un service</span>
            <% end %>
          <% end %>
        </div>

        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
          <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
            <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
            <span>Faire glisser pour voir plus</span>
          </div>
          <div class="overflow-x-auto">
            <table id="parametres" class="table table-sm w-full border-none">
              <thead class="bg-slate-100">
                <tr>
                  <%= th_tri 'Services', colonne: 'services.nom', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
                  <%= th_tri 'Utilisateurs', colonne: 'services.users', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
                  <%= th_tri "Nombre d'utilisateurs", colonne: 'services.users_count', class: 'px-4 py-3 font-semibold text-slate-500 uppercase text-center tracking-wider' %>
                  <th class="px-4 py-3 gap-1 items-center justify-center font-semibold flex flex-row text-slate-500 uppercase tracking-wider text-center cursor-help" title="Calcul de distance sur les interventions du service à partir de l'équipe de l'adhérent">
                    <%= sort_link 'services.calculate_distance', 'Calcul distances' %>
                    <%= embedded_svg "icons/error.svg", class: "w-6 h-6 fill-current", title: "Info" %>
                  </th>
                </tr>
              </thead>
              <tbody>
                <% if @services.any? %>
                  <%= render @services %>
                <% else %>
                  <tr>
                    <td colspan="4" class="text-center py-8 text-slate-400 text-base italic">Aucun service pour le moment.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <% if @pagy&.pages.to_i > 1 %>
          <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full mt-4 rounded-b-xl">
            <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
              <%= pagy_nav(@pagy).html_safe %>
            </div>
            <div class="text-slate-500 text-center text-sm w-full">
              <%= pagy_info(@pagy, item_name: "service").html_safe %>
            </div>
          </div>
        <% end %>
      </section>

    <% when 'sites' %>
      <section id="sites" class="animate-fade-in">
        <div class="flex justify-between items-center mb-4">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats (<%= @warehouses.size %>)</span>
          <% if policy(Warehouse).new? %>
            <%= link_to new_warehouse_path(tab: current_tab), data: { testid: "ajouter_warehouse" }, 
                class: "btn btn-primary btn-md rounded flex items-center justify-center gap-2 text-sm text-white border border-primary hover:bg-transparent hover:text-primary hover:border-primary" do %>
              <%= embedded_svg "icons/add.svg", class: "w-6 h-6 fill-current transition-colors duration-200", title: "Ajouter un site" %>
              <span class="hidden md:block">Ajouter un site</span>
            <% end %>
          <% end %>
        </div>

        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
          <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
            <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
            <span>Faire glisser pour voir plus</span>
          </div>
          <div class="overflow-x-auto">
            <table id="warehouses-table" class="table table-sm w-full">
              <thead class="bg-slate-100">
                <tr>
                  <%= th_tri 'Nom', colonne: 'warehouses.name', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider w-44' %>
                  <%= th_tri 'Utilisateurs', colonne: 'warehouses.users', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
                  <%= th_tri 'Localisation', colonne: 'warehouses.address', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
                </tr>
              </thead>
              <tbody>
                <% if @warehouses.any? %>
                  <%= render @warehouses %>
                <% else %>
                  <tr>
                    <td colspan="3" class="text-center py-8 text-slate-400 text-base italic">Aucun site pour le moment.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <% if @pagy&.pages.to_i > 1 %>
          <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full mt-4 rounded-b-xl">
            <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
              <%= pagy_nav(@pagy).html_safe %>
            </div>
            <div class="text-slate-500 text-center text-sm w-full">
              <%= pagy_info(@pagy, item_name: "site").html_safe %>
            </div>
          </div>
        <% end %>
      </section>

    <% when 'prestations' %>
      <section id="prestations" class="mb-8 animate-fade-in">
        <div class="flex justify-between items-center mb-4">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats (<%= @prestations.size %>)</span>
          <% if policy(Prestation).new? %>
            <%= link_to new_prestation_path(tab: current_tab), data: { testid: "ajouter_prestation" }, 
                class: "btn btn-primary btn-md rounded flex items-center justify-center gap-2 text-sm text-white border border-primary hover:bg-transparent hover:text-primary hover:border-primary" do %>
              <%= embedded_svg "icons/add.svg", class: "w-6 h-6 fill-current transition-colors duration-200", title: "Ajouter une prestation" %>
              <span class="hidden md:block">Ajouter une prestation</span>
            <% end %>
          <% end %>
        </div>

        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
          <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
            <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
            <span>Faire glisser pour voir plus</span>
          </div>
          <div class="overflow-x-auto">
            <table id="prestations-table" class="table table-sm w-full">
              <thead class="bg-slate-100">
                <tr>
                  <%= th_tri 'Code', colonne: 'prestations.code', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider w-32' %>
                  <%= th_tri 'Libellé', colonne: 'prestations.libellé', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
                  <%= th_tri 'Catégorie', colonne: 'prestations.catégorie', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center' %>
                  <%= th_tri 'Sous-catégorie', colonne: 'prestations.sous_catégorie', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center' %>
                  <%= th_tri 'Unité', colonne: 'prestations.unité', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center' %>
                  <%= th_tri 'Tarif HT', colonne: 'prestations.tarif', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center' %>
                </tr>
              </thead>
              <tbody>
                <% if @prestations.any? %>
                  <%= render @prestations %>
                <% else %>
                  <tr>
                    <td colspan="7" class="text-center py-8 text-slate-400 text-base italic">Aucune prestation pour le moment.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <% if @pagy&.pages.to_i > 1 %>
          <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full mt-4 rounded-b-xl">
            <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
              <%= pagy_nav(@pagy).html_safe %>
            </div>
            <div class="text-slate-500 text-center text-sm w-full">
              <%= pagy_info(@pagy, item_name: "prestation").html_safe %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</div>