<div class="w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!('Paramètres') %></h1>
  </div>
  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap items-start w-full gap-4 mt-8">
      <div class="w-full md:w-fit">
        <%= label_tag :search, "Rechercher" %>
        <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-sm w-full', placeholder: 'Nom' %>
      </div>
      <div class="w-full md:w-1/7">
        <%= label_tag :user_id, "Utilisateur" %>
        <%= select_tag :user_id, options_from_collection_for_select(@users, :id, :nom_prénom, params[:user_id]), include_blank: true, class: 'slim-select w-full', onchange: 'this.form.submit()' %>
      </div>
    </div>
  <% end %>
  <div class="divider"></div>
  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary">
      Services
    </h2>
    <% if policy(Service).new? %>
      <%= link_to "Ajouter un Service", new_service_path, data: { 'testid': "ajouter_service_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:text-white!" %>
      <%= link_to "+ Service", new_service_path, data: { 'testid': "ajouter_service_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:text-white!" %>
    <% end %>
  </div>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table id="services" class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th>Nom</th>
            <th>Utilisateurs</th>
            <th>Nombre utilisateurs</th>
            <th class="hover:cursor-help" title="Calcul de distance sur les interventions du service à partir de l'équipe de l'adhérent">Calcul distances ?</th>
          </tr>
        </thead>
        <tbody>
          <%= render @services %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary">
      Sites
    </h2>
    <% if policy(Warehouse).new? %>
      <%= link_to "Ajouter un site", new_warehouse_path, data: { 'testid': "ajouter_warehouse_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:text-white!" %>
      <%= link_to "+ Site", new_warehouse_path, data: { 'testid': "ajouter_warehouse_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:text-white!" %>
    <% end %>
  </div>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table id="services" class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th>Nom</th>
            <th>Utilisateurs</th>
            <th>Localisation</th>
          </tr>
        </thead>
        <tbody>
          <%= render @warehouses %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary">
      Catalogue des prestations
    </h2>
    <% if policy(Prestation).new? %>
      <%= link_to "Ajouter une prestation", new_prestation_path, data: { 'testid': "ajouter_prestation_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:text-white!" %>
      <%= link_to "+ Prestation", new_prestation_path, data: { 'testid': "ajouter_prestation_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:text-white!" %>
    <% end %>
  </div>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table id="prestations" class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th>Code</th>
            <th>Libellé</th>
            <th>Catégorie</th>
            <th>Sous-catégorie</th>
            <th>Unité</th>
            <th class="text-right">Tarif HT</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= render @prestations %>
        </tbody>
      </table>
    </div>
  </div>
</div>
