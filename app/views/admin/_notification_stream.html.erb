<div id="<%= dom_id notification %>" class="mt-2">
  <div class="chat <%= my_message ? "chat-end" : "chat-start" %> mt-2">
    <div class="flex items-end gap-2">
      <div class="avatar">
        <div class="w-10 rounded-full">
          <% if notification.from_user.profile_picture.attached? %>
            <%= image_tag url_for(notification.from_user.profile_picture) %>
          <% else %>
          <div class="avatar avatar-placeholder">
            <div class="bg-neutral text-neutral-content w-10 rounded-full">
              <span class="text-xs"><%= notification.from_user.initiales %></span>
            </div>
          </div>
          <% end %>
        </div>
      </div>
      <div class="flex flex-col">
        <small><i>il y a <%= time_ago_in_words notification.created_at %></i></small>
        <div class="chat-bubble rounded-full bg-gray-200">
          <p class="text-xl <%= my_message ? "" : "font-bold" %>">
            <%= notification.moderation %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>