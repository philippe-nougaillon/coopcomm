<tr id="<%= dom_id newsletter %>" class="hover">
  <td>
    <%= newsletter.email %>
  </td>
  <td>
    <%= l(newsletter.created_at, format: :long) %>
  </td>

  <td>
    <%= link_to "[X]", newsletter_path(newsletter), 'data-turbo-method': :delete, 'data-turbo-confirm': "Veuillez confirmer la suppression de la newsletter", class:"btn btn-ghost btn-sm" %>
  </td>
</tr>
