<%# app/views/navigation/_navbar_desktop.html.erb %>
<div class="hidden lg:navbar  <%= demo_instance? ? 'bg-indigo-100' : 'bg-base-100' %> shadow-sm py-0! pr-0! fixed top-0 z-200">
  <div class="flex items-center flex-1">
    <%= link_to root_path, title: "Page d'accueil" do %>
      <%= image_tag "CoopComm.png", class: "h-8 pr-1 ml-6" %>
    <% end %>
  </div>

  <div class="flex-none">
    <ul class="menu w-full menu-horizontal flex-1 items-center py-0! px-0" style="margin-left: 0px;">
      
      <li>
        <%= link_to home_path, class: class_names("h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary focus:bg-base-300! focus:outline-none! navbar-icon-trigger", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:action] == 'home'), title: "Page d'accueil" do %>
          <%= embedded_svg "icons/cottage.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
        <% end %>
      </li>

      <% if current_user.rôle == 'adhérent' %>
        <% if policy(Intervention).index? %>
          <li>
            <%= link_to interventions_path, class: class_names("h-16 py-0 px-3 flex items-center text-secondary hover:border-b-2 border-primary", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:controller] == 'interventions'), title: "Liste des interventions", data: { testid: "menu_interventions" } do %>
              <%= embedded_svg "icons/construction.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
            <% end %>
          </li>
        <% end %>

        <% if policy(Convention).index? %>
          <li>
            <%= link_to conventions_path, class: class_names("h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:controller] == 'conventions'), title: "Liste des conventions" do %>
              <%= embedded_svg "icons/order_approve.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            <% end %>
          </li>
        <% end %>

        <% if policy(Commande).index? || policy(Facture).index? || policy(Cotation).index? %>
          <li>
            <%= link_to adherent_crm_path, class: class_names("h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:controller] == 'adherent_crm'), title: "Adhérent CRM" do %>
              <%= embedded_svg "icons/contract.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            <% end %>
          </li>
        <% end %>

        <% if policy(:pages).dashboard? %>
          <li>
            <%= link_to dashboard_path, class: class_names("h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:action] == 'dashboard'), title: "Dashboard", 'data-turbo': false do %>
              <%= embedded_svg "icons/bar_chart.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            <% end %>
          </li>
        <% end %>

      <% else %>
        <% if current_user.rôle == 'agent' %>
          <% if policy(User).agent_calendrier? %>
            <li>
              <%= link_to agent_calendrier_users_path, class: class_names("h-16 py-0 px-3 flex items-center text-secondary hover:border-b-2 border-primary", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:action] == 'agent_calendrier'), title: "Disponibilités" do %>
                <%= embedded_svg "icons/event_available.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
              <% end %>
            </li>
          <% end %>

          <% if policy(Intervention).index? %>
            <li>
              <%= link_to interventions_path, class: class_names("h-16 py-0 px-3 flex items-center text-secondary hover:border-b-2 border-primary", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:controller] == 'interventions'), title: "Liste des interventions", data: { testid: "menu_interventions" } do %>
                <%= embedded_svg "icons/construction.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
              <% end %>
            </li>
          <% end %>

          <% if policy(Tool).index? %>
            <li>
              <%= link_to tools_path, class: class_names("h-16 py-0 px-3 flex items-center text-secondary hover:border-b-2 border-primary", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:controller] == 'tools'), title: "Matériels" do %>
                <%= embedded_svg "icons/front_loader.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
              <% end %>
            </li>
          <% end %>

        <% elsif current_user.rôle == 'administrateur' || current_user.rôle == 'manager' %>
          <% if policy(Tool).index? || policy(User).agent_calendrier? %>
            <li class="dropdown dropdown-start relative">
              <div tabindex="0" role="button" class="<%= class_names("h-16 py-0 px-3 flex items-center gap-1.5 text-secondary hover:border-b-2 border-primary cursor-pointer focus:bg-base-300! focus:outline-none! navbar-icon-trigger", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => (params[:controller] == 'tools' || params[:action] == 'agent_calendrier')) %>" title="Ressources">
                <%= embedded_svg "icons/construction.svg", class: "w-5 h-5 fill-current" %>
                <span class="text-sm">Ressources</span>
                <%= embedded_svg "icons/expand_more.svg", class: "w-4 h-4 fill-current opacity-70" %>
              </div>

              <ul tabindex="0" class="dropdown-content z-[210] menu p-0! py-2 shadow bg-base-100 rounded-box w-56 border border-slate-200 text-slate-700 left-0! top-full mt-0!" style="margin-left: 0px;">
                <% if policy(Intervention).index? %>
                  <li>
                    <%= link_to interventions_path, class: "py-2.5 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'interventions'}" do %>
                      <%= embedded_svg "icons/construction.svg", class: "w-5 h-5 fill-current" %>
                      <span>Interventions</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(Tool).index? %>
                  <li>
                    <%= link_to tools_path, class: "py-2.5 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'tools'}" do %>
                      <%= embedded_svg "icons/front_loader.svg", class: "w-5 h-5 fill-current" %>
                      <span>Matériels</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(User).agent_calendrier? %>
                  <li>
                    <%= link_to agent_calendrier_users_path, class: "py-2.5 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'agent_calendrier'}" do %>
                      <%= embedded_svg "icons/productivity.svg", class: "w-5 h-5 fill-current" %>
                      <span>Agents</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(Mouvement).index? %>
                  <li>
                    <%= link_to mouvements_path, class: "py-2.5 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'mouvements'}" do %>
                      <%= embedded_svg "icons/compare_arrows.svg", class: "w-5 h-5 fill-current" %>
                      <span>Mouvements</span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>

          <% if policy(Convention).index? || policy(Cotation).index? || policy(Commande).index? || policy(Facture).index? %>
            <li class="dropdown dropdown-start relative">
              <div tabindex="0" role="button" class="<%= class_names("h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary cursor-pointer focus:bg-base-300! focus:outline-none! navbar-icon-trigger", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => %w[conventions cotations commandes factures].include?(params[:controller])) %>" title="Documents">
                <%= embedded_svg "icons/contract.svg", class: "w-5 h-5 fill-current" %>
                <span class="text-sm">CRM</span>
                <%= embedded_svg "icons/expand_more.svg", class: "w-4 h-4 fill-current opacity-70" %>
              </div>
              <ul tabindex="0" class="dropdown-content z-[210] menu p-0! py-2 shadow bg-base-100 rounded-box w-56 border border-slate-200 text-slate-700 left-0! top-full mt-0!" style="margin-left: 0px;">
                <% if policy(Convention).index? %>
                  <li>
                    <%= link_to conventions_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'conventions'}" do %>
                      <%= embedded_svg "icons/contract.svg", class: "w-5 h-5 fill-current" %> <span>Conventions</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(Cotation).index? %>
                  <li>
                    <%= link_to cotations_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'cotations'}" do %>
                      <%= embedded_svg "icons/request_quote.svg", class: "w-5 h-5 fill-current" %> <span>Cotations</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(Commande).index? %>
                  <li>
                    <%= link_to commandes_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'commandes'}" do %>
                      <%= embedded_svg "icons/order_approve.svg", class: "w-5 h-5 fill-current" %> <span>Commandes</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(Facture).index? %>
                  <li>
                    <%= link_to factures_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'factures'}" do %>
                      <%= embedded_svg "icons/receipt.svg", class: "w-5 h-5 fill-current" %> <span>Factures</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(:pages).dashboard? %>
                  <li>
                    <%= link_to dashboard_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'dashboard'}", 'data-turbo': false do %>
                      <%= embedded_svg "icons/bar_chart.svg", class: "w-5 h-5 fill-current" %> <span>Tableau de bord</span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>

          <% if policy(:admin).parametres? || policy(User).index? || policy(Mouvement).index? || policy(:admin).audits? %>
            <li class="dropdown dropdown-start relative">
              <div tabindex="0" role="button" class="<%= class_names("h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary cursor-pointer focus:bg-base-300! focus:outline-none! navbar-icon-trigger", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => (%w[services warehouses users mouvements].include?(params[:controller]) || params[:action] == 'audits')) %>" title="Gestion">
                <%= embedded_svg "icons/settings.svg", class: "w-5 h-5 fill-current" %>
                <span class="text-sm">Gestion</span>
                <%= embedded_svg "icons/expand_more.svg", class: "w-4 h-4 fill-current opacity-70" %>
              </div>
              <ul tabindex="0" class="dropdown-content z-[210] menu p-0! py-2 shadow bg-base-100 rounded-box w-56 border border-slate-200 text-slate-700 left-0! top-full mt-0!" style="margin-left: 0px;">
                <% if policy(:admin).parametres? %>
                  <li>
                    <%= link_to admin_parametres_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if (['services', 'warehouses'].include?(params[:controller]) || (params[:controller] == 'admin' && params[:action] == 'parametres'))}" do %>
                      <%= embedded_svg "icons/settings.svg", class: "w-5 h-5 fill-current" %> <span>Paramètres</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(User).index? %>
                  <li>
                    <%= link_to users_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier' && !(params[:id] == current_user.slug)) || params[:action] == 'create_new_user'}" do %>
                      <%= embedded_svg "icons/group.svg", class: "w-5 h-5 fill-current" %> <span>Utilisateurs</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(:admin).audits? %>
                  <li>
                    <%= link_to admin_audits_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if (params[:action] == 'audits') || (params[:controller] == 'admin/audits')}" do %>
                      <%= embedded_svg "icons/history.svg", class: "w-5 h-5 fill-current" %> <span>Activité</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(MailLog).index? %>
                  <li>
                    <%= link_to notifications_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'mail_logs'}" do %>
                      <%= embedded_svg "icons/mail.svg", class: "w-5 h-5 fill-current" %> <span>Notifications (Mails)</span>
                    <% end %>
                  </li>
                <% end %>
                <% if policy(:pages).assistant? %>
                  <li>
                    <%= link_to assistant_path, class: "py-2 px-3 flex items-center gap-1.5 rounded-none #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'assistant'}" do %>
                      <%= embedded_svg "icons/smart_toy.svg", class: "w-5 h-5 fill-current" %> <span>Assistant (IA)</span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>
        <% end %>
      <% end %>

        <li>
          <%= link_to messagerie_path, class: class_names("h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary focus:bg-base-300! focus:outline-none! navbar-icon-trigger", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:controller] == 'messagerie'), title: 'Messagerie', 'data-turbo': false do %>
            <%= embedded_svg "icons/chat.svg", class: "w-6 h-6 fill-current transition-colors duration-200 #{'text-error' if current_user.new_messages?}" %>
          <% end %>
        </li>
        <% if policy(WikiPage).index? %>
          <li>
            <%= link_to documentation_index_path, class: class_names("h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary focus:bg-base-300! focus:outline-none! navbar-icon-trigger", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => params[:controller] == 'wiki_pages'), title: "Wiki" do %>
              <%= embedded_svg "icons/menu_book.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
            <% end %>
          </li>
        <% end %>
        <li title="<%= current_user.nom_prenom_role %>">
          <%= link_to user_path(current_user), class: class_names("h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary focus:bg-base-300! focus:outline-none! navbar-icon-trigger", "menu-active text-primary! border-b-2 #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'}" => (params[:controller] == 'users' && params[:id] == current_user.slug)) do %>
            <%= render partial: 'partials/user_profile_picture', locals: { user: current_user } %>
          <% end %>
        </li>
        <li>
          <button onclick="logout_modal.showModal()" title="Fermer la session de <%= current_user.email %> (<%= current_user.rôle %>)" class="h-16 py-0 flex items-center text-secondary hover:border-b-2 hover:border-primary cursor-pointer focus:bg-base-300! focus:outline-none! navbar-icon-trigger" data-testid="se_deconnecter">
            <%= embedded_svg "icons/logout.svg", class: "w-6 h-6 fill-current" %>
          </button>
        </li>
    </ul>
  </div>
</div>


<style>
  .navbar-icon-trigger:focus {
    color: #5f718b !important;
  }
  .navbar-icon-trigger:focus svg {
    fill: #5f718b !important;
  }
</style>