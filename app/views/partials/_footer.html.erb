<footer class="bg-[#E5EFF9] lg:bg-[#E5EFF9] shadow-lg px-6 py-4">
  <div class="flex flex-col md:flex-row p-8 justify-between text-center items-start gap-8">
    <div class="flex flex-col text-center md:text-left">
      <p class="text-sm font-black mb-4">NOUS CONTACTER</p>

      <a href="#" class="mb-2 hover:text-[#50b9df]">Mail</a>
      <a href="#" class="mb-2 hover:text-[#50b9df]">Linkedin</a>
      <a href="#" class="mb-2 hover:text-[#50b9df]">www.aikku.eu</a>
    </div>

    <div class="flex flex-col text-center md:text-left">
      <p class="text-sm font-black mb-4">BESOIN D'AIDE</p>

      <%= link_to "FAQ", wiki_pages_path, class: "mb-2 hover:text-[#50b9df]" %>
      <%= link_to "Blog", wiki_pages_path, class: "mb-2 hover:text-[#50b9df]" %>
    </div>

    <div class="flex flex-col text-center md:text-left">
      <p class="text-sm font-black mb-4">CONDITIONS</p>

      <a href="#" class="mb-2 hover:text-[#50b9df]">Mentions légales</a>
      <a href="#" class="mb-2 hover:text-[#50b9df]"
        >Protection des Données</a
      >
      <a href="#" class="mb-2 hover:text-[#50b9df]">Préférences Cookies</a>
