<footer class="-mx-8 -mb-24">
  <div class="footer md:footer-horizontal p-10 bg-base-300 text-base-content text-base flex items-center justify-between">
    <div>
      <span class="text-3xl font-black text-purple-800"><%= @sitename %></span>

      <p class="opacity-50 mt-4">
        <span class="text-primary text-lg font-black">
          <%= link_to 'AÏKKU (SAS)', 'https://www.aikku.eu/fr' %>
        </span>
        <br>  
        Tour Ariane - La Défense 
        <br>
        5, Place de la Pyramide
        <br>
        92800 PUTEAUX
        <br>
        FRANCE
        <br><br>
        SIREN : 934 780 735 R.C.S. Nanterre
      </p>
    </div>
    <div>
      <%= link_to 'Nous contacter', 'https://www.aikku.eu/fr/contact?objet=COOPCOM', target: '_blank', class: 'btn btn-success hover:underline btn-outline btn-lg mt-8' %>
    </div>
    <div>
      <%= image_tag 'aikku.png', class: "h-24 w-auto", alt: "Logo Aikku SAS" %>
    </div>
  </div>
  <div class="footer md:footer-horizontal px-10 py-6 border-t bg-base-content text-neutral-content border-base-300">
    <span class="inline">
      Copyright © 2025 <%= @sitename %> - Tous droits réservés -
      <%= link_to "Mentions Légales", mentions_legales_path, class:'hover:underline' %>
    </span>
    <div class="md:place-self-center md:justify-self-end flex items-center gap-4">
      <%= link_to 'https://www.aikku.eu/fr/contact', class: 'flex items-center' do %>
        <span class="material-symbols-outlined">
          mail
        </span>
        <span>Mail</span>
      <% end %>
      <%= link_to "https://www.linkedin.com/company/aikku-sas", target: "_blank", class: 'flex items-center' do %>
        <span class="material-symbols-outlined">
          open_in_new
        </span>
        <span>Linkedin</span>
      <% end %>
    </div>
  </div>
</footer>
