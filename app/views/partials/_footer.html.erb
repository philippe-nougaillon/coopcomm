  <div
    class="flex flex-col md:flex-row text-sm justify-between gap-4 p-8 border-t border-gray-300 text-center md:text-left"
  >
    <p>© <%= Date.current.year %> AÏKKU SAS. Tous droits réservés.</p>
    <p>AÏKKU SAS, 5 Place de la Pyramide, 92800 PUTEAUX</p>
    <p>SIREN : 934 780 735 R.C.S Nanterre</p>
