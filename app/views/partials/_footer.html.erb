    <div class="flex flex-col max-w-xs">
      <p class="mb-2 text-sm">
        <b>S'inscrire à la Newsletter</b> pour recevoir les dernières
        actualités
      </p>

      <input
        type="email"
        placeholder="Entrez votre adresse email"
        class="border border-gray-300 rounded-md py-2 px-4 mb-2"
      />

      <button class="bg-black text-white rounded-md py-2 hover:bg-gray-800">
        JE M'INSCRIS
      </button>
    </div>
