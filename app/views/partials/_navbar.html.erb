<div class="hidden lg:navbar <%= demo_instance? ? 'bg-indigo-100' : 'bg-base-100' %> shadow-sm py-0! pr-0! fixed top-0 z-200">
  <div class="flex items-center flex-1">
    <%= link_to root_path do %>
      <%= image_tag "CoopComm.png", class: "h-8 pr-1 ml-6" %>
    <% end %>
    <% if false && demo_instance? %>
      <span data-theme="corporate" class="badge badge-warning font-bold gap-1 shadow-sm">🧪 DÉMO</span>
    <% end %>
  </div>
  <div class="flex-none">
    <ul class="menu w-full menu-horizontal flex-1 items-center py-0! px-0">
      <li>
        <%= link_to home_path, class: "group h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:action] == 'home'}", title: "Page d'accueil" do %>
          <%= embedded_svg "icons/cottage.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
        <% end %>
      </li>
      <li>
        <%= link_to interventions_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'interventions'}", title: "Liste des interventions" do %>
          <%= embedded_svg "icons/construction.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
        <% end %>
      </li>
      <% if policy(Cotation).index? %>
        <li>
          <%= link_to cotations_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'cotations'}", title: "Cotations / Devis" do %>
            <span class="material-symbols-outlined">
              request_quote
            </span>
          <% end %>
        </li>
      <% end %>
      <% if policy(Convention).index? %>
        <li>
          <%= link_to conventions_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'conventions'}", title: "Conventions" do %>
            <span class="material-symbols-outlined">
              contract
            </span>
          <% end %>
        </li>
      <% end %>
      <% if policy(Tool).index? %>
        <li>
          <%= link_to tools_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'tools'}", title: "Liste du matériel" do %>
            <%= embedded_svg "icons/front_loader.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        </li>
      <% end %>
      <% if policy(User).agent_calendrier? %>
        <li>
          <%= link_to agent_calendrier_users_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:action] == 'agent_calendrier'}", title: "Voir la disponibilité des agents" do %>
            <%= embedded_svg "icons/event_available.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to messagerie_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'messagerie'}", title: 'Messagerie', 'data-turbo': false do %>
          <% if current_user.new_messages? %>
            <%= embedded_svg "icons/chat.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-error" %>
          <% else %>
            <%= embedded_svg "icons/chat.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-secondary #{'text-primary!' if params[:controller] == 'messagerie'}" %>
          <% end %>
        <% end %>
      </li>
      <% if policy(:pages).assistant? %>
        <li>
          <%= link_to assistant_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:action] == 'assistant'}", title: 'Assistant (IA)' do %>
            <%= embedded_svg "icons/smart_toy.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        </li>
      <% end %>
      <% if policy(Mouvement).index? %>
        <li>
          <%= link_to mouvements_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'mouvements'}", title: "Liste des mouvements" do %>
            <%= embedded_svg "icons/compare_arrows.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        </li>
      <% end %>
      <% if policy(:admin).parametres? %>
        <li>
          <%= link_to admin_parametres_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if (['services', 'warehouses'].include?(params[:controller]) || (params[:controller] == 'admin' && params[:action] == 'parametres')) }", title: 'Paramètres' do %>
            <%= embedded_svg "icons/settings.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        </li>
      <% end %>
      <% if policy(:admin).audits? %>
        <li>
          <%= link_to admin_audits_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if (params[:action] == 'audits') || (params[:controller] == 'mail_logs') }", title: 'Activité (historique des modifications)', 'data-testid': "audit_trail" do %>
            <%= embedded_svg "icons/history.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        </li>
      <% end %>
      <% if policy(:pages).dashboard? %>
        <li>
          <%= link_to dashboard_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:action] == 'dashboard'}", title: "Tableau de bord", 'data-turbo': false do %>
            <%= embedded_svg "icons/grid_view.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to wiki_pages_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'wiki_pages'}", title: "Wiki" do %>
          <%= embedded_svg "icons/menu_book.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
        <% end %>
      </li>
      <% if policy(User).index? %>
        <li>
          <%= link_to users_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if (params[:controller] == 'users' && params[:action] != 'agent_calendrier' && !(params[:id] == current_user.slug)) || params[:action] == 'create_new_user'}", title: "Liste des utilisateurs" do %>
            <%= embedded_svg "icons/group.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        </li>
      <% end %>
      <li title="<%= current_user.nom_prenom_role %>">
        <%= link_to user_path(current_user), class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'users' && (params[:id] == current_user.slug)}" do %>
          <%= render partial: 'partials/user_profile_picture', locals: {user: current_user} %>
        <% end %>
      </li>
      <li>
        <%= link_to destroy_user_session_path, 'data-turbo-method': :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir fermer cette session ?" }, title: "Fermer la session de #{current_user.email} (#{current_user.rôle})", class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 hover:border-primary!" do %>
          <%= embedded_svg "icons/logout.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
        <% end %>
      </li>
    </ul>
  </div>
</div>
<!-- MODE MOBILE -->
<div class="dock dock-lg lg:hidden z-100 shadow-2xl <%= 'bg-indigo-100' if demo_instance? %>" style="scrollbar-width: none;">
  <%= link_to home_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'home'}", title: "Page d'accueil" do %>
    <%= embedded_svg "icons/home.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
  <% end %>
  <%= link_to interventions_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'interventions'}", title: "Liste des interventions" do %>
    <%= embedded_svg "icons/construction.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
  <% end %>
  <% if policy(Tool).index? %>
    <%= link_to tools_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'tools'}", title: "Liste des outils" do %>
      <%= embedded_svg "icons/front_loader.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <% if policy(User).agent_calendrier? %>
    <%= link_to agent_calendrier_users_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'agent_calendrier'}", title: "Voir la disponibilité des agents" do %>
      <%= embedded_svg "icons/event_available.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <%= link_to messagerie_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'messagerie'}", title: 'Messagerie', 'data-turbo': false do %>
    <% if current_user.new_messages? %>
      <%= embedded_svg "icons/chat_error.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% else %>
      <%= embedded_svg "icons/chat.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <% if false && policy(Mouvement).index? %>
    <%= link_to mouvements_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'mouvements'}", title: "Liste des mouvements" do %>
      <%= embedded_svg "icons/compare_arrows.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <% if false && policy(WikiPage).index? %>
    <%= link_to wiki_pages_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'wiki_pages'}", title: "Wiki" do %>
      <%= embedded_svg "icons/menu_book.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <% if false && policy(:pages).assistant? %>
    <%= link_to assistant_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'assistant'}", title: 'Assistant (IA)' do %>
      <%= embedded_svg "icons/smart_toy.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <% if false && policy(:admin).audits? %>
    <%= link_to admin_audits_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if (params[:action] == 'audits') || (params[:controller] == 'mail_logs') }", title: 'Activité (historique des modifications)', 'data-testid': "audit_trail" do %>
      <%= embedded_svg "icons/history.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <% if false && policy(:pages).dashboard? %>
    <%= link_to dashboard_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'dashboard'}", title: "Tableau de bord", 'data-turbo': false do %>
      <%= embedded_svg "icons/grid_view.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <% if false && policy(User).index? %>
    <%= link_to users_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier') || params[:action] == 'create_new_user'}", title: "Liste des utilisateurs" do %>
      <%= embedded_svg "icons/group.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <%= link_to user_path(current_user), class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier') || params[:action] == 'create_new_user'}", title: "Liste des utilisateurs" do %>
    <%= embedded_svg "icons/account_circle.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
  <% end %>
  <%= link_to destroy_user_session_path, 'data-turbo-method': :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir fermer cette session ?", testid: "fermer_session" }, title: "Fermer la session de #{current_user.email} (#{current_user.rôle})", class: "text-secondary hover-active hover:shadow" do %>
    <%= embedded_svg "icons/logout.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
  <% end %>
</div>
