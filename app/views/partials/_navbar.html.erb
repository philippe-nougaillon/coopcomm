<div class="hidden lg:navbar <%= demo_instance? ? 'bg-indigo-100' : 'bg-base-100' %> shadow-sm py-0! pr-0! fixed top-0 z-200">
  <div class="flex items-center flex-1">
    <%= link_to root_path, title: "Page d'accueil" do %>
      <%= image_tag "CoopComm.png", class: "h-8 pr-1 ml-6" %>
    <% end %>
  </div>
  <div class="flex-none">
    <ul class="menu w-full menu-horizontal flex-1 items-center py-0! px-0">
      <%# --- ACCUEIL --- %>
      <li>
        <%= link_to home_path, class: "h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! ' + (demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!') + ' border-b-2' if params[:action] == 'home'}", title: "Page d'accueil" do %>
          <%= embedded_svg "icons/cottage.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
        <% end %>
      </li>
      <%# --- VISTA PARA EL ROL ADHÉRENT --- %>
      <% if current_user.rôle == 'adhérent' %>
        <% if policy(Intervention).index? %>
          <li>
            <%= link_to interventions_path, class: "h-16 py-0 px-3 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'interventions'}", title: "Liste des interventions" do %>
              <%= embedded_svg "icons/construction.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
            <% end %>
          </li>
        <% end %>
        <% if policy(Convention).index? %>
          <li>
            <%= link_to conventions_path, class: "h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! ' + (demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!') + ' border-b-2' if params[:controller] == 'conventions'}", title: "Liste des conventions" do %>
              <%= embedded_svg "icons/order_approve.svg",  class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            <% end %>
          </li>
        <% end %>
        <%# ---  (Commandes/Factures/Cotations) --- %>
        <% if policy(Commande).index? || policy(Facture).index? || policy(Cotation).index? %>
          <li>
            <%= link_to adherent_crm_path, class: "h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! ' + (demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!') + ' border-b-2' if params[:controller] == 'adherent_crm'}", title: "Adhérent CRM" do %>
              <%= embedded_svg "icons/contract.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            <% end %>
          </li>
        <% end %>
        <% if policy(:pages).dashboard? %>
          <li>
            <%= link_to dashboard_path, class: "h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! ' + (demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!') + ' border-b-2' if params[:action] == 'dashboard'}",title: "Dashboard", 'data-turbo': false do %>
              <%= embedded_svg "icons/bar_chart.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
            <% end %>
          </li>
        <% end %>
        <%# --- VISTA PARA OTROS ROLES (ADMIN, AGENT, ETC.) --- %>
      <% else %>
        <%# --- 3. PLANIFICATION & RESSOURCES PARA AGENTE --- %>
        <% if current_user.rôle == 'agent' %>
          <% if policy(User).agent_calendrier? %>
            <li>
              <%= link_to agent_calendrier_users_path, class: "h-16 py-0 px-3 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:action] == 'agent_calendrier'}", title: "Disponibilités" do %>
                <%= embedded_svg "icons/event_available.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
              <% end %>
            </li>
          <% end %>
          <% if policy(Intervention).index? %>
            <li>
              <%= link_to interventions_path, class: "h-16 py-0 px-3 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'interventions'}", title: "Liste des interventions" do %>
                <%= embedded_svg "icons/construction.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
              <% end %>
            </li>
          <% end %>
          <% if policy(Tool).index? %>
            <li>
              <%= link_to tools_path, class: "h-16 py-0 px-3 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'tools'}", title: "Réservation de matériel" do %>
                <%= embedded_svg "icons/front_loader.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-sm" %>
              <% end %>
            </li>
          <% end %>
          <%# --- 4. PLANIFICATION & RESSOURCES PARA ADMINISTRADOR --- %>
        <% elsif current_user.rôle == 'administrateur' || current_user.rôle == 'manager' %>
          <% if policy(Tool).index? || policy(User).agent_calendrier? %>
            <li class="dropdown dropdown-end">
              <div tabindex="0" role="button" class="h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'tools' || params[:action] == 'agent_calendrier'}" title="Ressources">
                <%= embedded_svg "icons/construction.svg", class: "w-5 h-5 fill-current" %>
                <span class="text-sm">Ressources</span>
                <%= embedded_svg "icons/expand_more.svg", class: "w-4 h-4 fill-current opacity-70" %>
              </div>
              <ul tabindex="0" class="dropdown-content z-[210] menu p-2 shadow bg-base-100 rounded-box w-56 border border-slate-200 mt-1 text-slate-700">
                <% if policy(Intervention).index? %>
                  <li>
                    <%= link_to interventions_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'interventions'}" do %>
                      <%= embedded_svg "icons/construction.svg", class: "w-4 h-4 inline mr-1" %> Interventions
                    <% end %>
                  </li>
                <% end %>
                <% if policy(Tool).index? %>
                  <li>
                    <%= link_to tools_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'tools'}" do %>
                      <%= embedded_svg "icons/front_loader.svg", class: "w-4 h-4 inline mr-1" %> Matériel
                    <% end %>
                  </li>
                <% end %>
                <% if policy(User).agent_calendrier? %>
                  <li>
                    <%= link_to agent_calendrier_users_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'agent_calendrier'}" do %>
                      <%= embedded_svg "icons/productivity.svg", class: "w-4 h-4 inline mr-1" %> Agents 
                    <% end %>
                  </li>
                <% end %>
                <% if policy(Mouvement).index? %>
                  <li>
                    <%= link_to mouvements_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'mouvements'}" do %>
                      <%= embedded_svg "icons/compare_arrows.svg", class: "w-4 h-4 inline mr-1" %> Mouvements
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>
        <% end %>
        <%# --- 3. CRM --- %>
        <% if policy(Convention).index? || policy(Cotation).index? || policy(Commande).index? || policy(Facture).index? %>
          <li class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if %w[conventions cotations commandes factures].include?(params[:controller])}" title="Documents">
              <%= embedded_svg "icons/contract.svg", class: "w-5 h-5 fill-current" %>
              <span class="text-sm">CRM</span>
              <%= embedded_svg "icons/expand_more.svg", class: "w-4 h-4 fill-current opacity-70" %>
            </div>
            <ul tabindex="0" class="dropdown-content z-[210] menu p-2 shadow bg-base-100 rounded-box w-56 border border-slate-200 mt-1 text-slate-700">
              <% if policy(Convention).index? %>
                <li>
                  <%= link_to conventions_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'conventions'}" do %>
                    <%= embedded_svg "icons/contract.svg", class: "w-4 h-4 inline mr-2" %> Conventions
                  <% end %>
                </li>
              <% end %>
              <% if policy(Cotation).index? %>
                <li>
                  <%= link_to cotations_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'cotations'}" do %>
                    <%= embedded_svg "icons/request_quote.svg", class: "w-4 h-4 inline mr-2" %> Cotations 
                  <% end %>
                </li>
              <% end %>
              <% if policy(Commande).index? %>
                <li>
                  <%= link_to commandes_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'commandes'}" do %>
                    <%= embedded_svg "icons/order_approve.svg", class: "w-4 h-4 inline mr-2" %> Commandes
                  <% end %>
                </li>
              <% end %>
              <% if policy(Facture).index? %>
                <li>
                  <%= link_to factures_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'factures'}" do %>
                    <%= embedded_svg "icons/receipt.svg", class: "w-4 h-4 inline mr-2" %> Factures
                  <% end %>
                </li>
              <% end %>
              <% if policy(:pages).dashboard? %>
                <li>
                  <%= link_to dashboard_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'dashboard'}", 'data-turbo': false do %>
                    <%= embedded_svg "icons/bar_chart.svg", class: "w-5 h-5 inline mr-2" %> Tableau de bord
                  <% end %>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>
        <%# --- 4. ADMINISTRATION (MOVIDO AL INICIO) --- %>
        <% if policy(:admin).parametres? || policy(User).index? || policy(Mouvement).index? || policy(:admin).audits? %>
          <li class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="h-16 py-0 px-3 flex items-center gap-1 text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if %w[services warehouses users mouvements].include?(params[:controller]) || params[:action] == 'audits'}" title="Gestion">
              <%= embedded_svg "icons/settings.svg", class: "w-5 h-5 fill-current" %>
                <span class="text-sm">Gestion</span>
              <%= embedded_svg "icons/expand_more.svg", class: "w-4 h-4 fill-current opacity-70" %>
            </div>
            <ul tabindex="0" class="dropdown-content z-[210] menu p-2 shadow bg-base-100 rounded-box w-56 border border-slate-200 mt-1 text-slate-700">
              <% if policy(:admin).parametres? %>
                <li>
                  <%= link_to admin_parametres_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if (['services', 'warehouses'].include?(params[:controller]) || (params[:controller] == 'admin' && params[:action] == 'parametres'))}" do %>
                    <%= embedded_svg "icons/settings.svg", class: "w-4 h-4 inline mr-1" %> Paramètres
                  <% end %>
                </li>
              <% end %>
              <% if policy(User).index? %>
                <li>
                  <%= link_to users_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier' && !(params[:id] == current_user.slug)) || params[:action] == 'create_new_user'}" do %>
                    <%= embedded_svg "icons/group.svg", class: "w-4 h-4 inline mr-1" %> Utilisateurs
                  <% end %>
                </li>
              <% end %>
              <% if policy(:admin).audits? %>
                <li>
                  <%= link_to admin_audits_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if (params[:action] == 'audits') || (params[:controller] == 'admin/audits')}" do %>
                    <%= embedded_svg "icons/history.svg", class: "w-4 h-4 inline mr-1" %> Activité
                  <% end %>
                </li>
              <% end %>
              <% if policy(MailLog).index? %>
                <li>
                  <%= link_to notifications_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'mail_logs'}" do %>
                    <%= embedded_svg "icons/mail.svg", class: "w-4 h-4 inline mr-1" %> Notifications (Mails)
                  <% end %>
                </li>
              <% end %>
              <% if policy(:pages).assistant? %>
                <li>
                  <%= link_to assistant_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'assistant'}" do %>
                    <%= embedded_svg "icons/smart_toy.svg", class: "w-4 h-4 inline mr-1" %> Assistant (IA)
                  <% end %>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>
      <% end %>
      <%# --- MESSAGERIE --- %>
      <li>
        <%= link_to messagerie_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'messagerie'}", title: 'Messagerie', 'data-turbo': false do %>
          <% if current_user.new_messages? %>
            <%= embedded_svg "icons/chat.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-error" %>
          <% else %>
            <%= embedded_svg "icons/chat.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <% end %>
        <% end %>
      </li>
      <%# --- WIKI --- %>
      <li>
        <%= link_to wiki_pages_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'wiki_pages'}", title: "Wiki" do %>
          <%= embedded_svg "icons/menu_book.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
        <% end %>
      </li>
      <%# --- AVATAR --- %>
      <li title="<%= current_user.nom_prenom_role %>">
        <%= link_to user_path(current_user), class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{"menu-active text-primary! #{demo_instance? ? 'bg-indigo-100!' : 'bg-base-100!'} border-b-2" if params[:controller] == 'users' && (params[:id] == current_user.slug)}" do %>
          <%= render partial: 'partials/user_profile_picture', locals: {user: current_user} %>
        <% end %>
      </li>
      <%# --- LOGOUT --- %>
      <li>
        <%= link_to destroy_user_session_path, 'data-turbo-method': :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir fermer cette session ?" }, title: "Fermer la session de #{current_user.email} (#{current_user.rôle})", class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 hover:border-primary!" do %>
          <%= embedded_svg "icons/logout.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
        <% end %>
      </li>
    </ul>
  </div>
</div>
<%# ---MÓVIL  --- %>
<div class="dock dock-lg lg:hidden z-200 shadow-2xl <%= 'bg-indigo-100' if demo_instance? %>" style="scrollbar-width: none;">
  <%# Accueil %>
  <%= link_to home_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'home'}", title: "Page d'accueil" do %>
    <%= embedded_svg "icons/cottage.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
  <% end %>
  <%# Interventions %>
  <%= link_to interventions_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'interventions'}", title: "Liste des interventions" do %>
    <%= embedded_svg "icons/construction.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
  <% end %>
  <%# Messagerie %>
  <%= link_to messagerie_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'messagerie'}", title: 'Messagerie', 'data-turbo': false do %>
    <% if current_user.new_messages? %>
      <%= embedded_svg "icons/chat.svg", class: "w-6 h-6 fill-current transition-colors duration-200 text-error" %>
    <% else %>
      <%= embedded_svg "icons/chat.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
  <%# Avatar %>
  <%= link_to user_path(current_user), class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier' && params[:id] == current_user.slug)}", title: "Mon profil" do %>
    <%= embedded_svg "icons/account_circle.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
  <% end %>
  <%# Menu desplegable móvil %>
  <div class="dropdown dropdown-top dropdown-end flex items-center justify-center w-full h-full">
    <div tabindex="0" role="button" class="flex flex-col items-center justify-center text-secondary w-full h-full active:bg-slate-100">
      <%= embedded_svg "icons/more_vert.svg", class: "w-6 h-6 fill-current" %>
    </div>
    <div tabindex="0" class="dropdown-content z-[210] shadow-xl bg-base-100 rounded-2xl w-60 border border-slate-200 mb-2 max-h-[70vh] flex flex-col overflow-hidden">
      <div class="overflow-y-auto flex-1 p-2 pb-14" style="scrollbar-width: none;">
        <ul class="menu p-0 text-slate-700 w-full">
          <%# ADHÉRENT %>
          <% if current_user.rôle == 'adhérent' %>
            <% if policy(Convention).index? %>
              <li>
                <%= link_to conventions_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'conventions'}" do %>
                  <%= embedded_svg "icons/order_approve.svg", class: "w-5 h-5 inline mr-2" %> Conventions
                <% end %>
              </li>
            <% end %>
            <% if policy(:crm).index? %>
              <li>
                <%= link_to adherent_crm_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'adherent_crm'}", title: "Adhérent CRM" do %>
                  <%= embedded_svg "icons/contract.svg", class: "w-5 h-5 inline mr-2" %> CRM
                <% end %>
              </li>
            <% end %>
            <% if policy(:pages).dashboard? %>
              <li>
                <%= link_to dashboard_path, class: "py-2 #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'dashboard'}", 'data-turbo': false do %>
                  <%= embedded_svg "icons/bar_chart.svg", class: "w-5 h-5 inline mr-2" %> Tableau de bord
                <% end %>
              </li>
            <% end %>
            <%# AGENT %>
          <% elsif current_user.rôle == 'agent' %>
            <% if policy(Tool).index? %>
              <li>
                <%= link_to tools_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'tools'}" do %>
                  <%= embedded_svg "icons/front_loader.svg", class: "w-5 h-5 inline mr-2" %> Matériel
                <% end %>
              </li>
            <% end %>
            <li>
              <%= link_to wiki_pages_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'wiki_pages'}" do %>
                <%= embedded_svg "icons/menu_book.svg", class: "w-5 h-5 inline mr-2" %> Wiki / Guides
              <% end %>
            </li>
            <%#  ADMIN / MANAGEMENT  %>
          <% elsif current_user.rôle == 'administrateur' || current_user.rôle == 'manager' %>
            <% if policy(:admin).parametres? || policy(User).index? || policy(:admin).audits? %>
              <li class="menu-title px-4 py-1 text-xs uppercase font-bold text-slate-400">Admin</li>
              <% if policy(:admin).parametres? %>
                <li>
                  <%= link_to admin_parametres_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if (['services', 'warehouses'].include?(params[:controller]) || (params[:controller] == 'admin' && params[:action] == 'parametres'))}" do %>
                    <%= embedded_svg "icons/settings.svg", class: "w-5 h-5 inline mr-2" %> Paramètres
                  <% end %>
                </li>
              <% end %>
              <% if policy(User).index? %>
                <li>
                  <%= link_to users_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier' && params[:id] != current_user.slug)}" do %>
                    <%= embedded_svg "icons/group.svg", class: "w-5 h-5 inline mr-2" %> Utilisateurs
                  <% end %>
                </li>
              <% end %>
              <% if policy(:admin).audits? %>
                <li>
                  <%= link_to admin_audits_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if (params[:action] == 'audits')}" do %>
                    <%= embedded_svg "icons/history.svg", class: "w-5 h-5 inline mr-2" %> Historique d'activité
                  <% end %>
                </li>
              <% end %>
              <% if policy(MailLog).index? %>
                <li>
                  <%= link_to notifications_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'mail_logs'}" do %>
                    <%= embedded_svg "icons/mail.svg", class: "w-5 h-5 inline mr-2" %> Notifications (Mails)
                  <% end %>
                </li>
              <% end %>
              <% if policy(:pages).assistant? %>
                <li>
                  <%= link_to assistant_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'assistant'}" do %>
                    <%= embedded_svg "icons/smart_toy.svg", class: "w-5 h-5 inline mr-2" %> Assistant (IA)
                  <% end %>
                </li>
              <% end %>
              <div class="divider my-1 opacity-50"></div>
            <% end %>
            <%# --- CRM --- %>
            <% if policy(Convention).index? || policy(Cotation).index? || policy(Commande).index? || policy(Facture).index? %>
              <li class="menu-title px-4 py-2 text-xs uppercase font-bold text-slate-400">CRM</li>
              <% if policy(Convention).index? %>
                <li>
                  <%= link_to conventions_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'conventions'}" do %>
                    <%= embedded_svg "icons/contract.svg", class: "w-5 h-5 inline mr-2" %> Conventions
                  <% end %>
                </li>
              <% end %>
              <% if policy(Cotation).index? %>
                <li>
                  <%= link_to cotations_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'cotations'}" do %>
                    <%= embedded_svg "icons/request_quote.svg", class: "w-5 h-5 inline mr-2" %> Cotations / Devis
                  <% end %>
                </li>
              <% end %>
              <% if policy(Commande).index? %>
                <li>
                  <%= link_to commandes_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'commandes'}" do %>
                    <%= embedded_svg "icons/order_approve.svg", class: "w-5 h-5 inline mr-2" %> Commandes
                  <% end %>
                </li>
              <% end %>
              <% if policy(Facture).index? %>
                <li>
                  <%= link_to factures_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'factures'}" do %>
                    <%= embedded_svg "icons/receipt.svg", class: "w-5 h-5 inline mr-2" %> Factures
                  <% end %>
                </li>
              <% end %>
              <% if policy(:pages).dashboard? %>
                <li>
                  <%= link_to dashboard_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'dashboard'}", 'data-turbo': false do %>
                    <%= embedded_svg "icons/bar_chart.svg", class: "w-5 h-5 inline mr-2"  %> Tableau de bord
                  <% end %>
                </li>
              <% end %>
              <div class="divider my-1 opacity-50"></div>
            <% end %>
            <%# ---  RESSOURCES --- %>
            <% if policy(Tool).index? || policy(User).agent_calendrier? || policy(Mouvement).index? %>
              <li class="menu-title px-4 py-1 text-xs uppercase font-bold text-slate-400">Ressources</li>
              <% if policy(Tool).index? %>
                <li>
                  <%= link_to tools_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'tools'}" do %>
                    <%= embedded_svg "icons/front_loader.svg", class: "w-5 h-5 inline mr-2" %> Matériel
                  <% end %>
                </li>
              <% end %>
              <% if policy(User).agent_calendrier? %>
                <li>
                  <%= link_to agent_calendrier_users_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:action] == 'agent_calendrier'}" do %>
                    <%= embedded_svg "icons/event_available.svg", class: "w-5 h-5 inline mr-2" %> Agents
                  <% end %>
                </li>
              <% end %>
              <% if policy(Mouvement).index? %>
                <li>
                  <%= link_to mouvements_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'mouvements'}" do %>
                    <%= embedded_svg "icons/compare_arrows.svg", class: "w-5 h-5 inline mr-2" %> Mouvements
                  <% end %>
                </li>
              <% end %>
              <div class="divider my-1 opacity-50"></div>
            <% end %>
            <%# --- guide --- %>
            <li class="menu-title px-4 py-1 text-xs uppercase font-bold text-slate-400">Guides</li>
            <li>
              <%= link_to wiki_pages_path, class: "py-3 #{'bg-slate-100 text-primary font-semibold' if params[:controller] == 'wiki_pages'}" do %>
                <%= embedded_svg "icons/menu_book.svg", class: "w-5 h-5 inline mr-2" %> Wiki 
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
      <%# logout %>
      <div class="absolute bottom-0 left-0 right-0 bg-base-100 border-t border-slate-100 p-2.5 rounded-b-2xl z-10">
        <%= link_to destroy_user_session_path, 'data-turbo-method': :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir fermer cette session ?", testid: 'fermer_session' }, class: "flex items-center text-red-400 hover:text-red-600 font-semibold text-xs transition-colors w-full px-3 py-1" do %>
          <%= embedded_svg "icons/logout.svg", class: "w-4 h-4 mr-2 " %> Déconnexion
        <% end %>
      </div>
    </div>
  </div>
</div>