<div class="hidden lg:navbar bg-base-100 shadow-sm py-0! pr-0! fixed top-0 z-200">
  <div class="flex items-center flex-1">
    <%= link_to root_path do %>
      <%= image_tag "CoopComm.png", class: "h-8 pr-1 ml-6" %>
    <% end %>
  </div>
  <div class="flex-none">
    <ul class="menu w-full menu-horizontal flex-1 items-center py-0! px-0">
      <li>
        <%= link_to home_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:action] == 'home'}", title: "Page d'accueil" do %>
          <img src="/assets/icons/cottage.svg" class="icon" alt="Page d'accueil" title="Page d'accueil">
        <% end %>
      </li>
      <li>
        <%= link_to interventions_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:controller] == 'interventions'}", title: "Liste des interventions" do %>
          <img src="/assets/icons/construction.svg" class="icon" alt="Liste des interventions" title="Liste des interventions">
        <% end %>
      </li>
      <% if policy(Tool).index? %>
        <li>
          <%= link_to tools_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:controller] == 'tools'}", title: "Liste du matériel" do %>
            <img src="/assets/icons/front_loader.svg" class="icon" alt="Liste du matériel" title="Liste du matériel">
          <% end %>
        </li>
      <% end %>
      <% if policy(User).agent_calendrier? %>
        <li>
          <%= link_to agent_calendrier_users_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:action] == 'agent_calendrier'}", title: "Voir la disponibilité des agents" do %>
            <img src="/assets/icons/event_available.svg" class="icon" alt="Voir la disponibilité des agents" title="Voir la disponibilité des agents">
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to messagerie_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:controller] == 'messagerie'}", title: 'Messagerie', 'data-turbo': false do %>
          <% if current_user.new_messages? %>
            <img src="/assets/icons/chat.svg" class="icon text-error" alt="Messagerie" title="Messagerie">
          <% else %>
            <span class="material-symbols-outlined text-secondary <%= 'text-primary!' if params[:controller] == 'messagerie' %>">
              chat
            </span>
          <% end %>
        <% end %>
      </li>
      <% if policy(:pages).assistant? %>
        <li>
          <%= link_to assistant_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:action] == 'assistant'}", title: 'Assistant (IA)' do %>
            <img src="/assets/icons/smart_toy.svg" class="icon" alt="Assistant (IA)" title="Assistant (IA)">
          <% end %>
        </li>
      <% end %>
      <% if policy(Mouvement).index? %>
        <li>
          <%= link_to mouvements_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:controller] == 'mouvements'}", title: "Liste des mouvements" do %>
            <img src="/assets/icons/compare_arrows.svg" class="icon" alt="Liste des mouvements" title="Liste des mouvements">
          <% end %>
        </li>
      <% end %>
      <% if policy(:admin).parametres? %>
        <li>
          <%= link_to admin_parametres_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if (['services', 'warehouses'].include?(params[:controller]) || (params[:controller] == 'admin' && params[:action] == 'parametres')) }", title: 'Paramètres' do %>
            <img src="/assets/icons/settings.svg" class="icon" alt="Paramètres" title="Paramètres">
          <% end %>
        </li>
      <% end %>
      <% if policy(:admin).audits? %>
        <li>
          <%= link_to admin_audits_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if (params[:action] == 'audits') || (params[:controller] == 'mail_logs') }", title: 'Activité (historique des modifications)', 'data-testid': "audit_trail" do %>
            <img src="/assets/icons/history.svg" class="icon" alt="Activité (historique des modifications)" title="Activité (historique des modifications)">
          <% end %>
        </li>
      <% end %>
      <% if policy(:pages).dashboard? %>
        <li>
          <%= link_to dashboard_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:action] == 'dashboard'}", title: "Tableau de bord", 'data-turbo': false do %>
            <img src="/assets/icons/grid_view.svg" class="icon" alt="Tableau de bord" title="Tableau de bord">
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to wiki_pages_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:controller] == 'wiki_pages'}", title: "Wiki" do %>
          <img src="/assets/icons/menu_book.svg" class="icon" alt="Wiki" title="Wiki">
        <% end %>
      </li>
      <% if policy(User).index? %>
        <li>
          <%= link_to users_path, class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier' && !(params[:id] == current_user.slug)) || params[:action] == 'create_new_user'}", title: "Liste des utilisateurs" do %>
            <img src="/assets/icons/group.svg" class="icon" alt="Liste des utilisateurs" title="Liste des utilisateurs">
          <% end %>
        </li>
      <% end %>
      <li title="<%= current_user.nom_prenom_role %>">
        <%= link_to user_path(current_user), class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 border-primary #{'menu-active text-primary! bg-base-100! border-b-2' if params[:controller] == 'users' && (params[:id] == current_user.slug)}" do %>
          <%= render partial: 'partials/user_profile_picture', locals: {user: current_user} %>
        <% end %>
      </li>
      <li>
        <%= link_to destroy_user_session_path, 'data-turbo-method': :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir fermer cette session ?" }, title: "Fermer la session de #{current_user.email} (#{current_user.rôle})", class: "h-16 py-0 flex items-center text-secondary hover:border-b-2 hover:border-primary!" do %>
          <img src="/assets/icons/logout.svg" class="icon" alt="Fermer la session" title="Fermer la session">
        <% end %>
      </li>
    </ul>
  </div>
</div>
<!-- MODE MOBILE -->
<div class="dock dock-lg lg:hidden z-100 shadow-2xl" style="scrollbar-width: none;">
  <%= link_to home_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'home'}", title: "Page d'accueil" do %>
    <img src="/assets/icons/home.svg" class="icon" alt="Page d'accueil" title="Page d'accueil">
  <% end %>
  <%= link_to interventions_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'interventions'}", title: "Liste des interventions" do %>
    <img src="/assets/icons/construction.svg" class="icon" alt="Liste des interventions" title="Liste des interventions">
<% end %>
<% if policy(Tool).index? %>
  <%= link_to tools_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'tools'}", title: "Liste des outils" do %>
    <img src="/assets/icons/front_loader.svg" class="icon" alt="Liste des outils" title="Liste des outils">
  <% end %>
<% end %>
<% if policy(User).agent_calendrier? %>
  <%= link_to agent_calendrier_users_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'agent_calendrier'}", title: "Voir la disponibilité des agents" do %>
    <img src="/assets/icons/event_available.svg" class="icon" alt="Voir la disponibilité des agents" title="Voir la disponibilité des agents">
  <% end %>
<% end %>
<%= link_to messagerie_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'messagerie'}", title: 'Messagerie', 'data-turbo': false do %>
  <% if current_user.new_messages? %>
    <img src="/assets/icons/chat_error.svg" class="icon" alt="Nouveau message" title="Nouveau message">
  <% else %>
    <img src="/assets/icons/chat.svg" class="icon" alt="Messagerie" title="Messagerie">
  <% end %>
<% end %>
<% if false && policy(Mouvement).index? %>
  <%= link_to mouvements_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'mouvements'}", title: "Liste des mouvements" do %>
    <img src="/assets/icons/compare_arrows.svg" class="icon" alt="Liste des mouvements" title="Liste des mouvements">
  <% end %>
<% end %>
<% if false && policy(WikiPage).index? %>
  <%= link_to wiki_pages_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:controller] == 'wiki_pages'}", title: "Wiki" do %>
    <img src="/assets/icons/menu_book.svg" class="icon" alt="Wiki" title="Wiki">
  <% end %>
<% end %>
<% if false && policy(:pages).assistant? %>
  <%= link_to assistant_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'assistant'}", title: 'Assistant (IA)' do %>
    <img src="/assets/icons/smart_toy.svg" class="icon" alt="Assistant (IA)" title="Assistant (IA)">
  <% end %>
<% end %>
<% if false && policy(:admin).audits? %>
  <%= link_to admin_audits_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if (params[:action] == 'audits') || (params[:controller] == 'mail_logs') }", title: 'Activité (historique des modifications)', 'data-testid': "audit_trail" do %>
    <img src="/assets/icons/history.svg" class="icon" alt="Activité (historique des modifications)" title="Activité (historique des modifications)">
  <% end %>
<% end %>
<% if false && policy(:pages).dashboard? %>
  <%= link_to dashboard_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if params[:action] == 'dashboard'}", title: "Tableau de bord", 'data-turbo': false do %>
    <img src="/assets/icons/grid_view.svg" class="icon" alt="Tableau de bord" title="Tableau de bord">
  <% end %>
<% end %>
<% if false && policy(User).index? %>
  <%= link_to users_path, class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier') || params[:action] == 'create_new_user'}", title: "Liste des utilisateurs" do %>
    <img src="/assets/icons/group.svg" class="icon" alt="Liste des utilisateurs" title="Liste des utilisateurs">
  <% end %>
<% end %>
<%= link_to user_path(current_user), class: "text-secondary hover-active hover:shadow #{'dock-active shadow text-primary!' if (params[:controller] == 'users' && params[:action] != 'agent_calendrier') || params[:action] == 'create_new_user'}", title: "Liste des utilisateurs" do %>
  <img src="/assets/icons/account_circle.svg" class="icon" alt="Profil" title="Profil">
<% end %>
<%= link_to destroy_user_session_path, 'data-turbo-method': :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir fermer cette session ?", testid: "fermer_session" }, title: "Fermer la session de #{current_user.email} (#{current_user.rôle})", class: "text-secondary hover-active hover:shadow" do %>
  <img src="/assets/icons/logout.svg" class="icon" alt="Déconnexion" title="Déconnexion">
<% end %>
</div>