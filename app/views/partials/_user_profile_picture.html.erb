<% taille = local_assigns.fetch(:taille, 'w-10') %>
<% if user.profile_picture.attached? %>
  <div class="avatar">
    <div class="<%= taille %> rounded-full">
      <%= image_tag(user.profile_picture.variable? ? user.profile_picture.variant(resize_to_fill: [80, 80]) : user.profile_picture, loading: 'lazy') %>
    </div>
  </div>
<% else %>
  <div class="avatar avatar-placeholder">
    <div class="bg-secondary text-neutral-content <%= taille %> rounded-full">
      <span class="text-xs"><%= user.initiales %></span>
    </div>
  </div>
<% end %>
