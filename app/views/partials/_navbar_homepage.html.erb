<header class="bg-white shadow-lg px-6 py-4 relative">
  <div class="flex items-center justify-between">
    <!--nav ordenador-->
    <img src="CoopComm.png" alt="CoopComm Logo" class="h-10" />
    <button id="menu-btn" class="md:hidden text-3xl focus:outline-none">
      ☰
    </button>
    <nav class="hidden md:block">
      <ul class="flex flex-row items-center gap-4">
        <li>
          <a
            href="#"
            class="inline-block bg-[#50b9df] px-4 py-2 rounded-full text-white text-sm font-medium hover:bg-[#48a7c8] transition"
          >
            Se connecter
          </a>
        </li>
        <li>
          <a
            href="#"
            class="inline-block bg-[#db2767] px-5 py-2 rounded-full text-white text-sm font-medium hover:bg-[#c51f5b] transition"
          >
            Réserver une démo
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <!--mobile-->
  <div
    id="menu-mobile"
    class="hidden md:hidden bg-white pt-6 pb-2 flex flex-col items-center gap-3"
  >
    <a
      href="#"
      class="w-full max-w-xs text-center bg-[#50b9df] px-5 py-2 rounded-full text-white text-sm font-medium hover:bg-[#48a7c8] transition"
    >
      Se connecter
    </a>
    <a
      href="#"
      class="w-full max-w-xs text-center bg-[#db2767] px-5 py-2 rounded-full text-white text-sm font-medium hover:bg-[#c51f5b] transition"
    >
      Réserver une démo
    </a>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuBtn = document.getElementById("menu-btn");
    const menuMobile = document.getElementById("menu-mobile");
    menuBtn.addEventListener("click", () => {
      menuMobile.classList.toggle("hidden");
      menuBtn.textContent = menuMobile.classList.contains("hidden")
        ? "☰"
        : "✕";
    });
  });
</script>