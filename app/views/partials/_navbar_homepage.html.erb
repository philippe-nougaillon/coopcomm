<header class="bg-white shadow-lg px-6 py-4 relative z-10">
  <div class="flex items-center justify-between">
    <!--nav ordenador-->
    <%= link_to root_path do %>
      <%= image_tag "CoopComm.png", class: "h-6 md:h-10 #{'ml-6 sm:ml-0' if params[:controller] == 'wiki_pages'}" %>
    <% end %>
    <button id="menu-btn" class="md:hidden text-3xl focus:outline-none">
      ☰
    </button>
    <nav class="hidden md:block">
      <ul class="flex flex-row items-center gap-4">
        <li>
          <%= link_to "Se connecter", '/users/sign_in', class: "inline-block bg-[#50b9df] px-4 py-2 rounded-full text-white text-sm font-medium hover:bg-[#48a7c8] transition" %>
        </li>
        <li>
          <%= link_to "Réserver une démo", "https://calendar.app.google/a52LSSCoXsdwz7A2A", class: "inline-block bg-[#db2767] px-5 py-2 rounded-full text-white text-sm font-medium hover:bg-[#c51f5b] transition" %>
        </li>
      </ul>
    </nav>
  </div>

  <!--mobile-->
  <div
    id="menu-mobile"
    class="hidden md:hidden bg-white pt-6 pb-2 flex flex-col items-center gap-3"
  >
    <%= link_to "Se connecter", '/users/sign_in', class: "w-full max-w-xs text-center bg-[#50b9df] px-5 py-2 rounded-full text-white text-sm font-medium hover:bg-[#48a7c8] transition" %>
    <%= link_to "Réserver une démo", "https://calendar.app.google/a52LSSCoXsdwz7A2A", class: "hidden md:block w-full max-w-xs text-center bg-[#db2767] px-5 py-2 rounded-full text-white text-sm font-medium hover:bg-[#c51f5b] transition" %>
    </a>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuBtn = document.getElementById("menu-btn");
    const menuMobile = document.getElementById("menu-mobile");
    menuBtn.addEventListener("click", () => {
      menuMobile.classList.toggle("hidden");
      menuBtn.textContent = menuMobile.classList.contains("hidden")
        ? "☰"
        : "✕";
    });
  });
</script>