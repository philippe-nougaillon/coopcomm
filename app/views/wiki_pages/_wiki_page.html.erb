<div id="<%= dom_id wiki_page %>">
  <h1 class="text-2xl font-bold flex items-center gap-2 <%= 'hover:underline' unless action_name == 'show' %>">
    <% if action_name != 'show' %>
      <%= link_to wiki_page.titre, documentation_path(wiki_page) %>
    <% else %>
      <span class="text-primary text-4xl"><%= page_title!(wiki_page.titre) %></span>
    <% end %>
  </h1>
  <h3 class="text-lg">
    <%= wiki_page.sous_titre %>
  </h3>
  <% if action_name == "show" %>
    <p class="my-5">
      <%= wiki_page.contenu %>
    </p>
  <% else %>
    <% if wiki_page.document.attached? %>
      <% if wiki_page.document.previewable? %>
        <%= link_to image_tag(wiki_page.document.preview(resize_to_limit: [300, 300]), class: 'max-w-none shadow-xl'), wiki_page.document %>
      <% elsif wiki_page.document.representable? %>
        <%= link_to 'Voir le document', wiki_page.document, class: "btn btn-primary" %>
      <% else %>
        <%= link_to "Télécharger le document", rails_blob_path(wiki_page.document, disposition: "attachment"), class: "btn btn-primary" %>
      <% end %>
    <% end %>
    <p><small>Il y a <%= time_ago_in_words(wiki_page.updated_at) %></small></p>
    <hr class="my-6">
  <% end %>
</div>
