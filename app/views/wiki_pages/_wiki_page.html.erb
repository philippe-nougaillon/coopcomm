<div id="<%= dom_id wiki_page %>">
  <h1 class="text-2xl font-bold flex items-center gap-2 <%= 'hover:underline' if params[:action] == 'index' %>">
    <!--
    <span class="material-symbols-outlined">
      <% icon_name = case wiki_page.catégorie %>
        <% when 'documentation' then 'description' %>
        <% when 'guide' then 'help' %>
        <% when 'fiche' then 'assignment' %>
      <% end %>
      <%= icon_name %>
    </span>
    -->
    <% if params[:action] == 'index' %>
      <%= link_to wiki_page.titre, wiki_page_path(wiki_page, catégorie: params[:catégorie]) %>
    <% else %>
      <span class="text-primary text-2xl"><%= page_title!(wiki_page.titre) %></span>
    <% end %>
  </h1>

  <% if action_name == "show" %>
    <p class="my-5">
      <%= wiki_page.contenu %>
    </p>
  <% else %>
    <div class="max-h-24 overflow-y-hidden"><%= wiki_page.contenu %>...</div>
    <br>
    <%= link_to 'Lire l\'article', wiki_page, class: 'btn' %>
    <% if wiki_page.document.attached? %>
      <% if wiki_page.document.representable? %>
        <%= link_to 'Voir le document', wiki_page.document, class: "btn btn-primary" %>
      <% else %>
        <%= link_to "Télécharger le document", rails_blob_path(wiki_page.document, disposition: "attachment"), class: "btn btn-primary" %>
      <% end %>
    <% end %>
    <hr class="my-6">
  <% end %>
</div>
