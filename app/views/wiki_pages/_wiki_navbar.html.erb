<div class="drawer sm:drawer-open w-min lg:mr-6">
  <input id="my-drawer" type="checkbox" class="sm:hidden drawer-toggle" />
  
  <div class="drawer-content fixed top-0 left-0 z-40 ml-4 mt-7">
    <div class="sm:hidden">
      <label id="drawer-label" for="my-drawer">
        <div></div>
        <div></div>
        <div></div>
      </label>
    </div>
  </div>

  <div class="drawer-side">
    <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
    
    <nav class="min-h-screen h-96 bg-base-100 shadow w-64 fixed top-0 -ml-4 2xl:-ml-8 overflow-y-auto flex flex-col justify-between">
      <div>
        <div class="h-18 <%= 'lg:h-16' if user_signed_in? %>"></div>
        
        <div class="p-4 border-b">
          <%= form_tag request.path, method: :get do %>
            <label class="input input-bordered flex items-center gap-2 w-full">
              <%= text_field_tag :search, params[:search], include_blank: true, onchange: 'this.form.submit()', class: 'grow border-none outline-none p-0 focus:ring-0 ml-2', placeholder: 'Rechercher...' %>
              <button type="submit" class="flex items-center cursor-pointer">
                <%= embedded_svg "icons/loupe.svg", class: "w-6 h-6 fill-current text-gray-700" %>
              </button>
            </label>
          <% end %>
        </div>

        <% WikiPage.catégories.each do |catégorie, id| %>
          <%= link_to wiki_path(catégorie: catégorie) do %>
            <div class="flex gap-2 items-center text-xl font-black mt-4 hover:bg-slate-100 py-3 pl-8 <%= 'bg-slate-50 hover:bg-base-300' if params[:catégorie] == catégorie %>">
              <%= catégorie.humanize %>
            </div>
          <% end %>
        <% end %>
      </div>

      <%= link_to 'Retour vers CoopComm', root_path, class: 'mb-8 mx-8 mt-12 text-primary hover:underline' %>
    </nav>
  </div>
</div>