<div class="flex w-full">
  <%= render "wiki_navbar" %>
  
  <div class="flex-1 sm:ml-64 p-6 lg:p-10 max-w-5xl max-w-none">

    <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100">

    <% if @wiki_page.document.attached? && @wiki_page.document.image? %>
      <div class="mb-8 overflow-hidden rounded-2xl border border-slate-200/80 shadow-sm max-h-[400px]">
         <% if @wiki_page.document.attached? && @wiki_page.document.image? %>
           <%= image_tag @wiki_page.document, class: "w-full h-56 object-contain group-hover:scale-105 transition-transform duration-300" %>
        <% else %>
          <%= embedded_svg "icons/images.svg", class: "w-8 h-8 text-slate-300 group-hover:scale-110 transition-transform duration-200", title: "Aucune image" %>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 pb-6 border-b border-slate-100">
      <div class="space-y-2">
        <h1 class="text-3xl font-black text-[#47b5db] tracking-tight">
          <%= page_title!(@wiki_page.titre) %>
        </h1>
        
        <% if @wiki_page.sous_titre.present? %>
          <p class="text-lg text-slate-600 font-normal leading-relaxed first-letter:capitalize">
            <%= @wiki_page.sous_titre %>
          </p>
        <% end %>
      </div>

      <% if current_user&.manager_or_admin? %>
        <div class="flex flex-wrap gap-1.5 shrink-0">
          <% if @wiki_page.publiée? %>
            <span class="badge badge-soft badge-sm badge-success gap-1 text-[11px] font-semibold shadow-xs border border-success/20">
                <%= embedded_svg "icons/visibility.svg", class: "w-3 h-3 fill-current" %>
                Publiée
              </span>
            <% else %>
              <span class="badge badge-soft badge-sm badge-primary gap-1 text-[11px] font-semibold shadow-xs border border-primary/20">
                <%= embedded_svg "icons/visibility_off.svg", class: "w-3 h-3 fill-current" %>
                Non publiée
              </span>
            <% end %>

            <% if @wiki_page.épinglée? %>
              <span class="badge badge-soft badge-sm badge-accent gap-1 text-[11px] font-semibold shadow-xs border border-accent/20">
                <%= embedded_svg "icons/pin.svg", class: "w-3 h-3 fill-current" %>
                Épinglée
              </span>
            <% end %>

            <% if @wiki_page.private? %>
              <span class="badge badge-soft badge-sm badge-secondary gap-1 text-[11px] font-semibold shadow-xs border border-secondary/20">
                <%= embedded_svg "icons/private.svg", class: "w-3 h-3 fill-current" %>
                Privée (managers et administrateurs)
              </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="py-6 text-slate-800 text-base leading-relaxed whitespace-pre-line text-justify">
      <%= @wiki_page.contenu %>
    </div>

    <% if @wiki_page.document.attached? && !@wiki_page.document.representable? %>
      <div class="my-6 p-4 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between">
        <span class="text-sm font-semibold text-slate-700">Document joint</span>
        <%= link_to "Télécharger le document", rails_blob_path(@wiki_page.document, disposition: "attachment"), class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>

    <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        <p>Publiée le <%= l(@wiki_page.created_at) %></p>
        <p class="mt-0.5">Modifiée il y a <%= time_ago_in_words @wiki_page.updated_at %></p>
      </div>

      <% if policy(@wiki_page).edit? %>
        <div class="flex items-center gap-2">
          <%= link_to edit_documentation_path(@wiki_page), class: "btn" do %>
            <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 fill-current" %>
            Modifier
          <% end %> 

          <% if policy(@wiki_page).destroy? %>
            <button type="button" 
                    onclick="document.getElementById('delete_page_modal_<%= @wiki_page.id %>').showModal()"
                    class="btn btn-ghost bg-red-50 text-red-600 hover:bg-red-100 border-none font-medium gap-2">
              <%= embedded_svg "icons/delete.svg", class: "w-4 h-4 fill-current", title: "Suppression" rescue nil %>
              Supprimer
            </button>

            <dialog id="delete_page_modal_<%= @wiki_page.id %>" class="modal">
              <div class="modal-box">
                <form method="dialog">
                  <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
                </form>
                <h3 class="text-lg font-bold text-error flex items-center gap-2">
                  <%= embedded_svg "icons/delete.svg", class: "w-6 h-6 fill-current text-error", title: "Supprimer" rescue nil %>
                  Supprimer la page
                </h3>
                <p class="py-4 text-sm text-slate-600 text-left">
                  Êtes-vous bien certain.e de vouloir supprimer définitivement cette page ? 
                  Cette action est irréversible.
                </p>
                <div class="modal-action">
                  <form method="dialog">
                    <button class="btn btn-ghost">Annuler</button>
                  </form>
                  <%= button_to documentation_path(@wiki_page),
                                method: :delete,
                                class: "btn btn-error text-white" do %>
                    Oui, supprimer
                  <% end %>
                </div>
              </div>
              <form method="dialog" class="modal-backdrop">
                <button>Fermer</button>
              </form>
            </dialog>

          <% else %>
            <div title="Suppression impossible : Vous n'êtes pas l'auteur de cette page wiki" class="btn btn-disabled btn-sm rounded-lg flex items-center gap-1">
              <%= embedded_svg "icons/delete.svg", class: "w-4 h-4 fill-current text-slate-400", title: "Suppression impossible" rescue nil %>
              Supprimer
            </div>
          <% end %>
        </div>
      <% end %>
      
    </div>
     <div class="mt-6">
      <%= link_to documentation_index_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
        <%= embedded_svg "icons/arrow_back.svg", class: "w-4 h-4 transition-transform group-hover:-translate-x-1 fill-current" rescue nil %>
        Retour à la liste des pages wiki
      <% end %>
    </div>
  </div>
</div>
</div>