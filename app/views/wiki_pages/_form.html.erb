<%= form_with(model: wiki_page,
              url: wiki_page.persisted? ? documentation_path(wiki_page) : documentation_index_path,
              class: "contents") do |form| %>
  <% if wiki_page.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3 mb-4">
      <h2 class="font-black!">
        <%= pluralize(wiki_page.errors.count, "erreur") %> empêche(nt) cette page wiki d'être sauvegardée :
      </h2>
      <ul class="list-disc list-inside">
        <% wiki_page.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="my-5">
    <%= form.label :catégorie %>
    <%= form.select :catégorie, options_for_select(WikiPage.catégories.keys, (@wiki_page.catégorie || params["catégorie"])), {}, class: 'select select-sm w-full' %>
  </div>
  <div class="my-5">
    <%= form.label :titre %>
    <%= form.text_field :titre, class: "input w-full", placeholder: "Titre", required: true %>
  </div>
  <div class="my-5">
    <%= form.label :sous_titre %>
    <%= form.text_field :sous_titre, class: "input w-full", placeholder: "Sous-titre", required: true %>
  </div>
  <div class="my-5">
    <%= form.rich_text_area :contenu, style: 'min-height: 50vh' %>
  </div>
  <div class="flex gap-4">
    <div class="hover:cursor-help" title="Visible uniquement par les managers et administrateurs si pas publiée ?">
      <%= form.label :publiée, "Publiée ?", class:'whitespace-nowrap' %>
      <br>
      <%= form.check_box :publiée, class: "checkbox checkbox-lg checkbox-primary" %>
    </div>
    <div class="hover:cursor-help" title="Visible sur l'index et affichée en premier ?">
      <%= form.label :épinglée, "Épinglée ?", class:'whitespace-nowrap' %>
      <br>
      <%= form.check_box :épinglée, class: "checkbox checkbox-lg checkbox-primary" %>
    </div>
    <div class="hover:cursor-help" title="Non visible par les agents et les personnes non connectées ?">
      <%= form.label :private, "Privé ?", class:'whitespace-nowrap hover:cursor-help' %>
      <br>
      <%= form.check_box :private, class: "checkbox checkbox-lg checkbox-primary" %>
    </div>
    <div>
      <%= form.label :poids %>
      <%= form.number_field :poids, class: "input input-bordered w-full focus:input-primary" %>
    </div>
  </div>
  <div class="my-5">
      <%= render "shared/file_dropzone",
                 form: form,
                 attribute: :document,
                 placeholder: "Glissez un document (PDF, Word, Excel, photo) ici ou cliquez pour parcourir" %>
    </div>
  <div class="inline">
    <%= form.submit "Enregistrer", class: "btn btn-primary" %>
  </div>
<% end %>
