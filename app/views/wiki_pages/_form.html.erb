<%= form_with(model: wiki_page, class: "contents") do |form| %>
  <% if wiki_page.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3 mb-4">
      <h2 class="!font-black">
        <%= pluralize(wiki_page.errors.count, "erreur") %> empêche(nt) cette page wiki d'être sauvegardée :
      </h2>

      <ul class="list-disc list-inside">
        <% wiki_page.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.text_field :titre, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full bg-orange-50", placeholder: "Titre", required: true %>
  </div>

  <div class="my-5">
    <%= form.rich_text_area :contenu, style: 'min-height: 50vh' %>
  </div>

  <div class="flex gap-4 my-5">

    <div class="my-5">
      <%= form.label :catégorie %>
      <%= form.select :catégorie, options_for_select(WikiPage.catégories.keys, @wiki_page.catégorie), {}, class: 'select select-bordered select-sm w-full' %>
    </div>

    <div class="my-5">
      <%= form.label :publiée, "Publiée ?", class:'whitespace-nowrap' %>
      <br>
      <%= form.check_box :publiée, class: "checkbox checkbox-lg checkbox-primary" %>
    </div>

    <div class="my-5">
      <%= form.label :épinglée, "Épinglée ?", class:'whitespace-nowrap' %>
      <br>
      <%= form.check_box :épinglée, class: "checkbox checkbox-lg checkbox-primary" %>
    </div>

    <div class="my-5">
      <%= form.label :poids %>
      <%= form.number_field :poids, class: "input input-bordered input-sm w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :document %>
      <%= form.file_field :document, class: "w-full max-w-md" %>
    </div>
  </div>

  <div class="inline">
    <%= form.submit "Enregistrer", class: "btn btn-primary btn-outline hover:!text-white" %>
  </div>
<% end %>
