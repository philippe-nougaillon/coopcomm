<div class="card bg-base-100 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-200 flex flex-col h-full overflow-hidden group">
  
  <div class=" w-full h-36 bg-slate-100 border-b border-slate-100 flex items-center justify-center shrink-0 overflow-hidden">
    <%= link_to documentation_path(wiki_page) do %>
      <% if wiki_page.document.image? %>
        <%= image_tag wiki_page.document, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" %>
      <% else %>
        <%= embedded_svg "icons/images.svg", class: "w-8 h-8 text-slate-300 group-hover:scale-110 transition-transform duration-200", title: "Aucune image" %>
      <% end %>
    <% end %>
  </div>

  <div class="card-body p-5 flex flex-col flex-1">
     <% if current_user&.manager_or_admin? %>
      <div class=" top-2.5 left-2.5 right-2.5 flex flex-wrap gap-1.5 pointer-events-none ">
         <% if wiki_page.private? %>
          <span class="badge badge-soft badge-sm badge-secondary gap-1 text-[11px] font-semibold shadow-xs border border-secondary/20">
            <%= embedded_svg "icons/private.svg", class: "w-3 h-3 fill-current" %>
            Privée (managers et administrateurs)
          </span>
        <% end %>
        
        <% if wiki_page.publiée? %>
          <span class="badge badge-soft badge-sm badge-success gap-1 text-[11px] font-semibold shadow-xs border border-success/20">
            <%= embedded_svg "icons/visibility.svg", class: "w-3 h-3 fill-current" %>
            Publiée
          </span>
        <% else %>
          <span class="badge badge-soft badge-sm badge-primary gap-1 text-[11px] font-semibold shadow-xs border border-primary/20">
            <%= embedded_svg "icons/visibility_off.svg", class: "w-3 h-3 fill-current" %>
            Non publiée
          </span>
        <% end %>

        <% if wiki_page.épinglée? %>
          <span class="badge badge-soft badge-sm badge-accent gap-1 text-[11px] font-semibold shadow-xs border border-accent/20">
            <%= embedded_svg "icons/pin.svg", class: "w-3 h-3 fill-current" %>
            Épinglée
          </span>
        <% end %>

       
      </div>
    <% end %>
    
    <h3 class="card-title text-xl font-extrabold  line-clamp-1 group-hover:text-primary transition-colors">
     <%= link_to documentation_path(wiki_page), class: "group-hover:underline " do %>
        <%= wiki_page.titre %>
     <% end %>
    </h3>
    
    <p class="text-sm text-slate-600 line-clamp-2 leading-relaxed mt-1">
      <%= wiki_page.sous_titre.presence %>
    </p>

    <div class="card-actions justify-end mt-auto pt-4 border-t border-slate-100">
      <%= link_to documentation_path(wiki_page), class: "btn btn-outline btn-primary btn-sm rounded-lg" do %>
        En savoir plus
      <% end %>
    </div>
  </div>

</div>