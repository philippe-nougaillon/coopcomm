<%
  category_styles = {
    "blog"  => { text: "text-[#4fb0da]", bg: "bg-[#4fb0da]", hover_text: "group-hover:text-[#4fb0da]" },
    "guide" => { text: "text-[#763ba7]", bg: "bg-[#763ba7]", hover_text: "group-hover:text-[#763ba7]" },
    "faq"   => { text: "text-[#D92666]", bg: "bg-[#D92666]", hover_text: "group-hover:text-[#D92666]" }
  }


  cat_key     = wiki_page.catégorie.to_s.downcase
  styles      = category_styles.fetch(cat_key, { text: "text-[#40b3db]", bg: "bg-[#40b3db]", hover_text: "group-hover:text-[#40b3db]" })
  accent_text = styles[:text]
  accent_bg   = styles[:bg]
  hover_text  = styles[:hover_text]
%>

<%= link_to documentation_path(wiki_page), class: "group relative card flex flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden h-[380px] hover:shadow-md hover:-translate-y-0.5 transition-all duration-200" do %>

  <% if wiki_page.photo.attached? && wiki_page.photo.representable? %>

    <div class="relative h-40 w-full overflow-hidden bg-slate-100 shrink-0">
      <%= image_tag wiki_page.photo, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" %>
      <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-black/60 to-transparent flex items-end p-3"></div>
    </div>

    <% if current_user&.manager_or_admin? %>
      <div class="flex flex-wrap gap-1.5 mt-4 ml-2 mr-2">
        <% if wiki_page.private? %>
          <span class="badge badge-soft badge-sm badge-secondary gap-1 text-[11px] font-semibold shadow-xs border border-secondary/20 p-2">
            <%= embedded_svg "icons/private.svg", class: "w-3 h-3 fill-current" %>
            Privée (managers et administrateurs)
          </span>
        <% end %>

        <% if wiki_page.publiée? %>
          <span class="badge badge-soft badge-sm badge-success gap-1 text-[11px] font-semibold shadow-xs border border-success/20">
            <%= embedded_svg "icons/visibility.svg", class: "w-3 h-3 fill-current" %>
            Publiée
          </span>
        <% else %>
          <span class="badge badge-soft badge-sm badge-primary gap-1 text-[11px] font-semibold shadow-xs border border-primary/20">
            <%= embedded_svg "icons/visibility_off.svg", class: "w-3 h-3 fill-current" %>
            Non publiée
          </span>
        <% end %>

        <% if wiki_page.épinglée? %>
          <span class="badge badge-soft badge-sm badge-accent gap-1 text-[11px] font-semibold shadow-xs border border-accent/20">
            <%= embedded_svg "icons/pin.svg", class: "w-3 h-3 fill-current" %>
            Épinglée
          </span>
        <% end %>
      </div>
    <% end %>

    <div class="card-body flex flex-col flex-1 h-full p-5 overflow-hidden">
      <h3 class="font-extrabold text-lg text-slate-900 leading-snug line-clamp-2 hover:underline <%= hover_text %> transition-colors">
        <%= wiki_page.titre.sub(/[a-zA-ZÀ-ÿ]/) { |c| c.upcase } %>
      </h3>

      <p class="my-2 text-sm text-slate-600 leading-relaxed line-clamp-2">
        <%= wiki_page.sous_titre.presence.upcase_first %>
      </p>

      <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
        <span>Modifié il y a <%= time_ago_in_words wiki_page.updated_at %></span>
        <span class="inline-flex items-center gap-1 font-semibold <%= accent_text %> group-hover:translate-x-1 transition-transform">
          En savoir plus 
          <%= embedded_svg "icons/arrow_forward.svg", class: "w-4 h-4 transition-transform group-hover:translate-x-1 fill-current hidden md:block" %>
        </span>
      </div>
    </div>

  <% else %>

    <span class="absolute left-0 top-0 bottom-0 w-1 <%= accent_bg %>"></span>

    <div class="flex flex-col flex-1 h-full p-5 overflow-hidden">

      <h3 class="font-extrabold text-xl text-slate-900 mt-4  hover:underline <%= hover_text %> transition-colors">
        <%= wiki_page.titre.sub(/\A\s*-\s*/, '').upcase_first %>
      </h3>

      <% if current_user&.manager_or_admin? %>
        <div class="flex flex-wrap gap-1.5 mb-4 mt-2">
          <% if wiki_page.private? %>
            <span class="badge badge-soft badge-sm badge-secondary gap-1 text-[11px] font-semibold shadow-xs border border-secondary/20 p-2">
              <%= embedded_svg "icons/private.svg", class: "w-3 h-3 fill-current" %>
              Privée (managers et administrateurs)
            </span>
          <% end %>

          <% if wiki_page.publiée? %>
            <span class="badge badge-soft badge-sm badge-success gap-1 text-[11px] font-semibold shadow-xs border border-success/20">
              <%= embedded_svg "icons/visibility.svg", class: "w-3 h-3 fill-current" %>
              Publiée
            </span>
          <% else %>
            <span class="badge badge-soft badge-sm badge-primary gap-1 text-[11px] font-semibold shadow-xs border border-primary/20">
              <%= embedded_svg "icons/visibility_off.svg", class: "w-3 h-3 fill-current" %>
              Non publiée
            </span>
          <% end %>

          <% if wiki_page.épinglée? %>
            <span class="badge badge-soft badge-sm badge-accent gap-1 text-[11px] font-semibold shadow-xs border border-accent/20">
              <%= embedded_svg "icons/pin.svg", class: "w-3 h-3 fill-current" %>
              Épinglée
            </span>
          <% end %>
        </div>
      <% end %>

      <% if wiki_page.sous_titre.present? %>
        <p class="my-2 text-base font-semibold text-slate-800 leading-snug line-clamp-3">
          <%= wiki_page.sous_titre.strip.upcase_first %>
        </p>
      <% end %>

        <%
          plain_text = wiki_page.rich_text_content&.to_plain_text&.sub(/\A\s*-\s*/, '')&.strip.to_s
          display_text = if plain_text.match?(/\A\[.+\]\z/)
            "Pièce jointe"
          else
            plain_text.upcase_first
          end
        %>
        <p class="my-2 text-base text-slate-500 leading-relaxed line-clamp-2">
          <%= display_text %>
        </p>
      <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
        <span>Modifié il y a <%= time_ago_in_words wiki_page.updated_at %></span>
        <span class="inline-flex items-center gap-1 text-slate-400 font-semibold <%= hover_text %> group-hover:translate-x-1 transition-transform">
          En savoir plus 
          <%= embedded_svg "icons/arrow_forward.svg", class: "w-4 h-4 transition-transform group-hover:translate-x-1 fill-current hidden md:block" %>
        </span>
      </div>

    </div>

  <% end %>

<% end %>