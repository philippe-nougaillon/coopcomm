<%= form_tag documentation_index_path, method: :get, class: "w-full mb-8 pl-10 md:pl-0" do %>
  <label class="input input-bordered flex items-center gap-2 w-full md:w-1/3">
    <button type="submit" class="flex items-center cursor-pointer">
      <%= embedded_svg "icons/loupe.svg", class: "w-6 h-6 fill-current text-gray-700" %>
    </button>
    <%= text_field_tag :search, params[:search], onchange: 'this.form.submit()', class: 'grow border-none outline-none p-0 focus:ring-0 ml-2', placeholder: 'Rechercher...' %>
  </label>
<% end %>
