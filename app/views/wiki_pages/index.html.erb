<div class="flex w-full">
  <%= render "wiki_navbar" %>
  <div class="w-full sm:ml-64">
    <%= render "barre_recherche" %>

    <div class="flex flex-row justify-between items-center mb-4">
      <h1 class="text-2xl sm:text-4xl text-primary font-bold">
        Bienvenue sur la documentation de CoopComm !
      </h1>
         <%= render "bouton_ajouter" %>
    </div>

    <p class="mb-6 max-w-4xl text-slate-600 text-justify">
      Le <strong>Blog</strong> rassemble les actualités et les nouveautés de CoopComm.
      Les <strong>Guides</strong> expliquent pas à pas comment utiliser l'application au quotidien.
      La <strong>FAQ</strong> répond aux questions les plus fréquentes.
    </p>

    <% WikiPage.catégories.keys.each do |categorie| %>
      <section>
        <div class="mt-6">
          <%
            categorie_path = case categorie
                              when "blog"  then blog_documentation_index_path
                              when "guide" then guide_documentation_index_path
                              when "faq"   then faq_documentation_index_path
                              end
          %>
          
          <%= link_to categorie_path, class: "inline-flex items-center gap-1.5 group mb-2" do %>
            <h3 class="text-2xl text-primary font-bold transition group-hover:underline">
              <%= categorie.humanize %>
            </h3>
          <% end %>

          <% if @wiki_pages.by_categorie(categorie).any? %>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <%= render partial: "carte", collection: @wiki_pages.by_categorie(categorie).first(3), as: :wiki_page %>
            </div>
          <% else %>
            <div class="border border-slate-200 rounded-xl shadow-sm bg-white p-6 sm:p-8">
              <div class="flex flex-col items-center justify-center text-center p-6 border-2 border-dashed border-slate-300 rounded-2xl bg-slate-50/50 max-w-2xl mx-auto my-2 transition-all">
                <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                   <% svg = case categorie
                              when "guide" then "book.svg"
                              when "faq"   then "help.svg"
                              else "article.svg"
                              end 
                    %>
                        <%= embedded_svg "icons/#{svg}", class: "w-6 h-6 text-primary opacity-70" %>
                        </div>
                <% titre, description = case categorie
                                          when "guide"
                                            ["Aucun guide pour le moment",
                                             "Les guides expliquent pas à pas comment utiliser l'application — parfait pour un premier pas-à-pas sur le CRM ou une interventio"]
                                          when "faq"
                                            ["Aucune question pour le moment",
                                             "Revenez bientôt : les réponses aux questions les plus fréquentes seront rassemblées ici."]
                                          else
                                            ["Aucun article pour le moment",
                                             "Les actualités et nouveautés de CoopComm apparaîtront ici."]
                                          end %>

                <h4 class="text-base sm:text-lg font-bold text-slate-800">
                  <%= titre %>
                </h4>
                <p class="text-xs sm:text-sm text-slate-500 max-w-sm mt-1 leading-relaxed mb-4">
                  <%= description %>
                </p>

                <% if current_user&.manager_or_admin? %>
                  <%= link_to new_documentation_path(catégorie: categorie), class: "btn btn-outline btn-primary" do %>
                    <%= embedded_svg "icons/add.svg", class: "w-5 h-5 fill-current", title: "" rescue nil %>
                    <span>Créer <%= categorie == "guide" ? "le premier guide" : categorie == "faq" ? "la première question" : "le premier article" %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>