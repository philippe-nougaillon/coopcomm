<div class="flex w-full">
  <%= render "wiki_navbar" %>
  <div class="w-full ml-8 sm:ml-64">
    <%= render "barre_recherche" %>

    <div class="flex flex-row justify-between items-center mb-4">
      <h1 class="text-2xl sm:text-4xl text-primary font-bold">
        Bienvenue sur la documentation de CoopComm !
      </h1>
      <%= render "bouton_ajouter" %>
    </div>

    <p class="mb-6 max-w-4xl text-slate-600 text-justify">
      CoopComm est un outil <strong>très complet</strong>. C'est pour cela que l'on vous propose une documentation détaillée des différentes interactions possibles.
      <br>
      <br>
      Le <strong>Blog</strong> rassemble les actualités et les nouveautés de CoopComm.
      Les <strong>Guides</strong> expliquent pas à pas comment utiliser l'application au quotidien.
      La <strong>FAQ</strong> répond aux questions les plus fréquentes.
    </p>

      <% WikiPage.catégories.keys.each do |categorie| %>
        <section>
          <div class="mt-6">
            <h3 class="text-2xl font-semibold mb-2"><%= categorie.humanize %></h3>
            <% if @wiki_pages.by_categorie(categorie).any? %>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <%= render partial: "carte", collection: @wiki_pages.by_categorie(categorie).first(3), as: :wiki_page %>
              </div>
            <% else %>
              <p>Aucune page de cette catégorie n'a été créée pour le moment.</p>
            <% end %>
          </div>
        </section>
      <% end %>
  </div>
</div>
