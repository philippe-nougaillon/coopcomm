<div class="mx-auto w-full max-w-3xl">
  <h1 class="text-primary font-bold text-2xl md:text-4xl text-center my-8">
    <%= page_title!('Copier vers une autre instance') %>
  </h1>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-100/50 p-6 md:p-8">
    <p class="text-xl text-slate-600"><%= @wiki_page.titre %></p>

    <% if @instances.empty? %>
      <p class="my-5 text-slate-600">Aucune autre instance n'est configurée (variable INSTANCES_COOPCOMM).</p>
    <% else %>
      <%= form_with url: copie_documentation_path(@wiki_page), method: :get, class: "my-5" do |form| %>
        <%= form.label :instance, "Instance", class: "label font-semibold text-slate-700" %>
        <%= form.select :instance, options_for_select(@instances.pluck(:nom), params[:instance]),
                        { include_blank: "Choisir une instance" },
                        class: "select select-sm w-full", onchange: "this.form.requestSubmit()" %>
      <% end %>

      <% if @auteurs&.empty? %>
        <p class="my-5 text-slate-600">
          Aucun compte de <%= @instance[:nom] %> n'est à la fois super_admin et manager ou administrateur.
        </p>
      <% elsif @auteurs %>
        <%= form_with url: copier_documentation_path(@wiki_page), data: { turbo: false } do |form| %>
          <%= form.hidden_field :instance, value: @instance[:nom] %>

          <div class="my-5">
            <%= form.label :auteur, "Auteur sur #{@instance[:nom]}", class: "label font-semibold text-slate-700" %>
            <%= form.select :auteur, options_for_select(@auteurs.map { |auteur| [auteur['libellé'], auteur['email']] }),
                            { include_blank: "Choisir un auteur" }, class: "select select-sm w-full", required: true %>
          </div>

          <label class="flex items-center gap-2 my-5">
            <%= form.check_box :publiée, class: "checkbox checkbox-lg checkbox-primary" %>
            <span class="text-sm text-slate-500">Publier directement</span>
          </label>

          <%= form.submit "Copier", class: "btn btn-primary text-white font-bold w-full" %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="pt-8">
    <%= link_to documentation_path(@wiki_page), class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "w-4 h-4 transition-transform group-hover:-translate-x-1 fill-current" %>
      Retour à la page
    <% end %>
  </div>
</div>
