<tr class="hover:bg-base-200/60 transition-colors duration-150 border-b border-slate-100 align-middle">
  <td class="px-4 py-3 text-lg font-semibold text-primary">
    <%= link_to convention.user.nom_prénom, convention, class: "hover:underline" %>
  </td>
  <td class="px-4 py-3 text-base"><%= convention.service&.nom %></td>
  <td class="px-4 py-3 text-nowrap">
    <% prog = convention_progress(convention) %>
    <% if prog %>
      <div class="mb-1 invisible" aria-hidden="true">
        <progress class="progress w-32"></progress>
      </div>
    <% end %>
    <%= l(convention.date_début, format: :long) if convention.date_début %>
    <span class="text-slate-400">→</span>
    <%= convention.date_fin_prévue ? l(convention.date_fin_prévue) : "Non renseignée" %>
    <div class="mt-1" title="<%= "Du #{l(convention.date_début, format: :long)}#{" au #{l(convention.date_fin_prévue, format: :long)}"}" %>">
      <div class="relative w-60 flex items-center h-6">
        <progress class="progress <%= prog[:color] %> w-full h-4" value="<%= prog[:percent] %>" max="100"></progress>
        <div class="absolute top-0 bottom-0 w-1 <%= prog[:indicateur_color] %> rounded dashed tooltip tooltip-secondary  z-10" 
             style="left: <%= prog[:indicateur] %>%;" 
             data-tip="<%= prog[:indicateur_label] %> ">
        </div>
      </div>
    </div>
 </td>
  <td class="px-4 py-3 text-nowrap text-sm">
    <%= convention.temps_total_interventions.round(1) %> h / <%= convention.heures_conventionnees %> h (<%= prog[:indicateur] %>%)
  </td>
  <td class="px-4 py-3 text-base">
    <% if convention.document.attached? %>
      <%= link_to rails_blob_path(convention.document, disposition: "inline"), target: "_blank", title: convention.document.filename.to_s, class: "inline-block" do %>
        <% if convention.document.representable? %>
          <%= image_tag convention.document.representation(resize_to_limit: [80, 100]), alt: convention.document.filename.to_s, class: "h-20 w-auto rounded border border-base-300 hover:opacity-80 transition" %>
        <% else %>
          <span class="flex flex-col items-center gap-1 text-primary hover:underline">
            <span class="material-symbols-outlined text-4xl">description</span>
            <span class="text-base max-w-32 truncate"><%= convention.document.filename %></span>
          </span>
        <% end %>
      <% end %>
    <% else %>
      <span class="text-slate-400 text-sm">Aucun document</span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-base">
    <% if convention.mémo.present? %>
      <span class="block max-w-48 truncate text-sm text-slate-500 cursor-help" title="<%= convention.mémo %>"><%= convention.mémo %></span>
    <% else %>
      <span class="text-slate-400 flex justify-center">—</span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-base">
    <div class="flex items-center justify-center">
      <% if convention.document.attached? %>
        <%= link_to rails_blob_path(convention.document, disposition: "attachment"), class: "btn btn-ghost", title: "Télécharger le document" do %>
          <%= embedded_svg "icons/download.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          Télécharger
        <% end %>
      <% end %>
    </div>
  </td>
</tr>