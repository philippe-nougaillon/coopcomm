<tr class="hover:bg-base-200/60 transition-colors duration-150 border-b border-slate-100 align-middle">
  <td class="px-4 py-3 text-lg font-semibold text-primary">
    <%= link_to convention.user.nom_prénom, convention, class: "hover:underline" %>
  </td>
  <td class="px-4 py-3 text-base">
    <% services = convention.respond_to?(:services) ? convention.services.pluck(:nom) : [convention.service&.nom].compact %>
    <% shown = services.first(2) %>
    <% extra = services.size - shown.size %>
    <div class="flex flex-wrap gap-1.5 items-center">
      <% shown.each do |s| %>
        <span class="inline-block bg-white border border-slate-200 text-slate-600 text-sm px-2.5 py-1 rounded-full whitespace-nowrap shadow-sm">
          <%= s %>
        </span>
      <% end %>
      <% if extra > 0 %>
        <div class="relative inline-block" data-controller="dropdown">
          <button type="button"
                  data-action="click->dropdown#togglePortal"
            class="inline-flex bg-white border border-slate-200 text-slate-600 text-sm px-2.5 py-1 rounded-full shadow-sm select-none cursor-pointer hover:bg-slate-50">
            + <%= extra %>
          </button>
          <div data-dropdown-target="menu"
               class="hidden absolute z-50 flex-col p-4 shadow-2xl bg-white border border-slate-200 rounded-xl w-58 max-h-60 overflow-y-auto mt-1 left-0">
            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 px-1 block text-left">
              Autres services (<%= extra %>)
            </span>
            <div class="flex flex-col gap-1">
              <% services.drop(2).each do |extra_service| %>
                <span class="text-sm text-slate-600 bg-white border border-slate-200 px-2.5 py-1 rounded-lg whitespace-normal break-words text-left">
                  <%= extra_service %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <% if services.empty? %>
        <span class="text-slate-400 italic text-sm">—</span>
      <% end %>
    </div>
  </td>
  <td class="px-4 py-3 text-nowrap">
    <% prog = convention_progress(convention) %>
    <% if prog %>
      <div class="mb-1 invisible" aria-hidden="true">
        <progress class="progress w-32"></progress>
      </div>
    <% end %>
    <%= l(convention.date_début, format: :long) if convention.date_début %>
    <span class="text-slate-400">→</span>
    <%= convention.date_fin_prévue ? l(convention.date_fin_prévue, format: :long) : "Non renseignée" %>
    <div class="mt-1" title="<%= "Du #{l(convention.date_début, format: :long)}#{" au #{l(convention.date_fin_prévue, format: :long)}"}" %>">
      <div class="relative w-60 flex items-center h-6">
        <progress class="progress <%= prog[:color] %> w-full h-4" value="<%= prog[:percent] %>" max="100"></progress>
        <div class="absolute top-0 bottom-0 w-1 <%= prog[:indicateur_color] %> rounded dashed tooltip tooltip-secondary z-10" 
             style="left: <%= prog[:indicateur] %>%;" 
             data-tip="<%= prog[:indicateur_label] %> ">
        </div>
      </div>
    </div>
  </td>
  <td class="px-4 py-3 text-nowrap text-sm">
  <% depasse = convention.heures_consommees > convention.heures_conventionnees %>
  <span class="<%= depasse ? 'text-error font-semibold' : 'text-slate-700' %>">
    <%= convention.heures_consommees.round(1) %> h
  </span>
  / <%= convention.heures_conventionnees %> h
  <span class="<%= depasse ? 'text-error font-semibold' : '' %>">
    (<%= depasse ? ((convention.heures_consommees / convention.heures_conventionnees) * 100).round : prog[:indicateur] %>%)
  </span>
</td>
  <td class="px-4 py-3 text-base text-center">
    <% if convention.document.attached? %>
      <%= link_to rails_blob_path(convention.document, disposition: "inline"), target: "_blank", title: convention.document.filename.to_s, class: "inline-block" do %>
        <% if convention.document.representable? %>
          <%= image_tag convention.document.representation(resize_to_limit: [80, 100]), alt: convention.document.filename.to_s, class: "h-20 w-auto rounded border border-base-300 hover:opacity-80 transition" %>
        <% else %>
          <span class="flex flex-col items-center gap-1 text-primary hover:underline">
            <span class="material-symbols-outlined text-4xl">description</span>
            <span class="text-base max-w-32 truncate"><%= convention.document.filename %></span>
          </span>
        <% end %>
      <% end %>
    <% else %>
      <span class="text-slate-400 text-sm">Aucun document</span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-base">
    <% if convention.mémo.present? %>
      <span class="block max-w-48 truncate text-sm text-slate-500 cursor-help" title="<%= convention.mémo %>"><%= convention.mémo %></span>
    <% else %>
      <span class="text-slate-400 flex justify-center">—</span>
    <% end %>
  </td>
</tr>