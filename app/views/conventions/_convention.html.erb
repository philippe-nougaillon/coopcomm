<tr class="hover:bg-base-300">
  <td class="font-medium">
    <%= link_to convention.user.nom_prénom, user_path(convention.user), class: "link" if convention.user %>
  </td>
  <td><%= convention.service&.nom %></td>
  <td class="text-nowrap"><%= l(convention.date_début, format: :long) if convention.date_début %></td>
  <td class="text-nowrap">
    <%= convention.date_fin_prévue ? l(convention.date_fin_prévue, format: :long) : "—" %>
  </td>
  <td>
    <% if convention.document.attached? %>
      <%= link_to rails_blob_path(convention.document, disposition: "inline"),
            target: "_blank", title: convention.document.filename.to_s,
            class: "inline-block" do %>
        <% if convention.document.representable? %>
          <%= image_tag convention.document.representation(resize_to_limit: [80, 100]),
                alt: convention.document.filename.to_s,
                class: "h-20 w-auto rounded border border-base-300 hover:opacity-80 transition" %>
        <% else %>
          <span class="flex flex-col items-center gap-1 text-primary hover:underline">
            <span class="material-symbols-outlined text-4xl">description</span>
            <span class="text-xs max-w-32 truncate"><%= convention.document.filename %></span>
          </span>
        <% end %>
      <% end %>
    <% else %>
      <span class="text-slate-400 text-sm">Aucun document</span>
    <% end %>
  </td>
  <td>
    <div class="flex gap-2 items-center justify-end">
      <% if convention.document.attached? %>
        <%= link_to rails_blob_path(convention.document, disposition: "attachment"),
              class: "btn btn-sm btn-ghost", title: "Télécharger le document" do %>
          <span class="material-symbols-outlined">download</span>
        <% end %>
      <% end %>
      <% if policy(convention).update? %>
        <%= link_to "Modifier", edit_convention_path(convention), class: "btn btn-sm btn-primary" %>
      <% end %>
      <% if policy(convention).destroy? %>
        <%= button_to convention_path(convention), method: :delete, class: "btn btn-sm",
              form: { data: { turbo_confirm: "Supprimer cette convention ?" } } do %>
          <span class="material-symbols-outlined">delete</span>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
