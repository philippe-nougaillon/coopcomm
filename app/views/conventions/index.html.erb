<div class="w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!("Conventions") %></h1>
    <% if policy(Convention).new? %>
      <%= link_to "Ajouter une convention", new_convention_path, class: "btn btn-primary btn-outline btn-lg rounded hover:text-white!" %>
    <% end %>
  </div>

  <%= form_tag conventions_path, method: :get do %>
    <div class="flex flex-wrap items-end gap-4 mt-6">
      <div class="w-full md:w-64">
        <%= label_tag :search, "Rechercher" %>
        <%= text_field_tag :search, params[:search], class: "input input-sm input-bordered w-full",
              placeholder: "Nom du document", onchange: "this.form.submit()" %>
      </div>

      <div class="w-full md:w-64">
        <%= label_tag :adherent_id, "Adhérent" %>
        <%= select_tag :adherent_id,
              options_from_collection_for_select(@adherents, :id, :nom_prénom, params[:adherent_id]),
              include_blank: "Tous", class: "slim-select w-full", onchange: "this.form.submit()" %>
      </div>

      <div class="w-full md:w-64">
        <%= label_tag :service_id, "Service" %>
        <%= select_tag :service_id,
              options_from_collection_for_select(@services, :id, :nom, params[:service_id]),
              include_blank: "Tous", class: "slim-select w-full", onchange: "this.form.submit()" %>
      </div>

      <div class="w-full md:w-fit">
        <%= label_tag :active_on, "Active au" %>
        <%= date_field_tag :active_on, params[:active_on], class: "input input-sm input-bordered w-full",
              onchange: "this.form.submit()" %>
      </div>
    </div>
  <% end %>

  <div class="divider"></div>

  <div class="overflow-x-auto">
    <table class="table table-sm">
      <thead class="bg-slate-100">
        <tr>
          <th>Adhérent</th>
          <th>Service</th>
          <th>Période</th>
          <th>Document</th>
          <th>Mémo</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "convention", collection: @conventions %>
      </tbody>
    </table>
  </div>

  <% if @conventions.empty? %>
    <p class="text-slate-400 mt-4">Aucune convention.</p>
  <% end %>

  <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
  <% if @pagy.pages > 1 %>
    <div class="hidden sm:block sm:flex-1"></div>
    
    <div class="w-full sm:w-auto sm:flex-1 order-1 sm:order-2 flex justify-center">
      <%= pagy_nav(@pagy).html_safe %>
    </div>
    
    <div class="text-base font-semibold text-slate-500 text-center sm:text-right w-full sm:flex-1 order-2 sm:order-3">
      <%= pagy_info(@pagy).html_safe %>
    </div>
  <% else %>
    <div >
    </div>
  <% end %>
</div>
</div>
