<%= form_with model: [user, convention], id: dom_id(convention, :form), html: { multipart: true } do |f| %>

  <% if convention.errors.any? %>
    <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3 mb-4">
      <h2 class="font-black!">
        <%= pluralize(convention.errors.count, "erreur") %> empêche(nt) l'enregistrement de la convention :
      </h2>
      <ul class="list-disc list-inside">
        <% convention.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-4">
    <%# Service : choisi à la création, figé en modification (clé d'unicité) %>
    <div class="flex flex-col gap-1">
      <%= f.label :service_id, "Service", class: "text-sm text-slate-500" %>
      <% if convention.persisted? %>
        <input type="text" value="<%= convention.service.nom %>" class="input input-sm input-bordered w-full" disabled>
      <% else %>
        <%= f.collection_select :service_id, available_services, :id, :nom,
              { prompt: "Choisir un service" },
              { class: "select select-sm select-bordered w-full", required: true } %>
      <% end %>
    </div>

    <%# Dates %>
    <div class="flex flex-wrap gap-4">
      <div class="flex-1 flex flex-col">
        <%= f.label :date_début, "Date de début", class: "text-sm text-slate-500 mb-1" %>
        <%= f.date_field :date_début, class: "input input-sm input-bordered w-full", required: true %>
      </div>
      <div class="flex-1 flex flex-col">
        <%= f.label :date_fin_prévue, "Date de fin prévue", class: "text-sm text-slate-500 mb-1" %>
        <%= f.date_field :date_fin_prévue, class: "input input-sm input-bordered w-full" %>
      </div>
    </div>

    <%# Document %>
    <div class="flex flex-col gap-1">
      <%= f.label :document, "Document", class: "text-sm text-slate-500" %>
      <% if convention.document.attached? %>
        <p class="text-sm mb-1 break-all">
          Document actuel :
          <%= link_to convention.document.filename, rails_blob_path(convention.document, disposition: "inline"),
                target: "_blank", class: "link link-primary" %>
        </p>
      <% end %>
      <%= f.file_field :document, class: "file-input file-input-sm file-input-bordered w-full", accept: '.pdf' %>
      <% if convention.document.attached? %>
        <span class="text-xs text-slate-400">Déposer un nouveau fichier remplacera le document actuel.</span>
      <% end %>
    </div>
  </div>

  <div class="modal-action">
    <%= f.submit "Enregistrer", class: "btn btn-primary" %>
  </div>
<% end %>
