<div class="max-w-3xl mx-auto bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-100/50 p-6 md:p-8">
  <%= form_with model: @convention, html: { multipart: true, class: 'flex flex-col gap-2' } do |f| %>
    <% if @convention.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-500 px-4 py-3 font-medium rounded-lg mb-2 border border-red-200">
        <h2 class="font-black mb-2 text-sm md:text-base">
          <%= pluralize(@convention.errors.count, "erreur") %> empêche(nt) l'enregistrement de la convention :
        </h2>
        <ul class="list-disc list-inside text-xs opacity-90">
          <% @convention.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4"
         data-controller="dynamic-select"
         data-dynamic-select-url-value="<%= services_for_adherent_conventions_path %>">
      <%# Adhérent : figé en modification %>
      <div class="form-control w-full">
        <%= f.label :user_id, "Adhérent", class: "label font-semibold text-slate-700" do %>
          Adhérent <span class="text-red-500">*</span>
        <% end %>
        <% if @convention.persisted? %>
          <input type="text" value="<%= @convention.user&.nom_prénom %>" class="input input-bordered w-full focus:input-primary" disabled>
          <%= f.hidden_field :user_id %>
        <% else %>
          <%= f.collection_select :user_id, @adherents, :id, :nom_prénom,
                { prompt: "Choisir un adhérent" },
                { class: "slim-select w-full h-10", required: true,
                  data: { dynamic_select_target: "adherent", action: "change->dynamic-select#updateServices" } } %>
        <% end %>
      </div>
      <%# Service : figé en modification (clé d'unicité) ; sinon dépend de l'adhérent choisi %>
      <div class="form-control w-full">
        <%= f.label :service_id, "Service", class: "label font-semibold text-slate-700" do %>
          Service <span class="text-red-500">*</span>
        <% end %>
        <% if @convention.persisted? %>
          <input type="text" value="<%= @convention.service&.nom %>" class="input input-bordered w-full focus:input-primary" disabled>
          <%= f.hidden_field :service_id %>
        <% else %>
          <%= f.collection_select :service_id, @available_services, :id, :nom,
                { prompt: "Choisir un service" },
                { class: "slim-select w-full h-10", required: true,
                  data: { dynamic_select_target: "service" } } %>
        <% end %>
      </div>
      <div class="form-control w-full">
        <%= f.label :date_début, class: "label font-semibold text-slate-700" do %>
          Date de début <span class="text-red-500">*</span>
        <% end %>
        <div class="flex items-center gap-2 bg-slate-50 h-10 rounded-lg border border-slate-200">
          <%= f.date_field :date_début, class: "flex-1 bg-transparent border-none outline-hidden text-sm", required: true %>
        </div>
      </div>
      <div class="form-control w-full">
        <%= f.label :date_fin_prévue, "Date de fin prévue", class: "label font-semibold text-slate-700" do %>
          Date de fin prévue <span class="text-red-500">*</span>
        <% end %>
        <div class="flex items-center gap-2 bg-slate-50 h-10 rounded-lg border border-slate-200">
          <%= f.date_field :date_fin_prévue, class: "flex-1 bg-transparent border-none outline-hidden text-sm", required: true  %>
        </div>
      </div>
      <div class="form-control w-full sm:col-span-2">
        <%= f.label :heures_conventionnees, "Heures conventionnées", class: "label font-semibold text-slate-700" do %>
          Heures conventionnées <span class="text-red-500">*</span>
        <% end %>
        <%= f.number_field :heures_conventionnees, min:"0", class: "input input-bordered w-full focus:input-primary ", required: true %>
      </div>
      <div class="form-control w-full sm:col-span-2">
        <%= f.label :mémo, "Mémo", class: "label font-semibold text-slate-700" %>
        <%= f.text_area :mémo, rows: 3, class: "textarea textarea-bordered w-full focus:textarea-primary" %>
      </div>
      <%= render "shared/file_dropzone", form: f, attribute: :document,
            accept: ".pdf", label: "Document", wrapper_class: "sm:col-span-2" %>
    </div>
    <div class="flex gap-2 mt-4 w-full">
      <button type="button" onclick="history.back();" class="btn flex-1">Annuler</button>
      <%= f.submit "Enregistrer", id: "conventions_path", class: "btn btn-primary flex-1" %>
    </div>
  <% end %>
  <div class="pt-6 max-w-3xl mx-auto px-4">
    <%= link_to conventions_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste des conventions" %>
      Retour à la liste des conventions
    <% end %>
  </div>
</div>
