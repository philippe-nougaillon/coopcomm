    <% if @convention.document.attached? %>
    <% doc = @convention.document %>
    <div class="w-full <%= @convention.validé? ? "md:w-64" : "xl:w-64" %> flex-shrink-0">
      <div class="w-full h-full min-h-64 border border-slate-200 rounded-xl overflow-hidden shadow-sm bg-white flex flex-col">
        <% if doc.content_type == "application/pdf" %>
          <iframe src="<%= rails_blob_path(doc, disposition: "inline") %>#toolbar=0&navpanes=0&scrollbar=0"
                  class="w-full flex-1 border-0"
                  title="<%= doc.filename %>">
          </iframe>
          <%= link_to doc.filename.to_s, rails_blob_path(doc, disposition: "inline"),
                  target: "_blank",
                  class: "flex items-center gap-2 px-3 py-2 text-xs text-primary hover:underline border-t border-slate-100 truncate" %>
        <% elsif doc.representable? %>
          <%= link_to rails_blob_path(doc, disposition: "inline"),
                  target: "_blank", title: doc.filename.to_s,
                  class: "block w-full h-full" do %>
            <%= image_tag doc.representation(resize_to_limit: [400, 500]),
                    alt: doc.filename.to_s,
                    class: "w-full h-full object-contain" %>
          <% end %>
        <% else %>
           <%= link_to rails_blob_path(doc, disposition: "inline"),
                  target: "_blank", title: doc.filename.to_s,
                  class: "flex flex-col items-center justify-center gap-2 p-4 h-full text-slate-700 hover:bg-slate-50 transition" do %>
            <%= embedded_svg "icons/article.svg", class: "text-3xl" %>
            <span class="text-xs text-center truncate max-w-full"><%= doc.filename %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
