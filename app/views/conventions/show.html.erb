<div class="mx-auto lg:w-2/3 w-full mt-8">
  <% page_title!("Convention — #{@convention.user&.nom_prénom}") %>
  <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
    <h1 class="text-2xl sm:text-3xl text-primary font-bold">Convention — <%= @convention.user&.nom_prénom %></h1>
    <div class="flex flex-wrap gap-2">
      <% if @convention.document.attached? %>
        <%= link_to rails_blob_path(@convention.document, disposition: "attachment"), class: "btn btn-outline" do %>
          <span class="material-symbols-outlined">download</span>
          Document
        <% end %>
      <% end %>
      <% if policy(@convention).update? %>
        <%= link_to edit_convention_path(@convention), class: "btn btn-primary" do %>
          <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 fill-current" %>
          Modifier
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl" style="padding: 1.25rem;">
    <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Informations</p>
    <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">
      <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/account_circle.svg", class: "text-base", title: "Adhérent" %> Adhérent
      </div>
      <div class="py-2.5 text-slate-800 border-b border-slate-100">
        <%= link_to @convention.user.nom_prénom, user_path(@convention.user), class: "link" if @convention.user %>
      </div>
      <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/store.svg", class: "text-base", title: "Service" %> Service
      </div>
      <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @convention.service&.nom %></div>
      <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/calendar_today.svg", class: "text-base", title: "Période" %> Période
      </div>
      <div class="py-2.5 text-slate-800 border-b border-slate-100">
        <% prog = convention_progress(@convention) %>
        <%= l(@convention.date_début, format: :long) if @convention.date_début %>
        <span class="text-slate-400">→</span>
        <%= @convention.date_fin_prévue ? l(@convention.date_fin_prévue, format: :long) : "—" %>
        <% if prog %>
          <div class="mt-1 max-w-xs">
            <% if prog[:indeterminate] %>
              <progress class="progress <%= prog[:color] %> w-full" value="100" max="100"></progress>
            <% else %>
              <progress class="progress <%= prog[:color] %> w-full" value="<%= prog[:percent] %>" max="100"></progress>
            <% end %>
            <span class="text-xs text-slate-400"><%= prog[:label] %></span>
          </div>
        <% end %>
      </div>
      <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <span class="material-symbols-outlined text-base" title="Heures consommées">schedule</span> Heures consommées
      </div>
      <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @convention.temps_total_interventions.round(1) %> h</div>
      <div class="flex items-center gap-2 py-2.5 text-slate-500<%= " border-b border-slate-100" if @convention.mémo.present? %>" style="padding-right: 2rem;">Document</div>
      <div class="py-2.5 text-slate-800<%= " border-b border-slate-100" if @convention.mémo.present? %>">
        <% if @convention.document.attached? %>
          <%= link_to rails_blob_path(@convention.document, disposition: "inline"),
                target: "_blank", title: @convention.document.filename.to_s,
                class: "inline-flex items-center gap-2 text-primary hover:underline" do %>
            <% if @convention.document.representable? %>
              <%= image_tag @convention.document.representation(resize_to_limit: [80, 100]),
                    alt: @convention.document.filename.to_s,
                    class: "h-20 w-auto rounded border border-base-300 hover:opacity-80 transition" %>
            <% else %>
              <span class="material-symbols-outlined text-2xl">description</span>
              <span class="text-sm truncate max-w-xs"><%= @convention.document.filename %></span>
            <% end %>
          <% end %>
        <% else %>
          <span class="text-slate-400 italic text-xs">Aucun document</span>
        <% end %>
      </div>
      <% if @convention.mémo.present? %>
        <div class="flex items-start gap-2 py-2.5 text-slate-500" style="padding-right: 2rem;">Mémo</div>
        <div class="py-2.5 text-slate-800 italic"><%= simple_format(@convention.mémo) %></div>
      <% end %>
    </div>
  </div>

  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary font-semibold">Activité</h2>
  </div>
  <div class="overflow-x-auto border border-slate-200 shadow-sm bg-white rounded-xl">
    <table class="table table-sm w-full border-none">
      <thead class="bg-slate-100">
        <tr>
          <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Date</th>
          <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Utilisateur</th>
          <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Action</th>
          <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Modifications</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "audit", collection: @audits %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %>
    <div class="flex justify-center mt-4">
      <%= pagy_nav(@pagy).html_safe %>
    </div>
  <% end %>

  <div class="my-10">
    <%= link_to conventions_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base", title: "Retour à la liste" %>
      Retour à la liste
    <% end %>
  </div>
</div>
