<div class="mx-auto lg:w-2/3 w-full mt-8">
  <% page_title!("Convention — #{@convention.user&.nom_prénom}") %>
  <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
    <h1 class="text-2xl sm:text-3xl text-primary font-bold">Convention — <%= @convention.user&.nom_prénom %></h1>
  </div>
  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary font-semibold">Informations</h2>
  </div>
  <div class=" bg-white border border-slate-200 rounded-xl  md:rounded-xl  shadow-sm ">
    <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
      <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
      <span>Faire glisser pour voir plus</span>
    </div>
    <div class="grid text-sm overflow-x-auto p-4" style="grid-template-columns: 250px 1fr;">
      <div class="flex flex-row items-center gap-2 pb-4 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/account_circle.svg", class: "text-base", title: "Adhérent" %> Adhérent
      </div>
      <div class="pb-4 text-slate-800 border-b border-slate-100">
        <%= link_to @convention.user.nom_prénom, user_path(@convention.user), class: "link" if @convention.user %>
      </div>
      <div class="flex items-center gap-2 py-4 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/store.svg", class: "text-base", title: "Service" %> Service
      </div>
      <div class="py-4 text-slate-800 border-b border-slate-100"><%= @convention.service&.nom %></div>
      <div class="flex items-center gap-2 py-4 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/calendar_today.svg", class: "text-base", title: "Période" %> Période
      </div>
      <div class="py-4 text-slate-800 border-b border-slate-100">
        <% prog = convention_progress(@convention) %>
        <%= l(@convention.date_début, format: :long) if @convention.date_début %>
        <span class="text-slate-400">→</span>
        <%= @convention.date_fin_prévue ? l(@convention.date_fin_prévue, format: :long) : "—" %>
        <br>
        <span class="text-xs text-slate-500">
          <strong><%= prog[:label] %></strong> du temps total du contrat se sont écoulés
        </span>
      </div>
      <div class="flex items-center gap-2 py-4 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/schedule.svg", class: "text-base", title: "Heures consommées" %>Heures consommées
      </div>
      <div class="py-4 text-slate-800 border-b border-slate-100">
        <%= @convention.heures_consommees.round(1) %> h sur <%= @convention.heures_conventionnees.to_f %> h
        <% if prog[:depassement] != 0 %>
          <div class="mt-2">
            <span class="badge badge-error badge-soft gap-1.5 !px-2 !py-4">        <%= embedded_svg "icons/warning.svg", class: "text-base" %>
              Dépassement de <%= prog[:depassement].round(1) %> heures
            </span>
          </div>
        <% end %>
      </div>
      <div class="flex items-center gap-2 py-4 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/article.svg", class: "text-base", title: "Document" %> Document
      </div>
      <div class="py-4 text-slate-800 border-b border-slate-100">
        <% if @convention.document.attached? %>
          <%= link_to rails_blob_path(@convention.document, disposition: "inline"), target: "_blank", title: @convention.document.filename.to_s, class: "inline-flex items-center gap-2 text-primary hover:underline" do %>
            <% if @convention.document.representable? %>
              <%= image_tag @convention.document.representation(resize_to_limit: [80, 100]), alt: @convention.document.filename.to_s, class: "h-20 w-auto rounded border border-base-300 hover:opacity-80 transition" %>
            <% else %>
              <%= embedded_svg "icons/article.svg", class: "text-base" %>
              <span class="text-sm truncate max-w-xs"><%= @convention.document.filename %></span>
            <% end %>
          <% end %>
        <% else %>
          <span class="text-slate-400 italic text-xs">Aucun document</span>
        <% end %>
      </div>
      <div class="flex items-start gap-2 pt-4 text-slate-500" style="padding-right: 2rem;">
        <%= embedded_svg "icons/sticky_note_2.svg", class: "text-base", title: "Mémo" %> Mémo
      </div>
      <div class="pt-4 text-slate-800">
        <% if @convention.mémo.present? %>
          <%= simple_format(@convention.mémo) %>
        <% else %>
          <span class="text-slate-400 italic text-xs">Aucun mémo</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary font-semibold">Activité</h2>
  </div>
  <div class="flex flex-col bg-white border border-slate-200 rounded-xl  md:rounded-xl  shadow-sm overflow-visible">
    <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
      <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
      <span>Faire glisser pour voir plus</span>
    </div>
    <div class="overflow-x-auto">
      <table class="table table-sm w-full border-none">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Date</th>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Utilisateur</th>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Action</th>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Modifications</th>
          </tr>
        </thead>
        <tbody>
          <% if @audits&.any? %>
            <%= render partial: "audit", collection: @audits %>
          <% else %>
            <tr>
              <td colspan="5" class="text-center py-8 text-slate-400 text-base italic">
                Aucun historique d'activité disponible.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy&.pages.to_i > 1 %>
      <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full">
        <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
          <%= pagy_nav(@pagy).html_safe %>
        </div>
        <div class="text-slate-500 text-center text-sm w-full mt-2">
          <%= pagy_info(@pagy, item_name: "audits").html_safe %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="flex gap-2.5 pt-4 items-center justify-end  mt-6 pt-4 border-t border-slate-200">
    <% if policy(@convention).update? %>
      <%= link_to edit_convention_path(@convention), class: "btn" do %>
        <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 fill-current" %>
        <span class="hidden lg:inline">Modifier</span>
      <% end %>
    <% end %>
    <% if policy(@convention).destroy? %>
      <button class="btn btn-soft btn-error hover:!text-white" onclick="delete_convention_modal_<%= @convention.id %>.showModal()" title="Supprimer">
        <%= embedded_svg "icons/delete.svg", class: "w-4 h-4 fill-current transition-colors duration-200" %>
        <span class="hidden lg:inline">Supprimer</span>
      </button>
      <dialog id="delete_convention_modal_<%= @convention.id %>" class="modal">
        <div class="modal-box">
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
          </form>
          <h3 class="text-lg font-bold text-error flex items-center gap-2">
            <%= embedded_svg "icons/warning.svg", title: "Supprimer la convention" %>
            Supprimer la convention
          </h3>
          <p class="py-4 text-sm text-slate-600 text-left">
            Êtes-vous certain(e) de vouloir supprimer cette convention ? Cette action est irréversible.
          </p>
          <div class="modal-action">
            <form method="dialog">
              <button class="btn btn-ghost">Annuler</button>
            </form>
            <%= button_to convention_path(@convention), method: :delete, class: "btn btn-error text-white" do %>
              Oui, supprimer
            <% end %>
          </div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>Fermer</button>
        </form>
      </dialog>
    <% end %>
  </div>
  <div class="my-10">
    <%= link_to conventions_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste" %>
      Retour à la liste
    <% end %>
  </div>
</div>