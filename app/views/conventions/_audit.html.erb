



<tr class="border-b border-slate-100 hover:bg-slate-50/80 transition-colors align-top">
  
  <!-- Columna 1: Date (Fecha relativa y absoluta estructurada) -->
  <td class="py-4 pl-4 pr-2 text-sm whitespace-nowrap flex-1">
    <div class="font-semibold text-slate-700 text-xs sm:text-sm leading-tight">
      Il y a <%= time_ago_in_words(audit.created_at) %>
    </div>
    <div class="py-4 px-4 text-sm whitespace-nowrap">
      <%= l(audit.created_at, format: :long) %>
    </div>
  </td>






 <td class="px-4 py-3flex-1">
    <% if audit.user_id %>
      <% if audit.user %>
        <%= audit.user.email %>
        (#<%= audit.user.id %>)
        <br>
        <span class="text-slate-400 text-xs"><%= audit.user.rôle.humanize %></span>
      <% end %>
    <% else %>
      SYSTEM CONSOLE
    <% end %>
  </td>

  <!-- Columna 2: Action (Reutiliza tu badge inteligente del Helper) -->
  <td class="px-4 py-4 whitespace-nowrap flex-1">
    <div class="inline-block">
      <%= audit_badge(audit) %>
    </div>
  </td>

  <!-- Columna 3: Modifications (Cuadro redondeado limpio con tus textos traducidos) -->
  <td class="px-4 py-4 flex-1">
    <div class="bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-xs text-slate-600 shadow-sm max-w-xl group">
      <% if audit.comment.present? %>
        <%= audit.comment %>
      <% else %>
        <%= audit_changes_list(audit, current_user) %>
      <% end %>
    </div>
  </td>

</tr>
