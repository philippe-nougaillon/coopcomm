<%= turbo_stream_from (current_user.administrateur? ? current_organisation : current_user), :analyses %>
<%= turbo_stream_from :etat_ia %>
<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-3xl sm:text-4xl text-primary font-bold mr-auto">
      <%= page_title!("Importation de conventions en masse") %></h1>
    <button type="button" onclick="import_conventions_modal.showModal()" title="Importer des conventions"
            class="btn btn-primary btn-md rounded flex items-center justify-center gap-2 text-sm text-white border border-primary hover:bg-transparent hover:text-primary hover:border-primary"
            data-testid="importer_conventions">
      <%= embedded_svg "icons/smart_toy.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
      <span class="hidden md:block">Importer des conventions</span>
    </button>
  </div>
  <%= render "etat_ia", etat: @etat_ia %>

  <dialog id="import_conventions_modal" class="modal">
    <div class="modal-box max-w-2xl max-h-[90vh]">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <h3 class="text-lg font-bold text-primary">Importer des conventions</h3>
      <%= form_with model: @convention, url: analyses_conventions_path, html: { multipart: true, class: "flex flex-col gap-3 pt-4" } do |f| %>
        <%= render "shared/file_dropzone", form: f, attribute: :document, multiple: true, types: %w[application/pdf], label: "Conventions à analyser et à importer",
              placeholder: "Glissez une ou plusieurs conventions en PDF ici ou cliquez pour parcourir" %>
        <div class="modal-action">
          <button type="button" class="btn btn-ghost" onclick="import_conventions_modal.close()">Annuler</button>
          <%= f.submit "Lancer l'importation", class: "btn btn-primary text-white font-bold" %>
        </div>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>Fermer</button>
    </form>
  </dialog>
  <%= form_tag analyses_conventions_path, method: :get, class: "pt-6", data: { turbo_action: "advance" } do %>
    <%= champs_tri_caches %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4 w-full bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="w-full md:flex-1">
        <%= label_tag :adherent_id, "Adhérent", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :adherent_id,
              options_from_collection_for_select(@adherents, :id, :nom_prénom, params[:adherent_id]),
              include_blank: "Tous les adhérents",
              class: "w-full h-10", data: { controller: "slim-select" },
              onchange: "this.form.submit()" %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :service_id, "Service", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :service_id,
              options_from_collection_for_select(@services, :id, :nom, params[:service_id]),
              multiple: true,
              class: "w-full h-10",
              data: { controller: "slim-select", placeholder: 'Tous les services',
                      max_values_shown_desktop: 2,
                      max_values_shown_mobile: 2
                    },
              onchange: "this.form.submit()" %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :etat, "État", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :etat,
              options_for_select(Convention.workflow_spec.states.values.reject { |etat| etat.name.to_s == Convention::VALIDE }.map { |etat| [etat.meta[:libelle], etat.name] }, params[:etat]),
              include_blank: "Tous les états",
              class: "w-full h-10", data: { controller: "slim-select" },
              onchange: "this.form.submit()" %>
      </div>
      <div class="w-full md:flex-1" data-controller="date-picker" data-action="click->date-picker#open">
        <%= label_tag :du, "Déposé du", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= date_field_tag :du, params[:du], class: "input input-bordered input-md w-full h-10",
              onchange: "this.form.submit()",
              data: { 'date-picker-target': "input" } %>
      </div>
      <div class="w-full md:flex-1" data-controller="date-picker" data-action="click->date-picker#open">
        <%= label_tag :au, "Au", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= date_field_tag :au, params[:au], class: "input input-bordered input-md w-full h-10",
              onchange: "this.form.submit()",
              data: { 'date-picker-target': "input" } %>
      </div>
    </div>
  <% end %>
</div>
<hr class="mt-6 mb-6">
<div class="flex flex-col bg-white border-x border-b border-slate-200 shadow-sm overflow-hidden <%= 'rounded-b-xl' unless @pagy.pages > 1 %>">
  <div class="overflow-x-auto">
    <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
      <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
      <span>Faire glisser pour voir plus</span>
    </div>
    <table class="table table-sm w-full border-none">
      <thead class="bg-slate-100">
        <tr>
          <%= th_tri 'MÀJ', colonne: 'conventions.updated_at', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Nom du fichier', colonne: 'conventions.document', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Déposé le', colonne: 'conventions.created_at', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Par', colonne: 'conventions.deposant', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Adhérent', colonne: 'conventions.user', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Service', colonne: 'conventions.service', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'Heures', colonne: 'conventions.heures_conventionnees', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <%= th_tri 'État', colonne: 'conventions.workflow_state', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
          <th></th>
        </tr>
      </thead>
      <tbody id="analyses">
        <%= render partial: "analyse", collection: @analyses, as: :convention %>
        <tr class="hidden only:table-row">
          <td colspan="9" class="text-center py-8 text-slate-400 text-base italic">
            Aucune analyse.
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %>
    <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
      <div class="w-full flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class="text-slate-500 text-center text-sm w-full mt-2">
        <%= pagy_info(@pagy, item_name: "analyses").html_safe %>
      </div>
    </div>
  <% end %>
</div>

<div class="my-10">
  <%= link_to conventions_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
    <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste des conventions" %>
    Retour à la liste des conventions
  <% end %>
</div>
