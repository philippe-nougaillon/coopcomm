<div class="mx-auto lg:w-2/3 w-full mt-8">
  <% page_title!("Cotation #{@cotation.ref}") %>
  <div class="flex flex-wrap justify-between items-start gap-3 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl text-primary font-bold">Cotation <%= @cotation.ref %></h1>
      
      
       <div class="mt-3 flex items-center gap-2">
        <span class="badge badge-sm px-3 py-3 font-medium <%= @cotation.style %>flex items-center gap-1.5">
          <%= @cotation.workflow_state.humanize %>
           </span>
      </div>

<% if @cotation.signee_le.present? %>
        <p class="text-sm text-slate-500 mt-2">
           Signée par <%= @cotation.adherent&.nom %> le <%= l(@cotation.signee_le, format: :long) %>
        </p>
      <% end %>
    </div>

       <div class="flex items-center gap-2">
         <% if policy(@cotation).update? %>
    <%= link_to edit_cotation_path(@cotation), class: "btn " do %>
      <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 fill-current" %>
      Modifier
    <% end %>
  <% end %>
    <%= link_to pdf_cotation_path(@cotation, filename: @cotation.pdf_filename),
                class: "btn btn-outline btn-info ", target: "_blank", data: { turbo: false } do %>
      <%= embedded_svg "icons/download.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
      Générer PDF
    <% end %>
 
    </div>
  </div>

  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary font-semibold">Informations</h2>
  </div>
  <div class=" block md:hidden flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
  </div>
  <div class="overflow-x-auto border-x border-b border-slate-200 shadow-sm bg-white rounded-b-xl md:rounded-xl">
    <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
      <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
      <span>Faire glisser pour voir plus</span>
    </div>
    <div class="grid text-sm overflow-x-auto p-4" style="grid-template-columns: 250px 1fr;">
     
     
    <%# ---  ADHÉRENT --- %>
    <div class="flex items-center gap-2 pb-4 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
      <%= embedded_svg "icons/account_circle.svg", class: "text-base", title: "Adhérent" %> Adhérent
    </div>
    <div class="pb-4 text-slate-800 text-right border-b border-slate-100 flex items-center ">
      <%= link_to @cotation.adherent.nom_prénom, user_path(@cotation.adherent), class: "link" if @cotation.adherent %>
    </div>
    <%# ---  SERVICE --- %>
    <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
      <%= embedded_svg "icons/store.svg", class: "text-base", title: "Service" %> Service
    </div>
    <div class="py-2.5 text-slate-800 border-b border-slate-100 flex items-center capitalize"><%= @cotation.service&.nom %></div>
    <%# ---  INTITULÉ --- %>
    <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
      <%= embedded_svg "icons/label.svg", class: "text-base", title: "Service" %>  Intitulé
    </div>
    <div class="py-2.5 text-slate-800 border-b border-slate-100 flex items-center capitalize"><%= @cotation.intitulé %></div>
    <%# --- LIVRAISON SOUHAITÉE --- %>
    <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
      <%= embedded_svg "icons/calendar_today.svg", class: "text-base", title: "Livraison souhaitée" %> Livraison souhaitée
    </div>
    <div class="py-2.5 text-slate-800 border-b border-slate-100 flex items-center">
      <% if @cotation.date_livraison_souhaitée %>
        <%= l(@cotation.date_livraison_souhaitée, format: :long) %>
      <% else %>
        <span class="text-slate-400 italic text-xs">Non renseignée</span>
      <% end %>
    </div>
    <%# ---  TOTAL HT --- %>
    <div class="flex items-center gap-2 py-2.5 text-slate-500<%= " border-b border-slate-100" if @cotation.mémo.present? %>" style="padding-right: 2rem;">
      <%= embedded_svg "icons/euro.svg", class: "text-base", title: "Service" %> Service Total HT
    </div>
    <div class="py-2.5<%= " border-b border-slate-100" if @cotation.mémo.present? %> flex items-center">
      <span class="text-lg whitespace-nowrap font-bold text-slate-800"><%= number_to_currency(@cotation.total_ht) %></span>
    </div>
    <%# ---  signature --- %>
    <% if @cotation.mémo.present? %>
      <div class="flex items-start gap-2 py-2.5 text-slate-500 p-2">Mémo</div>
      <div class="py-2.5 text-slate-800 italic flex items-center"><%= simple_format(@cotation.mémo) %></div>
    <% end %>
    <% if @cotation.signee_le.present? %>
      <div class="flex items-center gap-2 py-2.5 text-slate-500 border-t border-slate-100" style="padding-right: 2rem;">
        <%= embedded_svg "icons/signature.svg", class: "text-base", title: "Livraison souhaitée" %> Signature
      </div>
      <div class="py-2.5 text-slate-800 border-t border-slate-100 flex items-center gap-1">
        <%= l(@cotation.signee_le, format: :long) %> <span class="text-secondary">(<%= @cotation.ip %>)</span>
      </div>
    <% end %>
  </div>
</div>



<%# --- Prochaine étape --- %>
<div class="flex flex-wrap justify-between shadow-sm bg-white rounded-b-xl items-center gap-3 mt-2 p-4 bg-slate-50 rounded-xl mb-8">
  <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Prochaine étape</span>

  <div class="flex flex-row gap-2 flex-wrap">
    <% unless (policy(@cotation).envoyer? && @cotation.can_envoyer?) ||
              (policy(@cotation).valider? && @cotation.can_valider?) ||
              (policy(@cotation).refuser? && @cotation.can_refuser?) %>
      <span class="badge text-nowrap min-w-20 font-bold <%= @cotation.style %>">
        <%= @cotation.workflow_state.humanize %>
      </span>
    <% end %>
    <% if policy(@cotation).envoyer? && @cotation.can_envoyer? %>
      <%= button_to "Envoyer", envoyer_cotation_path(@cotation), class: "btn btn-sm btn-info btn-outline min-w-20 hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
    <% if policy(@cotation).valider? && @cotation.can_valider? %>
      <%= button_to "Valider", valider_cotation_path(@cotation), class: "btn btn-sm btn-success btn-outline min-w-20 hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
    <% if policy(@cotation).refuser? && @cotation.can_refuser? %>
      <%= button_to "Refuser", refuser_cotation_path(@cotation), class: "btn btn-sm btn-error btn-outline min-w-20 hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
  </div>
</div>

<%# --- Supprimer--- %>
<div class="flex pt-4 mt-2 border-t border-slate-100 items-center justify-end">
  <% if policy(@cotation).destroy? %>
    <button class="btn btn-soft btn-error hover:!text-white"
              onclick="delete_cotation_modal_<%= @cotation.id %>.showModal()"
              title="Supprimer">
      <%= embedded_svg "icons/delete.svg", title: "Supprimer la cotation" %>
      <span class="hidden lg:inline">Supprimer</span>
    </button>
    <dialog id="delete_cotation_modal_<%= @cotation.id %>" class="modal">
      <div class="modal-box">
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>
        <h3 class="text-lg font-bold text-error flex items-center gap-2">
          <%= embedded_svg "icons/warning.svg", title: "Supprimer la cotation" %>
          Supprimer la cotation
        </h3>
        <p class="py-4 text-sm text-slate-600 text-left">
          Êtes-vous certain(e) de vouloir supprimer cette cotation ?
          Cette action est irréversible.
        </p>
        <div class="modal-action">
          <form method="dialog">
            <button class="btn btn-ghost">Annuler</button>
          </form>
          <%= button_to cotation_path(@cotation), method: :delete, class: "btn btn-error text-white" do %>
            Oui, supprimer
          <% end %>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>Fermer</button>
      </form>
    </dialog>
  <% end %>
</div>
<div class="flex justify-between flex-wrap items-center mt-8 mb-4">
  <h2 class="text-2xl text-secondary font-semibold">Prestations</h2>
</div>
<div class=" block md:hidden flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
</div>
<div class="overflow-x-auto border-x border-b border-slate-200 shadow-sm bg-white rounded-b-xl md:rounded-xl">
  <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
    <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
    <span>Faire glisser pour voir plus</span>
  </div>
  <table class="table table-sm w-full border-none">
    <thead class="bg-slate-100">
      <tr>
        <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Code</th>
        <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Intitulé</th>
        <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-right">Prix HT</th>
        <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-right">Qté</th>
        <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-right">Total HT</th>
      </tr>
    </thead>
    <tbody>
      <% cotation_lignes = @cotation.cotation_lignes.includes(:prestation) %>
      <% if cotation_lignes.any? %>
        <% cotation_lignes.each do |ligne| %>
          <tr class="border-b border-slate-100">
            <td class="px-4 py-3 font-medium"><%= ligne.prestation&.code %></td>
            <td class="px-4 py-3"><%= ligne.intitulé.presence || ligne.prestation&.libellé %></td>
            <td class="px-4 py-3 text-right"><%= number_to_currency(ligne.prix_ht) %></td>
            <td class="px-4 py-3 text-right"><%= ligne.qté %></td>
            <td class="px-4 py-3 text-right"><%= number_to_currency(ligne.total_ht) %></td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="text-center py-8 text-slate-400 text-base italic">Aucune prestation enregistrée.</td>
        </tr>
      <% end %>
    </tbody>
    <% if cotation_lignes.any? %>
      <tfoot>
        <tr class="bg-slate-50/50">
          <th colspan="4" class="px-4 py-3 text-right">Total HT</th>
          <th class="px-4 py-3 text-right"><%= number_to_currency(@cotation.total_ht) %></th>
        </tr>
      </tfoot>
    <% end %>
  </table>
</div>
