<tr class="hover:bg-base-200/60 transition-colors duration-150 border-b border-slate-100 align-middle">
  
  <%# Columna 1: Fecha y Tiempo relativo %>
  <td class="py-4 pl-4 text-sm whitespace-nowrap">
    <div class="font-semibold text-slate-700 text-xs sm:text-sm leading-tight">
      <%= time_tag(audit.created_at, format: :long) { "Il y a #{time_ago_in_words(audit.created_at)}" } %>
    </div>
    <div class="text-slate-400 text-xs mt-1">
      <%= l(audit.created_at, format: :long) %>
    </div>
  </td>

  <%# Columna 2: Autor del cambio (Usuario o Sistema) %>
  <td class="px-4 py-3 text-sm">
    <% if audit.user_id && audit.user %>
      <div class="font-medium text-slate-700 leading-snug">
        <%= audit.user.email %>
      </div>
      <div class="text-slate-400 text-xs flex items-center gap-1.5 mt-0.5">
        <span class="capitalize"><%= audit.user.rôle.to_s.humanize %></span>
      </div>
    <% else %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200 uppercase tracking-wider">
        System Console
      </span>
    <% end %>
  </td>

  <%# Columna 3: Acción realizada (Badge dinámico con icono SVG) %>
  <td class="px-4 py-3 align-middle">
    <%= audit_badge(audit) %>
  </td>

  <%# Columna 4: Detalles de las modificaciones o Comentarios %>
  <td class="px-4 py-3 text-sm max-w-xs md:max-w-md">
    <% if audit.comment.present? %>
      <span class="italic text-slate-500">"<%= audit.comment %>"</span>
    <% elsif audit.auditable_type == "Absence" && audit.action == "destroy" %>
      <%= absence_period_badge(audit) %>
    <% elsif audit.auditable_type == "User" && audit.audited_changes.key?("invitation_token") %>
      <div class="bg-slate-50/60 rounded-lg p-2 border border-slate-300 group-hover:bg-white transition-colors duration-150">
        <%= invitation_changes_summary(audit) %>
      </div>
    <% else %>
      <div class="bg-slate-50/60 rounded-lg p-2 border border-slate-300 group-hover:bg-white transition-colors duration-150">
        <%= audit_changes_list(audit, current_user) %>
      </div>
    <% end %>
  </td>

</tr>