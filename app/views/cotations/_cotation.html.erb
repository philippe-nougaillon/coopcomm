<tr class="hover:bg-base-200/60 transition-colors duration-150 border-b border-slate-100 align-middle">
  <td class="px-4 py-3 text-lg font-semibold text-primary">
    <%= link_to cotation.ref, cotation, class: "hover:underline" %>
  </td>
  <td class="px-4 py-3">
    <span class="badge text-nowrap font-bold <%= cotation.style %>"><%= cotation.workflow_state.humanize %></span>
  </td>
  <td class="px-4 py-3"><%= cotation.adherent&.nom_prénom %></td>
  <td class="px-4 py-3"><%= cotation.service&.nom %></td>
  <td class="px-4 py-3"><%= cotation.intitulé %></td>
  <td class="px-4 py-3 text-nowrap"><%= l(cotation.date_livraison_souhaitée, format: :long) if cotation.date_livraison_souhaitée %></td>
  <td class="px-4 py-3 text-right font-medium"><%= number_to_currency(cotation.total_ht) %></td>
  <td class="px-4 py-3">
    <% mail_log = last_mail_logs[cotation.id] %>
    <% if mail_log %>
      <div class="flex flex-col gap-0.5 text-xs leading-tight">
        <span class="font-semibold <%= mail_log.statut ? 'text-success' : 'text-error' %>"><%= mail_log.statut ? 'OK' : 'KO' %></span>
        <% if mail_log.statut && mail_log.etat %>
          <span class="text-info">OUVERT</span>
        <% end %>
        <span class="text-slate-400"><%= time_ago_in_words mail_log.created_at %></span>
      </div>
    <% else %>
      <span class="text-slate-300">—</span>
    <% end %>
  </td>
  <%# Une colonne par action : chaque bouton de même catégorie s'aligne
      verticalement d'une cotation à l'autre (cellule vide si l'action ne
      s'applique pas à l'état courant). %>
  <td class="px-2 py-3 text-center">
    <%= link_to cotation,  class: "btn btn-sm btn-ghost text-info hover:bg-info/20 gap-1" do %>
      Voir <i class="ti ti-eye"></i>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(cotation).envoyer? && cotation.can_envoyer? %>
      <%= button_to "Envoyer", envoyer_cotation_path(cotation), class: "btn btn-sm btn-info btn-outline hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(cotation).valider? && cotation.can_valider? %>
      <%= button_to "Valider", valider_cotation_path(cotation), class: "btn btn-sm btn-success btn-outline hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(cotation).refuser? && cotation.can_refuser? %>
      <%= button_to "Refuser", refuser_cotation_path(cotation), class: "btn btn-sm btn-error btn-outline hover:text-white!", form: { data: { turbo: false }, class: 'inline-block' } %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(cotation).pdf? %>
      <%= link_to pdf_cotation_path(cotation, filename: cotation.pdf_filename),
            class: "btn btn-sm", target: "_blank", title: "Générer le PDF", data: { turbo: false } do %>
        <span class="material-symbols-outlined">picture_as_pdf</span>
      <% end %>
    <% end %>
  </td>
  <td class="px-2 py-3 text-center">
    <% if policy(cotation).destroy? %>
      <button class="btn btn-sm btn-ghost text-error border border-transparent hover:!bg-error/20 hover:!border-error/40" 
          onclick="delete_cotation_modal_<%= cotation.id %>.showModal()" 
          title="Supprimer">
            <%= embedded_svg "icons/delete.svg", title: "Supprimer la cotation" %>
      </button>
      <dialog id="delete_cotation_modal_<%= cotation.id %>" class="modal">
        <div class="modal-box">
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
          </form>
          <h3 class="text-lg font-bold text-error flex items-center gap-2">
            <%= embedded_svg "icons/warning.svg", title: "Supprimer la cotation" %>
            Supprimer la cotation
          </h3>
          <p class="py-4 text-sm text-slate-600 text-left">
            Êtes-vous certain(e) de vouloir supprimer cette cotation ?
            Cette action est irréversible.
          </p>
          <div class="modal-action">
            <form method="dialog">
              <button class="btn btn-ghost">Annuler</button>
            </form>
            <%= button_to cotation_path(cotation),
                      method: :delete,
                      class: "btn btn-error text-white" do %>
              Oui, supprimer
            <% end %>
          </div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>Fermer</button>
        </form>
      </dialog>
    <% end %>
  </td>
</tr>
