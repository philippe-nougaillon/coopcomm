<div class="max-w-3xl mx-auto px-4 py-8">
  <% page_title!("Signature cotation") %>
  <div class="flex flex-col items-center text-center mb-8">
    <h1 class="text-primary font-bold text-3xl sm:text-4xl">Cotation à signer</h1>
    <p class="text-slate-500 mt-2 text-sm">Vérifiez les informations ci-dessous, puis signez.</p>
  </div>
  <%= form_with(model: @cotation, url: signer_do_cotation_path(@cotation), method: :post) do |f| %>
    <% if @cotation.errors.any? %>
      <div class="bg-red-50 text-red-500 px-4 py-3 font-medium rounded-lg mb-6 border border-red-200">
        <h2 class="font-black mb-2 text-sm md:text-base">
          <%= pluralize(@cotation.errors.count, "erreur") %> empêche(nt) l'enregistrement de la cotation :
        </h2>
        <ul class="list-disc list-inside text-xs opacity-90">
          <% @cotation.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%# Récapitulatif : ce que le signataire valide %>
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6 mb-6">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Récapitulatif</p>
      <div class="grid text-sm" style="grid-template-columns: auto 1fr; gap: 0;">
        <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
          <%= embedded_svg "icons/store.svg", class: "text-base", title: "Service" %> Référence
        </div>
        <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @cotation.ref %></div>
        <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
          <%= embedded_svg "icons/account_circle.svg", class: "text-base", title: "Adhérent" %> Adhérent
        </div>
        <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @cotation.adherent&.nom_prénom %></div>
        <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">
          <%= embedded_svg "icons/store.svg", class: "text-base", title: "Service" %> Service
        </div>
        <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @cotation.service&.nom %></div>
        <div class="flex items-center gap-2 py-2.5 text-slate-500 border-b border-slate-100" style="padding-right: 2rem;">Intitulé</div>
        <div class="py-2.5 text-slate-800 border-b border-slate-100"><%= @cotation.intitulé %></div>
        <div class="flex items-center gap-2 py-2.5 text-slate-500<%= " border-b border-slate-100" if @cotation.mémo.present? %>" style="padding-right: 2rem;">
          <%= embedded_svg "icons/calendar_today.svg", class: "text-base", title: "Livraison souhaitée" %> Livraison souhaitée
        </div>
        <div class="py-2.5 text-slate-800<%= " border-b border-slate-100" if @cotation.mémo.present? %>">
          <% if @cotation.date_livraison_souhaitée %>
            <%= l(@cotation.date_livraison_souhaitée, format: :long) %>
          <% else %>
            <span class="text-slate-400 italic text-xs">Non renseignée</span>
          <% end %>
        </div>
        <% if @cotation.mémo.present? %>
          <div class="flex items-start gap-2 py-2.5 text-slate-500" style="padding-right: 2rem;">Mémo</div>
          <div class="py-2.5 text-slate-800 italic"><%= simple_format(@cotation.mémo) %></div>
        <% end %>
      </div>
      <%# Prestations %>
      <% cotation_lignes = @cotation.cotation_lignes.includes(:prestation) %>
      <div class="overflow-x-auto mt-4 border border-slate-200 rounded-xl">
        <table class="table table-sm w-full border-none">
          <thead class="bg-slate-100">
            <tr>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Prestation</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-right">Prix HT</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-right">Qté</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-right">Total HT</th>
            </tr>
          </thead>
          <tbody>
            <% if cotation_lignes.any? %>
              <% cotation_lignes.each do |ligne| %>
                <tr class="border-b border-slate-100">
                  <td class="px-4 py-3"><%= ligne.intitulé.presence || ligne.prestation&.libellé %></td>
                  <td class="px-4 py-3 text-right"><%= number_to_currency(ligne.prix_ht) %></td>
                  <td class="px-4 py-3 text-right"><%= ligne.qté %></td>
                  <td class="px-4 py-3 text-right"><%= number_to_currency(ligne.total_ht) %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="text-center py-6 text-slate-400 text-sm italic">Aucune prestation enregistrée.</td>
              </tr>
            <% end %>
          </tbody>
          <% if cotation_lignes.any? %>
            <tfoot>
              <tr class="bg-slate-50/50">
                <th colspan="3" class="px-4 py-3 text-right">Total HT</th>
                <th class="px-4 py-3 text-right text-base text-slate-800"><%= number_to_currency(@cotation.total_ht) %></th>
              </tr>
            </tfoot>
          <% end %>
        </table>
      </div>
    </div>
    <%# Zone de signature %>
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5 sm:p-6">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-1">Votre signature</p>
      <p class="text-sm text-slate-500 mb-4">Signez dans le cadre ci-dessous à l'aide de votre souris ou de votre doigt.</p>
      <%= f.text_field :signature, style: 'display: none' %>
      <div id="signature">
        <div class="wrapper flex justify-center">
          <canvas id="signature-pad" class="signature-pad rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 touch-none max-w-full" width="350" height="300"></canvas>
        </div>
        <div class="flex items-center justify-center gap-3 mt-4">
          <%= f.button id: "save",
                      disabled: true,
                      class: "btn gap-1",
                      data: { turbo_confirm: "Confirmez-vous la signature ? Le créateur de la cotation sera notifié." } do %>
            <%= embedded_svg "icons/check.svg", class: "w-5 h-5 fill-current" %>
            Signer
          <% end %>
          <a id="clear" class="btn btn-ghost text-slate-500 gap-1">
            <%= embedded_svg "icons/delete.svg", class: "w-5 h-5 fill-current" %>
            Effacer
          </a>
        </div>
      </div>
      <p class="text-xs text-slate-400 text-center mt-4 max-w-md mx-auto">
        En signant, vous acceptez les termes de cette cotation. La date, l'heure et votre adresse IP seront enregistrées comme preuve de signature.
      </p>
    </div>
  <% end %>
  <div class="pt-6">
    <%= link_to cotations_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste des cotations" %>
      Retour à la liste des cotations
    <% end %>
  </div>
</div>
<%= render 'signature_pad' %>
