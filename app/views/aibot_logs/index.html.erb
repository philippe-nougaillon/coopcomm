<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!('Logs AIBOT') %>
    </h1>
    <% if ENV["DEBUG_AIBOT"] == "true" %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        Logs activés
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-200 whitespace-nowrap">
        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
        Logs désactivés
      </span>
    <% end %>
  </div>
  <p class="mb-4">
    Historique des appels à AIBOT, enregistrés uniquement lorsque le mode debug est actif.
  </p>

  <%= form_tag request.path, method: :get, class: "pt-6", data: { turbo_action: "advance" } do %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4 w-full bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="w-full md:flex-1">
        <%= label_tag :search, "Rechercher", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= text_field_tag :search, params[:search],
                onchange: 'this.form.requestSubmit()',
                class: 'input input-bordered input-md w-full',
                placeholder: 'Question / Réponse' %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :user_id, "Utilisateur", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :user_id,
                options_for_select([["Tous les utilisateurs", ""]] + @users.map { |user| [user.nom_prénom, user.id] }, params[:user_id]),
                class: 'slim-select w-full h-10',
                data: { placeholder: 'Tous les utilisateurs' },
                onchange: 'this.form.requestSubmit()' %>
      </div>
      <div class="flex items-center gap-3 h-10 px-3 border border-slate-200 rounded-lg bg-slate-50 cursor-pointer"
       onclick="document.getElementById('ko_toggle').click()">
        <%= check_box_tag :ko, 1, params[:ko],
          id: 'ko_toggle',
          class: 'hidden',
          onchange: 'this.form.requestSubmit()' %>
        <div id="toggle-track"
         class="w-8 h-4 rounded-full transition-colors duration-200 flex items-center px-0.5 flex-shrink-0 <%= params[:ko].present? ? 'bg-[#007fcb]' : 'bg-slate-300' %>">
          <div class="w-3 h-3 rounded-full bg-white transition-transform duration-200 <%= params[:ko].present? ? 'translate-x-4' : 'translate-x-0' %>"></div>
        </div>
        <span class="text-sm font-medium text-slate-600 whitespace-nowrap">
          Échecs seulement (KO)
        </span>
      </div>
    </div>
  <% end %>
  <hr class="mt-6 mb-6">

  <div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
  </div>
  <div class="flex flex-col bg-white border-x border-b border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
        <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
        <span>Faire glisser pour voir plus</span>
      </div>
      <table id="aibot_logs" class="table table-sm w-full border-none">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Il y a</th>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Utilisateur</th>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Question</th>
            <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Statut</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if @aibot_logs.any? %>
            <% @aibot_logs.each do |aibot_log| %>
              <%= render partial: "aibot_log", locals: { aibot_log: aibot_log } %>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="text-left md:text-center py-8 text-slate-400 text-base italic">
                Aucun log enregistré.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy&.pages.to_i > 1 %>
      <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full">
        <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
          <%= pagy_nav(@pagy).html_safe %>
        </div>
        <div class="text-slate-500 text-center text-sm w-full mt-2">
          <%= pagy_info(@pagy, item_name: "Logs").html_safe %>
        </div>
      </div>
    <% end %>
  </div>
</div>
