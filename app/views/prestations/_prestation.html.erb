<tr class="hover:bg-base-200/60 transition-colors duration-150 align-middle">
  <td class="px-4 py-3.5 uppercase text-primary font-bold text-lg max-w-[180px] truncate">
    <%= link_to prestation.code, prestation_path(prestation), class: 'hover:underline', title: prestation.code %>
  </td>
  <td class="px-4 py-3.5 text-base font-semibold">
    <%= prestation.libellé.humanize %>
  </td>
  <td class="px-4 py-3.5 text-base text-center">
    <% if prestation.catégorie.present? %>
      <span class="text-success font-semibold whitespace-nowrap">
        <%= prestation.catégorie.humanize %>
      </span>
    <% else %>
      <span class="text-success font-semibold flex justify-center whitespace-nowrap">
        <%= embedded_svg "icons/check_indeterminate_small.svg", title: "Aucune catégorie" %>
      </span>
    <% end %>
  </td>
  <td class="px-4 py-3.5 text-base text-center">
    <% sous = prestation.sous_catégorie %>
    <% if sous.present? %>
      <span class="text-slate-600 whitespace-nowrap">
        <%= sous %>
      </span>
    <% else %>
      <span class="text-success font-semibold flex justify-center whitespace-nowrap">
        <%= embedded_svg "icons/check_indeterminate_small.svg", title: "Aucune sous-catégorie" %>
      </span>
    <% end %>
  </td>
  <td class="px-4 py-3.5 text-base text-center">
    <%= prestation.unité.humanize %>
  </td>
  <td class="px-4 py-3.5 text-base text-center font-medium">
    <%= number_to_currency(prestation.tarif) %>
  </td>
</tr>