
<div class="overflow-x-auto w-full border border-slate-200 shadow-sm">
  <table id="intervenant" class="table table-sm w-full">
    <thead class="bg-slate-100 ">
  <tr>
    <%= th_tri 'Il y a', colonne: 'interventions.updated_at', class: 'align-middle px-3 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
    <%= th_tri 'État', colonne: 'interventions.workflow_state', class: 'align-middle pl-2 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center w-36' %>
    <%= th_tri 'Description', colonne: 'interventions.description', class: 'align-middle pl-12 py-3 font-semibold text-slate-500 uppercase tracking-wider w-70 text-center' %>
    <%= th_tri 'Adhérent', colonne: 'interventions.adherent', class: 'align-middle px-4 py-3 text-center font-semibold text-slate-500 uppercase tracking-wider' %>
    <%= th_tri 'Horaires', colonne: 'interventions.début_prévue', class: 'align-middle px-3 py-3 font-semibold text-slate-500 uppercase tracking-wider min-w-[140px] text-center' %>
    <%= th_tri 'Temps total', colonne: 'interventions.temps_total', class: 'align-middle px-2 py-3 font-semibold text-slate-500 uppercase tracking-wider whitespace-nowrap w-10 text-center' %>
    <th class="align-middle px-3 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Actions</th>
  </tr>
</thead>
    <tbody class="divide-y divide-slate-200">
      <% if @interventions.any? %>
        <%= render partial: 'intervention_compact', collection: @interventions, as: :intervention,
                   cached: ->(intervention) { [intervention, current_user] } %>
      <% else %>
        <tr>
          <td colspan="8" class="text-left md:text-center py-8 text-slate-400 text-base italic">
            Aucun résultat trouvé pour cette recherche.
          </td>
        </tr>
      <% end %> </tbody>
  </table>
</div>