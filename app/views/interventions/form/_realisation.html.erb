<%# locals: (form:, intervention:, terminaison_demandee: false) %>
<% pause_obligatoire = terminaison_demandee || intervention.terminé? %>

<div class=" space-y-6">
  

<div class="border-b border-slate-100 pb-3 flex items-center gap-2">
  <span class="w-2 h-6 bg-success rounded-full"></span>
  <h2 class="text-xl text-slate-800 font-black tracking-tight uppercase">Réalisation de l'intervention</h2>
</div>

<div class =" flex flex-row gap-4 items-center">
  <div class=" flex-1">
    <%= form.label :début, class: "label font-semibold text-slate-700" do %>
      Début <%= raw('<span class="text-red-500">*</span>') if terminaison_demandee %>
    <% end %>
    <div class="flex flex-col sm:flex-row items-center gap-2 <%= terminaison_demandee && intervention.début.blank? ? 'bg-amber-50 border-amber-300' : 'bg-slate-50 border-slate-200' %> p-2 rounded-lg border">
      <%= form.date_field :début,
                          class: "w-full flex-1 bg-transparent border-none outline-hidden text-sm",
                          value: intervention.début&.to_date,
                          required: terminaison_demandee,
                          data: { 'calc-temps-passe-target': 'debut_date', 'verification-disponibilites-target': 'debut', action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" } %>
      <div class="flex items-center gap-1 bg-white px-2 py-1 rounded-md border border-slate-200 shadow-2xs">
        <%= form.select :début_hour, (0..23).map { |h| [format('%02d', h), h] }, { selected: heure_saisie(intervention, :début) }, class: "bg-transparent border-none outline-hidden text-sm cursor-pointer", data: { 'calc-temps-passe-target': 'debut_hour', 'verification-disponibilites-target': 'debut_hour', action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" } %>
        <span class="text-slate-400 font-bold">:</span>
        <%= form.select :début_minute, (0..59).map { |m| [format('%02d', m), m] }, { selected: minute_saisie(intervention, :début) }, class: "bg-transparent border-none outline-hidden text-sm cursor-pointer", data: { 'calc-temps-passe-target': 'debut_minute', 'verification-disponibilites-target': 'debut_minute', action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" } %>
      </div>
    </div>
  </div>

    <div class=" flex-1">
    <%= form.label :fin, class: "label font-semibold text-slate-700" do %>
      Fin <%= raw('<span class="text-red-500">*</span>') if terminaison_demandee %>
    <% end %>
    <div class="flex flex-col sm:flex-row  items-center gap-2 <%= terminaison_demandee && intervention.fin.blank? ? 'bg-amber-50 border-amber-300' : 'bg-slate-50 border-slate-200' %> p-2 rounded-lg border">
      <%= form.date_field :fin, class: "w-full flex-1 bg-transparent border-none outline-hidden text-sm", value: intervention.fin&.to_date, required: terminaison_demandee, data: { 'calc-temps-passe-target': 'fin_date', 'verification-disponibilites-target': 'fin', action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" } %>
      <div class="flex items-center gap-1 bg-white px-2 py-1 rounded-md border border-slate-200 shadow-2xs">
        <%= form.select :fin_hour, (0..23).map { |h| [format('%02d', h), h] }, { selected: heure_saisie(intervention, :fin) }, class: "bg-transparent border-none outline-hidden text-sm cursor-pointer", data: { 'calc-temps-passe-target': 'fin_hour', 'verification-disponibilites-target': 'fin_hour', action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" } %>
        <span class="text-slate-400 font-bold">:</span>
        <%= form.select :fin_minute, (0..59).map { |m| [format('%02d', m), m] }, { selected: minute_saisie(intervention, :fin) }, class: "bg-transparent border-none outline-hidden text-sm cursor-pointer", data: { 'calc-temps-passe-target': 'fin_minute', 'verification-disponibilites-target': 'fin_minute', action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" } %>
      </div>
    </div>
  </div>

 </div> 

  <%= render "interventions/form/temps", form: form, intervention: intervention,
             pause_obligatoire: pause_obligatoire %>
</div>
