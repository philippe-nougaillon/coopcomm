<tr class="hover:bg-base-200/60 transition-colors duration-150">
  <td class="capitalize align-middle px-3 py-3 text-slate-600 font-medium whitespace-nowrap">
    <%= time_ago_in_words(intervention.updated_at) %>
  </td>
  <td class="align-middle pl-2 py-3 text-center w-36">
    <span class="badge inline-block w-34 text-center font-bold <%= intervention.style %>">
      <%= intervention.workflow_state.humanize %>
    </span>
  </td>
  <td class="align-middle pl-12 py-3">
    <div class="flex items-center gap-2 justify-left text-lg sm:text-xl font-semibold text-<%= intervention.style.split.first.split('-').last %>">
      <% if intervention.repeter %>
        <%= embedded_svg "icons/event_repeat.svg", class: "text-slate-700", title: "Modèle pour le pointage" %>
      <% elsif intervention.template_slug %>
        <%= embedded_svg "icons/qr_code_2.svg", title: "Pointage" %>
      <% end %>
      <%= link_to intervention.description.humanize, intervention, class: 'z-10 hover:underline' %>
    </div>
  </td>
  <td class="align-middle px-4  py-3 text-center font-medium text-slate-700">
    <%= intervention.adherent&.nom_prénom %>
  </td>
  <td class="align-middle px-3 py-3 text-xs text-slate-600 min-w-[140px]">
    <% if intervention.début_prévue || intervention.fin_prévue %>
      <div class="flex flex-col gap-0.5 text-center">
        <% if intervention.début_prévue %>
          <div>
            <span class="font-bold text-slate-400 text-[10px] uppercase mr-1">Du:</span>
            <%= l(intervention.début_prévue, format: :custom) %>
          </div>
        <% end %>
        <% if intervention.fin_prévue %>
          <div>
            <span class="font-bold text-slate-400 text-[10px] uppercase mr-1">Au:</span>
            <%= l(intervention.fin_prévue, format: :custom) %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flex justify-center w-full">
        <%= embedded_svg "icons/check_indeterminate_small.svg", title: "Aucun horaires" %>
      </div>
    <% end %>
  </td>
  <td class="align-middle px-2 py-3 text-center text-center font-semibold text-slate-700 whitespace-nowrap">
    <%= intervention.temps_total %> h
  </td>
  <td class="align-middle px-3 py-3 text-center md:text-center">
    <% if !(intervention.validé? || intervention.refusé?) %>
      <div class="my-2">
        <div class="flex justify-center gap-2">
          <% if policy(intervention).terminer? %>
            <%= link_to 'Terminer', terminer_intervention_path(intervention), class: 'z-10 btn btn-primary border border-gray-200 btn-outline btn-xs sm:btn-sm hover:text-white!', title: 'Cliquez pour passer cette intervention en statut \'Terminé\'', 'data-turbo': false, disabled: !intervention.can_terminer? || current_user.adhérent? %>
          <% end %>
          <% if policy(intervention).valider? %>
            <%= link_to 'Valider', valider_intervention_path(intervention), class: 'z-10 btn btn-success border border-gray-200 btn-outline btn-xs sm:btn-sm hover:text-white!', title: 'Cliquez pour passer cette intervention en statut \'Validé\'', 'data-turbo': false, disabled: !intervention.can_valider? %>
          <% end %>
          <% if policy(intervention).refuser? %>
            <%= link_to 'Refuser', refuser_intervention_path(intervention), class: 'z-10 btn btn-error border border-gray-200 btn-outline btn-xs sm:btn-sm hover:text-white!', title: 'Cliquez pour passer cette intervention en statut \'Refusé\'', 'data-turbo': false, disabled: !intervention.can_refuser? %>
          <% end %>
        </div>
      </div>
    <% else %>
      <span class="text-xs italic text-slate-400 font-medium">Aucune action</span>
    <% end %>
  </td>
</tr>