<% page_title!('Pointage "' + @intervention.description + '"') %>
<h1 class="text-2xl sm:text-4xl text-primary font-bold mb-12">
  CoopComm
</h1>

<p class="text-xl mb-4">
  <strong class="block text-slate-400 mb-1">Intervention</strong>
  <%= @intervention.description %>
</p>


<h3 class="text-xl mb-4">
  <strong class="block text-slate-400 mb-1">Agent(s)</strong>
  <% @intervention.agents.each do |agent| %>
    <%= agent.nom_prénom %>
    <br>
  <% end %>
</h3>

<ul class="timeline timeline-vertical mt-8" data-controller="geolocation" data-location-url-value="<%= update_location_intervention_url %>">
  <li>
    <div class="timeline-start">Heure d'arrivée</div>
    <div class="timeline-middle">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-5 w-5 text-success">
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
          clip-rule="evenodd" />
      </svg>
    </div>
    <div class="timeline-end timeline-box mb-4"><%= l(@intervention.début, format: :short) %></div>
    <hr />
  </li>
  <li>
    <hr />
    <div class="timeline-start">Heure de départ</div>
    <div class="timeline-middle">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-5 w-5 <%= 'text-success' if @intervention.fin %>">
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
          clip-rule="evenodd" />
      </svg>
    </div>
    <% if @intervention.fin %>
      <div class="timeline-end timeline-box mt-4">
        <%= l(@intervention.fin, format: :short) %>
        <br>
        Durée : 
        <br>
        <%= @intervention.durée_humanized %>
      </div>
    <% end %>
  </li>
</ul>

<% if @intervention.fin && flash[:notice] %>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <script>
    confetti({});
  </script>
<% end %>