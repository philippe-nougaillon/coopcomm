<%#
  Formulaire d'intervention pour les adhérents, les managers et les
  administrateurs — les agents ont le leur (`_form_for_agents`).
  Chaque bloc est un partial, et sa présence est décidée par InterventionPolicy.
%>
<% terminaison_demandee = params[:terminer].present? %>
<%
  controleurs = []
  controleurs << "verification-disponibilites" if policy(intervention).verifier_disponibilites?
  controleurs << "dynamic-select" if policy(intervention).cascade_services?

  donnees_form = {}
  if controleurs.any?
    donnees_form[:controller] = controleurs.join(" ")
    donnees_form[:verification_disponibilites_intervention_id_value] = intervention.id if intervention.persisted?
    if policy(intervention).cascade_services?
      donnees_form[:dynamic_select_url_value] = services_for_adherent_interventions_path
      donnees_form[:dynamic_select_agents_url_value] = agents_for_service_interventions_path
    end
  end
%>

<%= form_with(model: intervention,
              url: (create_intervention_modele_pointage_interventions_path if intervention.repeter && intervention.new_record?),
              class: "max-w-5xl mx-auto space-y-8 pb-12",
              data: donnees_form) do |form| %>

  <%# Transmis par un champ caché : un formulaire GET perd la query string de son action. %>
  <%= hidden_field_tag :terminer, 1 if terminaison_demandee %>

  <% if terminaison_demandee %>
    <div class="alert bg-sky-50 border border-sky-200 text-sky-800 rounded-xl p-4 flex items-start gap-3">
      <%= embedded_svg "icons/info.svg", class: "w-5 h-5 shrink-0 mt-0.5" rescue nil %>
      <div>
        <p class="font-semibold">Complétez les informations pour terminer cette intervention</p>
        <p class="text-sm mt-1">Les champs <strong>Agents</strong>, <strong>Début</strong>, <strong>Fin</strong> et <strong>Pause</strong> ci-dessous sont obligatoires. Une fois enregistrés, l'intervention passera automatiquement au statut « Terminé ».</p>
      </div>
    </div>
  <% end %>

  <%= render "interventions/form/erreurs", intervention: intervention %>

  <div class="<%= intervention.repeter ? 'grid grid-cols-1 gap-6 items-start' : 'space-y-8' %>">

    <section class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs space-y-6 <%= 'h-full' if intervention.repeter %>">
      <%= render "interventions/form/demande", form: form, intervention: intervention %>
    </section>

    <% if policy(intervention).saisir_assignation? %>
      <div data-controller="calc-temps-passe" class="space-y-6">
        
        <section class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs space-y-6 <%= 'h-full' if intervention.repeter %>">
          <%= render "interventions/form/assignation", form: form, intervention: intervention,
                    terminaison_demandee: terminaison_demandee %>
        </section>

        <% if policy(intervention).saisir_realisation? %>
          <section class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs space-y-6 <%= 'h-full' if intervention.repeter %>">
            <%= render "interventions/form/realisation", form: form, intervention: intervention,
                      terminaison_demandee: terminaison_demandee %>
          </section>
        <% end %>

      </div>
    <% end %>

    <% if policy(intervention).saisir_commentaires? %>
      <%= render "interventions/form/commentaires_photos", form: form, intervention: intervention %>
    <% end %>

    <% if saisir_compte_rendu?(intervention, terminaison_demandee) %>
      <%= render "interventions/form/compte_rendu", form: form, intervention: intervention %>
    <% end %>

    <div class="flex flex-col sm:flex-row gap-3 mt-4 pt-4">
      <%= button_tag "Annuler", type: "button", onclick: "history.back();", class: "btn flex-1" %>
      <%= form.submit "Enregistrer", id: "enregistrer_intervention", class: "btn btn-primary flex-1" %>
    </div>

  </div>
<% end %>

<div class="max-w-5xl mx-auto pt-6 pb-12">
  <%= link_to interventions_path, class: "inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
    <%= embedded_svg "icons/arrow_back.svg", class: "w-4 h-4 transition-transform group-hover:-translate-x-1", title: "Retour à la liste des interventions" %>
    Retour à la liste des interventions
  <% end %>
</div>
