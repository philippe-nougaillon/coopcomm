<div id="<%= dom_id intervention %>" class="border-b border-slate-200 collapse collapse-arrow rounded-none <%= 'collapse-open' if !defined?(from_turbo_stream) && intervention.id == @interventions.first.id %>">
  <input type="checkbox" class="h-full min-h-[3rem]"/>
  <div class="collapse-title p-4 sm:p-6">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-3 md:gap-4 pr-6">
      <div class="flex flex-col items-start gap-1.5 min-w-0">
        <div class="flex items-center flex-wrap gap-1.5 text-lg sm:text-xl md:text-2xl text-<%= intervention.style.split.first.split('-').last %>">
          <span class="badge font-bold text-xs uppercase shrink-0 <%= intervention.style %>">
            <%= intervention.workflow_state.humanize %>
          </span>
          <%= link_to intervention.description.humanize, intervention, class: 'z-10 hover:underline break-words font-semibold' %>
          <% if intervention.repeter %>
            <%= embedded_svg "icons/event_repeat.svg", title: "Modèle pour le pointage", class: "w-5 h-5 text-slate-500 shrink-0" %>
          <% elsif intervention.template_slug %>
            <%= embedded_svg "icons/qr_code_2.svg", title: "Pointage", class: "w-5 h-5 text-slate-500 shrink-0" %>
          <% end %>
        </div>
        <div class="text-xs text-slate-400">
          <i class="<%= 'text-error animate-pulse font-black' if defined?(from_turbo_stream) %>">
            <%= time_tag(intervention.updated_at, format: :long) { "il y a #{time_ago_in_words(intervention.updated_at)}" } %>
          </i>
        </div>
        <% if intervention.tags.any? %>
          <div class="flex flex-wrap gap-1">
            <% intervention.tags.each do |tag| %>
              <span class="badge badge-primary badge-outline text-[11px] h-auto py-0.5"><%= tag.name.humanize %></span>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if !(intervention.validé? || intervention.refusé?) %>
        <div class="flex justify-center gap-2">
          <%= render "interventions/boutons_workflow", intervention: intervention,
                     styles: InterventionsHelper::STYLES_LISTE,
                     titres: InterventionsHelper::TITRES_LISTE,
                     classe_form: 'contents' %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="collapse-content px-4 sm:px-6 pb-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 pt-4 border-t border-slate-100 text-sm">
      <div class="space-y-3 min-w-0">
        <div>
          <strong class="block text-xs font-bold text-slate-400 uppercase">Adhérent</strong>
          <span class="font-semibold text-slate-700 block truncate"><%= intervention.adherent.try(:nom_prénom) || '-' %></span>
        </div>
        <div>
          <strong class="block text-xs font-bold text-slate-400 uppercase">Service</strong>
          <span class="font-semibold text-slate-700 block truncate"><%= intervention.service&.nom || '-' %></span>
        </div>
      </div>
      <div class="space-y-2 min-w-0">
        <% if !intervention.agents.any? %>
          <div>
            <strong class="block text-xs font-bold text-slate-400 uppercase">Agent</strong>
            <span class="text-slate-400 italic text-xs">Aucun</span>
          </div>
        <% else %>
          <% intervention.agents.each_with_index do |agent, index| %>
            <div>
              <strong class="block text-xs font-bold text-slate-400 uppercase">Agent #<%= index + 1 %></strong>
              <span class="font-semibold text-slate-700 block truncate"><%= agent.nom_prénom %></span>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="space-y-2 min-w-0">
        <div>
          <strong class="block text-xs font-bold text-slate-400 uppercase">Début / Fin</strong>
          <p class="text-xs text-slate-700">
            <%= intervention.début ? l(intervention.début, format: :short) : 'non renseigné' %>
          </p>
          <p class="text-xs text-slate-700">
            <%= intervention.fin ? l(intervention.fin, format: :short) : 'non renseignée' %>
          </p>
        </div>
      </div>
      <div class="space-y-1 min-w-0">
        <div>
          <strong class="block text-xs font-bold text-slate-400 uppercase">Temps passé</strong>
          <span class="text-xs font-semibold text-slate-700"><%= intervention.temps_par_agent %> h</span>
        </div>
        <div>
          <strong class="block text-xs font-bold text-slate-400 uppercase">Temps total</strong>
          <span class="text-xs font-semibold text-slate-700"><%= intervention.temps_total %> h</span>
        </div>
        <div>
          <strong class="block text-xs font-bold text-slate-400 uppercase">Pause</strong>
          <span class="text-xs text-slate-500"><%= intervention.temps_de_pause %> h</span>
        </div>
      </div>
      <div class="space-y-2 min-w-0">
        <% if !intervention.tools.any? %>
          <div>
            <strong class="block text-xs font-bold text-slate-400 uppercase">Matériel</strong>
            <span class="text-slate-400 italic text-xs">Aucun</span>
          </div>
        <% else %>
          <% intervention.tools.each_with_index do |tool, index| %>
            <div>
              <strong class="block text-xs font-bold text-slate-400 uppercase">Matériel #<%= index + 1 %></strong>
              <span class="font-semibold text-slate-700 block truncate"><%= tool.name %></span>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="space-y-3 min-w-0 lg:col-span-1">
        <div>
        <% unless current_user.adhérent? %>
            <strong class="block text-xs font-bold text-slate-400 uppercase mb-1">Commentaires</strong>
            <p class="text-xs text-slate-600 break-words leading-relaxed max-h-24 overflow-y-auto">
              <%= intervention.commentaires.present? ? truncate(intervention.commentaires, length: 120) : '-' %>
            </p>
          </div>
        <% end %>
        <% if intervention.photos.attached? %>
          <div>
            <% if intervention.photos.count > 1 %>
              <button type="button" onclick="my_modal_<%= intervention.id %>.showModal()" class="block">
                <div class="stack w-20 h-20">
                  <% intervention.photos.limit(3).each do |photo| %>
                    <div class="avatar">
                      <div class="w-20 h-20 rounded-lg overflow-hidden border border-slate-200">
                        <%= image_tag photo, loading: 'lazy', class: "object-cover w-full h-full" %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </button>
            <% else %>
              <div class="avatar">
                <div class="w-20 h-20 rounded-lg overflow-hidden border border-slate-200">
                  <%= link_to image_tag(intervention.photos.last, loading: 'lazy', class: "object-cover w-full h-full"), intervention.photos.last, target: "_blank" %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <% if (intervention.validé? || intervention.refusé?) && !current_user.agent? %>
      <div class="mt-4 pt-3 border-t border-slate-100 flex flex-col gap-1">
        <strong class="block text-xs font-bold text-slate-400 uppercase">Évaluation</strong>
        <div class="rating rating-sm">
          <% 5.times do |index| %>
            <input type="radio" name="rating-<%= intervention.id %>" class="mask mask-star bg-primary" <%= 'checked' if intervention.note == index + 1 %> disabled/>
          <% end %>
        </div>
        <% if intervention.avis.present? %>
          <p class="text-xs text-slate-600 break-words mt-1"><%= intervention.avis %></p>
        <% end %>
      </div>
    <% end %>
    <% if intervention.photos.attached? %>
      <dialog id="my_modal_<%= intervention.id %>" class="modal">
        <div class="modal-box max-w-3xl bg-slate-900/90 text-white p-6">
          <div class="flex justify-end mb-2">
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost text-white">✕</button>
            </form>
          </div>
          <div class="carousel w-full gap-4">
            <% intervention.photos.each do |photo| %>
              <div class="carousel-item w-full justify-center">
                <%= image_tag(photo, class: "max-h-[70vh] object-contain rounded-lg", loading: 'lazy') %>
              </div>
            <% end %>
          </div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>
    <% end %>
  </div>
</div>