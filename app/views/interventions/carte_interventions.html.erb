<div class="w-full">
    <div class="flex flex-wrap justify-between items-center h-12 sm:h-16">
        <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!("Carte des interventions du #{l(DateTime.parse(@date_to_string), format: :long)}") %></h1>
    </div>
</div>

<%= form_tag request.path, method: :get do %>
        <div class="flex flex-wrap items-start w-full gap-4 mt-8">
            <div class="min-w-full md:min-w-36">
                <%= label_tag :search, "Rechercher" %>
                <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-sm w-full', placeholder: 'Nom / Description' %>
            </div>
            <div class="min-w-full md:min-w-36">
                <%= label_tag :date %>
                <%= datetime_field_tag :date, params[:date], onchange:'this.form.submit()', class: 'input input-sm w-full' %>
            </div>
            <div class="min-w-full md:min-w-36">
                <%= label_tag :workflow_state, "Statut" %>
                <%= select_tag :workflow_state,
                                options_for_select(Intervention.workflow_state_humanized, params[:workflow_state]),
                                include_blank: true,
                                class: 'select select-sm w-full',
                                onchange: 'this.form.submit()' %>
            </div>
            <div class="min-w-full md:min-w-36">
                <%= label_tag :tool_ids, "Outil(s)" %>
                <%= select_tag :tool_ids, options_from_collection_for_select(@tools, 'id', 'name', params[:tool_ids]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()', multiple: true %>
            </div>
        </div>

        <div class="flex flex-wrap w-full items-end mt-4">
          <div class="flex flex-wrap gap-4 w-full min-w-fit lg:w-4/12 pr-4">
            <% if current_user.manager? || current_user.agent? %>
                <div class="min-w-full md:min-w-36">
                    <%= label_tag :adherent_id, "Adhérent" %>
                    <%= select_tag :adherent_id, options_from_collection_for_select(@adhérents, :id, :nom_prénom, params[:adherent_id]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()' %>
                </div>

                <% if current_user.manager? %>
                    <div class="min-w-full md:min-w-36">
                    <%= label_tag :team_id, "Équipe" %>
                    <%= select_tag :team_id, options_from_collection_for_select(@teams, 'id', 'nom_prénom', params[:team_id]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()' %>
                    </div>
                <% end %>
            <% end %>

            <% if current_user.manager? || current_user.équipe? %>
                <% if current_user.manager? || current_user.adhérent? %>
                    <div class="min-w-full md:min-w-36">
                    <%= label_tag :service %>
                    <%= select_tag :service, options_for_select(@services, params[:service]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()' %>
                    </div>
                <% end %>

                <div class="min-w-full md:min-w-36">
                    <%= label_tag :agent_ids, "Agent(s)" %>
                    <%= select_tag :agent_ids, grouped_options_for_select(@grouped_agents, params[:agent_ids]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()', multiple: true %>
                </div>
            <% end %>

            <div class="flex flex-wrap gap-1 w-full">
                <%= render TagCloudComponent.new(tags: @tags) %>
            </div>
          </div>
        </div>
<% end %>

<div class="divider"></div>

<div id="map" class="w-full h-150"></div>

<p class="mt-4"><%= @interventions.size %> intervention(s) trouvée(s)</p>

<%= render @interventions %>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV["GOOGLE_MAPS_API_KEY"] %>&loading=async&callback=initMap"></script>

<script>
    let map;
    let center = <%= @map_center %>;

    async function initMap() {

        // Initialisation des bibliothèques nécessaires
        const { Map } = await google.maps.importLibrary("maps");
        const { AdvancedMarkerElement, PinElement } = await google.maps.importLibrary(
          "marker",
        );

        // Initialisation de la map
        map = new google.maps.Map(document.getElementById("map"), {
            center,
            zoom: 11,
            mapId: "549c4681c953f814fa1cd142",
        });

        <% if current_user.adhérent? %>
            // Ajout du marker pour l'adhérent courant
            const pinHost = new PinElement({
                scale: 1.5,
                glyphColor: "white",
            });
            new google.maps.marker.AdvancedMarkerElement({
                map,
                position: <%= current_user.localisation_to_lat_lng_object %>,
                title: "<%= current_user.nom_prénom %>",
                content: pinHost.element
            });
        <% end %>

        // Initialisation des markers

        <% @interventions_localisations_to_marker.each do |to_marker| %>
            // Ajout du marker d'une intervention
            var pinIntervention = new PinElement({
                background: "orange",
            });
            new google.maps.marker.AdvancedMarkerElement({
                map,
                position: <%= to_marker[:position] %>,
                title: "<%= to_marker[:title] %>",
                content: pinIntervention.element
            });
        <% end %>
    }

    // Inutilisée
    function initMarkers() {
        <% @interventions_localisations_to_marker.each do |to_marker| %>
            addMarker( <%= to_marker[:position] %>, "<%= to_marker[:title] %>")
        <% end %>
    }

    // Inutilisée
    async function addMarker(position, title = "") {
        const marker = new google.maps.marker.AdvancedMarkerElement({
            map,
            position: position,
            title: title
        });
    }
</script>

