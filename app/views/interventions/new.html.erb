<div class="mx-auto w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-primary font-bold text-3xl sm:text-4xl whitespace-nowrap">
      <%= current_user.agent? ? page_title!('Bon d\'intervention') : page_title!('Nouvelle intervention') %>
    </h1>
  </div>

  <% if current_user.agent? %>
    <%= render "form_for_agents", intervention: @intervention %>
  <% else %>
    <%= render "form", intervention: @intervention %>
  <% end %>
</div>
