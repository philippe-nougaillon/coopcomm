<%#
  Formulaire d'intervention des agents : bon d'intervention saisi après coup, ou
  modification d'un pointage. Il diffère de `_form` sur trois points, qui sont
  tout ce qui reste à trancher pour une éventuelle fusion :
    - pas de champ description, et le service est figé sur celui de l'agent ;
    - l'adhérent n'est modifiable que sur un bon saisi par un agent ;
    - les dates réelles sont TOUJOURS obligatoires, côte à côte.
%>
<% terminaison_demandee = params[:terminer].present? %>

<%= form_with(model: intervention, class: "max-w-5xl mx-auto space-y-8 pb-12",
              data: { controller: "verification-disponibilites",
                      verification_disponibilites_intervention_id_value: (intervention.id if intervention.persisted?) }) do |form| %>
  
  <%= hidden_field_tag :terminer, 1 if terminaison_demandee %>

  <% if terminaison_demandee %>
    <div class="alert bg-sky-50 border border-sky-200 text-sky-800 rounded-xl p-4 flex items-start gap-3">
      <%= embedded_svg "icons/info.svg", class: "w-5 h-5 shrink-0 mt-0.5" rescue nil %>
      <div>
        <p class="font-semibold">Complétez les informations pour terminer cette intervention</p>
        <p class="text-sm mt-1">Les champs <strong>Agents</strong>, <strong>Début</strong>, <strong>Fin</strong> et <strong>Pause</strong> ci-dessous sont obligatoires. Une fois enregistrés, l'intervention passera automatiquement au statut « Terminé ».</p>
      </div>
    </div>
  <% end %>

  <%= render "interventions/form/erreurs", intervention: intervention %>


  <div class="space-y-8">
    <section class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs space-y-6">
      <div class="border-b border-slate-100 pb-3 flex items-center gap-2">
        <span class="w-2 h-6 bg-[#40b3db] rounded-full"></span>
        <h2 class="text-xl text-slate-800 font-black tracking-tight uppercase">Demande</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="col-span-1 md:col-span-2">
          <%# L'adhérent est figé dès que la demande ne vient pas de l'agent
              lui-même, et sur toute fille de pointage. %>
          <% if intervention.persisted? && (!intervention.bon? || intervention.template_slug.present?) %>
            <%= form.label :adherent_id, "Adhérent", class: "label font-semibold text-slate-700" %>
            <%= form.text_field :adherent_id, value: intervention.adherent&.nom_prénom, class: "input input-bordered w-full bg-slate-50 text-slate-500", disabled: true %>
          <% else %>
            <div>
              <%= form.label :adherent_id, class: "label font-semibold text-slate-700" do %>
                <span>Adhérent <span class="text-red-500">*</span></span>
              <% end %>
              <%= form.select :adherent_id,
                              options_from_collection_for_select(@adhérents, :id, :nom_prénom, intervention.adherent_id),
                              { include_blank: true, required: true },
                              class: "slim-select w-full h-10" %>
            </div>
          <% end %>
          <%= form.hidden_field :service_id, value: current_user.services.first.id %>
        </div>
      </div>
    </section>

    <section data-controller="calc-temps-passe" class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs space-y-6">
      <div class="border-b border-slate-100 pb-3 flex items-center gap-2">
        <span class="w-2 h-6 bg-[#681b98] rounded-full"></span>
        <h2 class="text-xl text-slate-800 font-black tracking-tight uppercase">Assignation</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div data-verification-disponibilites-target="formAgents">
          <% agents_obligatoires = terminaison_demandee || intervention.terminé? %>
          <%= form.label :agent_ids, class: "label font-semibold text-slate-700" do %>
            Agents <%= raw('<span class="text-red-500">*</span>') if agents_obligatoires %>
          <% end %>
          <%# `data-mandatory` empêche slim-select de désélectionner l'agent
              connecté ; un pointage n'accepte qu'un seul agent, d'où le verrou. %>
          <%= form.select :agent_ids,
                          options_for_select(
                            @agents.map { |nom, id| id == current_user.id ? [nom, id, { data: { mandatory: true } }] : [nom, id] },
                            selected: (Array(intervention.agent_ids) + [current_user.id]).uniq
                          ),
                          {},
                          class: "w-full h-10", multiple: true,
                          disabled: intervention.template_slug.present?,
                          data: {
                            controller: 'slim-select',
                            'calc-temps-passe-target': 'agents',
                            'verification-disponibilites-target': 'agents',
                            action: "change->calc-temps-passe#calc"
                          } %>
        </div>
        <div data-verification-disponibilites-target="formTools">
          <%= form.label :tool_ids, "Matériel(s)", class: "label font-semibold text-slate-700" %>
          <%= form.select :tool_ids,
                          options_from_collection_for_select(@tools, 'id', 'name', intervention.tool_ids.presence || params[:tool_ids]),
                          {},
                          class: "slim-select w-full h-10", multiple: true,
                          'data-verification-disponibilites-target': "tools" %>
        </div>
        <div class="col-span-1 md:col-span-2">
          <%= render "interventions/form/mots_cles", form: form, intervention: intervention,
                     champ: :tags_intervenant %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
        <div>
          <%= form.label :début, class: "label font-semibold text-slate-700" do %>
            Début <span class="text-red-500">*</span>
          <% end %>
          <div class="flex items-center gap-2  <%= terminaison_demandee && intervention.début.blank? ?  'bg-amber-50 border-amber-300' : 'bg-slate-50 border-slate-200' %> p-2 rounded-lg border">
            <%= form.date_field :début,
                                class: "flex-1 bg-transparent border-none outline-hidden text-sm",
                                value: (params[:début]&.to_date || intervention.début&.to_date || (intervention.new_record? ? Date.current : nil)),
                                data: { 'calc-temps-passe-target': 'debut_date',
                                        'verification-disponibilites-target': 'debut',
                                        action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" },
                                required: true %>
            <div class="flex items-center gap-1 bg-white px-2 py-1 rounded-md border border-slate-200 shadow-2xs">
              <%= form.select :début_hour, 
                               options_for_select((0..23).map { |h| [format('%02d', h), h] },
                              params[:début_hour] || intervention.début&.hour),
                              { include_blank: '--' },
                              class: "bg-transparent border-none outline-hidden text-sm cursor-pointer",
                              data: { 'calc-temps-passe-target': 'debut_hour',
                                      'verification-disponibilites-target': 'debut_hour',
                                      action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" },
                              required: true %>
              <span class="text-slate-400 font-bold">:</span>
              <%= form.select :début_minute, 
                              options_for_select((0..59).map { |m| [format('%02d', m), m] },
                                                 params[:début_minute] || intervention.début&.min),
                              { include_blank: '--' },
                              class: "bg-transparent border-none outline-hidden text-sm cursor-pointer",
                              data: { 'calc-temps-passe-target': 'debut_minute',
                                      'verification-disponibilites-target': 'debut_minute',
                                      action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" },
                              required: true %>
            </div>
          </div>
        </div>
        <div>
          <%= form.label :fin, class: "label font-semibold text-slate-700" do %>
            Fin <span class="text-red-500">*</span>
          <% end %>
          <div class="flex items-center gap-2  <%= terminaison_demandee && intervention.fin.blank? ?  'bg-amber-50 border-amber-300' : 'bg-slate-50 border-slate-200' %> p-2 rounded-lg border">
            <%= form.date_field :fin,
                                class: "flex-1 bg-transparent border-none outline-hidden text-sm",
                                value: (params[:fin].try(:to_date) || intervention.fin&.to_date),
                                data: { 'calc-temps-passe-target': 'fin_date',
                                        'verification-disponibilites-target': 'fin',
                                        action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" },
                                required: true %>
            <div class="flex items-center gap-1 bg-white px-2 py-1 rounded-md border border-slate-200 shadow-2xs">
              <%= form.select :fin_hour, 
                              options_for_select((0..23).map { |h| [format('%02d', h), h] },
                                                 params[:fin_hour] || intervention.fin&.hour),
                              { include_blank: '--' },
                              class: "bg-transparent border-none outline-hidden text-sm cursor-pointer",
                              data: { 'calc-temps-passe-target': 'fin_hour',
                                      'verification-disponibilites-target': 'fin_hour',
                                      action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" },
                              required: true %>
              <span class="text-slate-400 font-bold">:</span>
              <%= form.select :fin_minute, 
                              options_for_select((0..59).map { |m| [format('%02d', m), m] },
                                                 params[:fin_minute] || intervention.fin&.min),
                              { include_blank: '--' },
                              class: "bg-transparent border-none outline-hidden text-sm cursor-pointer",
                              data: { 'calc-temps-passe-target': 'fin_minute',
                                      'verification-disponibilites-target': 'fin_minute',
                                      action: "change->calc-temps-passe#calc change->verification-disponibilites#verificationWithInput" },
                              required: true %>
            </div>
          </div>
        </div>
      </div>

      <%= render "interventions/form/temps", form: form, intervention: intervention,
                 pause_obligatoire: true %>
    </section>

    <%= render "interventions/form/commentaires_photos", form: form, intervention: intervention %>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 pt-4">
    <%= button_tag "Annuler", type: "button", onclick: "history.back();", class: "btn flex-1" %>
    <%= form.submit "Enregistrer", id: "enregistrer_intervention", class: "btn btn-primary text-white font-bold flex-1 order-1 sm:order-2 shadow-md hover:shadow-lg transition-all" %>
  </div>

  <div class="pt-4">
    <%= link_to interventions_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "w-4 h-4 transition-transform group-hover:-translate-x-1 fill-current" rescue nil %>
      Retour à la liste des interventions
    <% end %>
  </div>
<% end %>
