<% if current_user&.agent? && audit.audited_changes.keys.map(&:to_s) == ['note'] %>
  <% return %>
<% end %>
<tr class="hover:bg-base-300">
  <td class="whitespace-nowrap">
    <%= time_tag(audit.created_at, format: :long) { "Il y a #{time_ago_in_words(audit.created_at)}" } %>
    <br>
    (<%= l(audit.created_at, format: :long) %>)
  </td>
  <td>
    <% if audit.user_id %>
      <% if audit.user %>
        <%= audit.user.email %>
        (#<%= audit.user.id %>)
        <br>
        <%= audit.user.rôle.humanize %>
        <br>
      <% end %>
    <% else %>
      SYSTEM CONSOLE
    <% end %>
  </td>
  <td>
    <%= audit.auditable_type %>
  </td>
  <td>
    <%= audit.action.humanize %>
  </td>
  <td class="whitespace-nowrap">
    <%= audit_details(audit, current_user) %>
  </td>
</tr>
