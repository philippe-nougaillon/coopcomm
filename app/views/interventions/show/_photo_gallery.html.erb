<%# locals: (photos:, compact: false, titre: "Photos", message_vide: nil, supprimable: true, chemin_suppression: nil) %>

<span class="block text-xs font-bold text-slate-400 uppercase tracking-wider <%= compact ? 'mb-2' : 'mb-3' %>">
  <%= titre %>
</span>

<% if photos.attached? %>
  <div class="flex flex-wrap gap-3 <%= 'max-h-48 overflow-y-auto p-1' if compact %>">
    <% photos.each do |photo| %>
      <div class="relative group flex-shrink-0">
        <div class="w-28 h-28 rounded-xl border border-slate-200 overflow-hidden bg-white shadow-xs hover:shadow-md transition-all">
          <%= link_to image_tag(photo, loading: 'lazy', class: "w-full h-full object-cover"), photo, target: "_blank", rel: "noopener" %>
        </div>

        <% if supprimable %>
          <button type="button" 
                  onclick="document.getElementById('delete_photo_modal_<%= photo.id %>').showModal()"
                  class="absolute -top-2 -right-2 bg-white text-red-500 rounded-full p-1.5 shadow-md border border-slate-200 hover:bg-red-50 hover:text-red-600 transition-all z-10">
            <%= embedded_svg "icons/delete.svg", class: "w-3.5 h-3.5", title: "Supprimer" %>
          </button>

          <dialog id="delete_photo_modal_<%= photo.id %>" class="modal">
            <div class="modal-box">
              <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
              </form>
              <h3 class="text-lg font-bold text-error flex items-center gap-2">
                <%= embedded_svg "icons/delete.svg", class: "w-6 h-6 fill-current text-error", title: "Supprimer" %>
                Supprimer la photo
              </h3>
              <p class="py-4 text-sm text-slate-600 text-left">
                Êtes-vous bien certain.e de vouloir supprimer définitivement cette photo ? 
                Cette action est irréversible.
              </p>
              <div class="modal-action">
                <form method="dialog">
                  <button class="btn btn-ghost">Annuler</button>
                </form>
                
                <% target_path = chemin_suppression.is_a?(Proc) ? chemin_suppression.call(photo) : (chemin_suppression || purge_intervention_path(photo_id: photo.id)) %>
                
                <%= button_to target_path,
                              method: :delete,
                              class: "btn btn-error text-white" do %>
                  Oui, supprimer
                <% end %>
              </div>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>Fermer</button>
            </form>
          </dialog>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-slate-400 italic text-sm <%= 'pt-2' unless compact %>">
    <%= message_vide || "Aucune photo n'est attachée#{compact ? '.' : ' à cette intervention.'}" %>
  </p>
<% end %>