<%# locals: (intervention:, routes_response:) %>
<% affiche_trajet = trajet_affichable?(intervention) %>

<section class="mb-10">
  <div class="flex items-center gap-2 mb-4">
    <span class="w-1.5 h-6 rounded-full bg-gradient-to-b from-[#681b98] via-[#9fd9ec] to-[#40b3db]"></span>
    <h2 class="text-xl text-slate-800 font-bold tracking-tight uppercase">Intervention</h2>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="p-6 grid grid-cols-1 gap-6 items-start <%= affiche_trajet ? 'lg:grid-cols-[1fr_1.3fr] lg:grid-rows-2' : 'md:grid-cols-2 lg:grid-cols-3' %>">

      <div class="<%= 'lg:col-start-1 lg:row-start-1' if affiche_trajet %> bg-slate-50/70 p-4 rounded-xl border border-slate-100 space-y-3">
        <div>
          <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Début</span>
          <% if intervention.début.present? %>
            <p class="text-sm font-semibold mt-0.5 text-slate-800"><%= l(intervention.début, format: :long) %></p>
          <% else %>
            <span class="text-slate-400 italic text-sm">Non renseigné</span>
          <% end %>
        </div>
        <div class="border-t border-slate-200/60 pt-3">
          <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Fin</span>
          <% if intervention.fin.present? %>
            <p class="text-sm font-semibold mt-0.5 text-slate-800"><%= l(intervention.fin, format: :long) %></p>
          <% else %>
            <span class="text-slate-400 italic text-sm">Non renseignée</span>
          <% end %>
        </div>
      </div>

      <div class="<%= 'lg:col-start-1 lg:row-start-2' if affiche_trajet %> bg-slate-50/70 p-4 rounded-xl border border-slate-100 flex flex-col justify-between space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Temps passé</span>
          <span class="w-24 text-center text-sm font-bold text-slate-800 bg-white py-1 rounded-md border border-slate-200 shadow-xs">
            <%= intervention.temps_par_agent %> h
          </span>
        </div>
        <div class="flex items-center justify-between border-t border-slate-200/60 pt-2">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Temps total</span>
          <span class="w-24 text-center text-sm font-bold text-slate-800 bg-white py-1 rounded-md border border-slate-200 shadow-xs">
            <%= intervention.temps_total %> h
          </span>
        </div>
        <div class="flex items-center justify-between border-t border-slate-200/60 pt-2">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Pause</span>
          <span class="w-24 text-center text-sm font-medium text-slate-500 bg-white py-1 rounded-md border border-slate-200 shadow-xs">
            <%= intervention.temps_de_pause %> h
          </span>
        </div>
      </div>

      <div class="<%= affiche_trajet ? 'lg:col-start-2 lg:row-start-1 lg:row-span-2' : '' %> bg-slate-50/70 p-4 rounded-xl border border-slate-100 flex flex-col h-full min-h-[12rem]">
        <% if affiche_trajet %>
          <%= render "interventions/show/trajet", intervention: intervention, routes_response: routes_response %>
        <% else %>
          <%= render "interventions/show/photo_gallery", photos: intervention.photos, compact: true %>
        <% end %>
      </div>
    </div>

    <div class="p-6 border-t border-slate-100 bg-white">
      <div class="grid grid-cols-1 <%= affiche_trajet ? 'md:grid-cols-2 gap-6' : 'w-full' %>">
        <div class="<%= 'md:border-r md:border-slate-100 md:pr-6' if affiche_trajet %> space-y-2">
          <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Commentaires</span>
          <div class="bg-slate-50/60 rounded-xl p-3 border border-slate-100 max-h-32 overflow-y-auto <%= intervention.commentaires.present? ? 'min-h-[4rem]' : '' %>">
            <p class="text-slate-700 text-left text-sm leading-relaxed break-words">
              <% if intervention.commentaires.present? %>
                <%= intervention.commentaires %>
              <% else %>
                <span class="text-slate-400 italic text-sm">Aucun commentaire.</span>
              <% end %>
            </p>
          </div>
        </div>
        <% if affiche_trajet %>
          <div class="mt-6 md:mt-0">
            <%= render "interventions/show/photo_gallery", photos: intervention.photos %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>