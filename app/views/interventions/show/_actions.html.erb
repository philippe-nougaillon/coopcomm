<%# locals: (intervention:) %>
<% if actions_workflow_disponibles?(intervention) %>
  <section class="mb-10">
    <div class="flex items-center gap-2 mb-3 pt-3">
      <span class="w-2 h-6 rounded-full bg-gradient-to-b from-[#40b3db] via-[#9fd9ec] to-[#681b98]"></span>
      <h2 class="text-xl text-slate-800 font-black tracking-tight uppercase">Actions</h2>
    </div>
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
      <div>
        <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Actions de validation</span>
        <div class="flex flex-wrap gap-2">
          <%= render "interventions/boutons_workflow", intervention: intervention,
                     styles: { terminer: "btn btn-info btn-outline min-w-20 flex-1 sm:flex-none hover:text-white!",
                               valider: "btn btn-success btn-outline min-w-20 flex-1 sm:flex-none hover:text-white!",
                               refuser: "btn btn-error btn-outline min-w-20 flex-1 sm:flex-none hover:text-white!" },
                     titres: { terminer: "Terminer l'intervention",
                               valider: "Valider l'intervention",
                               refuser: "Refuser l'intervention" },
                     classe_form: 'contents' %>
        </div>
      </div>
    </div>
  </section>
<% end %>
