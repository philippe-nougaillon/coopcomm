<%# locals: (intervention:) %>
<div class="bg-slate-50/70 p-4 rounded-xl border border-slate-100 space-y-3">
  <div>
    <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Début</span>
    <% if intervention.début.present? %>
      <p class="text-sm font-semibold mt-0.5 text-slate-800"><%= l(intervention.début, format: intervention.template_slug.present? ? :very_long : :long ) %></p>
    <% else %>
      <span class="text-slate-400 italic text-sm">Non renseigné</span>
    <% end %>
  </div>
  <div class="border-t border-slate-200/60 pt-3">
    <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Fin</span>
    <% if intervention.fin.present? %>
      <p class="text-sm font-semibold mt-0.5 text-slate-800"><%= l(intervention.fin, format: intervention.template_slug.present? ? :very_long : :long ) %></p>
    <% else %>
      <span class="text-slate-400 italic text-sm">Non renseignée</span>
    <% end %>
  </div>
</div>