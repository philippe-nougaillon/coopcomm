<%# locals: (intervention:) %>
<section class="flex flex-col mb-10">
  <div class="pb-3 flex items-center gap-2 mb-3">
    <span class="w-2 h-6 bg-[#40b3db] rounded-full"></span>
    <h2 class="text-xl text-slate-800 font-black tracking-tight uppercase">Demande</h2>
  </div>
  <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex-1 <%= 'h-full' if policy(intervention).voir_assignation? %>">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 <%= 'h-full' if policy(intervention).voir_assignation? %>">
      <div class="space-y-4 flex flex-col justify-start">
        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Adhérent</span>
          <p class="text-slate-800 font-semibold">
            <% if current_user.manager_or_admin? && intervention.adherent.present? %>
              <%= link_to intervention.adherent.nom_prénom, user_path(intervention.adherent), class: "text-primary hover:underline" %>
            <% else %>
              <%= intervention.adherent.try(:nom_prénom) || "—" %>
            <% end %>
          </p>
        </div>
        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Service</span>
          <span class="inline-block bg-white border border-slate-200 text-slate-600 text-sm px-2.5 py-1 rounded-full whitespace-nowrap shadow-sm">
            <%= intervention.service.nom %>
          </span>
        </div>
      </div>
      <div class="space-y-4 flex flex-col justify-start">
        <div>
          <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Météo</span>
          <% if intervention.meteo.present? %>
            <div class="flex flex-wrap gap-1.5">
              <% intervention.meteo.split('|').each do |info| %>
                <li class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                  <span><%= info.strip %></span>
                </li>
              <% end %>
            </div>
          <% else %>
            <p class="text-slate-400 italic text-sm">Non renseignée</p>
          <% end %>
        </div>
      </div>
      <% unless current_user.adhérent? %>
        <div class="bg-slate-50/80 p-4 rounded-xl border border-slate-100 flex flex-col justify-center space-y-3 h-full">
          <div>
            <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Début prévue</span>
            <% if intervention.début_prévue.present? %>
              <p class="text-sm font-semibold mt-0.5 text-slate-800"><%= l(intervention.début_prévue, format: :long) %></p>
            <% else %>
              <span class="text-slate-400 italic text-sm">Non renseigné</span>
            <% end %>
          </div>
          <div class="border-t border-slate-200/60 pt-3">
            <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Fin prévue</span>
            <% if intervention.fin_prévue.present? %>
              <p class="text-sm font-semibold mt-0.5 text-slate-800"><%= l(intervention.fin_prévue, format: :long) %></p>
            <% else %>
              <span class="text-slate-400 italic text-sm">Non renseignée</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>