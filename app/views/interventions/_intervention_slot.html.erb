<% if interventions.any? %>
  <% intervention = interventions.first %>
  
  <% span_content = capture do %>
    <span class="border-1" 
          style="padding-left: 15px; <%= margin_style %>; background-color: <%= intervention.team&.color || 'red' %>" 
          title="<%= interventions.map(&:get_title_for_cases).join(' | ') %>">
    </span>
  <% end %>

  <%= link_to_if (interventions.one? && policy(intervention).edit?), span_content, edit_intervention_path(intervention) %>

<% else %>
  <%= link_to new_intervention_path(
        tool_ids: tool_id, 
        début_prévue: date, 
        début_prévue_hour: start_hour, 
        début_prévue_minute: local_assigns[:start_minute] || 0, 
        fin_prévue: date, 
        fin_prévue_hour: end_hour
      ), 
      title: new_title do %>
    <span class="border-1 hover:bg-green-500" style="padding-left: 15px; <%= margin_style %>;"></span>
  <% end %>
<% end %>