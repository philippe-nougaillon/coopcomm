<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-3xl md:text-4xl text-primary font-bold">
      <%= page_title!('Interventions') %></h1>
    <div class="flex gap-2">
      <% if policy(Intervention).new_intervention_modele_pointage? %>
        <%= link_to new_intervention_modele_pointage_interventions_path, 
            class: "btn btn-info btn-outline btn-md rounded flex items-center justify-center gap-2 text-base",
        title: "Ajouter un modèle de pointage" do %>
          <%= embedded_svg "icons/qr_code_2_add.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <span class="hidden md:block">Ajouter un modèle de pointage</span>
        <% end %>
      <% end %>
      <%= link_to new_intervention_path, 
      data: { 'testid': "ajouter_intervention_pc" }, 
            class: "btn btn-primary btn-md rounded flex items-center justify-center gap-2 text-sm text-white border border-primary hover:bg-transparent hover:text-primary hover:border-primary",
      title: "Créer une nouvelle intervention " do %>
        <%= embedded_svg "icons/assignment_add.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
        <span class="hidden md:block">Ajouter une Intervention</span>
      <% end %>
    </div>
  </div>
  <%= form_tag request.path, method: :get, class: "pt-6",data: { turbo_action: "advance" } do %>
    <%= champs_tri_caches %>
    <div class="flex flex-col gap-3 w-full bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 items-end w-full">
        <div class="w-full">
          <%= label_tag :search, "Rechercher", class: "block font-semibold text-slate-600 text-sm mb-1" %>
          <%= text_field_tag :search, params[:search], include_blank: false, 
              onchange: 'this.form.requestSubmit()',
              class: 'input input-bordered input-md w-full',
              placeholder: 'Rechercher...' %>
        </div>
        <div class="w-full">
          <%= label_tag :workflow_state, "Statut", class: "block font-semibold text-slate-600 text-sm mb-1" %>
          <%= select_tag :workflow_state, 
              options_for_select(Intervention.workflow_state_humanized { |k, _| I18n.transliterate(k) }, params[:workflow_state]), 
                multiple: true,
                class: 'slim-select w-full h-10',
                data: { placeholder: 'Tous les status' },
                onchange: 'this.form.requestSubmit()' %>
        </div>
        <div class="flex flex-row gap-2 w-full">
          <div class="flex-1" data-controller="date-picker" data-action="click->date-picker#open">
            <%= label_tag :du, 'Du', class: "block font-semibold text-slate-600 text-sm mb-1" %>
            <%= date_field_tag :du, params[:du], 
              class: 'input input-bordered input-md w-full ', 
              onchange: 'this.form.requestSubmit()',
              data: { 'date-picker-target': "input" } %>
          </div>
          <div class="flex-1" data-controller="date-picker" data-action="click->date-picker#open">
            <%= label_tag :au, 'Au', class: "block font-semibold text-slate-600 text-sm mb-1" %>
            <%= date_field_tag :au, params[:au], 
              class: 'input input-bordered input-md w-full ', 
              onchange: 'this.form.requestSubmit()',
              data: { 'date-picker-target': "input" } %>
          </div>
        </div>
      </div>
      <% if current_user.manager_or_admin? || current_user.agent? || current_user.adhérent? %>
        <% filtros_avanzados_activos = params[:adherent_id].present? ||
                                params[:tags].present? ||
                                params[:service].to_a.reject(&:blank?).present? ||
                                params[:agent_ids].present? ||
                                params[:tool_ids].present? %>
        <details class="group w-full" <%= 'open' if filtros_avanzados_activos %>>          <summary class="flex items-center gap-2 text-primary font-semibold text-sm cursor-pointer select-none list-none w-fit pt-2 hover:underline">
            <%= embedded_svg "icons/tune.svg", class: "text-[18px] transition-transform group-open:rotate-180", title: "Fermer" %>
            <span class="group-open:hidden">Plus de critères de filtrage</span>
            <span class="hidden group-open:inline">Moins de critères de filtrage</span>
          </summary>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 items-end w-full pt-4 mt-2 border-t border-slate-200/60 dynamic-filters">
            <% if current_user.manager_or_admin? || current_user.agent? %>
              <div class="w-full">
                <%= label_tag :adherent_id, "Adhérent", class: "block font-semibold text-slate-600 text-sm mb-1" %>
                <%= select_tag :adherent_id, 
                options_from_collection_for_select(@adhérents, :id, :nom_prénom, params[:adherent_id]), 
                
                  multiple: true,
                  data: { placeholder: 'Tous les adhérents' },
                  onchange: 'this.form.requestSubmit()',
                  class: 'slim-select w-full h-10' %>
              </div>
              <div class="w-full">
                <%= label_tag :tags, "Mots clés", class: "block font-semibold text-slate-600 text-sm mb-1" %>
                <%= select_tag "tags[]", 
                    options_from_collection_for_select(@intervention_tags, :name, :name, params[:tags]), 
                    multiple: true,
                class: 'slim-select w-full h-10', 
                data: { placeholder: 'Tous les mots-clés' },
                onchange: 'this.form.requestSubmit()' %>
              </div>
            <% end %>
            <% if current_user.manager_or_admin? || current_user.adhérent? %>
              <%# Filtre service masqué si le current_user n'a qu'un seul service (sauf administrateur, qui filtre sur toute l'organisation). %>
              <% if current_user.administrateur? || @services.size > 1 %>
                <div class="w-full">
                  <%= label_tag :service, "Service", class: "block font-semibold text-slate-600 text-sm mb-1" %>
                  <%# Champ caché : garantit que `service[]` est TOUJOURS soumis, même
                      filtre vidé → le contrôleur distingue « premier affichage » (param
                      absent → services présélectionnés) de « filtre vidé » (param présent
                      vide → tout le périmètre). Cf. ApplicationController#scoped_services. %>
                  <%= hidden_field_tag 'service[]', '', id: nil %>
                  <%= select_tag :service, options_from_collection_for_select(@services, 'id', 'nom', @selected_service_ids),
                      multiple: true,
                      class: 'slim-select w-full h-10',
                      data: { placeholder: 'Tous les services' },
                      onchange: 'this.form.requestSubmit()' %>
                </div>
              <% end %>
              <div class="w-full">
                <%= label_tag :agent_ids, "Agent(s)", class: "block font-semibold text-slate-600 text-sm mb-1" %>
                <%= select_tag :agent_ids, grouped_options_for_select(@grouped_agents, params[:agent_ids]), 
                  multiple: true,
                  class: 'slim-select w-full h-10',
                  data: { placeholder: 'Tous les agents' },
                  onchange: 'this.form.requestSubmit()' %>
              </div>
            <% end %>
            <div class="w-full">
              <%= label_tag :tool_ids, "Matériel(s)", class: "block font-semibold text-slate-600 text-sm mb-1" %>
              <%= select_tag :tool_ids, options_from_collection_for_select(@tools, 'id', 'name', params[:tool_ids]), 
                  multiple: true,
                  class: 'slim-select w-full h-10',
                  data: { placeholder: 'Tous les matériels' },
                  onchange: 'this.form.requestSubmit()' %>
            </div>
            
          </div>
        </details>
      <% end %>
    </div>
    <hr class="mt-6 mb-6">
    <div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
      <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-slate-500 hidden sm:inline">Affichage:</span>
        <div class=" join ">
          <label class="btn btn-primary btn-outline btn-sm join-item <%= 'btn-active text-white!' if params[:vue] == 'normal' %>" for="btnradio1" title="Mode normal">
            <%= embedded_svg "icons/density_small.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
            <span class="text-[11px] font-medium">Normal</span>
          </label>
          <%= radio_button_tag :vue, "normal", (params[:vue] == 'normal'), name: 'vue', id: 'btnradio1', onchange: 'this.form.submit()', class: 'hidden' %>
          <label class="btn btn-primary btn-outline btn-sm join-item rounded-r <%= 'btn-active text-white!' if params[:vue] == 'compact' %>" for="btnradio2" title="Mode compact">
            <%= embedded_svg "icons/compress.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
            <span class="text-[11px] font-medium">Compact</span>
          </label>
          <%= radio_button_tag :vue, 'compact', (params[:vue] == 'compact'), name: 'vue', id: 'btnradio2', onchange: 'this.form.submit()', class: 'hidden' %>
        </div>
      </div>
    </div>
  <% end %>
    <% if params[:vue] == 'compact' %>
      <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
        <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "swipe" %>
        <span>Faire glisser pour voir plus</span>
      </div>
    <% end %>
    <%# Abonnement Turbo Stream par rôle : reçoit le prepend live d'une nouvelle
        intervention selon le périmètre du rôle. Cf. Intervention#broadcast_channels. %>
    <% if current_user.agent? %>
      <%= turbo_stream_from "interventions_user_#{current_user.id}" %>
    <% elsif current_user.adhérent? %>
      <%= turbo_stream_from "interventions_adherent_#{current_user.id}" %>
    <% elsif current_user.administrateur? %>
      <%= turbo_stream_from "interventions_organisation_#{current_organisation.id}" %>
    <% elsif current_user.manager? %>
      <% current_user.services.each do |service| %>
        <%= turbo_stream_from "interventions_service_#{service.id}" %>
      <% end %>
    <% end %>
    <% if @interventions.present? %>
      <% if params[:vue] == 'normal' %>
        <%= render partial: 'intervention', collection: @interventions, as: :intervention,
                   cached: ->(intervention) { [intervention, current_user] } %>
      <% else %>
        <%= render partial: 'view_compact' %>
      <% end %>
    <% else %>
      <div class="flex items-center justify-center py-12">
        <span class="text-slate-400 text-base italic">
          Aucun résultat trouvé pour cette recherche.
        </span>
      </div>
    <% end %>

  <div class="flex flex-col bg-white border-x border-b border-slate-200 rounded-b-xl">
    <div class=" flex flex-wrap justify-end items-center gap-2 p-4">
      <% if @interventions.any? %>
          <%= link_to url_for(intervention_filter_params.merge(format: :xls)), 
                class: "btn btn-primary btn-outline btn-md rounded flex items-center justify-center gap-2 text-base w-full sm:w-auto" do %>
          <%= embedded_svg "icons/upload.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
          <span>Exporter en XLS</span>
        <% end %>
      <% end %>
      
    </div>


    
    <% if @pagy.pages > 1 %>
      <div class=" flex flex-col justify-center  p-4 border-t border-slate-100 bg-slate-50/50 w-full">
        <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
          <%= pagy_nav(@pagy).html_safe %>
        </div>
        <div class=" text-slate-500 text-center text-sm w-full ">
          <%= pagy_info(@pagy, item_name: "interventions").html_safe %>
        </div>
      <% else %>
        <div></div>
      <% end %>
    </div>
</div>
