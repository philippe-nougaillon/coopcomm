<div class="w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!('Interventions') %></h1>
    <div class="flex gap-8">
      <% if policy(Intervention).new_intervention_pointage? %>
        <%= link_to "Ajouter un modèle de pointage", new_intervention_pointage_interventions_path, class: "hidden sm:inline-flex btn btn-outline btn-warning btn-lg rounded hover:text-white!" %>
      <% end %>
      <%= link_to "Ajouter une Intervention", new_intervention_path, data: { 'testid': "ajouter_intervention_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-lg rounded btn-outline hover:text-white!" %>
      <%= link_to "+ Intervention", new_intervention_path, data: { 'testid': "ajouter_intervention_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:text-white!" %>
    </div>
  </div>

  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap mt-8">
      
      <div class="flex gap-4 w-full lg:w-4/12 lg:pr-4">
        <div class="w-full">
          <%= label_tag :search, "Rechercher" %>
          <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-sm w-full', placeholder: 'Description / Commentaires' %>
        </div>
      </div>
      
      <div class="flex gap-4 w-full lg:w-4/12 lg:pr-4">
        <div class="flex gap-4 w-full items-end">
          <div class="flex-1 min-w-0">
            <%= label_tag :workflow_state, "Statut" %>
            <%= select_tag :workflow_state, 
                            options_for_select(Intervention.workflow_state_humanized, params[:workflow_state]), 
                            include_blank: true,
                            class: 'select select-sm w-full', 
                            onchange: 'this.form.submit()' %>
          </div>
          <div class="flex-1 min-w-0">
            <%= label_tag :du, 'Du' %>
            <%= date_field_tag :du, params[:du], onchange: 'this.form.submit()', class: 'input input-sm w-full' %>
          </div>
        </div>
      </div>

      <div class="flex lg:flex-row-reverse items-end gap-4 w-full lg:w-4/12 lg:pr-4">
        <div class="flex-1 flex w-full gap-2 mb-1 min-w-0">
          <%= check_box_tag :archives, 1, params[:archives], class:'checkbox', onchange:'this.form.submit()' %>
          <%= label_tag :archives, "Archivées ?", class: 'cursor-pointer truncate' %>
        </div>
        <div class="flex-1 min-w-0">
          <%= label_tag :au, 'Au' %>
          <%= date_field_tag :au, params[:au], onchange: 'this.form.submit()', class: 'input input-sm w-full' %>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap w-full items-start mt-2">
      <% if current_user.manager_or_admin? || current_user.agent? %>
        <div class="flex gap-4 w-full lg:w-4/12 lg:pr-4">
          <div class="flex-1 min-w-0">
            <%= label_tag :adherent_id, "Adhérent" %>
            <%= select_tag :adherent_id, options_from_collection_for_select(@adhérents, :id, :nom_prénom, params[:adherent_id]), include_blank: true, class: 'slim-select w-full', onchange: 'this.form.submit()' %>
          </div>
          <div class="flex-1 min-w-0">
            <%= label_tag :tags, "Mots clés" %>
            <%= select_tag "tags[]", 
                  options_from_collection_for_select(@tags, :name, :name, params[:tags]), 
                  multiple: true, 
                  class: 'slim-select w-full', 
                  onchange: 'this.form.submit()' %> 
          </div>
        </div>
      <% end %>

      <% if current_user.manager_or_admin? || current_user.adhérent? %>
        <div class="flex gap-4 w-full lg:w-4/12 lg:pr-4">
          <% if current_user.manager_or_admin? || current_user.adhérent? %>
            <div class="flex-1 min-w-0">
              <%= label_tag :service %>
              <%= select_tag :service, options_from_collection_for_select(@services, 'id', 'nom', params[:service]), include_blank: true, class: 'slim-select w-full', onchange: 'this.form.submit()' %>
            </div>
          <% end %>

          <div class="flex-1 min-w-0">
            <%= label_tag :agent_ids, "Agent(s)" %>
            <%= select_tag :agent_ids, grouped_options_for_select(@grouped_agents, params[:agent_ids]), class: 'slim-select w-full', onchange: 'this.form.submit()', multiple: true %>
          </div>
        </div>
      <% end %>

      <div class="flex gap-4 w-full lg:w-4/12 lg:pr-4 items-start">
        <div class="flex-1 min-w-0">
          <%= label_tag :tool_ids, "Matériel(s)" %>
          <%= select_tag :tool_ids, options_from_collection_for_select(@tools, 'id', 'name', params[:tool_ids]), include_blank: true, class: 'slim-select w-full', onchange: 'this.form.submit()', multiple: true %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="w-full sm:w-fit">
            <%= label_tag :vue, 'Mode' %>
            <br>
            <div class="join">
              <label class="btn btn-primary btn-outline btn-sm join-item <%= 'btn-active text-white!' if params[:vue] == 'normal' %>" for="btnradio1" title="Mode normal">
                <span class="material-symbols-outlined">
                  density_small
                </span>
              </label>
              <%= radio_button_tag :vue, "normal", (params[:vue] == 'normal'), name: 'vue', id: 'btnradio1', autocomplete: 'off', onchange: 'this.form.submit()', class: 'hidden' %>

              <%= radio_button_tag :vue, 'compact', (params[:vue] == 'compact'), name: 'vue', id: 'btnradio2', autocomplete: 'off', onchange: 'this.form.submit()', class: 'hidden' %>
              <label class="btn btn-primary btn-outline btn-sm join-item <%= 'btn-active text-white!' if params[:vue] == 'compact' %>" for="btnradio2" title="Mode compact">
                <span class="material-symbols-outlined">
                  compress
                </span>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <hr class="mt-4">

  <div id="interventions" class="min-w-full">
    <% if current_user.agent? %>
      <%= turbo_stream_from "interventions_user_#{current_user.id}" %>
    <% else %>
      <%= turbo_stream_from "interventions_organisation_#{current_user.organisation.id}" %>
    <% end %>

    <% if params[:vue] == 'normal' %>
      <%= render @interventions %>
    <% else %>
      <%= render partial: 'view_compact' %>
    <% end %>
  </div>

  <div class="my-6">
    <%== pagy_info(@pagy) %>
    <%== pagy_nav(@pagy) %>
  </div>

  <% if @interventions.any? %>
    <!--
    <p class="text-sm mt-4">
      Nombre d'interventions par statut : <%= JSON.pretty_generate(Intervention.workflow_states_count(@interventions)) %>
      <br><br>
    </p>
    -->
    <%= link_to "Exporter les interventions en XLS", url_for(params.permit!.merge(format: :xls)), class: "text-sm btn btn-sm btn-outline btn-success hover:text-white!" %>
  <% end %>

</div>
