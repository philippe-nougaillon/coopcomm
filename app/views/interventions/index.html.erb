<div class="w-full">
  <div class="flex flex-wrap justify-between items-center">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold">Interventions</h1>
    <%= link_to "Ajouter une Intervention", new_intervention_path, data: { 'testid': "ajouter_intervention_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-lg rounded btn-outline hover:!text-white" %>
    <%= link_to "+", new_intervention_path, data: { 'testid': "ajouter_intervention_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:!text-white" %>
  </div>

  <%= form_tag request.path, method: :get, class: 'mt-4 ring ring-base-200' do %>
    <details data-testid="filtres_interventions" class="collapse collapse-arrow">
      <summary class="collapse-title text-lg sm:text-2xl text-secondary">Filtres</summary>
      <div class="collapse-content">
        <div class="flex flex-wrap mt-8">
          <div class="flex gap-4 w-full min-w-fit lg:w-4/12 pr-4">
            <div class="w-full">
              <%= label_tag :search, "Rechercher" %>
              <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-bordered input-sm w-full', placeholder: 'Description / Commentaires' %>
            </div>
          </div>
          <div class="flex gap-4 w-full min-w-fit lg:w-4/12 pr-4">
            <div class="flex items-start gap-4 w-full min-w-fit items-end">
              <div class="flex-1">
                <%= label_tag :workflow_state, "Statut" %>
                <%= select_tag :workflow_state, 
                                options_for_select(Intervention.workflow_state_humanized, params[:workflow_state]), 
                                include_blank: true,
                                class: 'select select-bordered select-sm w-full', 
                                onchange: 'this.form.submit()' %>
              </div>
              <div class="flex-1">
                <%= label_tag :du, 'Du' %>
                <%= date_field_tag :du, params[:du], onchange: 'this.form.submit()', class: 'input input-bordered input-sm w-full' %>
              </div>
            </div>
          </div>

          <!-- Inversement pour que début/fin soient ensemble sur mobile et sur ordi -->
          <div class="flex sm:flex-row-reverse items-end gap-4 w-full min-w-fit lg:w-4/12 pr-4">
            <div class="flex-1 flex w-full min-w-fit lg:w-4/12 gap-2 mb-1">
              <%= check_box_tag :archives, 1, params[:archives], class:'checkbox', onchange:'this.form.submit()' %>
              <%= label_tag :archives, "Archivées ?", class: 'cursor-pointer' %>
            </div>
            <div class="flex-1">
              <%= label_tag :au, 'Au' %>
              <%= date_field_tag :au, params[:au], onchange: 'this.form.submit()', class: 'input input-bordered input-sm w-full' %>
            </div>
          </div>

        </div>
        <div class="flex flex-wrap w-full items-end mt-4">
          <% if current_user.manager? || current_user.agent? %>
            <div class="flex flex-wrap gap-4 w-full min-w-fit lg:w-4/12 pr-4">
              <div class="flex-1">
                <%= label_tag :adherent_id, "Adhérent" %>
                <%= select_tag :adherent_id, options_from_collection_for_select(@adhérents, :id, :nom_prénom, params[:adherent_id]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()' %>
              </div>

              <% if current_user.manager? %>
                <div class="flex-1">
                  <%= label_tag :team_id, "Équipe" %>
                  <%= select_tag :team_id, options_from_collection_for_select(@teams, 'id', 'nom_prénom', params[:team_id]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()' %>
                </div>
              <% end %>

            </div>
          <% end %>

          <% if current_user.manager? || current_user.adhérent? || current_user.équipe? %>
            <div class="flex flex-wrap gap-4 w-full min-w-fit lg:w-4/12 pr-4">
              <% if current_user.manager? || current_user.adhérent? %>
                <div class="flex-1">
                  <%= label_tag :service %>
                  <%= select_tag :service, options_for_select(@services, params[:service]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()' %>
                </div>
              <% end %>

              <div class="flex-1">
                <%= label_tag :agent_ids, "Agent(s)" %>
                <%= select_tag :agent_ids, grouped_options_for_select(@grouped_agents, params[:agent_ids]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()', multiple: true %>
              </div>
            </div>
          <% end %>

          <div class="flex flex-wrap gap-4 w-full min-w-fit lg:w-4/12 pr-4">
            <div class="flex-1">
              <%= label_tag :tool_ids, "Outil(s)" %>
              <%= select_tag :tool_ids, options_from_collection_for_select(@tools, 'id', 'name', params[:tool_ids]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()', multiple: true %>
            </div>
            <div class="flex-1">
            </div>
          </div>

          <div class="flex flex-wrap gap-1 w-full mt-4">
            <%= render TagCloudComponent.new(tags: @tags) %>
          </div>
        </div>
      </div>
    </details>
  <% end %>

  <hr class="mt-8">

  <div id="interventions" class="min-w-full">
    <%= turbo_stream_from "interventions_#{current_user.organisation.id}" %>
    <%= render @interventions %>
  </div>

  <div class="my-6">
    <%== pagy_info(@pagy) %>
    <%== pagy_nav(@pagy) %>
  </div>

  <% if @interventions.any? %>
    <p class="text-sm mt-4">
      Nombre d'interventions par statut : <%= JSON.pretty_generate(Intervention.workflow_states_count(@interventions)) %>
      <br><br>
      <%= link_to "Exporter les interventions en XLS", url_for(params.permit!.merge(format: :xls)), class: "text-sm btn btn-sm btn-outline btn-success hover:!text-white" %>
    </p>
  <% end %>

</div>

<script>
  // slimselect
  new SlimSelect({
    select: '#adherent_id',
    settings: {
      searchPlaceholder: 'Recherche',
      searchText: 'Pas de résultat',
      searchingText: 'Recherche...',
      placeholderText: 'Choisissez un adhérent',
      allowDeselect: true,
    }
  })

  new SlimSelect({
    select: '#team_id',
    settings: {
      searchPlaceholder: 'Recherche',
      searchText: 'Pas de résultat',
      searchingText: 'Recherche...',
      placeholderText: 'Choisissez une équipe',
      allowDeselect: true,
    }
  })

  new SlimSelect({
    select: '#service',
    settings: {
      searchPlaceholder: 'Recherche',
      searchText: 'Pas de résultat',
      searchingText: 'Recherche...',
      placeholderText: 'Choisissez un service',
      allowDeselect: true,
    }
  })

  new SlimSelect({
    select: '#agent_ids',
    settings: {
      searchPlaceholder: 'Recherche',
      searchText: 'Pas de résultat',
      searchingText: 'Recherche...',
      placeholderText: '',
      allowDeselect: true,
    }
  })

  new SlimSelect({
    select: '#tool_ids',
    settings: {
      searchPlaceholder: 'Recherche',
      searchText: 'Pas de résultat',
      searchingText: 'Recherche...',
      placeholderText: '',
      allowDeselect: true,
    }
  })
</script>
