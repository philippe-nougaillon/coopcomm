<div class="mx-auto w-full">
  <div id="<%= dom_id @intervention %>">
    <div class="flex flex-col sm:flex-row justify-between mb-8">
      <%= link_to interventions_path, title:"Revenir en arrière", class: "sm:hidden" do %>
        <%= embedded_svg "icons/arrow_circle_left.svg", title: "Revenir en arrière" %>
      <% end %>
      <div>
        <p class="text-3xl text-<%= @intervention.style.split.first.split('-').last %> font-bold flex items-center gap-2">
          <span class="badge badge-lg h-fit font-bold <%= @intervention.style %>">
            <%= @intervention.workflow_state.humanize %>
          </span>
          <% if @intervention.repeter %>
            <%= embedded_svg "icons/event_repeat.svg", class: "text-black", title: "Modèle pour le pointage" %>
          <% elsif @intervention.template_slug %>
            <%= embedded_svg "icons/qr_code_2.svg", class: "text-black", title: "Pointage" %>
          <% end %>
          <%= page_title!(@intervention.description.humanize) %>
        </p>
        <small class="text-slate-500">
          <i>il y a <%= time_ago_in_words @intervention.updated_at %></i>
        </small>
      </div>
      <div class="flex flex-wrap gap-2 mt-4 sm:mt-0 h-fit">
        <% if @intervention.repeter && !current_user&.agent? %>
          <%= link_to intervention_path(format: :pdf), class: "btn btn-warning", title: "Voir le QRCode de pointage" do %>
            <%= embedded_svg "icons/qr_code_2.svg", class: "text-lg", title: "Voir le QRCode de pointage" %>
          <% end %>
        <% end %>
        <% if policy(@intervention).edit? %>
          <%= link_to "Modifier", edit_intervention_path(@intervention), class: "btn btn-primary" %>
        <% end %>
        <% if policy(@intervention).destroy? %>
          <span title="<%= "Impossible de supprimer l'intervention car il y a des mouvements rattachés" if @intervention.mouvements.any? %>">
            <%= button_to intervention_path(@intervention), method: :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cette intervention ?" }, class: "btn", disabled: @intervention.mouvements.any?, 'data-testid': "Supprimer l'intervention" do %>
              <%= embedded_svg "icons/delete.svg", class: "text-lg", title: "Supprimer" %>
            <% end %>
          </span>
        <% end %>
        <%= link_to "Retour", interventions_path, class: "btn hidden sm:flex" %>
      </div>
    </div>
    <h2 class="text-lg text-secondary font-black mb-2">Demande</h2>
    <div class="bg-sky-50 p-4 rounded border border-sky-100 shadow-xs mb-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
        <div>
          <strong class="block text-slate-400 mb-1">Adhérent</strong>
          <b><%= @intervention.adherent.try(:nom_prénom) %></b>
        </div>
        <div>
          <strong class="block text-slate-400 mb-1">Service</strong>
          <b><%= @intervention.service.nom %></b>
        </div>
        <div>
          <strong class="block text-slate-400 mb-1">Météo</strong>
          <%= @intervention.meteo.presence || "Non renseignée" %>
        </div>
      </div>
      <% if @intervention.début_prévue || @intervention.fin_prévue %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8 mt-4">
          <% if @intervention.début_prévue %>
            <div>
              <strong class="block text-slate-400 mb-1">Début prévu</strong>
              <%= l(@intervention.début_prévue, format: :long) %>
            </div>
          <% end %>
          <% if @intervention.fin_prévue %>
            <div>
              <strong class="block text-slate-400 mb-1">Fin prévue</strong>
              <%= l(@intervention.fin_prévue, format: :long) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if !current_user.adhérent? %>
      <h2 class="text-lg text-secondary font-black mb-2">Assignation</h2>
      <div class="bg-indigo-50 rounded border border-indigo-100 p-4 shadow-xs mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
          <div>
            <strong class="block text-slate-400 mb-1">Agents</strong>
            <% if !@intervention.agents.any? %>
              <i>Aucun agent assigné</i>
            <% else %>
              <% @intervention.agents.each do |agent| %>
                <p><b><%= agent.nom_prénom %></b></p>
              <% end %>
            <% end %>
          </div>
          <div>
            <strong class="block text-slate-400 mb-1">Matériel(s)</strong>
            <% if !@intervention.tools.any? %>
              <i>Aucun matériel</i>
            <% else %>
              <% @intervention.tools.each do |tool| %>
                <p><b><%= tool.name %></b></p>
              <% end %>
            <% end %>
          </div>
          <div>
            <strong class="block text-slate-400 mb-1">Mots clés</strong>
            <% if @intervention.tags.any? %>
              <div class="flex flex-wrap gap-2 mt-1">
                <% @intervention.tags.each do |tag| %>
                  <span class="badge badge-primary badge-outline h-fit"><%= tag.name.humanize %></span>
                <% end %>
              </div>
            <% else %>
              <i>Aucun mot clé</i>
            <% end %>
          </div>
        </div>
      </div>
      <% if @intervention.repeter %>
        <div class="mb-8">
          <h2 class="text-lg text-secondary font-black mb-2">Pointages</h2>
          <div class="overflow-x-auto mt-4">
            <table class="table">
              <thead class="bg-slate-100">
                <tr>
                  <th>Il y a</th>
                  <% unless current_user.agent? %>
                    <th>Agent</th>
                  <% end %>
                  <th>Début</th>
                  <th>Fin</th>
                  <th>Temps total</th>
                  <th>Statut</th>
                  <th>Commentaires</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if @pointages.any? %>
                  <% @pointages.each do |pointage| %>
                    <tr>
                      <td><%= time_ago_in_words pointage.début %></td>
                      <% unless current_user.agent? %>
                        <td><%= pointage.agents.first&.nom_prénom %></td>
                      <% end %>
                      <td><%= l pointage.début %></td>
                      <td><%= l pointage.fin if pointage.fin %></td>
                      <td><%= pointage.temps_total %></td>
                      <td>
                        <span class="badge h-fit font-bold <%= pointage.style %>">
                          <%= pointage.workflow_state.humanize %>
                        </span>
                      </td>
                      <td><%= truncate(pointage.commentaires, length: 15) %></td>
                      <td><%= link_to "Voir", pointage, class: 'underline text-primary' %></td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="<%= current_user.agent? ? 7 : 8 %>" class="text-center py-8 text-slate-400 text-base italic">
                      Aucun pointage enregistré pour le moment.
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <div class="mb-8">
          <h2 class="text-lg text-secondary font-black mb-2">Intervention</h2>
          <div class="rounded border border-gray-200 p-4 shadow-xs mb-8 bg-white">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
              <div class="flex flex-col gap-4">
                <div>
                  <strong class="block text-slate-400 mb-1">Début</strong>
                  <%= l(@intervention.début, format: :long) if @intervention.début %>
                </div>
                <div>
                  <strong class="block text-slate-400 mb-1">Fin</strong>
                  <%= l(@intervention.fin, format: :long) if @intervention.fin %>
                </div>
              </div>
              <div class="flex flex-col gap-4">
                <div>
                  <strong class="block text-slate-400 mb-1">Temps passé</strong>
                  <%= @intervention.temps_par_agent %> h
                </div>
                <div>
                  <strong class="block text-slate-400 mb-1">Temps total</strong>
                  <%= @intervention.temps_total %> h
                </div>
                <div>
                  <strong class="block text-slate-400 mb-1">Temps de pause</strong>
                  <%= @intervention.temps_de_pause %> h
                </div>
              </div>
              <% if @intervention.service&.calculate_distance? && (@routes_response.present? || @intervention.trajet.present?) %>
                <div class="flex flex-col h-full">
                  <strong class="block text-slate-400 mb-1">Trajet (AR)</strong>
                  <% if @intervention.trajet.present? && !@intervention.nouveau? %>
                    <p><%= @intervention.trajet %></p>
                  <% elsif @intervention.nouveau? && @routes_response.present? %>
                    <div id="map" 
                        class="w-full h-56 rounded border"
                        data-controller="map"
                        data-map-depart-value="<%= @routes_response["localisation_depart"].to_json %>"
                        data-map-arrivee-value="<%= @routes_response["localisation_arrivee"].to_json %>"
                        data-map-polyline-value="<%= @routes_response["data_response"] ? @routes_response.dig("data_response","routes", 0, "polyline", "encodedPolyline") : '' %>">
                    </div>
                    <p class="mt-2 text-sm text-gray-600"><%= @routes_response["routes_info"] %></p>
                  <% end %>
                </div>
              <% else %>
                <div class="hidden lg:block"></div>
              <% end %>
            </div>
            <div class="mt-8 pt-6 border-t border-gray-100">
              <strong class="block text-slate-400 mb-1">Commentaires</strong>
              <p class="whitespace-pre-wrap"><%= @intervention.commentaires.presence || "Aucun commentaire." %></p>
            </div>
            <div class="mt-6 pt-6 border-t border-gray-100">
              <strong class="block text-slate-400 mb-2">Photos</strong>
              <% if @intervention.photos.attached? %>
                <div class="flex flex-wrap gap-4 mt-2">
                  <% @intervention.photos.each do |photo| %>
                    <div class="flex items-end gap-2">
                      <div class="avatar">
                        <div class="w-20 rounded hover:shadow-sm border bg-gray-50">
                          <%= link_to image_tag(photo, loading: 'lazy'), photo, target: "_blank" %>
                        </div>
                      </div>
                      <%= button_to purge_intervention_path(photo_id: photo.id), method: :delete, form: { data: {'turbo-confirm': "Êtes-vous bien certain.e de vouloir supprimer définitivement cette photo ?"} }, class: 'text-base-300 hover:text-error' do %>
                        <%= embedded_svg "icons/delete.svg", title: "Supprimer" %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-gray-500 italic">Aucune photo n'est attachée à cette intervention.</p>
              <% end %>
            </div>
          </div>
        </div>
        <% if current_user.adhérent? || current_user.manager_or_admin? %>
          <h2 class="text-lg text-secondary font-black mb-2">Compte-rendu</h2>
          <div class="bg-sky-50 rounded border border-sky-100 p-4 shadow-xs mb-8">
            <% if (@intervention.validé? || @intervention.refusé?) && !current_user.agent? %>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-8">
                <div>
                  <strong class="block text-slate-400 mb-1">Avis</strong>
                  <p><%= @intervention.avis.presence || "Aucun avis renseigné." %></p>
                </div>
                <div>
                  <strong class="block text-slate-400 mb-1">Évaluation</strong>
                  <div class="rating">
                    <% 5.times do |index| %>
                      <input type="radio" class="mask mask-star bg-primary cursor-text" <%= 'aria-current=true' if @intervention.note == index + 1 %> disabled/>
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <div>
                <strong class="block text-slate-400 mb-2">Actions de validation</strong>
                <div class="flex flex-wrap gap-2">
                  <% if policy(@intervention).terminer? %>
                    <%= button_to 'Terminer', terminer_intervention_path(@intervention), class: 'btn btn-primary btn-outline btn-sm sm:btn-md hover:text-white!', title: 'Cliquez pour passer cette intervention en statut Terminée', form: { data: { turbo: false }, class: 'contents' }, disabled: !@intervention.can_terminer? %>
                  <% end %>
                  <% if policy(@intervention).valider? %>
                    <%= button_to 'Valider', valider_intervention_path(@intervention), class: 'btn btn-success btn-outline btn-sm sm:btn-md hover:text-white!', title: 'Cliquez pour passer cette intervention en statut Validée', form: { data: { turbo: false }, class: 'contents' }, disabled: !@intervention.can_valider?  %>
                  <% end %>
                  <% if policy(@intervention).refuser? %>
                    <%= button_to 'Refuser', refuser_intervention_path(@intervention), class: 'btn btn-error btn-outline btn-sm sm:btn-md hover:text-white!', title: 'Cliquez pour passer cette intervention en statut Refusée', form: { data: { turbo: false }, class: 'contents' }, disabled: !@intervention.can_refuser? %>
                  <% end %>
                  <% if !policy(@intervention).terminer? && !policy(@intervention).valider? && !policy(@intervention).refuser? %>
                    <p class="text-sm text-gray-500 italic mt-1">Aucune action disponible pour le moment.</p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <% if current_user.manager_or_admin? %>
      <h2 class="text-2xl text-secondary mt-8">Activité</h2>
      <div class="flex flex-col bg-white border border-slate-200 shadow-sm rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="table table-sm w-full border-none">
            <thead class="bg-slate-100">
              <tr>
                <th>Date</th>
                <th>Utilisateur</th>
                <th>Type</th>
                <th>Action</th>
                <th>Modifications</th>
              </tr>
            </thead>
            <tbody>
              <% if @audits&.any? %>
                <%= render partial: 'audit', collection: @audits %>
                            <%= render partial: "audit", collection: @audits %>

              <% else %>
                <tr>
                  <td colspan="5" class="text-center py-8 text-slate-400 text-base italic">
                    Aucun historique d'activité disponible.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
    <% if @pagy&.pages.to_i > 1 %>
          <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
            <div class="hidden sm:block sm:flex-1"></div>
            <div class="w-full sm:w-auto sm:flex-1 order-1 sm:order-2 flex justify-center">
              <%= pagy_nav(@pagy).html_safe %>
            </div>
            <div class="text-base font-semibold text-slate-500 text-center sm:text-right w-full sm:flex-1 order-2 sm:order-3">
              <%= pagy_info(@pagy, item_name: "interventions").html_safe %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>























<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
  <div id="<%= dom_id @intervention %>">
    
    <%# --- ENCABEZADO Y ACCIONES PRINCIPALES --- %>
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <div class="flex items-center gap-3 flex-wrap">
          <h1 class="text-3xl font-bold text-slate-800 tracking-tight">
            <%= page_title!(@intervention.description.humanize) %>
          </h1>
          <span class="badge badge-lg font-semibold px-3 py-1.5 rounded-full <%= @intervention.style %>">
            <%= @intervention.workflow_state.humanize %>
          </span>
          <% if @intervention.repeter %>
            <%= embedded_svg "icons/event_repeat.svg", class: "w-6 h-6 text-slate-500", title: "Modèle pour le pointage" %>
          <% elsif @intervention.template_slug %>
            <%= embedded_svg "icons/qr_code_2.svg", class: "w-6 h-6 text-slate-500", title: "Pointage" %>
          <% end %>
        </div>
        <p class="text-sm text-slate-400 mt-1">
          Il y a <%= time_ago_in_words @intervention.updated_at %>
        </p>
      </div>

      <%# Botones de Acción Superior %>
      <div class="flex items-center gap-2">
        <% if @intervention.repeter && !current_user&.agent? %>
          <%= link_to intervention_path(format: :pdf), class: "btn btn-ghost bg-amber-50 text-amber-700 hover:bg-amber-100 border-none font-medium gap-2", title: "Voir le QRCode de pointage" do %>
            <%= embedded_svg "icons/qr_code_2.svg", class: "w-4 h-4" %>
            <span>QR Code</span>
          <% end %>
        <% end %>

        <% if policy(@intervention).edit? %>
          <%= link_to edit_intervention_path(@intervention), class: "btn btn-ghost bg-slate-100 text-slate-700 hover:bg-slate-200 border-none font-medium gap-2" do %>
            <%= embedded_svg "icons/edit.svg", class: "w-4 h-4" rescue nil %>
            Modifier
          <% end %>
        <% end %>

        <% if policy(@intervention).destroy? %>
          <span title="<%= "Impossible de supprimer l'intervention car il y a des mouvements rattachés" if @intervention.mouvements.any? %>">
            <%= button_to intervention_path(@intervention), 
                          method: :delete, 
                          data: { turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cette intervention ?" }, 
                          class: "btn btn-ghost bg-red-50 text-red-600 hover:bg-red-100 border-none font-medium gap-2", 
                          disabled: @intervention.mouvements.any?, 
                          'data-testid': "Supprimer l'intervention" do %>
              <%= embedded_svg "icons/delete.svg", class: "w-4 h-4" %>
              Supprimer
            <% end %>
          </span>
        <% end %>
      </div>
    </div>

    <%# --- SECCIÓN DEMANDE --- %>
    <section class="mb-10">
      <h2 class="text-xl font-bold text-slate-700 mb-3">Demande</h2>
      <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div>
            <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Adhérent</span>
            <p class="text-slate-700 font-medium"><%= @intervention.adherent.try(:nom_prénom) || "—" %></p>
          </div>
          <div>
            <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Service</span>
            <p class="text-slate-700 font-medium"><%= @intervention.service.nom %></p>
          </div>
          <div>
            <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Météo</span>
            <p class="text-slate-700 font-medium"><%= @intervention.meteo.presence || "Non renseignée" %></p>
          </div>
        </div>

        <% if @intervention.début_prévue || @intervention.fin_prévue %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6 pt-6 border-t border-slate-100">
            <% if @intervention.début_prévue %>
              <div>
                <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Début prévu</span>
                <p class="text-slate-700 font-medium"><%= l(@intervention.début_prévue, format: :long) %></p>
              </div>
            <% end %>
            <% if @intervention.fin_prévue %>
              <div>
                <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Fin prévue</span>
                <p class="text-slate-700 font-medium"><%= l(@intervention.fin_prévue, format: :long) %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <%# --- SECCIÓN ASSIGNATION --- %>
    <% if !current_user.adhérent? %>
      <section class="mb-10">
        <h2 class="text-xl font-bold text-slate-700 mb-3">Assignation</h2>
        <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <div>
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Agents</span>
              <% if !@intervention.agents.any? %>
                <p class="text-slate-400 italic text-sm">Aucun agent assigné</p>
              <% else %>
                <div class="space-y-1">
                  <% @intervention.agents.each do |agent| %>
                    <p class="text-slate-700 font-medium"><%= agent.nom_prénom %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div>
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Matériel(s)</span>
              <% if !@intervention.tools.any? %>
                <p class="text-slate-400 italic text-sm">Aucun matériel</p>
              <% else %>
                <div class="space-y-1">
                  <% @intervention.tools.each do |tool| %>
                    <p class="text-slate-700 font-medium"><%= tool.name %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div>
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Mots clés</span>
              <% if @intervention.tags.any? %>
                <div class="flex flex-wrap gap-1.5">
                  <% @intervention.tags.each do |tag| %>
                    <span class="badge bg-indigo-50 text-indigo-600 border border-indigo-100 font-medium text-xs py-1 px-2.5 rounded-full">
                      <%= tag.name.humanize %>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <p class="text-slate-400 italic text-sm">Aucun mot clé</p>
              <% end %>
            </div>
          </div>
        </div>
      </section>

      <%# --- POINTAGES O INTERVENTION --- %>
      <% if @intervention.repeter %>
        <section class="mb-10">
          <h2 class="text-xl font-bold text-slate-700 mb-3">Pointages</h2>
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
              <table class="table w-full text-left border-collapse">
                <thead class="bg-slate-50/80 border-b border-slate-100 text-xs uppercase font-semibold text-slate-400 tracking-wider">
                  <tr>
                    <th class="py-3 px-4">Il y a</th>
                    <% unless current_user.agent? %>
                      <th class="py-3 px-4">Agent</th>
                    <% end %>
                    <th class="py-3 px-4">Début</th>
                    <th class="py-3 px-4">Fin</th>
                    <th class="py-3 px-4">Temps total</th>
                    <th class="py-3 px-4 text-center">Statut</th>
                    <th class="py-3 px-4">Commentaires</th>
                    <th class="py-3 px-4"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm text-slate-600">
                  <% if @pointages.any? %>
                    <% @pointages.each do |pointage| %>
                      <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="py-3 px-4"><%= time_ago_in_words pointage.début %></td>
                        <% unless current_user.agent? %>
                          <td class="py-3 px-4 font-medium text-slate-700"><%= pointage.agents.first&.nom_prénom %></td>
                        <% end %>
                        <td class="py-3 px-4"><%= l pointage.début %></td>
                        <td class="py-3 px-4"><%= l pointage.fin if pointage.fin %></td>
                        <td class="py-3 px-4 font-medium"><%= pointage.temps_total %></td>
                        <td class="py-3 px-4 text-center">
                          <span class="badge font-medium text-xs px-2.5 py-1 rounded-full <%= pointage.style %>">
                            <%= pointage.workflow_state.humanize %>
                          </span>
                        </td>
                        <td class="py-3 px-4 text-slate-500"><%= truncate(pointage.commentaires, length: 25) %></td>
                        <td class="py-3 px-4 text-right">
                          <%= link_to "Voir", pointage, class: 'font-medium text-sky-600 hover:text-sky-700 hover:underline' %>
                        </td>
                      </tr>
                    <% end %>
                  <% else %>
                    <tr>
                      <td colspan="<%= current_user.agent? ? 7 : 8 %>" class="text-center py-10 text-slate-400 italic">
                        Aucun pointage enregistré pour le moment.
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      <% else %>
        <section class="mb-10">
          <h2 class="text-xl font-bold text-slate-700 mb-3">Intervention</h2>
          <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <div class="space-y-4">
                <div>
                  <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Début</span>
                  <p class="text-slate-700 font-medium"><%= l(@intervention.début, format: :long) if @intervention.début %></p>
                </div>
                <div>
                  <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Fin</span>
                  <p class="text-slate-700 font-medium"><%= l(@intervention.fin, format: :long) if @intervention.fin %></p>
                </div>
              </div>

              <div class="space-y-4">
                <div>
                  <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Temps passé</span>
                  <p class="text-slate-700 font-medium"><%= @intervention.temps_par_agent %> h</p>
                </div>
                <div>
                  <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Temps total</span>
                  <p class="text-slate-700 font-medium"><%= @intervention.temps_total %> h</p>
                </div>
                <div>
                  <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Temps de pause</span>
                  <p class="text-slate-700 font-medium"><%= @intervention.temps_de_pause %> h</p>
                </div>
              </div>

              <% if @intervention.service&.calculate_distance? && (@routes_response.present? || @intervention.trajet.present?) %>
                <div>
                  <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Trajet (AR)</span>
                  <% if @intervention.trajet.present? && !@intervention.nouveau? %>
                    <p class="text-slate-700 font-medium"><%= @intervention.trajet %></p>
                  <% elsif @intervention.nouveau? && @routes_response.present? %>
                    <div id="map" 
                         class="w-full h-48 rounded-xl border border-slate-200 overflow-hidden"
                         data-controller="map"
                         data-map-depart-value="<%= @routes_response["localisation_depart"].to_json %>"
                         data-map-arrivee-value="<%= @routes_response["localisation_arrivee"].to_json %>"
                         data-map-polyline-value="<%= @routes_response["data_response"] ? @routes_response.dig("data_response","routes", 0, "polyline", "encodedPolyline") : '' %>">
                    </div>
                    <p class="mt-2 text-xs text-slate-500"><%= @routes_response["routes_info"] %></p>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%# Commentaires %>
            <div class="mt-6 pt-6 border-t border-slate-100">
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Commentaires</span>
              <p class="text-slate-600 whitespace-pre-wrap text-sm leading-relaxed"><%= @intervention.commentaires.presence || "Aucun commentaire." %></p>
            </div>

            <%# Photos %>
            <div class="mt-6 pt-6 border-t border-slate-100">
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Photos</span>
              <% if @intervention.photos.attached? %>
                <div class="flex flex-wrap gap-4">
                  <% @intervention.photos.each do |photo| %>
                    <div class="relative group">
                      <div class="w-24 h-24 rounded-xl border border-slate-200 overflow-hidden bg-slate-50 shadow-xs">
                        <%= link_to image_tag(photo, loading: 'lazy', class: "w-full h-full object-cover"), photo, target: "_blank" %>
                      </div>
                      <%= button_to purge_intervention_path(photo_id: photo.id), 
                                    method: :delete, 
                                    form: { data: {'turbo-confirm': "Êtes-vous bien certain.e de vouloir supprimer définitivement cette photo ?"} }, 
                                    class: "absolute -top-2 -right-2 bg-white text-red-500 rounded-full p-1 shadow border border-slate-100 hover:bg-red-50" do %>
                        <%= embedded_svg "icons/delete.svg", class: "w-4 h-4", title: "Supprimer" %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-slate-400 italic text-sm">Aucune photo n'est attachée à cette intervention.</p>
              <% end %>
            </div>
          </div>
        </section>

        <%# --- COMPTE-RENDU --- %>
        <% if current_user.adhérent? || current_user.manager_or_admin? %>
          <section class="mb-10">
            <h2 class="text-xl font-bold text-slate-700 mb-3">Compte-rendu</h2>
            <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
              <% if (@intervention.validé? || @intervention.refusé?) && !current_user.agent? %>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                  <div>
                    <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Avis</span>
                    <p class="text-slate-700"><%= @intervention.avis.presence || "Aucun avis renseigné." %></p>
                  </div>
                  <div>
                    <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Évaluation</span>
                    <div class="rating gap-1 mt-1">
                      <% 5.times do |index| %>
                        <input type="radio" class="mask mask-star-2 bg-amber-400 cursor-default" <%= 'checked' if @intervention.note == index + 1 %> disabled/>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% else %>
                <div>
                  <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Actions de validation</span>
                  <div class="flex flex-wrap gap-2">
                    <% if policy(@intervention).terminer? %>
                      <%= button_to 'Terminer', terminer_intervention_path(@intervention), class: 'btn btn-sm sm:btn-md bg-sky-50 text-sky-700 hover:bg-sky-100 border-none font-medium', title: 'Cliquez pour passer cette intervention en statut Terminée', form: { data: { turbo: false }, class: 'contents' }, disabled: !@intervention.can_terminer? %>
                    <% end %>
                    <% if policy(@intervention).valider? %>
                      <%= button_to 'Valider', valider_intervention_path(@intervention), class: 'btn btn-sm sm:btn-md bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border-none font-medium', title: 'Cliquez pour passer cette intervention en statut Validée', form: { data: { turbo: false }, class: 'contents' }, disabled: !@intervention.can_valider? %>
                    <% end %>
                    <% if policy(@intervention).refuser? %>
                      <%= button_to 'Refuser', refuser_intervention_path(@intervention), class: 'btn btn-sm sm:btn-md bg-red-50 text-red-700 hover:bg-red-100 border-none font-medium', title: 'Cliquez pour passer cette intervention en statut Refusée', form: { data: { turbo: false }, class: 'contents' }, disabled: !@intervention.can_refuser? %>
                    <% end %>
                    <% if !policy(@intervention).terminer? && !policy(@intervention).valider? && !policy(@intervention).refuser? %>
                      <p class="text-sm text-slate-400 italic">Aucune action disponible pour le moment.</p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      <% end %>
    <% end %>

    <%# --- ACTIVITÉ (TABLA CON ESTILO MARTEAU) --- %>
    <% if current_user.manager_or_admin? %>
      <section class="mb-10">
        <h2 class="text-xl font-bold text-slate-700 mb-3">Activité</h2>
        <div class="bg-white border border-slate-100 shadow-sm rounded-2xl overflow-hidden">
          <div class="overflow-x-auto">
            <table class="table w-full text-left border-collapse">
              <thead class="bg-slate-50/80 border-b border-slate-100 text-xs uppercase font-semibold text-slate-400 tracking-wider">
                <tr>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4">Utilisateur</th>
                  <th class="py-3 px-4">Type</th>
                  <th class="py-3 px-4">Action</th>
                  <th class="py-3 px-4">Modifications</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-sm text-slate-600">
                <% if @audits&.any? %>
                  <%= render partial: 'audit', collection: @audits %>
                <% else %>
                  <tr>
                    <td colspan="5" class="text-center py-10 text-slate-400 italic">
                      Aucun historique d'activité disponible.
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <% if @pagy&.pages.to_i > 1 %>
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-4 border-t border-slate-100 bg-slate-50/50 w-full">
              <div class="hidden sm:block sm:flex-1"></div>
              <div class="w-full sm:w-auto sm:flex-1 order-1 sm:order-2 flex justify-center">
                <%= pagy_nav(@pagy).html_safe %>
              </div>
              <div class="text-xs font-semibold text-slate-400 text-center sm:text-right w-full sm:flex-1 order-2 sm:order-3">
                <%= pagy_info(@pagy, item_name: "interventions").html_safe %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# --- BOTÓN INFERIOR RETOUR (Estilo Marteau) --- %>
    <div class="mt-8">
      <%= link_to interventions_path, class: "inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors" do %>
        <span>←</span>
        <span>Retour à la liste</span>
      <% end %>
    </div>

  </div>
</div>