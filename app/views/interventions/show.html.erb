<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
  <div id="<%= dom_id @intervention %>">

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <div class="flex items-center gap-3 flex-wrap">
          <h1 class="text-3xl font-bold tracking-tight text-<%= @intervention.style.split.first.split('-').last %>">
            <%= page_title!(@intervention.description.humanize) %>
          </h1>
          <span class="badge font-bold text-xs uppercase shrink-0 <%= @intervention.style %>">
            <%= @intervention.workflow_state.humanize %>
          </span>
          <% if @intervention.repeter %>
            <%= embedded_svg "icons/event_repeat.svg", class: "w-6 h-6 text-#{@intervention.style.split.first.split('-').last}", title: "Modèle pour le pointage" %>
          <% elsif @intervention.template_slug %>
            <% mère = @intervention.intervention_mère %>
              <% if mère %>
                <%= link_to intervention_path(mère),
                            class: "inline-flex hover:opacity-60 transition",
                            title: "Voir le modèle de pointage ##{mère.id}" do %>
                  <%= embedded_svg "icons/qr_code_2.svg", class: "w-6 h-6 text-#{@intervention.style.split.first.split('-').last}" %>
                <% end %>
              <% else %>
                <%= embedded_svg "icons/qr_code_2.svg", class: "w-6 h-6 text-#{@intervention.style.split.first.split('-').last}", title: "Pointage" %>
              <% end %>
            <% end %>
        </div>
        <p class="text-sm text-slate-400 mt-1">
          Il y a <%= time_ago_in_words @intervention.updated_at %>
        </p>

        <% if @intervention.template_slug.present? %>
          <% mère = @intervention.intervention_mère %>
          <% if mère %>
            <%= link_to intervention_path(mère),
                        class: "inline-flex items-center gap-1.5 mt-2 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
              <%= embedded_svg "icons/back.svg", class: "w-4 h-4 transition-transform group-hover:-translate-x-1" %>
              Pointage du modèle <span class="font-semibold">#<%= mère.id %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <div class="flex items-center gap-2">
        <% if policy(@intervention).voir_qrcode_pointage? %>
          <%= link_to intervention_path(@intervention, format: :pdf), class: "btn btn-ghost bg-amber-50 text-amber-700 hover:bg-amber-100 border-none font-medium gap-2", title: "Voir le QRCode de pointage" do %>
            <%= embedded_svg "icons/qr_code_2.svg", class: "w-5 h-5 fill-current" %>
            <span>QR Code</span>
          <% end %>
        <% end %>
        <% if policy(@intervention).fiche? %>
          <%= link_to fiche_intervention_path(@intervention, filename: @intervention.pdf_filename),
              class: "btn btn-outline btn-info flex-1 sm:flex-none", target: "_blank", data: { turbo: false }, title: "Générer le bon d'intervention (PDF)" do %>
            <%= embedded_svg "icons/download.svg", class: "w-6 h-6 fill-current transition-colors duration-200 hidden md:block" %>
            <span class="block md:hidden"> PDF </span>
            <span class="hidden md:block">Générer PDF</span>
          <% end %>
        <% end %>
        <% if policy(@intervention).edit? %>
          <%= link_to edit_intervention_path(@intervention), class: "btn flex-1 sm:flex-none" do %>
            <%= embedded_svg "icons/edit.svg", class: "w-5 h-5 fill-current" %>
            Modifier
          <% end %>
        <% end %>
      </div>
    </div>

    

    <div class="grid grid-cols-1 <%= policy(@intervention).voir_assignation? ? 'lg:grid-cols-2 gap-8' : '' %>">
      <%= render "interventions/show/demande", intervention: @intervention %>
      <% if policy(@intervention).voir_assignation? %>
        <%= render "interventions/show/assignation", intervention: @intervention %>
      <% end %>
    </div>

     <% unless @intervention.repeter %>
      <%= render "interventions/show/actions", intervention: @intervention %>
    <% end %>

    <% if policy(@intervention).voir_pointages? %>
      <%= render "interventions/show/pointages_table", intervention: @intervention, pointages: @pointages %>
    <% elsif policy(@intervention).voir_realisation? %>
      <%= render "interventions/show/intervention_details", intervention: @intervention, routes_response: @routes_response %>
    <% elsif policy(@intervention).voir_temps? %>
      <%= render "interventions/show/temps_adherent", intervention: @intervention %>
    <% end %>

    <% if policy(@intervention).voir_compte_rendu? %>
      <%= render "interventions/show/compte_rendu", intervention: @intervention %>
    <% end %>

    <% if policy(@intervention).voir_activite? %>
      <%= render "interventions/show/activite", audits: @audits, pagy: @pagy %>
    <% end %>

    <div class="flex justify-end mt-6 pt-4 border-t border-slate-200">
      <% if policy(@intervention).destroy? %>
        <span title="<%= "Impossible de supprimer l'intervention car il y a des mouvements rattachés" if @intervention.mouvements.any? %>">
          <button class="btn btn-ghost bg-red-50 text-red-600 hover:bg-red-100 border-none font-medium gap-2"
                  onclick="delete_intervention_modal_<%= @intervention.id %>.showModal()"
                  title="Supprimer"
                  data-testid="Supprimer l'intervention"
                  <%= "disabled" if @intervention.mouvements.any? %>>
            <%= embedded_svg "icons/delete.svg", class: "w-4 h-4" %>
            Supprimer l'intervention
          </button>
          <dialog id="delete_intervention_modal_<%= @intervention.id %>" class="modal">
            <div class="modal-box">
              <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
              </form>
              <h3 class="text-lg font-bold text-error flex items-center gap-2">
                <%= embedded_svg "icons/warning.svg", title: "Supprimer l'intervention" %>
                Supprimer l'intervention
              </h3>
              <p class="py-4 text-base text-slate-600 text-left">
                Êtes-vous certain(e) de vouloir supprimer cette intervention ?
                Cette action est irréversible.
              </p>
              <div class="modal-action">
                <form method="dialog">
                  <button class="btn btn-ghost">Annuler</button>
                </form>
                <%= button_to intervention_path(@intervention), method: :delete, class: "btn btn-error text-white" do %>
                  Oui, supprimer
                <% end %>
              </div>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>Fermer</button>
            </form>
          </dialog>
        </span>
      <% end %>
    </div>

    <div class="py-10">
      <%= link_to interventions_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
        <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste" %>
        Retour à la liste
      <% end %>
    </div>
  </div>
</div>