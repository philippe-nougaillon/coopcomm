
<% if mouvement && mouvement.réservé? %>
  <% bg_class = (mouvement.user == current_user) ? 'bg-blue-500' : 'bg-blue-300' %>
  <% span_content = capture do %>
    <span class="border border-slate-400 inline-block w-4 h-4 rounded-sm shadow-sm hover:scale-110 transition-transform <%= bg_class %>"
          title="Réservé par <%= mouvement.user == current_user ? 'vous' : (mouvement.user&.email || 'Utilisateur inconnu') %>">
    </span>
  <% end %>
  <%= link_to_if policy(mouvement).destroy?, span_content, mouvement_path(mouvement), data: { turbo_method: :delete } %>

<% elsif mouvement && mouvement.panne? %>
  <% panne_est_resolue = mouvement.resolue? %>
  <% span_content = capture do %>
    <span class="bg-red-500 border border-slate-400 inline-block w-4 h-4 rounded-sm shadow-sm"
          title="Panne déclarée le <%= mouvement.date.strftime('%d/%m à %H:%M') %><%= ' (Déjà réparé depuis)' if panne_est_resolue %>">
    </span>
  <% end %>

  <% if policy(Mouvement).new? && !panne_est_resolue %>
    <% datetime_debut = Time.zone.parse("#{date} #{start_hour}:#{local_assigns[:start_minute] || '00'}:00") %>
    <% datetime_fin_panne = [(datetime_debut - 1.minute), (mouvement.date + 1.minute)].max %>
    <%= link_to mouvements_path(mouvement: { tool_id: tool_id, état: 'fin_panne', date: datetime_fin_panne }),
                data: {
                  turbo_method: :post,
                  turbo_confirm: "Confirmer la réparation et la fin de panne pour cet outil ? Les réservations présentes au moment de la panne seront supprimées"
                },
                title: "Déclarer la fin de la panne" do %>
      <%= span_content %>
    <% end %>
  <% else %>
    <%= span_content %>
  <% end %>

<% else %>
  <%= link_to reserve_tool_mouvements_path(
        tool_id: tool_id,
        date: date,
        start_hour: start_hour,
        start_minute: local_assigns[:start_minute] || 0,
        end_hour: end_hour
      ),
      data: { turbo_method: :post },
      title: new_title do %>
    <span class="bg-green-500 border border-slate-400 inline-block w-4 h-4 rounded-sm shadow-sm hover:scale-110 transition-transform"></span>
  <% end %>
<% end %>