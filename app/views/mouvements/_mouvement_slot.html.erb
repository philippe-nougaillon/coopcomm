<% if mouvement && mouvement.sortie? %>
  <%# --- CAS ROUGE : L'OUTIL EST SORTI --- %>
  <% span_content = capture do %>
    <span class="border-1 border-slate-400 h-4 inline-block align-middle" 
          style="padding-left: 15px; <%= margin_style %>; background-color: #db2767;" 
          title="Réservé par <%= mouvement.user&.email || 'Utilisateur inconnu' %>">
    </span>
  <% end %>

  <%= link_to_if policy(mouvement).destroy?, span_content, mouvement_path(mouvement), data: { turbo_method: :delete } %>

<% elsif mouvement && mouvement.panne? %>
  <%# --- CAS NOIR : L'OUTIL EST EN PANNE --- %>
  <% panne_est_resolue = mouvement.resolue? %>

  <% span_content = capture do %>
    <span class="border-1 border-slate-400 h-4 inline-block align-middle" 
          style="padding-left: 15px; <%= margin_style %>; background-color: black;" 
          title="Panne déclarée le <%= mouvement.date.strftime('%d/%m à %H:%M') %><%= ' (Déjà réparé depuis)' if panne_est_resolue %>">
    </span>
  <% end %>

  <%# On affiche le lien SEULEMENT si la panne n'est pas encore résolue %>
  <% if policy(Mouvement).new? && !panne_est_resolue %>
    <% datetime_debut = Time.zone.parse("#{date} #{start_hour}:#{local_assigns[:start_minute] || '00'}:00") %>

    <%# On recule d'une minute le début théorique pour éviter la collision avec une future réservation %>
    <% datetime_fin_panne = [(datetime_debut - 1.minute), (mouvement.date + 1.minute)].max %>

    <%= link_to mouvements_path(mouvement: { tool_id: tool_id, état: 'fin_panne', date: datetime_fin_panne }), 
                data: { turbo_method: :post }, 
                title: "Déclarer la fin de la panne" do %>
      <%= span_content %>
    <% end %>
  <% else %>
    <%# Si c'est résolu, c'est juste un span noir, pas de curseur cliquable %>
    <%= span_content %>
  <% end %>
<% else %>
  <%# --- CAS VERT : L'OUTIL EST DISPONIBLE (Entrée ou Aucun mouvement) --- %>
  <%= link_to reserve_tool_mouvements_path(
        tool_id: tool_id, 
        date: date, 
        start_hour: start_hour, 
        start_minute: local_assigns[:start_minute] || 0, 
        end_hour: end_hour
      ), 
      data: { turbo_method: :post },
      title: new_title do %>
    <span class="border-1 border-slate-400 bg-green-500 hover:opacity-75 h-4 inline-block align-middle" style="padding-left: 15px; <%= margin_style %>;"></span>
  <% end %>
<% end %>