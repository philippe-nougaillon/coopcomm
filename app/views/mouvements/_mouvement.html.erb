<tr class="hover:bg-base-300">
  <% if params[:controller] != 'tools' %>
    <td><b><%= link_to mouvement.tool.name, mouvement.tool, class: 'hover:underline' %></b></td>
  <% end %>
  <td><p class="font-bold badge badge-sm badge-<%= mouvement.style %>"><%= mouvement.état.humanize %></p></td>
  <td>
    <% if mouvement.intervention %>
      <b><%= l mouvement.intervention.début, format: :long %> - <%= mouvement.intervention.fin.strftime("%H:%M") %></b>
      <br>
      <%= mouvement.intervention.description %>
    <% end %>
  </td>
  <td><%= time_ago_in_words(mouvement.updated_at) %></td>
</tr>