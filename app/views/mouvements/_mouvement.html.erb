<tr class="hover:bg-base-200/60 transition-colors duration-150 border-b border-slate-100 align-middle">
  <td class="align-middle capitalize  px-4 py-1.5 text-slate-600 font-medium whitespace-nowrap">
    <%= time_ago_in_words(mouvement.updated_at) %>
  </td>
  
  <% if params[:controller] != 'tools' %>
    <td class="px-4 py-1.5 uppercase font-bold">
      <%= link_to mouvement.tool.name.humanize, mouvement.tool, class: 'text-sm font-bold text-primary hover:underline' %>
    </td>
  <% end %>
  
  <td class="align-middle px-4 py-1.5 text-center w-36">
    <span class="font-bold w-34 text-center badge badge-<%= mouvement.style %> h-fit px-3 py-1">
      <%= mouvement.état.humanize %>
    </span>
  </td>
  
  <td class="px-4 py-1.5 text-sm text-slate-600"><%= mouvement.user.nom_prénom %></td>
  
  <td class="px-4 py-1.5 text-sm text-slate-600 whitespace-nowrap">
    <%= l mouvement.date, format: :long %>
  </td>
  
  <td class="px-4 py-1.5">
    <% if mouvement.panne? || mouvement.fin_panne? %>
      <%= link_to edit_mouvement_path(mouvement), class: 'btn btn-sm' do %>
     <%= embedded_svg "icons/edit.svg", class: "w-4 h-4 fill-current transition-colors duration-200" %>
          Modifier
           <% end %>
    <% end %>
  </td>
</tr>