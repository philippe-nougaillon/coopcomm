<tr class="hover:bg-base-300">
  <td><p class="font-bold badge badge-<%= mouvement.style %>"><%= mouvement.état.humanize %></p></td>
  <% if params[:controller] != 'tools' %>
    <td><%= link_to mouvement.tool.name, mouvement.tool, class: 'hover:underline' %></td>
  <% end %>
  <td></td>
  <td><%= time_ago_in_words(mouvement.updated_at) %></td>
</tr>