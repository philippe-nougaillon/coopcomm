<div class="max-w-3xl mx-auto my-6 bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-100/50 p-6 md:p-8">
  <%= form_with(model: mouvement, class:'flex flex-col gap-4') do |form| %>
    <% if mouvement.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-500 px-4 py-3 font-medium rounded-lg mb-2 border border-red-200">
        <h2 class="font-black mb-2 text-sm md:text-base">
          <%= pluralize(mouvement.errors.count, "erreur") %> empêche(nt) ce mouvement d'être sauvegardé :
        </h2>
        <ul class="list-disc list-inside text-xs opacity-90">
          <% mouvement.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if (@mouvement.tool && @mouvement.persisted?) || params[:tool_id] %>
      <%# Deux champs volontairement : ils n'ont PAS le même name, donc pas le même rôle. %>
      <%# 1) la donnée enregistrée — name="mouvement[tool_id]", lue par mouvement_params %>
      <%= form.hidden_field :tool_id, value: @mouvement.tool_id || params[:tool_id] %>
      <%# 2) le signal "outil imposé" — name="tool_id" (1er niveau), ignoré à l'enregistrement. %>
      <%#    Seul moyen de garder le champ caché après une erreur de validation : mouvement[tool_id] %>
      <%#    est envoyé que l'outil soit imposé OU choisi, donc il ne peut pas distinguer les deux cas. %>
      <%= hidden_field_tag :tool_id, @mouvement.tool_id || params[:tool_id], id: nil %>
    <% else %>
      <%# CORRECCIÓN: El contenedor div ahora envuelve únicamente al select visible %>
      <div class="w-full">
        <%= form.label :tool_id, class: "label font-semibold text-slate-700" do %>
          <span>Matériel <span class="text-red-500">*</span></span>
        <% end %>
        <%= form.select :tool_id, 
            options_from_collection_for_select(@tools, :id, :name, @mouvement.tool_id),
            {include_blank: true, required: true}, 
            class: "slim-select w-full" %>
      </div> <%# <-- El cierre se movió aquí adentro para evitar cajas vacías al editar %>
    <% end %>

    <div class="w-full">
      <%= form.label :état, class: "label font-semibold text-slate-700"  do%>
        <span>État <span class="text-red-500">*</span></span>
      <% end %>
      <%= form.select :état, options_for_select([['Panne', 'panne'], ['Fin de panne', 'fin_panne']], mouvement.état), 
          {include_blank: true}, class: 'slim-select w-full', required: true %>
    </div>

    <div class="w-full">
      <%= form.label :date, class: "label font-semibold text-slate-700" %>
      <%= form.datetime_field :date, value: @mouvement.date&.strftime('%Y-%m-%dT%H:%M'), class: 'input input-bordered input-sm w-full', required: true %>
    </div>

    <div class="w-full">
      <%= form.label :commentaires, class: "label font-semibold text-slate-700" %>
      <%= form.text_area :commentaires, class: 'textarea textarea-bordered textarea-sm w-full', autofocus: true, 'data-controller': 'textarea-autogrow' %>
    </div>

    <div class="flex gap-2 mt-4 w-full">
      <%= link_to "Annuler", (session.delete(:return_to) || mouvements_path), class: "btn flex-1" %>
      <%= form.submit "Enregistrer", class: "btn btn-primary flex-1" %>
    </div>
  <% end %>

  <div class="pt-6 max-w-3xl mx-auto px-4">
    <%= link_to mouvements_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste des utilisateurs" %>
      Retour à la liste des mouvements
    <% end %>
  </div>
</div>