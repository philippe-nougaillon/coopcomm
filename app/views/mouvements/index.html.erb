<div class="w-full mb-24">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!('Mouvements') %></h1>
  </div>

  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap items-start w-full gap-4 mt-8">
      <div class="w-full md:w-fit">
        <%= label_tag :tool_ids, "Matériel(s)" %>
        <%= select_tag :tool_ids, options_from_collection_for_select(@tools, 'id', 'name', params[:tool_ids]), include_blank: true, class: 'slim-select w-full sm:min-w-96 max-w-screen', onchange: 'this.form.submit()', multiple: true %>
      </div>
      <div class="min-w-full md:min-w-36">
        <%= label_tag :etats, "États" %>
        <%= select_tag :etats, options_for_select(@états, params[:etats]), include_blank: true, class: 'slim-select w-full', onchange: 'this.form.submit()' %>
      </div>
      <div class="w-full md:w-fit">
        <%= label_tag :date, "Date d'intervention" %>
        <%= date_field_tag :date, params[:date], include_blank:true, onchange:'this.form.submit()', class: 'input input-sm w-full' %>
      </div>
    </div>
  <% end %>

  <div class="divider"></div>

  <div class="overflow-x-auto">
    <table id="tools" class="table table-sm">
      <thead class="bg-slate-100">
        <tr>
          <th><%= sort_link 'tools.name', 'Matériel'%></th>
          <th><%= sort_link 'mouvements.état', 'État'%></th>
          <th>Intervention</th>
          <th><%= sort_link 'mouvements.updated_at', 'MÀJ'%></th>
        </tr>
      </thead>
      <tbody>
        <%= render @mouvements %>
      </tbody>
      <tfoot>
        <th></th>
      </tfoot>
    </table>
  </div>

  <div class="my-6">
    <%== pagy_info(@pagy) %>
    <%== pagy_nav(@pagy) %>
  </div>

</div>