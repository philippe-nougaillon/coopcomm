<tr class="hover">
  <td class="whitespace-nowrap"><%= time_ago_in_words mail_log.created_at %></td>
  <td><%= mail_log.channel.humanize %></td>
  <td class="whitespace-nowrap"><%= mail_log.user_id == 0 ? "Système" : User.find(mail_log.user_id).nom_prénom %></td>
  <td><%= mail_log.to %></td>
  <td><%= mail_log.subject %></td>
  <td>
    <% if status_ko %>
      <span class="text-error">KO</span>
    <% else %>
      <span class="text-success">OK</span>
    <% end %>
  </td>
  <td>
    <% if !status_ko && (mail_log.etat || (mail_log.mail? && @result_opened["items"].find{|item| item["message"]["headers"]["message-id"] == mail_log.message_id })) %>
      <span class="text-info">OUVERT</span>
    <% end %>
  </td>
  <td><%= link_to 'Voir', mail_log, class: 'text-primary hover:underline' %></td>
</tr>