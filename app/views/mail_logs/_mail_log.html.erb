<tr class="hover:bg-base-300 ">
  <td class="px-4 py-3 whitespace-nowrap text-sm capitalize"><%= time_ago_in_words mail_log.created_at %></td>
  <td class="px-4 py-3 text-sm font-semibold"><%= mail_log.channel.humanize %></td>
  <td class="px-4 py-3 whitespace-nowrap text-sm text-primary font-bold"><%= mail_log.user_id == 0 ? "Système" : User.with_discarded.find(mail_log.user_id).nom_prénom %></td>
  <td class="px-4 py-3  text-base font-mono text-slate-400 ">
    <%= mail_log.to %></td>
  <td class="px-4 py-3 text-sm">
    <%= mail_log.subject %></td>
  <td class="px-4 py-3 text-sm">
    <% if mail_log.statut %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-700">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>OK
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-700">
        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>KO
      </span>
    <% end %>
  </td>
  <%# État %>
  <td class="px-4 py-3 text-sm">
    <% if mail_log.etat && mail_log.statut %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Ouvert
      </span>
    <% else %>
      <span class="text-slate-400 text-sm">
        <%= embedded_svg "icons/check_indeterminate_small.svg", class: "text-sm", title: "Aucun état" %>
      </span>
    <% end %>
  </td>
  <td class="pr-4 py-3 text-sm">
    <%= link_to mail_log, class: 'group flex flex-row border border-[#007fcb] items-center rounded-xl p-2 w-16 gap-1 justify-center transition-colors duration-200 hover:bg-[#007fcb] text-primary hover:text-white no-underline' do %>
      <span class="text-xs font-semibold">Voir</span>
      <%= embedded_svg "icons/visibility.svg", class: "w-5 h-5 text-[#007fcb] group-hover:text-white transition-colors duration-200", title: "Aucun état" %>
    <% end %>
  </td>
</tr>
