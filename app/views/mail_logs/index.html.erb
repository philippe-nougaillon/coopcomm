<div class="flex flex-wrap justify-between items-center">
<h1 class="text-4xl text-primary font-bold">Notifications</h1>
  <%= link_to "Actualiser", refresh_mail_logs_path, class: "inline-flex btn btn-primary btn-outline btn-lg rounded hover:!text-white" %>
</div>

<p class="mb-8">
  Historique des notifications envoyées via 
  <%= link_to "MailGun", "https://www.mailgun.com/fr/", target: "_blank", class: "text-primary hover:underline" %>
  ou WhatsApp (<%= link_to "Twilio", "https://www.twilio.com/fr-fr", target: "_blank", class: "text-primary hover:underline" %>),
  avec Statut et État (OK = Acheminé, OUVERT = Vu).
</p>

<%= form_tag request.path, method: :get do %>
  <div class="flex flex-wrap items-end gap-4">

    <div class="w-full md:w-6/12 lg:w-3/12 pr-4">
      <%= label_tag :search, "Destinataire" %>
      <%= select_tag :search, options_for_select(@emails, params[:search]), include_blank: true, onchange:'this.form.submit()', class:"input input-bordered input-sm w-full" %>
    </div>

    <div class="relative max-w-full pr-4">
      <%= label_tag :search_subject, "Sujet" %>
      <%= select_tag :search_subject, options_for_select(@mail_logs.pluck(:subject).uniq.sort, params[:search_subject]), include_blank: true, onchange:'this.form.submit()', class:"select select-bordered select-sm w-full" %>
    </div>

    <div class="pr-4">
      <%= check_box_tag :ko, 1, params[:ko], class:'checkbox mr-2', onchange:'this.form.submit()' %>
      <%= label_tag :ko, "Afficher que les échecs (Statut = KO) ?" %>
    </div>
    
  </div>
<% end %>

<div class="divider"></div>

<div class="overflow-x-auto mt-4">
  <table class="table table-sm">
    <thead class="bg-slate-100">
      <tr>
        <th>Il y a</th>
        <th>Via</th>
        <th>Expéditeur</th>
        <th>Destinataire</th>
        <th>Sujet</th>
        <th>Statut</th>
        <th>État</th>
        <th colspan="2"></th>
      </tr>
    </thead>

    <tbody>
      <% @mail_logs.each_with_index do |mail_log, index| %>
        <%= render partial: "mail_log", locals: {mail_log: mail_log, index:} %>
      <% end %>
    </tbody>

    <tfoot>
      <tr>
        <th colspan=7></th>
      </tr>
    </tfoot>
  </table>
</div>

<% unless params[:ko].present? %>
  <div class="mt-6">
    <%== pagy_info(@pagy) %>
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
<% end %>