<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!('Notifications') %>
    </h1>
    <%= link_to refresh_mail_logs_path, 
                data: { testid: "Actualiser" },
            class: "btn btn-info btn-outline btn-md rounded flex items-center justify-center gap-2 text-base",
     title: "Actualiser" do %>
      <%= embedded_svg "icons/refresh.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
      <span class="hidden md:block"> Actualiser </span>
    <% end %>
  </div>
  <p class="mb-4">
      Historique des mails envoyés via MailGun, avec Statut et État (OK = Acheminé, OUVERT = Vu).
      <br>
      Réactualisation automatique toutes les 10 minutes.
      <br>
      Cliquez sur Actualiser pour récupérer les derniers états plus rapidement. 
  </p>
  <%= form_tag request.path, method: :get, class: "pt-6", data: { turbo_action: "advance" } do %>
    <%= champs_tri_caches %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4 w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="w-full md:flex-1">
        <%= label_tag :search, "Destinataire", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :search, 
          options_for_select(@emails, params[:search]), 
          multiple: true,
          class: 'w-full h-10',
          data: { controller: 'slim-select', placeholder: 'Tous les destinataires',
                  max_values_shown_desktop: 2,
                  max_values_shown_mobile: 2 
                },
          onchange: 'this.form.requestSubmit()' %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :search_subject, "Sujet", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :search_subject, 
          options_for_select(@all_subjects, params[:search_subject]), 
          multiple: true,
          class: 'w-full h-10',
          data: { controller: 'slim-select', placeholder: 'Tous les sujets',
                  max_values_shown_desktop: 2,
                  max_values_shown_mobile: 2 
                },
          onchange: 'this.form.requestSubmit()' %>
      </div>
      <%# Toggle switch "Échecs seulement" %>
      <div class="flex items-center   gap-3 h-10 px-3 border border-slate-200 rounded-lg bg-slate-50 cursor-pointer"
       onclick="document.getElementById('ko_toggle').click()">
        <%= check_box_tag :ko, 1, params[:ko],
          id: 'ko_toggle',
          class: 'hidden',
          onchange: 'this.form.requestSubmit()' %>
        <div id="toggle-track"
         class="w-8 h-4 rounded-full transition-colors duration-200 flex items-center px-0.5 flex-shrink-0 <%= params[:ko].present? ? 'bg-[#007fcb]' : 'bg-slate-300' %>">
          <div class="w-3 h-3 rounded-full bg-white transition-transform duration-200 <%= params[:ko].present? ? 'translate-x-4' : 'translate-x-0' %>"></div>
        </div>
        <span class="text-sm font-medium text-slate-600 whitespace-nowrap">
          Échecs seulement (KO)
        </span>
      </div>
    </div>
  <% end %>
  <hr class="mt-6 mb-6">
  <div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
  </div>
  <div class="flex flex-col bg-white  border-x border-b border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto ">
      <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
        <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
        <span>Faire glisser pour voir plus</span>
      </div>
      <table id="notifications" class="table table-sm w-full border-none ">
        <thead class="bg-slate-100">
          <tr>
            <%= th_tri 'Il y a', colonne: 'mail_logs.created_at', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Via', colonne: 'mail_logs.channel', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Expéditeur', colonne: 'mail_logs.user', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Destinataire', colonne: 'mail_logs.to', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Sujet', colonne: 'mail_logs.subject', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider' %>
            <%= th_tri 'Statut', colonne: 'mail_logs.statut', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center' %>
            <%= th_tri 'État', colonne: 'mail_logs.etat', class: 'px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center' %>
            <th colspan="2"></th>
          </tr>
        </thead>
        <tbody>
          <% if @mail_logs.any? %>
            <% @mail_logs.each_with_index do |mail_log, index| %>
              <%= render partial: "mail_log", locals: { mail_log: mail_log, index: index } %>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="text-left md:text-center py-8 text-slate-400 text-base italic">
                Aucun résultat trouvé pour cette recherche.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy&.pages.to_i > 1 %>
      <div class=" flex flex-col justify-center  p-4 border-t border-slate-100 bg-slate-50/50 w-full">
        <div class="w-full sm:w-auto sm:flex-1 flex justify-center">
          <%= pagy_nav(@pagy).html_safe %>
        </div>
        <div class="text-slate-500 text-center text-sm w-full mt-2">
          <%= pagy_info(@pagy, item_name: "Notifications").html_safe %>
        </div>
      </div>
    <% end %>
  </div>
</div>