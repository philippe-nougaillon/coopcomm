<p class="mb-4">
  <strong>Il y a :</strong>
  <%= time_ago_in_words @mail_log.created_at %>
</p>

<p class="mb-4">
  <strong>Destinataire :</strong>
  <%= @mail_log.to %>
</p>

<p class="mb-4">
  <strong>Sujet :</strong>
  <%= @mail_log.subject %>
</p>

<p class="mb-4">
  <strong>Date :</strong>
  <%= l @mail_log.created_at %>
</p>

<p class="mb-4">
  <strong>ID du message :</strong>
  <%= @mail_log.message_id %>
</p>

<p class="mb-4">
  <strong>Statut :</strong>
  <% if status = @result["items"].find{|item| item["message"]["headers"]["message-id"] == @mail_log.message_id } || @mail_log.error_message %>
    <span class="text-error !break-words"><%= JSON.pretty_generate(status) %></span>
  <% else %>
    <span class="text-success">OK</span>
  <% end %>
</p>

<p class="mb-4">
  <strong>État :</strong>
  <% if status = @result_opened["items"].find{|item| item["message"]["headers"]["message-id"] == @mail_log.message_id } || @mail_log.etat %>
    <span class="text-info">OUVERT</span>
  <% end %>
</p>

<% if @mail_log.whatsapp? %>
  <p class="mb-4">
    <%= link_to "Voir le 'Message Details Twilio'", "https://console.twilio.com/us1/monitor/logs/sms/#{ENV['TWILIO_ACCOUNT_SID']}/#{@mail_log.message_id}", class: 'text-primary hover:underline'%>
  </p>
<% end %>

<%= link_to 'Retour', mail_logs_path, class: 'text-primary hover:underline' %>
