<% formater = ->(valeur) { valeur.is_a?(Date) ? l(valeur, format: :long) : valeur.presence || 'Aucune' } %>

<h2 style="margin-top: 0; color: #0f172a; font-size: 18px;">Bonjour,</h2>

<p style="color: #475569; margin-bottom: 24px;">
  Une absence vous concernant vient d'être <strong><%= @action %></strong> par votre gestionnaire.
</p>

<table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; font-size: 14px;">
  <tbody>
    <% @resume.each do |champ, valeur| %>
      <% ancienne = @resume_avant && @resume_avant[champ] %>
      <tr style="border-bottom: 1px solid #f1f5f9;">
        <td style="padding: 10px 0; font-weight: 600; color: #334155; width: 40%;">
          <%= champ.capitalize %>
        </td>
        <td style="padding: 10px 0; color: #0f172a; text-align: right;">
          <% if @resume_avant && ancienne != valeur %>
            <span style="text-decoration: line-through; color: #94a3b8; margin-right: 6px;">
              <%= formater.call(ancienne) %>
            </span>
            <span style="color: #334155; font-weight: 600;">
              → <strong><%= formater.call(valeur) %></strong>
            </span>
          <% else %>
            <span><%= formater.call(valeur) %></span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div style="background-color: #f8fafc; border-left: 4px solid #3b82f6; padding: 12px 16px; border-radius: 0 4px 4px 0;">
  <p style="margin: 0; font-size: 13px; color: #64748b;">
    En cas d'erreur, rapprochez-vous de votre gestionnaire.
  </p>
</div>