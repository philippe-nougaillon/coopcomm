Bonjour,
<br>
<br>
Une nouvelle absence vient d'être créée :
<br>
<%= @absence.user.nom_prénom %>
<br>
<% if @absence.matin %>
  Le <%= I18n.l(@absence.du, format: :long) %> matin
<% elsif @absence.après_midi %>
  Le <%= I18n.l(@absence.du, format: :long) %> après-midi
<% else %>
  Du <%= I18n.l(@absence.du, format: :long) %> au <%= I18n.l(@absence.au, format: :long) %>
<% end %>
<br>
<br>
Motif : <%= @absence.motif %>
<br>
<br>
Observation : <%= @absence.observation.presence || "Aucune" %>
