Bonjour,
<br><br>
Le QRCode de l'intervention '<b><%= @intervention.description.humanize %></b>' vient d'être flashé.

<br><br>
Arrivée
<br>
<strong><%= I18n.l(@intervention.début, format: :long) %></strong>
<% if @intervention.fin %>
  <br><br>
  Départ
  <br>
  <strong><%= I18n.l(@intervention.fin, format: :long) %></strong>

  <br><br>
  Durée
  <br>
  <strong><%= ((@intervention.fin - @intervention.début).seconds.in_hours - @intervention.temps_de_pause).round(2) %> h</strong>
<% end %>

<br><br>
<%= link_to "Voir l'intervention", intervention_url(@intervention) %>