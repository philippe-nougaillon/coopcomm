<div class="mx-auto lg:w-2/3 w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold">
      <%= page_title!(@warehouse.name) %>
    </h1>
  </div>

  <p class="mt-4">
    <strong class="block text-slate-400 mb-1">Équipes</strong>
    <% if @warehouse.users.any? %>
      <ul>
        <% @warehouse.users.each do |user| %>
          <li><%= user.nom_prénom %></li> <%# Change :email par le champ que tu veux afficher %>
        <% end %>
      </ul>
    <% else %>
      <p>Aucun utilisateur rattaché à ce site pour le moment.</p>
    <% end %>
  </p>

  <p class="mt-4">
    <strong class="block text-slate-400 mb-1">Localisation</strong>
    <%= @warehouse.address %>
  </p>

  <div class="flex flex-wrap gap-2 mt-8">
    <% if policy(@warehouse).edit? %>
      <%= link_to "Modifier", edit_warehouse_path(@warehouse), class: "btn" %>
    <% end %>
    <% if policy(@warehouse).destroy? %>
      <%= button_to warehouse_path(@warehouse), method: :delete, id: "supprimer_warehouse", data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer ce site ?" }, class: "btn", 'data-testid': "Supprimer le site" do %>
            <img
          src="/assets/icons/delete.svg"
          class="icon"
          alt="Suppression"
          title="Suppression de ce site"
        />   
      <% end %>
    <% end %>
    <%= link_to "Retour", admin_parametres_path, class: "btn" %>
  </div>
</div>