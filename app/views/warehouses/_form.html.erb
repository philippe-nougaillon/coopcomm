<div class="max-w-3xl mx-auto bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-100/50 p-6 md:p-8">
  <%= form_with(model: warehouse,  class:'flex flex-col gap-4') do |form| %>
    <% if warehouse.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-500 px-4 py-3 font-medium rounded-lg mb-2 border border-red-200">
        <h2 class="font-black mb-2 text-sm md:text-base">
          <%= pluralize(warehouse.errors.count, "error") %> empêche(nt) ce mouvement d'être sauvegardé :
        </h2>
        <ul class="list-disc list-inside text-xs opacity-90">
          <% warehouse.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= hidden_field_tag :tab, params[:tab] %>
    <div class="w-full">
      <%= form.label :name, class: "label font-semibold text-slate-700" do %>
        <span>Nom <span class="text-red-500">*</span></span>
      <% end %>
      <%= form.text_field :name,       
      required: true,
      class: ["input input-bordered w-full focus:input-primary", {"input-error": warehouse.errors[:name].any?}] %>
    </div>
    <div class="w-full">
      <%= form.label :user_ids, class: "label font-semibold text-slate-700 " do %>
        <span>Équipe (Utilisateurs rattachés) <span class="text-red-500">*</span></span>
      <% end %>
      <%# 
      Note: Remplace `User.all` par la variable de ton contrôleur (ex: @users) si tu veux filtrer.
      Remplace `:email` par `:nom_complet` ou l'attribut que tu veux afficher dans la liste déroulante.
    %>
      <%= form.collection_select :user_ids, @users, :id, :nom_prénom, {}, { 
        multiple: true, 
        class: 'w-full h-10 slim-select', 
        required: true,
        data: {  max_values_shown_desktop: 2,
                 max_values_shown_mobile: 1 
              }
        }
        %>
    </div>
    <div class="w-full" data-controller="places" data-places-center-lat-value="<%= ENV['MAPS_CENTER_LAT'] %>" data-places-center-lng-value="<%= ENV['MAPS_CENTER_LNG'] %>">
      <%= form.label :address, class: "label font-semibold text-slate-700" do %>
        <span>Localisation <span class="text-red-500">*</span></span>
      <% end %>
      <%# Le champ visible par l'utilisateur pour chercher l'adresse %>
      <%= form.text_field :address, 
          required: true, 
          class: 'input input-bordered w-full focus:input-primary', 
          placeholder: 'Commencez à taper une adresse...', 
          data: { places_target: "address" } %>
      <%# Les champs cachés qui seront remplis automatiquement par le JS %>
      <%= form.hidden_field :latitude, data: { places_target: "latitude" } %>
      <%= form.hidden_field :longitude, data: { places_target: "longitude" } %>
    </div>
    <div class="flex flex-col sm:flex-row gap-2 mt-4 w-full">
      <%= button_tag "Annuler", type: "button", onclick: "history.back();", class: "btn w-full sm:flex-1" %>
      <%= form.submit "Enregistrer",   class: "btn btn-primary text-white font-bold w-full sm:flex-1 order-1 sm:order-2 shadow-md hover:shadow-lg transition-all" %>
  </div>
  <% end %>
  <div class="pt-6 max-w-3xl mx-auto ">
    <%= link_to admin_parametres_path(tab: params[:tab] || 'sites'), class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-primary transition group" do %>
      <%= embedded_svg "icons/arrow_back.svg", class: "text-base transition-transform group-hover:-translate-x-1", title: "Retour à la liste des utilisateurs" %>
      Retour aux paramètres
    <% end %>
  </div>