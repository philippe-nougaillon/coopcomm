<tr id="<%= dom_id warehouse %>" class="hover:bg-base-300">
  <td class="text-lg sm:text-2xl text-primary">
    <%= link_to warehouse.name, warehouse, class: 'text-primary hover:underline' %>
  </td>
  <td class="text-sm">
    <%= warehouse.users.pluck(:nom).join(', ') %>
  </td>
  <td class="text-sm">
    <%= warehouse.address %>
  </td>
</tr>
