<div class="flex flex-col">
  <div class="flex flex-row justify-between items-center my-4 gap-2">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!('CRM') %>
    </h1>
  </div>
  <% current_tab = params[:tab] || 'cotations' %>
  <%= form_tag request.path, method: :get, class: "pt-6", data: { turbo_action: "advance" } do %>
    <%= hidden_field_tag :tab, current_tab %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4 w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="w-full md:flex-1">
        <%= label_tag :search, "Rechercher", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= text_field_tag :search, params[:search],
                            onchange: 'this.form.requestSubmit()',
                            class: 'input input-bordered input-md w-full',
                            placeholder: "Réf, intitulé" %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :service_ids, "Services", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1"  %>
        <%= select_tag :service_ids,
                options_from_collection_for_select(@services, 'id', 'nom', params[:service_ids]),
                multiple: true,
                class: 'slim-select w-full h-10',
                data: { placeholder: 'Tous les services' },
                onchange: 'this.form.requestSubmit()' %>
      </div>
      <div class="w-full md:flex-1">
        <%= label_tag :workflow_state, "Statut", class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1" %>
        <%= select_tag :workflow_state,
                       options_for_select(Commande.workflow_state_humanized, params[:workflow_state]),
                       include_blank: "Tous", class: "slim-select w-full h-10",
                       onchange: "this.form.submit()" %>
      </div>
    </div>
  <% end %>
  <div class="mt-4 border-b border-slate-200">
    <nav class="flex gap-1" aria-label="adherent_crm">
      <%= link_to adherent_crm_path(tab: 'cotations', search: params[:search]),
                    class: "px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors #{@tab == 'cotations' ? 'text-primary border-primary' : 'text-slate-500 hover:text-slate-800 border-transparent'}" do %>
        Mes Cotations
      <% end %>
      <%= link_to adherent_crm_path(tab: 'commandes', search: params[:search]),
                    class: "px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors #{@tab == 'commandes' ? 'text-primary border-primary' : 'text-slate-500 hover:text-slate-800 border-transparent'}" do %>
        Mes Commandes
      <% end %>
      <%= link_to adherent_crm_path(tab: 'factures', search: params[:search]),
                    class: "px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors #{@tab == 'factures' ? 'text-primary border-primary' : 'text-slate-500 hover:text-slate-800 border-transparent'}" do %>
        Mes Factures
      <% end %>
    </nav>
  </div>
  <div class="mt-6">
    <% case @tab %>
    <% when 'cotations' %>
      <section id="cotations" class="animate-fade-in">
        <div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
        </div>
        <div class="flex flex-col bg-white border-x border-b border-slate-200 shadow-sm overflow-hidden <%= 'rounded-b-xl' unless @pagy&.pages.to_i > 1 %>">
          <div class="overflow-x-auto">
            <table class="table table-sm w-full border-none">
              <thead class="bg-slate-100">
                <tr>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Réf</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Statut</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Adhérent</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Service</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Intitulé</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Livraison</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Total HT</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Dernier mail</th>
                </tr>
              </thead>
              <tbody>
                <% if @cotations.any? %>
                  <%= render partial: "cotations/cotation", collection: @cotations, locals: { last_mail_logs: @last_mail_logs } %>
                <% else %>
                  <tr>
                    <td colspan="8" class="text-center py-8 text-slate-400 text-base italic">Aucune cotation.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @pagy&.pages.to_i > 1 %>
            <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full">
              <%= pagy_nav(@pagy).html_safe %>
              <div class="text-slate-500 text-center text-sm w-full"><%= pagy_info(@pagy, item_name: "cotations").html_safe %></div>
            </div>
          <% end %>
        </div>
      </section>
    <% when 'commandes' %>
      <section id="commandes" class="animate-fade-in">
        <div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
        </div>
        <div class="flex flex-col bg-white border-x border-b border-slate-200 shadow-sm overflow-hidden <%= 'rounded-b-xl' unless @pagy&.pages.to_i > 1 %>">
          <div class="overflow-x-auto">
            <table class="table table-sm w-full border-none">
              <thead class="bg-slate-100">
                <tr>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Réf</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Statut</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Adhérent</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Service</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Intitulé</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Livraison</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Total HT</th>
                </tr>
              </thead>
              <tbody>
                <% if @commandes.any? %>
                  <%= render partial: "commandes/commande", collection: @commandes %>
                <% else %>
                  <tr>
                    <td colspan="7" class="text-center py-8 text-slate-400 text-base italic">Aucune commande.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @pagy&.pages.to_i > 1 %>
            <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full">
              <%= pagy_nav(@pagy).html_safe %>
              <div class="text-slate-500 text-center text-sm w-full"><%= pagy_info(@pagy, item_name: "commandes").html_safe %></div>
            </div>
          <% end %>
        </div>
      </section>
    <% when 'factures' %>
      <section id="factures" class="animate-fade-in">
        <div class="flex flex-row justify-between items-center w-full bg-slate-100 px-4 py-2 rounded-t-xl border-t border-x border-slate-200">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Résultats</span>
        </div>
        <div class="flex flex-col bg-white border-x border-b border-slate-200 shadow-sm overflow-hidden <%= 'rounded-b-xl' unless @pagy&.pages.to_i > 1 %>">
          <div class="overflow-x-auto">
            <table class="table table-sm w-full border-none">
              <thead class="bg-slate-100">
                <tr>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Réf</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Statut</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Adhérent</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Service</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">Intitulé</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Livraison</th>
                  <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider text-center">Total HT</th>
                </tr>
              </thead>
              <tbody>
                <% if @factures.any? %>
                  <%= render partial: "factures/facture", collection: @factures %>
                <% else %>
                  <tr>
                    <td colspan="7" class="text-center py-8 text-slate-400 text-base italic">Aucune facture.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @pagy&.pages.to_i > 1 %>
            <div class="flex flex-col justify-center p-4 border-t border-slate-100 bg-slate-50/50 w-full">
              <%= pagy_nav(@pagy).html_safe %>
              <div class="text-slate-500 text-center text-sm w-full"><%= pagy_info(@pagy, item_name: "factures").html_safe %></div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>