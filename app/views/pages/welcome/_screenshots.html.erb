<%
  slides = [
    { src: "/slide1.png",           title: "Une vue d'ensemble",              text: "Toute l'activité de votre intercommunalité sur un seul écran." },
    { src: "/new_intervention.png", title: "Créer une intervention",          text: "Une demande se saisit en quelques secondes, depuis un ordinateur ou un téléphone." },
    { src: "/interventions.png",    title: "Suivre les interventions",        text: "Retrouvez toutes les demandes et leur état d'avancement." },
    { src: "/intervention.png",     title: "Le détail d'une intervention",    text: "Agents, matériel, échanges et historique réunis au même endroit." },
    { src: "/tools.png",            title: "Gérer le matériel",               text: "Inventaire, prêts et utilisation du matériel partagé." },
    { src: "/dashboard.png",        title: "Piloter avec le tableau de bord", text: "Les indicateurs clés pour garder la maîtrise de vos budgets." }
  ]
%>  
  
  <section id="images" data-controller="welcome" class="scroll-mt-24 bg-[#F6F2F9] px-6 lg:px-16 py-20 lg:py-28">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight max-w-3xl text-center md:text-left">La plateforme en images</h2>
      <p class="mt-3 text-lg text-black/70 max-w-2xl text-center md:text-left">Choisissez une fonctionnalité pour voir l'écran correspondant.</p>

      <div class="mt-12 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 lg:gap-14 items-start">

        <div role="tablist" aria-orientation="vertical" aria-label="Écrans de CoopComm"
             class="order-2 lg:order-1 flex flex-col">
          <% slides.each_with_index do |slide, i| %>
             <button type="button" role="tab" id="tab-<%= i %>" aria-controls="shot-<%= i %>"
                    aria-selected="<%= i.zero? %>" tabindex="<%= i.zero? ? 0 : -1 %>"
                    data-welcome-target="tab" data-active="<%= i.zero? %>"
                    data-action="click->welcome#select keydown->welcome#keydown"
                    class="group text-left border-l-2 border-[#691E9A]/15 data-[active=true]:border-[#691E9A]
                           pl-5 py-3 transition-colors motion-reduce:transition-none <%= PagesHelper::TAB_FOCUS %>">
              <span class="block text-lg font-bold text-black/55 group-hover:text-black/80 group-data-[active=true]:text-[#691E9A] transition-colors">
                <%= slide[:title] %>
              </span>
              <span class="grid grid-rows-[0fr] group-data-[active=true]:grid-rows-[1fr] transition-[grid-template-rows] duration-300 motion-reduce:transition-none">
                <span class="overflow-hidden">
                  <span class="block pt-1 pb-1 text-black/70 leading-relaxed"><%= slide[:text] %></span>
                </span>
              </span>
            </button>
          <% end %>
        </div>

        <div class="order-1 lg:order-2 lg:sticky lg:top-28">
          <div class="rounded-xl overflow-hidden bg-white shadow-2xl ring-1 ring-black/5">
            <div class="flex gap-1.5 px-3 py-2 bg-slate-100" aria-hidden="true">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff6b6b]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#ffd166]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#06d6a0]"></span>
            </div>
            <div class="relative aspect-[16/10] bg-white">
              <% slides.each_with_index do |slide, i| %>
                <div role="tabpanel" id="shot-<%= i %>" aria-labelledby="tab-<%= i %>"
                      data-welcome-target="panel" data-active="<%= i.zero? %>"
                      class="absolute inset-0 opacity-0 data-[active=true]:opacity-100 transition-opacity duration-300 motion-reduce:transition-none
                            pointer-events-none data-[active=true]:pointer-events-auto">
                  <%= image_tag slide[:src], alt: slide[:title], class: "h-full w-full object-contain object-top",
                        loading: (i.zero? ? nil : "lazy") %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>