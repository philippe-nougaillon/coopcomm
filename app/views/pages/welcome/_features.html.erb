<section id="features" data-controller="welcome" data-welcome-hash-prefix-value="group-"
         class="bg-white px-6 py-16 lg:px-16">

  <div class="max-w-6xl mx-auto">

    <h2 class="text-3xl lg:text-5xl font-bold">
      Des fonctionnalités pensées pour votre quotidien
    </h2>
    <p class="mt-4 text-lg text-gray-600">
      Découvrez l'ensemble de nos outils conçus pour simplifier la gestion de votre organisation.
    </p>

    <div role="tablist" class="mt-8 flex flex-wrap gap-2">
      <% feature_groups.each_with_index do |group, i| %>
        <button type="button" role="tab" id="gtab-<%= group[:id] %>"
                aria-selected="<%= i.zero? %>" tabindex="<%= i.zero? ? 0 : -1 %>"
                data-welcome-target="tab" data-id="<%= group[:id] %>" data-active="<%= i.zero? %>"
                data-action="click->welcome#select keydown->welcome#keydown"
                class="px-4 py-2 rounded-full border border-purple-300 text-[#691E9A] font-semibold
                       hover:bg-purple-50
                       data-[active=true]:bg-[#691E9A] data-[active=true]:text-white">
          <%= group[:title] %>
        </button>
      <% end %>
    </div>

    <div class="mt-10">
      <% feature_groups.each_with_index do |group, i| %>
        <div role="tabpanel" id="group-<%= group[:id] %>"
             data-welcome-target="panel" data-active="<%= i.zero? %>"
             class="hidden data-[active=true]:grid grid-cols-1 lg:grid-cols-3 gap-6">

          <div>
            <h3 class="text-2xl font-bold text-[#691E9A]"><%= group[:title] %></h3>
            <p class="mt-2 text-gray-600"><%= group[:intro] %></p>
          </div>

          <ul class="lg:col-span-2 divide-y divide-gray-200 border-y border-gray-200">
            <% group[:items].each do |item| %>
              <li class="flex gap-4 py-5">
                <span class="shrink-0 w-10 h-10 rounded-full bg-purple-50 text-[#691E9A] flex items-center justify-center">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><%= raw item[:icon] %></svg>
                </span>
                <div>
                  <h4 class="font-semibold text-lg">
                    <%= item[:title] %>
                    <% if item[:new] %>
                      <span class="ml-2 text-xs font-bold bg-yellow-200 px-2 py-1 rounded-full">Nouveau</span>
                    <% end %>
                  </h4>
                  <p class="mt-1 text-gray-700"><%= item[:text] %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

  </div>
</section>