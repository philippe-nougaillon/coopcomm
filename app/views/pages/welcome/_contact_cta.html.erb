<section id="savoir-plus" class="scroll-mt-24 px-6 py-12 lg:px-16 lg:py-20">
  <div class="max-w-6xl mx-auto">
    <div class="relative overflow-hidden bg-[#F4EFE6] rounded-3xl p-6 lg:p-16 shadow-sm">

      <span aria-hidden="true" class="absolute -bottom-12 -right-12 w-40 h-40 lg:-bottom-20 lg:-right-20 lg:w-64 lg:h-64 rounded-full bg-[#47b5db]/30"></span>
      <span aria-hidden="true" class="absolute -top-12 -left-12 w-32 h-32 lg:-top-16 lg:-left-16 lg:w-48 lg:h-48 rounded-full bg-[#db2767]/25"></span>

      <div class="relative max-w-3xl mx-auto text-center">
        <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-black mb-4">
          Vous souhaitez en savoir plus ?
        </h2>
        <p class="text-base lg:text-lg text-black mb-10 lg:mb-12">
          Échangez avec l'un de nos experts ou explorez notre documentation pour découvrir comment
          <%= coopcomm_logo %> s'adapte à votre intercommunalité.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <%= link_to "Réservez une démonstration", PagesHelper::DEMO_URL,
                class: "#{PagesHelper::BUTTON_BASE} w-full md:inline-block bg-[#db2767] text-white shadow-md
                  hover:bg-[#a8174f] hover:shadow-xl hover:-translate-y-0.5" %>
          <%= link_to "Consultez notre documentation", documentation_index_path,
                class: "#{PagesHelper::BUTTON_BASE}  w-full md:inline-block bg-white border border-slate-200
                  hover:bg-[#db2767]/10 hover:border-[#db2767] hover:text-[#db2767] hover:-translate-y-0.5" %>
      </div>

    </div>
  </div>
</section>