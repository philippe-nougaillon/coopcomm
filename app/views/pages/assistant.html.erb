<div class="flex flex-col">
  <div class="flex flex-row my-4 gap-6">
    <h1 class="text-4xl text-primary font-bold">
      <%= page_title!('Assistant (IA)') %>
    </h1>
    <span class="inline-flex w-fit items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-700">
      <%= embedded_svg "icons/star_shine.svg", class: "w-4 h-4 fill-current" %>
      Bêta
    </span>
  </div>

  <p class="text-lg text-secondary mb-14">
    Analyse vos données d'intervention et génère automatiquement des propositions de planification adaptées à votre contexte.
  </p>

  <%= form_tag request.path, method: :get, class: 'mb-8', id: 'ai-generate-form' do %>
    <%= submit_tag "Lancer la génération de propositions",
        class: 'btn btn-primary btn-outline rounded hover:text-white! md:btn-lg',
        'data-turbo': 'false',
        'data-disable-with': false %>
  <% end %>

  <% if @results.blank? && !@is_failed %>
    <div class="mb-8 p-6 rounded-lg border border-dashed border-slate-300 text-secondary text-sm">
      Aucune proposition générée pour le moment. Cliquez sur « Lancer la génération » ci-dessus pour que l'IA analyse votre historique d'interventions.
    </div>
  <% end %>

  <% if @is_failed %>
    <div class="flex items-start gap-2 mb-8 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-800">
      <%= embedded_svg "icons/warning.svg", class: "w-4 h-4 fill-current text-red-600 mt-0.5 flex-shrink-0" %>
      <p>La génération a échoué. Cela peut être dû à une surcharge temporaire du service IA. Vous pouvez réessayer ci-dessous.</p>
    </div>
    <%= form_tag request.path, method: :get, class: 'mb-8' do %>
      <%= submit_tag "Réessayer la génération",
          class: 'btn btn-primary btn-outline rounded hover:text-white! md:btn-lg',
          'data-turbo': 'false' %>
    <% end %>
  <% end %>

  <% if @results.present? %>
    <div class="mb-4 animate-fade-in">
      <h3 class="text-xl font-semibold mb-4">
        Propositions de l'IA
        <span class="text-sm font-normal text-slate-400">(mistral-medium-2508)</span>
      </h3>
      <%# Version Mistral — sanitize en 2e barrière derrière filter_html (injection de prompt) %>
      <div class="prose max-w-none typewriter">
        <%= sanitize(@results) %>
      </div>
    </div>
  <% end %>

  <div class="flex items-start gap-2 mt-4 p-3 rounded-lg bg-amber-50 border border-amber-200 text-sm text-amber-800">
    <%= embedded_svg "icons/warning.svg", class: "w-4 h-4 fill-current text-amber-600 mt-0.5 flex-shrink-0" %>
    <p>Les propositions générées sont des suggestions basées sur l'historique. Aucune intervention n'est créée automatiquement sans votre validation explicite.</p>
  </div>
</div>

<style>
  .typewriter p {
    opacity: 0;
    animation: fadeInLine 0.4s ease forwards;
  }
  @keyframes fadeInLine {
    to { opacity: 1; }
  }
  .animate-fade-in {
    animation: fadeInBlock 0.3s ease-out;
  }
  @keyframes fadeInBlock {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .btn-loading {
    pointer-events: none;
    opacity: 0.7;
  }
  .btn-loading::after {
    content: "";
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-left: 0.5em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    vertical-align: -0.15em;
    animation: spin 0.6s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    // --- Typewriter effect sur les résultats ---
    const paragraphs = document.querySelectorAll(".typewriter p");
    const typingSpeed = 1;
    let totalTime = 0;
    paragraphs.forEach((paragraph, index) => {
      const delay = totalTime;
      paragraph.style.animationDelay = `${delay}s`;
      const duration = typingSpeed + 0.5;
      totalTime += duration;
    });

    // --- Feedback de chargement au clic ---
    document.querySelectorAll('form[data-turbo="false"]').forEach(function(form) {
      form.addEventListener("submit", function() {
        const btn = form.querySelector('input[type="submit"], button[type="submit"]');
        if (btn) {
          btn.classList.add("btn-loading");
          btn.value = "Génération en cours…";
          btn.disabled = false; // rester "enabled" pour que la valeur soit soumise, mais bloquer le clic via pointer-events
        }
      });
    });
  });
</script>