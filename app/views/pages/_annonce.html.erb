<% auteur = User.with_discarded.find_by(id: message.from_id) %>
<% service = message.destinataire if message.annonce? %>
<div class="flex flex-wrap lg:flex-nowrap items-center gap-4  p-4">
  <div class="w-10">
    <% if auteur %>
      <%= render partial: 'partials/user_profile_picture', locals: { user: auteur } %>
    <% else %>
      <%= embedded_svg "icons/campaign.svg", class: "text-primary", title: "annonce" %>
    <% end %>
  </div>
  <div class="flex flex-col">
    <span class="badge badge-primary badge-sm h-auto py-0.5"><%= message.annonce? ? "Annonce service #{service&.nom}" : "#{current_user.organisation.nom}" %></span>
    <span class="text-xs whitespace-nowrap italic text-slate-400 mt-1">
      il y a <%= time_ago_in_words message.created_at %>
    </span>
    <b class="lg:line-clamp-2">
      <%= link_to truncate(message.moderation, length: 100), messagerie_annonces_path(service_slug: service&.slug), class: 'hover:underline hover:text-primary' %>
    </b>
  </div>
</div>
