<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="flex flex-wrap justify-between items-center h-12 sm:h-16">
  <h1 class="text-4xl text-primary font-bold">Tableau de bord</h1>
</div>

<% if current_user.manager? %>
  <div class="flex flex-wrap">
    <div class="w-full sm:w-1/2 flex flex-col items-center mb-12">
      <h2 class="text-2xl sm:whitespace-nowrap text-center">Temps total par adhérent</h2>
      <canvas id="tempsTotalParAdhérentChart" class="max-h-64" data-turbo="false"></canvas>
    </div>
    <div class="w-full sm:w-1/2 flex flex-col items-center mb-12">
      <h2 class="text-2xl sm:whitespace-nowrap text-center">Temps total par agent</h2>
      <canvas id="tempsTotalParAgentChart" class="max-h-64" data-turbo="false"></canvas>
    </div>
    <div class="w-full sm:w-1/2 flex flex-col items-center mb-12">
      <h2 class="text-2xl sm:whitespace-nowrap text-center">Nombre d'intervention par état et par mois</h2>
      <canvas id="workflowChart" class="max-h-64" data-turbo="false"></canvas>
    </div>
    <div class="flex-1 flex flex-wrap gap-12 items-between">
      <div class="flex-1 sm:w-1/2 flex flex-col items-center mb-12">
        <h2 class="text-2xl sm:whitespace-nowrap text-center">Nombre d'intervention par service</h2>
        <canvas id="qtéInterventionsParServiceChart" class="max-h-64" data-turbo="false"></canvas>
      </div>
      <div class="flex-1 sm:w-1/2 flex flex-col items-center mb-12">
        <h2 class="text-2xl sm:whitespace-nowrap text-center">Temps total par service</h2>
        <canvas id="tempsTotalParServiceChart" class="max-h-64" data-turbo="false"></canvas>
      </div>
    </div>
  </div>
  <script>
    /*
      Temps total par adhérent
    */
    var dataTempsTotalParAdhérent = {
      labels: <%= @temps_total_par_adhérent.keys.to_json.html_safe %>,
      datasets: [
        {
          label: "Temps(h)",
          backgroundColor: [
            'rgba(153, 101, 255, 0.4)',
            'rgba(255,159, 64, 0.4)',
            'rgba(54, 162, 235, 0.4)',
            'rgba(75, 192, 192, 0.4)',
            'rgba(255, 205, 86, 0.4)',
            'rgba(255, 99, 132, 0.4)',
            'rgba(201, 203, 207, 0.4)',
          ],
          borderColor: [
            'rgb(153, 102, 255)',
            'rgb(255, 159, 64)',
            'rgb(54, 162, 235)',
            'rgb(75, 192, 192)',
            'rgb(255, 205, 86)',
            'rgb(255, 99, 132)',
            'rgb(201, 203, 207)'
          ],
            borderWidth: 1,
          data: <%= @temps_total_par_adhérent.values.to_json.html_safe %>,
        },
      ],
    };

    var configTempsTotalParAdhérent = {
      type: "pie",
      data: dataTempsTotalParAdhérent,
      options: {},
    };

    var elementTempsTotalParAdhérent = document.getElementById("tempsTotalParAdhérentChart");
    if (elementTempsTotalParAdhérent) {
      new Chart(elementTempsTotalParAdhérent, configTempsTotalParAdhérent);
    }


    /*
      Temps total par agent
    */

    var configTempsTotalParAgent = {
      data: {
        datasets: [{
          type: 'bar',
          label: "Temps total (h)",
            backgroundColor: [
              'rgba(54, 162, 235, 0.4)',
            ],
            borderColor: [
              'rgb(54, 162, 235)',
            ],
            borderWidth: 1,
          data: <%= @temps_total_par_agent.values.to_json.html_safe %>,
        }],
        // , {
        //   type: 'line',
        //   label: 'Limite mensuelle',
        //   data: Array(<%= @temps_total_par_agent.keys.count %>).fill(35*4),
        //   backgroundColor: 'rgba(255, 99, 132, 0.4)',
        //   borderColor: 'rgb(255, 99, 132)',
        //   borderWidth: 1,
        // }],
        labels: <%= @temps_total_par_agent.keys.to_json.html_safe %>,
      },
      options: {}
    };

    var elementTempsTotalParAgent = document.getElementById("tempsTotalParAgentChart");
    if (elementTempsTotalParAgent) {
      new Chart(elementTempsTotalParAgent, configTempsTotalParAgent);
    }

    /*
      Quantité intervention par workflow par mois
    */
    var dataWorkflowChart = <%= @data_workflow_chart.to_json.html_safe %>; // Passez les données depuis Rails au JS

    var configWorkflowChart = {
      type: "bar",
      data: dataWorkflowChart,
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'top',
          },
          tooltip: {
            mode: 'index',
            intersect: false,
          }
        },
        scales: {
          x: {
            stacked: true, // Barres empilées sur l'axe X
          },
          y: {
            stacked: true, // Barres empilées sur l'axe Y
          }
        }
      }
    };

    var elementWorkflowChart = document.getElementById("workflowChart");
    if (elementWorkflowChart) {
      new Chart(elementWorkflowChart, configWorkflowChart);
    }

    /*
      Quantité intervention par service
    */

    var dataQtéInterventionsParService = {
      labels: <%= @qté_interventions_par_service.keys.to_json.html_safe %>,
      datasets: [
        {
          label: "Nombre intervention",
          backgroundColor: [
            'rgba(153, 101, 255, 0.4)',
            'rgba(255,159, 64, 0.4)',
            'rgba(54, 162, 235, 0.4)',
            'rgba(75, 192, 192, 0.4)',
            'rgba(255, 205, 86, 0.4)',
            'rgba(255, 99, 132, 0.4)',
            'rgba(201, 203, 207, 0.4)',
          ],
          borderColor: [
            'rgb(153, 102, 255)',
            'rgb(255, 159, 64)',
            'rgb(54, 162, 235)',
            'rgb(75, 192, 192)',
            'rgb(255, 205, 86)',
            'rgb(255, 99, 132)',
            'rgb(201, 203, 207)'
          ],
            borderWidth: 1,
          data: <%= @qté_interventions_par_service.values.to_json.html_safe %>,
        },
      ],
    };

    var configQtéInterventionsParService = {
      type: "pie",
      data: dataQtéInterventionsParService,
      options: {},
    };

    var elementQtéInterventionsParService = document.getElementById("qtéInterventionsParServiceChart");
    if (elementQtéInterventionsParService) {
      new Chart(elementQtéInterventionsParService, configQtéInterventionsParService);
    }

    /*
      Temps total par service
    */

    var dataTempsTotalParService = {
      labels: <%= @temps_total_par_service.keys.to_json.html_safe %>,
      datasets: [
        {
          label: "Temps total (h)",
          backgroundColor: [
            'rgba(153, 101, 255, 0.4)',
            'rgba(255,159, 64, 0.4)',
            'rgba(54, 162, 235, 0.4)',
            'rgba(75, 192, 192, 0.4)',
            'rgba(255, 205, 86, 0.4)',
            'rgba(255, 99, 132, 0.4)',
            'rgba(201, 203, 207, 0.4)',
          ],
          borderColor: [
            'rgb(153, 102, 255)',
            'rgb(255, 159, 64)',
            'rgb(54, 162, 235)',
            'rgb(75, 192, 192)',
            'rgb(255, 205, 86)',
            'rgb(255, 99, 132)',
            'rgb(201, 203, 207)'
          ],
            borderWidth: 1,
          data: <%= @temps_total_par_service.values.to_json.html_safe %>,
        },
      ],
    };

    var configTempsTotalParService = {
      type: "pie",
      data: dataTempsTotalParService,
      options: {},
    };

    var elementTempsTotalParService = document.getElementById("tempsTotalParServiceChart");
    if (elementTempsTotalParService) {
      new Chart(elementTempsTotalParService, configTempsTotalParService);
    }

  </script>
