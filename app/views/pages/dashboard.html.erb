<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16 mb-8">
  <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!('Tableau de bord - ' + current_user.rôle.humanize) %></h1>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12 w-full">
  <div class="flex flex-col items-center justify-center p-6 bg-base-100 border border-base-300 rounded-xl shadow-sm text-center">
    <span class="text-xs font-semibold text-base-content/60 uppercase tracking-wider">Total Interventions</span>
    <span class="text-3xl font-black text-primary mt-1"><%= @kpi_total_interventions %></span>
  </div>
  <div class="flex flex-col items-center justify-center p-6 bg-base-100 border border-base-300 rounded-xl shadow-sm text-center">
    <span class="text-xs font-semibold text-base-content/60 uppercase tracking-wider">Temps Cumulé</span>
    <span class="text-3xl font-black text-secondary mt-1"><%= @kpi_temps_total %></span>
  </div>
  <div class="flex flex-col items-center justify-center p-6 bg-base-100 border border-base-300 rounded-xl shadow-sm text-center">
    <span class="text-xs font-semibold text-base-content/60 uppercase tracking-wider">Agents Assignés</span>
    <span class="text-3xl font-black text-accent mt-1"><%= @kpi_agents_actifs %></span>
  </div>
  <div class="flex flex-col items-center justify-center p-6 bg-base-100 border border-base-300 rounded-xl shadow-sm text-center">
    <span class="text-xs font-semibold text-base-content/60 uppercase tracking-wider">Empreinte CO₂</span>
    <span class="text-3xl font-black text-neutral mt-1"><%= @kpi_co2_total %></span>
  </div>
</div>
<% if current_user.manager_or_admin? %>
  <%= render partial:'pages/dashboard/dashboard_manager' %>
  <h2 class="text-2xl text-secondary mt-16 font-bold mb-4">Historique des exports</h2>
  <% if @export_logs.any? %>
    <div class="flex flex-col bg-white border border-slate-200 rounded-xl  shadow-sm overflow-hidden">
      <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
        <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
        <span>Faire glisser pour voir plus</span>
      </div>
      <div class="overflow-x-auto">
        <table class="table table-sm w-full border-none">
          <thead class="bg-slate-100">
            <tr>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">
                Date et heure</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">
                Utilisateur</th>
              <th class="px-4 py-3 font-semibold text-slate-500 uppercase tracking-wider">
                Type d'export</th>
            </tr>
          </thead>
          <tbody>
            <% @export_logs.first(10).each do |log| %>
              <tr class="hover:bg-base-200/60 transition-colors duration-150 align-middle">
                <td class="whitespace-nowrap"><%= l(log.created_at, format: :long) %></td>
                <td class="whitespace-nowrap"><%= log.user.try(:nom_prénom) || "Utilisateur supprimé" %></td>
                <td>
                  <span class="badge badge-sm badge-outline whitespace-nowrap px-3 py-3">
                    <%= export_type_label(log.export_type) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% if @export_logs.count > 10 %>
    <%= link_to export_logs_path, class: 'text-primary mt-4 hover:underline flex items-center flex-row justify-between gap-2 max-w-xs' do %>
      Voir tout l'historique
      <%= embedded_svg "icons/download.svg", class: "w-5 h-5 fill-current transition-colors duration-200" %>
    <% end %>
  <% end %>
<% else %>
  <div class="border border-base-200 rounded-xl p-4 bg-base-100">
    <p class="text-slate-500">Aucun export effectué pour le moment.</p>
  </div>
<% end %>
<% elsif current_user.adhérent? %>
  <%= render partial:'pages/dashboard/dashboard_adhérent' %>
<% end %>
<div class="flex flex-wrap justify-end items-center gap-2 p-4">
  <%= link_to url_for(params.permit!.merge(format: :xls)), 
              class: "btn btn-primary btn-outline btn-md rounded flex items-center justify-center gap-2 text-base w-full sm:w-auto" do %>
    <%= embedded_svg "icons/upload.svg", class: "w-6 h-6 fill-current transition-colors duration-200" %>
    <span>Exporter en XLS</span>
  <% end %>
</div>
