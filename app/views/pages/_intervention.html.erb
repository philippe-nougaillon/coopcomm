<div class="group p-6 transition-all duration-300 hover:bg-slate-50 hover:-translate-y-0.5">
  <div class="flex gap-5">
    <div class="flex-shrink-0">
      <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center">
        <% if intervention.repeter %>
          <%= embedded_svg "icons/event_repeat.svg",
              class: "w-6 h-6 text-secondary",
              title: "Intervention répétée" %>
        <% else %>
          <%= embedded_svg "icons/construction.svg",
              class: "w-6 h-6 text-secondary",
              title: "Intervention en cours" %>
        <% end %>
      </div>
    </div>
    <div class="flex-1 min-w-0">
      <%= link_to intervention,
          class:"block group/title" do %>
        <h3 class="font-bold text-lg leading-6 text-<%= intervention.style.split.first.split('-').last %> group-hover/title:underline break-words flex flex-row  gap-1 items-center ">
          <span><%= intervention.description.humanize %></span>
          <% if intervention.repeter %>
            <%= embedded_svg "icons/event_repeat.svg", title: "Modèle pour le pointage", class: "w-5 h-5 fill-current shrink-0" %>
          <% elsif intervention.template_slug %>
            <%= embedded_svg "icons/qr_code_2.svg", title: "Pointage", class: "w-5 h-5 fill-current shrink-0" %>
          <% end %>
        </h3>
      <% end %>
      <small class="text-slate-500 mt-2 block">
        Il y a <%= time_ago_in_words(intervention.updated_at) %>
      </small>
      <!-- Boutons -->
      <div class="flex flex-row  gap-3 mt-5">
        <%= render "interventions/boutons_workflow", intervention: intervention,
                   styles: { terminer_modal: "btn btn-primary btn-outline   hover:text-white! w-full sm:w-24 justify-center",
                             terminer: "btn btn-primary btn-outline w-24 text-sm transition-all duration-300 hover:scale-105 hover:text-white!",
                             valider: "btn btn-success btn-outline w-24 text-sm  transition-all duration-300 hover:scale-105 hover:text-white!",
                             refuser: "btn btn-error btn-outline w-24 transition-all duration-300 hover:scale-105 hover:text-white!" },
                   titres: { terminer_modal: "Terminer l'intervention" } %>
      </div>
    </div>
  </div>
</div>