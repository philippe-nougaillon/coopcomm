<div class="flex items-center justify-between sm:justify-start gap-4 border border-gray-200 p-4 sm:p-8">
  <div class="flex items-start gap-4 sm:w-80 min-w-0">
    <% if intervention.repeter %>
      <%= embedded_svg "icons/event_repeat.svg", class: "text-secondary", title: "Intervention répétée" %>
    <% else %>
      <%= embedded_svg "icons/construction.svg", title: "Intervention en cours" %>
    <% end %>
    <div class="flex flex-col gap-1 min-w-0">
      <b><%= link_to intervention.description.humanize, intervention, class: "text-#{intervention.style.split.first.split('-').last} hover:underline block truncate" %></b>
      <small>Modifié il y a <%= time_ago_in_words(intervention.updated_at)%></small>
    </div>
  </div>
  <div class="flex flex-col sm:flex-row gap-4 shrink-0">
    <% if policy(intervention).terminer? && intervention.can_terminer? %>
      <% pointe = current_user.agent? && intervention.template_slug %>
      <%# `pointer` est une route GET (scan QR / URL), `terminer` une route POST : verbe conditionnel. %>
      <%= button_to 'Terminer',
        pointe ? pointer_intervention_path(Intervention.find_by(slug: intervention.template_slug)) : terminer_intervention_path(intervention),
        method: pointe ? :get : :post,
        class: 'btn btn-primary btn-outline btn-ml hover:text-white! w-[100px] justify-center',
        title: "Cliquez pour passer cette intervention en statut 'Terminé'",
        form: { data: { turbo: false }, class: 'w-[100px]' } %>
    <% end %>
    <% if policy(intervention).valider? && intervention.can_valider? %>
      <%= button_to 'Valider', valider_intervention_path(intervention), 
        class: 'btn btn-success btn-outline btn-ml hover:text-white! w-[100px] justify-center', 
        form: { data: { turbo: false }, class: 'w-[100px]' } %>
    <% end %>
    <% if policy(intervention).refuser? && intervention.can_refuser? %>
      <%= button_to 'Refuser', refuser_intervention_path(intervention), 
        class: 'btn btn-error btn-outline btn-ml hover:text-white! w-[100px] justify-center', 
        form: { data: { turbo: false }, class: 'w-[100px]' } %>
    <% end %>
  </div>
</div>
