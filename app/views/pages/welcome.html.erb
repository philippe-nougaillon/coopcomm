  <div class="mt-24">
    <h2 class="text-2xl lg:text-3xl font-medium text-center mb-12">
      Vous souhaitez en savoir plus ?
    </h2>
    <div class="flex flex-wrap items-center justify-around gap-4">
      <%= link_to 'Consultez notre Wiki (Blog / FAQ / ...)', wiki_pages_path, class: 'btn lg:btn-lg btn-primary hover:text-white!' %>
      <%= link_to "Réservez une démo personnalisée", "https://www.aikku.eu/fr/contact?objet=COOPCOMM", class: 'btn lg:btn-lg btn-secondary hover:text-white!', title: "Réservez une démo personnalisée avec l'un de nos experts" %>
      <div class="text-2xl mt-8">
        <%= form_with(model: @newsletter, id: "nouvelle_newsletter", method: "post", html: { autocomplete: "off", class: 'w-full', onsubmit: "event.preventDefault();",  'data-controller':"newsletter" }) do |form| %>
          <div class="md:join w-full" data-turbo="false">
            <%= form.email_field :email, 'data-newsletter-target': 'email', class: 'input input-lg md:join-item w-full max-w-lg mb-4 md:mb-0', required: true, placeholder: "Entrez votre email" %>
            <%= form.submit "Je m'inscris à la newsletter", 'data-action': 'click->newsletter#print_result', class: "btn btn-lg btn-primary md:join-item md:rounded-r-full mx-auto" %>
          </div>

          <div>
            <%= render "result_newsletter" %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</div>


