<%= render partial: "partials/navbar/navbar_homepage" %>

<%
  demo_url = "https://calendar.app.google/a52LSSCoXsdwz7A2A"

  logo = <<~HTML.squish.html_safe
    <span class="font-extrabold whitespace-nowrap">
      <span class="text-[#47b5db]">Co</span><span class="text-[#691E9A]">op</span><span class="text-[#47b5db]">Comm</span><span class="text-[#691E9A]">.</span>
    </span>
  HTML

  button_base  = "px-8 py-3 rounded-full text-base font-semibold transition"
  tab_focus    = "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#691E9A]"
  footer_link  = "mb-2 hover:text-[#50b9df]"

  commitments = ["Développée et hébergée en France", "Code source ouvert", "Conforme RGPD"]

  benefits = [
    { title: "Réduction des coûts",    tag: "Mutualisation", shift: "",
      text: "Diminuez vos dépenses de fonctionnement grâce à la mutualisation intelligente des ressources." },
    { title: "Optimisation RH",        tag: "Coopération",   shift: "xl:translate-y-12",
      text: "Maximisez l'efficacité de vos équipes en partageant les compétences entre communes." },
    { title: "Conformité garantie",    tag: "RGPD",          shift: "",
      text: "Respectez toutes les réglementations avec une solution conforme au RGPD." },
    { title: "Souveraineté numérique", tag: "100 % France",  shift: "xl:translate-y-10",
      text: "Profitez d'une solution développée, hébergée et maintenue à 100 % en France." },
    { title: "Code source ouvert",     tag: "Open source",   shift: "",
      text: "Développé en France et publié en toute transparence sur GitHub." }
  ]

  slides = [
    { src: "/slide1.png",           title: "Une vue d'ensemble",              text: "Toute l'activité de votre intercommunalité sur un seul écran." },
    { src: "/new_intervention.png", title: "Créer une intervention",          text: "Une demande se saisit en quelques secondes, depuis un ordinateur ou un téléphone." },
    { src: "/interventions.png",    title: "Suivre les interventions",        text: "Retrouvez toutes les demandes et leur état d'avancement." },
    { src: "/intervention.png",     title: "Le détail d'une intervention",    text: "Agents, matériel, échanges et historique réunis au même endroit." },
    { src: "/tools.png",            title: "Gérer le matériel",               text: "Inventaire, prêts et utilisation du matériel partagé." },
    { src: "/dashboard.png",        title: "Piloter avec le tableau de bord", text: "Les indicateurs clés pour garder la maîtrise de vos budgets." }
  ]

  feature_groups = [
    { id: "terrain", title: "Sur le terrain", intro: "Organiser et suivre les interventions au quotidien.", items: [
      { title: "Interventions",
        text: "L'adhérent émet une demande, l'équipe locale se rend sur place et enregistre l'intervention. Une fois terminée, l'adhérent la valide ou donne son avis.",
        icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>' },
      { title: "Pointage par QR Code",
        text: "Pour les interventions récurrentes, générez un QR code depuis un modèle. Un scan démarre la mission, un second la termine.",
        icon: '<rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/>' },
      { title: "Gestion des actifs et des absences",
        text: "Suivi de l'inventaire et des prêts, avec la trace de chaque utilisation. Bloque l'attribution à un agent absent.",
        icon: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>' },
      { title: "Workflow",
        text: "Chaque intervention change d'état via des actions définies à l'avance. Certaines déclenchent des notifications.",
        icon: '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>' }
    ] },
    { id: "pilotage", title: "Pilotage et gestion", intro: "Garder une vision claire de l'activité et des budgets.", items: [
      { title: "Maîtrise budgétaire",
        text: "Un tableau de bord permet aux adhérents et aux managers de suivre leurs indicateurs clés.",
        icon: '<line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/>' },
      { title: "CRM",
        text: "En un clic, un devis devient une commande, puis une facture, avec signature électronique.",
        icon: '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>' },
      { title: "Une information claire et partagée",
        text: "Une source unique de référence (SSOT), robuste et fiable. Chaque modification de données est auditée.",
        icon: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>' }
    ] },
    { id: "communication", title: "Communication et accès", intro: "Chacun trouve l'information qui le concerne.", items: [
      { title: "Adhérents",
        text: "Suivre ses demandes, gérer ses devis et retrouver conventions, commandes et factures, signables en ligne.",
        icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
      { title: "Agents et managers",
        text: "Les agents voient uniquement leurs interventions. Les managers accèdent aux données de leur organisation.",
        icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>' },
      { title: "Messagerie instantanée",
        text: "Les managers échangent avec les agents, avec une modération du vocabulaire inapproprié.",
        icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>' },
      { title: "Notifications et alertes",
        text: "Un email ou un message WhatsApp informe toutes les parties prenantes lors de certains changements d'état.",
        icon: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>' }
    ] },
    { id: "ia", title: "Intelligence artificielle", intro: "Une IA développée et hébergée en France.", items: [
      { title: "AIBOT IA",
        text: "Elle vous aide à créer des interventions et analyse les données du site pour vous donner rapidement l'information recherchée.",
        icon: '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>' },
      { title: "Prévision d'intervention",
        text: "À partir des interventions passées, l'IA vous propose celles qu'il faut prévoir.",
        icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>',
        new: true }
    ] }
  ]

  footer_columns = [
    { title: "NOUS CONTACTER", links: [
      { label: "www.aikku.fr", href: "https://www.aikku.eu/", external: true },
      { label: "LinkedIn",     href: "https://www.linkedin.com/showcase/coopcomm", external: true },
      { label: "E-mail",       href: "mailto:contact@coopcomm.fr" }
    ] },
    { title: "BESOIN D'AIDE", links: [
      { label: "FAQ",   href: faq_documentation_index_path },
      { label: "Blog",  href: blog_documentation_index_path },
      { label: "Guide", href: guide_documentation_index_path }
    ] },
    { title: "CONDITIONS", links: [
      { label: "Mentions légales",      href: mentions_legales_path },
      { label: "Protection des Données", href: "#" },
      { label: "Préférences Cookies",    href: "#" }
    ] }
  ]
%>

<main class="bg-gradient-to-b from-blue-50 via-blue-100 to-blue-20">

  <section class="py-16 lg:py-24 px-6 lg:px-16 flex flex-col gap-6 md:flex-row">
    <div class="flex-1 m-10">
      <h1 class="text-4xl text-center lg:text-7xl font-extrabold text-slate-900 tracking-tight">
        <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(to right, #47b5db, #bc437e, #8043ad);">
          Mutualisez mieux,
        </span>
        <br/>
        dépensez moins !
      </h1>

      <section aria-label="Nos engagements" class="px-6 lg:px-16 pb-4">
        <ul class="max-w-6xl mx-auto flex flex-wrap justify-center gap-x-10 gap-y-3 text-sm font-semibold text-slate-700">
          <% commitments.each do |label| %>
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-[#691E9A]" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <%= label %>
            </li>
          <% end %>
        </ul>
      </section>

      <p class="text-lg lg:text-2xl text-justify text-slate-600 mt-18 m-4 leading-relaxed">
        CoopComm est la plateforme collaborative pensée pour les communautés de communes : gérez vos plannings d'agents, partagez votre matériel et automatisez votre facturation en un clic.
      </p>

      <div class="flex flex-col mt-10 sm:flex-row justify-center text-center items-center gap-4 pt-4">
        <%= link_to "Planifier une démonstration", demo_url,
              class: "#{button_base} w-72 md:inline-block bg-[#db2767] text-white shadow-md hover:bg-[#c51f5b]" %>
        <%= link_to "Voir les fonctionnalités", "#features",
              class: "#{button_base} w-72 md:inline-block bg-white border border-slate-200 hover:bg-transparent" %>
      </div>
    </div>

    <div class="flex-1 pt-10 max-w-4xl mx-auto">
      <%= image_tag "/ecrans(1).png", class: "w-full", alt: "Plateforme CoopComm" %>
    </div>
  </section>

  <section id="pourquoi" class="scroll-mt-24 bg-[#F4EFE6] m-6 lg:m-20 rounded-3xl px-6 py-12 lg:p-16 overflow-hidden shadow-sm">
    <div class="flex flex-col gap-4">
      <div class="flex flex-col lg:flex-row gap-4 lg:gap-8 lg:items-center mb-6">
        <h2 class="text-4xl lg:text-5xl font-semibold tracking-tight">
          Pourquoi choisir <%= logo %>&nbsp;?
        </h2>
        <p class="text-xl lg:text-2xl text-black/70">
          Une solution complète pour optimiser la gestion de votre intercommunalité.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-6 xl:pb-12">
        <% benefits.each_with_index do |benefit, index| %>
          <li class="group relative overflow-hidden rounded-3xl p-8 min-h-[280px] flex flex-col text-black
                     shadow-sm hover:shadow-2xl hover:translate-x-2
                     transition duration-500 ease-out motion-reduce:transition-none
                     <%= benefit[:shift] %>">
            <span aria-hidden="true"
                  class="absolute -bottom-16 -right-16 w-36 h-36 rounded-full <%= index.even? ? "bg-[#47b5db]" : "bg-[#691E9A]" %>
                         transition-transform duration-700 group-hover:scale-150 motion-reduce:transition-none"></span>

            <div class="relative mt-10">
              <h3 class="text-2xl font-semibold mb-2"><%= benefit[:title] %></h3>
              <span class="text-xs font-medium uppercase tracking-wider border border-black/20 rounded-full px-3 py-1">
                <%= benefit[:tag] %>
              </span>
              <p class="opacity-80 mt-8 leading-relaxed"><%= benefit[:text] %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <section id="images" data-tabs class="scroll-mt-24 bg-[#F6F2F9] px-6 lg:px-16 py-20 lg:py-28">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight max-w-3xl">La plateforme en images</h2>
      <p class="mt-3 text-lg text-black/70 max-w-2xl">Choisissez une fonctionnalité pour voir l'écran correspondant.</p>

      <div class="mt-12 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 lg:gap-14 items-start">

        <div role="tablist" aria-orientation="vertical" aria-label="Écrans de CoopComm"
             class="order-2 lg:order-1 flex flex-col">
          <% slides.each_with_index do |slide, i| %>
            <button type="button" role="tab" id="tab-<%= i %>" aria-controls="shot-<%= i %>"
                    aria-selected="<%= i.zero? %>" tabindex="<%= i.zero? ? 0 : -1 %>"
                    data-tab data-active="<%= i.zero? %>"
                    class="group text-left border-l-2 border-[#691E9A]/15 data-[active=true]:border-[#691E9A]
                           pl-5 py-3 transition-colors motion-reduce:transition-none <%= tab_focus %>">
              <span class="block text-lg font-bold text-black/55 group-hover:text-black/80 group-data-[active=true]:text-[#691E9A] transition-colors">
                <%= slide[:title] %>
              </span>
              <span class="grid grid-rows-[0fr] group-data-[active=true]:grid-rows-[1fr] transition-[grid-template-rows] duration-300 motion-reduce:transition-none">
                <span class="overflow-hidden">
                  <span class="block pt-1 pb-1 text-black/70 leading-relaxed"><%= slide[:text] %></span>
                </span>
              </span>
            </button>
          <% end %>
        </div>

        <div class="order-1 lg:order-2 lg:sticky lg:top-28">
          <div class="rounded-xl overflow-hidden bg-white shadow-2xl ring-1 ring-black/5">
            <div class="flex gap-1.5 px-3 py-2 bg-slate-100" aria-hidden="true">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff6b6b]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#ffd166]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#06d6a0]"></span>
            </div>
            <div class="relative aspect-[16/10] bg-white">
              <% slides.each_with_index do |slide, i| %>
                <div role="tabpanel" id="shot-<%= i %>" aria-labelledby="tab-<%= i %>"
                     data-panel data-active="<%= i.zero? %>"
                     class="absolute inset-0 opacity-0 data-[active=true]:opacity-100 transition-opacity duration-300 motion-reduce:transition-none
                            pointer-events-none data-[active=true]:pointer-events-auto">
                  <%= image_tag slide[:src], alt: slide[:title], class: "h-full w-full object-contain object-top",
                        loading: (i.zero? ? nil : "lazy") %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section id="features" data-tabs data-tabs-hash="group-" class="scroll-mt-24 px-6 lg:px-16 py-20 lg:py-28">
    <style>
      @media (prefers-reduced-motion: no-preference) {
        #features [data-panel][data-active="true"] { animation: features-in .3s ease-out; }
      }
      @keyframes features-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    </style>

    <div class="max-w-6xl mx-auto">
      <div class="max-w-3xl">
        <h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight">Des fonctionnalités pensées pour votre quotidien</h2>
        <p class="mt-4 text-xl text-slate-600">Découvrez l'ensemble de nos outils conçus pour simplifier la gestion de votre organisation.</p>
      </div>

      <div role="tablist" aria-label="Catégories de fonctionnalités"
           class="mt-10 flex gap-2 overflow-x-auto pb-2 -mx-6 px-6 lg:mx-0 lg:px-0">
        <% feature_groups.each_with_index do |group, i| %>
          <button type="button" role="tab" id="gtab-<%= group[:id] %>" aria-controls="group-<%= group[:id] %>"
                  aria-selected="<%= i.zero? %>" tabindex="<%= i.zero? ? 0 : -1 %>"
                  data-tab data-id="<%= group[:id] %>" data-active="<%= i.zero? %>"
                  class="shrink-0 rounded-full border border-[#691E9A]/25 px-5 py-2.5 text-sm lg:text-base font-semibold text-[#691E9A]
                         transition-colors motion-reduce:transition-none hover:bg-[#691E9A]/10
                         data-[active=true]:bg-[#691E9A] data-[active=true]:border-[#691E9A] data-[active=true]:text-white
                         <%= tab_focus %>">
            <%= group[:title] %>
          </button>
        <% end %>
      </div>

      <div class="mt-10 lg:mt-14">
        <% feature_groups.each_with_index do |group, i| %>
          <div role="tabpanel" id="group-<%= group[:id] %>" aria-labelledby="gtab-<%= group[:id] %>"
               data-panel data-active="<%= i.zero? %>"
               class="hidden data-[active=true]:grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-6 lg:gap-14">

            <div>
              <h3 class="text-2xl lg:text-3xl font-bold text-[#691E9A]"><%= group[:title] %></h3>
              <p class="mt-2 text-lg text-slate-600 max-w-sm"><%= group[:intro] %></p>
            </div>

            <ul class="divide-y divide-[#691E9A]/10 border-y border-[#691E9A]/10">
              <% group[:items].each do |item| %>
                <li class="flex gap-4 py-6">
                  <span class="shrink-0 w-11 h-11 rounded-full bg-[#F6F2F9] text-[#691E9A] flex items-center justify-center">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><%= raw item[:icon] %></svg>
                  </span>
                  <div>
                    <h4 class="font-semibold text-lg flex flex-wrap items-center gap-2">
                      <%= item[:title] %>
                      <% if item[:new] %>
                        <span class="text-xs font-bold bg-[#ECE88F] text-slate-800 px-2.5 py-0.5 rounded-full">Nouveau</span>
                      <% end %>
                    </h4>
                    <p class="mt-1 text-black/75 leading-relaxed max-w-xl"><%= item[:text] %></p>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section id="confiance" class="scroll-mt-24 m-6 lg:m-20 rounded-3xl p-6 lg:p-12 bg-white border border-slate-100 shadow-sm">
    <div class="max-w-3xl mx-auto text-center mb-10 lg:mb-14">
      <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-[#691E9A] mb-4">Ils nous font confiance</h2>
      <p class="text-base lg:text-lg text-slate-600">
        Découvrez en vidéo comment CoopComm simplifie le quotidien des équipes.
      </p>
    </div>

    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">

      <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col items-center justify-between text-center">
        <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#691E9A]">
          <span class="w-4 h-px bg-[#691E9A]/40" aria-hidden="true"></span>
          Déjà déployé chez
          <span class="w-4 h-px bg-[#691E9A]/40" aria-hidden="true"></span>
        </p>

        <div class="my-6 p-4 bg-slate-50 rounded-xl w-full flex items-center justify-center">
          <img src="madmoselle.png" alt="Logo Communauté de Communes Mad & Moselle" class="h-32 w-auto object-contain" />
        </div>

        <div class="space-y-2">
          <h3 class="font-bold text-slate-900 text-lg">CC Mad &amp; Moselle</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Une collectivité qui mutualise ses agents et ses équipements grâce à CoopComm.
          </p>
        </div>
      </div>

      <div class="lg:col-span-2 bg-white rounded-2xl shadow-lg overflow-hidden flex items-center justify-center border border-slate-200">
        <div class="w-full aspect-video">
          <video controls playsinline preload="metadata"
                 poster="<%= image_path("New_logo.png") %>"
                 class="w-full h-full object-contain">
            <source src="aikkucoopcomm.mp4" type="video/mp4">
            Votre navigateur ne prend pas en charge la lecture de vidéos.
          </video>
        </div>
      </div>

    </div>
  </section>

  <section id="savoir-plus" class="scroll-mt-24 relative overflow-hidden m-6 lg:m-20 rounded-3xl px-6 py-12 lg:p-16 bg-[#F4EFE6] shadow-sm">
    <span aria-hidden="true" class="absolute -bottom-20 -right-20 w-64 h-64 rounded-full bg-[#47b5db]/30"></span>
    <span aria-hidden="true" class="absolute -top-16 -left-16 w-48 h-48 rounded-full bg-[#db2767]/25"></span>

    <div class="relative max-w-3xl mx-auto text-center">
      <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-black mb-4">
        Vous souhaitez en savoir plus ?
      </h2>
      <p class="text-base lg:text-lg text-black mb-10 lg:mb-12">
        Échangez avec l'un de nos experts ou explorez notre documentation pour découvrir comment
        <%= logo %> s'adapte à votre intercommunalité.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <%= link_to "Réservez une démo personnalisée", demo_url,
              class: "#{button_base} w-full sm:w-auto bg-[#db2767] text-white shadow-md hover:bg-[#c51f5b]",
              title: "Réservez une démo personnalisée avec l'un de nos experts" %>
        <%= link_to "Consultez notre documentation", documentation_index_path,
              class: "#{button_base} w-full sm:w-auto bg-white text-[#691E9A] shadow-md hover:bg-[#F4EFE6]" %>
      </div>
    </div>
  </section>

</main>

<footer class="bg-[#E5EFF9] shadow-lg px-6 py-4">
  <div class="flex flex-col md:flex-row items-center md:items-start p-8 justify-between text-center gap-8">

    <% footer_columns.each do |column| %>
      <div class="flex flex-col text-center md:text-left">
        <p class="text-sm font-black mb-4"><%= column[:title] %></p>
        <% column[:links].each do |link| %>
          <%= link_to link[:label], link[:href], class: footer_link, target: (link[:external] ? "_blank" : nil) %>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-col max-w-xs">
      <p class="mb-2 text-sm">
        <b>S'inscrire à la Newsletter</b> pour recevoir les dernières actualités
      </p>
      <%= form_with(model: @newsletter, id: "nouvelle_newsletter", method: "post",
            html: { autocomplete: "off", class: "w-full flex flex-col justify-center",
                    onsubmit: "event.preventDefault();", "data-controller": "newsletter" }) do |form| %>
        <input id="newsletter_form_email" type="email" placeholder="Entrez votre adresse email"
               data-newsletter-target="email" required
               class="border border-gray-300 rounded-md py-2 px-4 mb-2" />
        <%= form.submit "JE M'INSCRIS", "data-action": "click->newsletter#print_result",
              class: "bg-black text-white rounded-md py-2 hover:bg-gray-800" %>
        <%= render "result_newsletter" %>
      <% end %>
    </div>

  </div>

  <div class="flex flex-col md:flex-row text-sm justify-between gap-4 p-8 border-t border-gray-300 text-center md:text-left">
    <p>© <%= Date.current.year %> AÏKKU SAS. Tous droits réservés.</p>
    <div class="text-center">
      <p>Aïkku - La Défense. 5 Place de la Pyramide, 92800 PUTEAUX</p>
      <p>Aïkku - Montfermeil. 112 Allée de Notre Dame des Anges, 93370 MONTFERMEIL</p>
    </div>
    <p>SIREN : 934 780 735 R.C.S Nanterre</p>
  </div>
</footer>

<script>
  (function () {
    document.querySelectorAll("[data-tabs]").forEach(function (root) {
      if (root.dataset.bound) return;
      root.dataset.bound = "true";

      var tabs = Array.prototype.slice.call(root.querySelectorAll("[data-tab]"));
      var panels = Array.prototype.slice.call(root.querySelectorAll("[data-panel]"));
      var current = 0;

      function select(index, focus) {
        current = index;
        tabs.forEach(function (tab, i) {
          var active = i === index;
          tab.dataset.active = active;
          tab.setAttribute("aria-selected", active);
          tab.tabIndex = active ? 0 : -1;
        });
        panels.forEach(function (panel, i) { panel.dataset.active = i === index; });
        if (focus) tabs[index].focus();
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () { select(i, false); });
        tab.addEventListener("keydown", function (event) {
          var last = tabs.length - 1;
          var next = current;

          if (event.key === "ArrowDown" || event.key === "ArrowRight") next = current === last ? 0 : current + 1;
          else if (event.key === "ArrowUp" || event.key === "ArrowLeft") next = current === 0 ? last : current - 1;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = last;
          else return;

          event.preventDefault();
          select(next, true);
        });
      });

      var hashPrefix = root.dataset.tabsHash;
      if (!hashPrefix) return;

      function selectFromHash() {
        if (location.hash.indexOf("#" + hashPrefix) !== 0) return;
        var id = location.hash.replace("#" + hashPrefix, "");
        var index = tabs.findIndex(function (tab) { return tab.dataset.id === id; });
        if (index < 0) return;
        select(index, false);
        root.scrollIntoView();
      }

      window.addEventListener("hashchange", selectFromHash);
      selectFromHash();
    });
  })();
</script>
