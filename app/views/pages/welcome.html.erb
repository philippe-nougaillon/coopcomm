  <div class="my-24">

    <h2 class="text-2xl lg:text-3xl text-base-content">
      Conception et développement
    </h2>

    <div class="divider mb-12"></div>
    <div class="w-full my-4">
      <p>
        Cette application Web a été conçue et développée, en Ruby on Rails, par nos soins.
        <br>
        Le code source est édité sous licence Open Source (GLP GNU v3).
      </p>
    </div>
  </div>

  <div class="my-24">

    <h2 class="text-2xl lg:text-3xl text-base-content">
      Notre newsletter
    </h2>

    <div class="divider mb-12"></div>
    <div class="w-full text-2xl my-4">
      <p>Inscrivez-vous à la newsletter pour être informé des dernières nouveautés</p>
      <%= form_with(model: @newsletter, id: "nouvelle_newsletter", method: "post", html: { autocomplete: "off", class: 'mt-4 w-full', onsubmit: "event.preventDefault();",  'data-controller':"newsletter" }) do |form| %>
        <div class="md:join w-full" data-turbo="false">
          <%= form.email_field :email, 'data-newsletter-target': 'email', class: 'input input-lg md:join-item w-full max-w-lg mb-4 md:mb-0', required: true, placeholder: "Email" %>
          <%= form.submit "Je m'inscris", 'data-action': 'click->newsletter#print_result', class: "btn btn-lg md:join-item md:rounded-r-full mx-auto" %>
        </div>

        <div>
          <%= render "result_newsletter" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="my-24">

    <h2 class="text-2xl lg:text-3xl text-base-content">
      Vous souhaitez découvrir la plateforme CoopComm ?
    </h2>

    <div class="divider mb-12"></div>
    <div class="w-full text-2xl my-4">
      <%= link_to "Réservez une démo personnalisée avec l'un de nos experts ➔", "https://www.aikku.eu/fr/contact?objet=COOPCOMM", class: 'btn lg:btn-lg btn-secondary hover:text-white! ' %>
    </div>
  </div>

</div>


