<section id="features" class="scroll-mt-24 px-6 lg:px-16 py-20 lg:py-28">
  <style>
    @media (prefers-reduced-motion: no-preference) {
      #features [data-panel]:not([hidden]) { animation: features-in .3s ease-out; }
    }
    @keyframes features-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  </style>

  <div class="max-w-6xl mx-auto">

    <div class="max-w-3xl">
      <h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight">Des fonctionnalités pensées pour votre quotidien</h2>
      <p class="mt-4 text-xl text-slate-600">Découvrez l'ensemble de nos outils conçus pour simplifier la gestion de votre organisation.</p>
    </div>

    <!-- Onglets : défilement horizontal sur mobile -->
    <div role="tablist" aria-label="Catégories de fonctionnalités"
         class="mt-10 flex gap-2 overflow-x-auto pb-2 -mx-6 px-6 lg:mx-0 lg:px-0">
      <% groups.each_with_index do |g, i| %>
        <button type="button" role="tab" id="gtab-<%= g[:id] %>" aria-controls="group-<%= g[:id] %>"
                aria-selected="<%= i.zero? %>" tabindex="<%= i.zero? ? 0 : -1 %>"
                data-tab data-id="<%= g[:id] %>" data-active="<%= i.zero? %>"
                class="shrink-0 rounded-full border border-[#691E9A]/25 px-5 py-2.5 text-sm lg:text-base font-semibold text-[#691E9A]
                       transition-colors motion-reduce:transition-none hover:bg-[#691E9A]/10
                       data-[active=true]:bg-[#691E9A] data-[active=true]:border-[#691E9A] data-[active=true]:text-white
                       focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#691E9A]">
          <%= g[:title] %>
        </button>
      <% end %>
    </div>

    <!-- Panneaux : intro à gauche, liste des fonctionnalités à droite -->
    <div class="mt-10 lg:mt-14">
      <% groups.each_with_index do |g, i| %>
        <div role="tabpanel" id="group-<%= g[:id] %>" aria-labelledby="gtab-<%= g[:id] %>"
             data-panel <%= "hidden" unless i.zero? %>
             class="grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-6 lg:gap-14">

          <div>
            <h3 class="text-2xl lg:text-3xl font-bold text-[#691E9A]"><%= g[:title] %></h3>
            <p class="mt-2 text-lg text-slate-600 max-w-sm"><%= g[:intro] %></p>
          </div>

          <ul class="divide-y divide-[#691E9A]/10 border-y border-[#691E9A]/10">
            <% g[:items].each do |t, d, icon, new_flag| %>
              <li class="flex gap-4 py-6">
                <span class="shrink-0 w-11 h-11 rounded-full bg-[#F6F2F9] text-[#691E9A] flex items-center justify-center">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><%= raw icon %></svg>
                </span>
                <div>
                  <h4 class="font-semibold text-lg flex flex-wrap items-center gap-2">
                    <%= t %>
                    <% if new_flag %>
                      <span class="text-xs font-bold bg-[#ECE88F] text-slate-800 px-2.5 py-0.5 rounded-full">Nouveau</span>
                    <% end %>
                  </h4>
                  <p class="mt-1 text-black/75 leading-relaxed max-w-xl"><%= d %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    (function () {
      var section = document.currentScript.closest("section");
      if (!section || section.dataset.bound) return;
      section.dataset.bound = "true";

      var tabs = Array.prototype.slice.call(section.querySelectorAll("[data-tab]"));
      var panels = Array.prototype.slice.call(section.querySelectorAll("[data-panel]"));
      var current = 0;

      function select(i, focus) {
        current = i;
        tabs.forEach(function (tab, j) {
          var on = j === i;
          tab.dataset.active = on;
          tab.setAttribute("aria-selected", on);
          tab.tabIndex = on ? 0 : -1;
        });
        panels.forEach(function (panel, j) { panel.hidden = j !== i; });
        if (focus) tabs[i].focus();
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () { select(i, false); });
        tab.addEventListener("keydown", function (e) {
          var last = tabs.length - 1, next = current;
          if (e.key === "ArrowRight" || e.key === "ArrowDown") next = current === last ? 0 : current + 1;
          else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = current === 0 ? last : current - 1;
          else if (e.key === "Home") next = 0;
          else if (e.key === "End") next = last;
          else return;
          e.preventDefault();
          select(next, true);
        });
      });

      // Liens externes du type /#group-ia : ouvre le bon onglet
      function fromHash() {
        var id = location.hash.replace("#group-", "");
        var i = tabs.findIndex(function (t) { return t.dataset.id === id; });
        if (i >= 0 && location.hash.indexOf("#group-") === 0) {
          select(i, false);
          section.scrollIntoView();
        }
      }
      window.addEventListener("hashchange", fromHash);
      fromHash();
    })();
  </script>
</section>



