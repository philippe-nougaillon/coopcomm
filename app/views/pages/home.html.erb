<div class="flex flex-wrap items-end gap-8 lg:px-48 -mt-20">
  <div class="flex-8 w-full">
    <h1 class="text-3xl font-black mb-10">
      <%= page_title!("Bonjour") %>,
      <%= current_user.prénom %>
    </h1>
  </div>
  <div class="flex-5 w-max">
    <h2 class="text-lg mb-10">Nous sommes le <%= l(Date.today, format: :custom) %></h2>
  </div>
</div>
<div class="flex flex-wrap gap-8 lg:px-48">
  <div class="flex-8 w-full">
    <div class="border shadow-sm p-4 rounded-2xl mb-8">
      <h2 class="font-black text-lg mb-6">Actions en attente</h2>
      <div class="flex flex-col gap-6">
        <% @interventions.each do |intervention| %>
          <div class="flex items-center gap-4 px-2">
            <span class="material-symbols-outlined text-secondary p-2 bg-gray-200 rounded-full">
              construction
            </span>
            <div class="flex flex-col gap-1">
              <b><%= intervention.description %></b>
              <%= time_ago_in_words(intervention.updated_at)%>
              <div class="flex gap-2">
                <%= link_to_if intervention.can_terminer?, 'Terminer', terminer_intervention_path(intervention), class: 'hover:text-primary hover:underline', title: 'Cliquez pour passer cette intervention en statut \'Terminé\'', 'data-turbo': false %>
                <%= link_to_if intervention.can_valider?, 'Valider', valider_intervention_path(intervention), class: 'hover:text-success hover:underline', title: 'Cliquez pour passer cette intervention en statut \'Validé\'', 'data-turbo': false %>
                <%= link_to_if intervention.can_refuser?, 'Refuser', refuser_intervention_path(intervention), class: 'hover:text-error hover:underline', title: 'Cliquez pour passer cette intervention en statut \'Refusé\'', 'data-turbo': false %>
              </div>
            </div>
          </div>
        <% end %>
        <%= link_to 'Voir toutes les actions en attente', interventions_path, class: 'text-primary' %>
      </div>
    </div>
    <div class="border shadow-sm p-4 rounded-2xl">
      <h2 class="font-black text-lg mb-8">Messages de votre équipe</h2>
      <% @notifications.each do |notification| %>
        <% user = User.find(notification.from_id) %>
        <div class="flex items-center gap-4 border px-4 py-4">
          <span class="material-symbols-outlined text-primary">
            chat
          </span>
          <div>
            <b><%= notification.moderation %></b>
            <div>
              <small>
                il y a <%= time_ago_in_words notification.created_at %>
              </small>
              -
              <%= user.nom_prenom_role %> 
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="flex-5 w-full">

    <div class="border shadow-sm p-4 pb-10 rounded-2xl">
      <h2 class="font-black text-lg mb-6">Actions rapides</h2>
      <div class="flex flex-col gap-4">
        <%= link_to 'Créer une Intervention', new_intervention_path, class: 'btn btn-outline rounded-full w-fit px-6' %>
        <%= link_to 'Ajouter un nouveau Matériel', new_tool_path, class: 'btn btn-outline rounded-full w-fit px-6' %>
        <%= link_to 'Ajouter un nouvel Utilisateur', new_user_path, class: 'btn btn-outline rounded-full w-fit px-6' %>
        <%= link_to 'Lancer une discussion', admin_messagerie_path, class: 'btn btn-outline rounded-full w-fit px-6' %>
      </div>
    </div>

  </div>
</div>