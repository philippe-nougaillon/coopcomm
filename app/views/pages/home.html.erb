<div class="flex flex-wrap items-start gap-8 lg:px-48 md:-mt-8 lg:-mt-20 mb-5 lg:mb-10">
  <div class="flex-8 w-full">
    <h1 class="text-3xl font-black">
      <%= page_title!("Bonjour") %>,
      <%= current_user.prénom %>
    </h1>
  </div>
  <div class="hidden sm:block flex-5 w-max">
    <h2 class="text-lg">
      Nous sommes le <%= l(Date.today, format: :custom) %>,
      il est <%= Time.now.strftime("%Hh%M") %>.
    </h2>
  </div>
</div>
<div class="flex flex-wrap gap-8 lg:px-48">
  <div class="flex-1 sm:flex-8 w-full">
    <div class="border shadow-sm p-4 rounded-2xl mb-8">
      <h2 class="font-black text-lg mb-6">Actions en attente</h2>
      <div class="flex flex-col gap-6">
        <% @interventions.each do |intervention| %>
          <%= render partial: 'intervention', locals: {intervention: } %>
        <% end %>
        <%= link_to 'Voir toutes les actions en attente', interventions_path, class: 'text-primary' %>
      </div>
    </div>
    <div class="border shadow-sm p-4 rounded-2xl">
      <h2 class="font-black text-lg mb-8">Messages de votre équipe</h2>
      <% @notifications.each do |notification| %>
        <%= render partial: 'notification', locals: {notification: }%>
      <% end %>
    </div>
  </div>
  <div class="flex-1 sm:flex-5 w-full">

    <div class="border shadow-sm p-4 pb-10 rounded-2xl mb-8">
      <h2 class="font-black text-lg mb-6">Actions rapides</h2>
      <div class="flex flex-col gap-4">
        <%= link_to 'Créer une Intervention', new_intervention_path, class: 'btn btn-outline rounded-full w-fit whitespace-nowrap px-6' %>
        <% if current_user.manager? %>
          <%= link_to 'Ajouter un nouveau Matériel', new_tool_path, class: 'btn btn-outline rounded-full w-fit whitespace-nowrap px-6' %>
          <%= link_to 'Ajouter un nouvel Utilisateur', new_user_path, class: 'btn btn-outline rounded-full w-fit whitespace-nowrap px-6' %>
        <% elsif current_user.adhérent? %>
          <%= link_to 'Voir le tableau de bord', dashboard_path, class: 'btn btn-outline rounded-full w-fit whitespace-nowrap px-6' %>
        <% end %>
        <%= link_to 'Lancer une discussion', admin_messagerie_path, class: 'btn btn-outline rounded-full w-fit whitespace-nowrap px-6' %>
      </div>
    </div>

    <div class="border shadow-sm p-4 pb-4 rounded-2xl">
      <% if @forecasts %>
        <h2 class="font-black text-lg">Météo à <%= @city %></h2>
        <small>Dernière mise à jour : <%= l(MeteoConceptConnexion.instance.get_time_nexthours, format: :long) %></small>
        <div class="flex justify-center">
          <div class="w-64 flex flex-col items-center text-center p-6">
            <div class="text-md font-bold text-gray-900">
              <span class="font-normal text-gray-700 text-sm"><%= @forecast["datetime"].to_time.strftime("%H:%M") %></span>
            </div>
            <%= image_tag MeteoConceptConnexion.get_icon_meteo(@forecast["weather"]), size: 100 %>
            <p class="text-gray-700 mb-2"><%= MeteoConceptConnexion.WEATHER[@forecast["weather"]] %></p>
            <div class="text-xl text-gray-900">
              <p><%= @forecast["temp2m"] %>ºC</p>
            </div>
            <div class="flex justify-between w-full">
              <div class="flex items-center text-gray-700 px-2 gap-1">
                <%= image_tag "meteo/humidity.svg", size: 10 %>
                <p><%= @forecast["rh2m"] %>%</p>
              </div>
              <div class="flex items-center text-gray-700 px-2 gap-1">
                <%= image_tag "meteo/wind.svg", size: 10 %>
                <p><%= @forecast["wind10m"] %> km/h</p>
              </div>
            </div>
          </div>
          <div class="w-64 flex flex-col items-center text-center p-6">
            <div class="text-md font-bold text-gray-900">
              <span class="font-normal text-gray-700 text-sm"><%= @last_forecast["datetime"].to_time.strftime("%H:%M") %></span>
            </div>
            <%= image_tag MeteoConceptConnexion.get_icon_meteo(@last_forecast["weather"]), size: 100 %>
            <p class="text-gray-700 mb-2"><%= MeteoConceptConnexion.WEATHER[@last_forecast["weather"]] %></p>
            <div class="text-xl text-gray-900">
              <p><%= @last_forecast["temp2m"] %>ºC</p>
            </div>
            <div class="flex justify-between w-full">
              <div class="flex items-center text-gray-700 px-2 gap-1">
                <%= image_tag "meteo/humidity.svg", size: 10 %>
                <p><%= @last_forecast["rh2m"] %>%</p>
              </div>
              <div class="flex items-center text-gray-700 px-2 gap-1">
                <%= image_tag "meteo/wind.svg", size: 10 %>
                <p><%= @last_forecast["wind10m"] %> km/h</p>
              </div>
            </div>
          </div>

        </div>
        <%= link_to 'Voir la prévision météo sur 14 jours', meteo_path, class: 'text-primary' %>
      <% else %>
        <p>Météo indisponible</p>
      <% end %>
    </div>
  </div>
</div>