<% adherent = current_user.adhérent? %>

<div class="relative w-full h-72 md:h-80 overflow-hidden rounded-xl">
    <% if @banner_image_name.present? %>
      <div class="absolute inset-y-0 left-0 w-full  ">
        <%= image_tag @banner_image_name, class: "w-full h-full object-cover object-center " %>
      </div>
    <% end %>  
</div>

<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-24 space-y-8 pb-12">

  <div class="w-full bg-white rounded-3xl shadow-lg min-h-[90px] flex items-center p-4 md:p-6">
    <div class="w-full flex flex-row items-center justify-between gap-4">

      <div>
        <h1 class="text-xl md:text-3xl lg:text-4xl font-black text-slate-900">
          <%= page_title!("Bonjour") %>, <%= current_user.prénom %>
        </h1>
        <div class="flex gap-2 mt-0.5 flex-col">
          <p class="text-slate-600 font-medium text-xs md:text-base lg:text-lg">
            <%= current_user.organisation.nom %>
          </p>
          <time datetime="<%= Date.today.to_s %>" class="font-medium text-xs md:text-sm lg:text-base text-slate-600">
            <span class="hidden md:block"><%= l(Date.today, format: :custom) %> &bull; <%= Time.now.strftime("%Hh%M") %></span>
            <span class="block md:hidden"><%= Time.now.strftime("%Y-%m-%d") %> &bull; <%= Time.now.strftime("%H:%M") %></span>
          </time>
        </div>
      </div>

      <% if @forecasts && @forecasts["city"] && @forecasts["forecast"] %>
        <% forecast = @forecasts["forecast"].first.third %>
        <div class="flex-shrink-0 flex flex-col items-end">
          <p class="hidden md:block text-xs md:text-base font-bold uppercase text-slate-500">
            <%= @forecasts["city"]["name"] %>
          </p>
          <div class="flex flex-row items-center gap-2 my-2">
            <%= image_tag MeteoConceptConnexion.get_icon_meteo(forecast["weather"]), class: "w-10 h-10 md:w-20 md:h-20 flex-shrink-0" %>
            <div class="flex flex-col items-start text-xs md:text-base text-slate-500">
              <p class="text-base md:text-2xl font-black text-slate-900 leading-tight"><%= forecast["temp2m"] %>º</p>
              <span><%= MeteoConceptConnexion.WEATHER[forecast["weather"]] %></span>
              <span class="hidden md:block">Vent <%= forecast["wind10m"] %> km/h</span>
              <span class="hidden md:block">Pluie <%= forecast["probarain"] %>%</span>
            </div>
          </div>
          <%= link_to meteo_path, class: "inline-flex items-center gap-2 text-xs md:text-base text-primary font-medium hover:underline transition group" do %>
                Prévisions <span class="hidden md:inline">à venir</span>
            <%= embedded_svg "icons/arrow_forward.svg", class: "w-3 h-3 fill-current transition-transform group-hover:translate-x-0.5" %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

    <div class="lg:col-span-7">
      <div class="border shadow-sm p-6 rounded-2xl bg-white h-full flex flex-col justify-between">
        <div class="space-y-6 flex-1 flex flex-col justify-between">
          <div>
            <h2 class="font-black text-xl mb-6 flex items-center gap-3 uppercase">
              <span class="w-1.5 h-7 rounded-full bg-gradient-to-b from-[#40b3db] via-[#72cfe8] via-[#a48ad5] to-[#681b98]"></span>
              <%= current_user.agent? ? "Interventions récentes" : "Actions récentes" %>
            </h2>

            <% if current_user.adhérent? %>
              <div class="space-y-3 mb-6">
                <h3 class="font-black text-lg">Cotations à signer</h3>

                <% if @cotations.any? %>
                  <div class="border border-slate-200 rounded-xl flex flex-col divide-y divide-slate-200 bg-white">
                    <% @cotations.each do |cotation| %>
                      <%= render partial: 'cotation', locals: { cotation: cotation } %>
                    <% end %>
                  </div>
                <% else %>
                  <div class="border border-slate-200 rounded-xl p-4 bg-white">
                    <p class="text-slate-500">Pas de cotations à signer.</p>
                  </div>
                <% end %>

                <div class="pt-1 flex justify-end">
                  <%= link_to adherent_crm_path(tab: params[:tab] || 'cotations'), class: "inline-flex items-center gap-2 text-primary font-medium hover:underline transition group" do %>
                    <span>Voir toutes les cotations</span>
                    <%= embedded_svg "icons/arrow_forward.svg", class: "w-5 h-5 fill-current transition-transform duration-200 ease-out group-hover:translate-x-1" %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="space-y-3">
              <% if current_user.adhérent? %>
                <h3 class="font-black text-lg">Interventions</h3>
              <% end %>

              <% if @interventions.any? %>
                <div class="border border-slate-200 rounded-xl flex flex-col divide-y divide-slate-200 bg-white">
                  <% @interventions.each do |intervention| %>
                    <%= render partial: 'intervention', locals: { intervention: intervention } %>
                  <% end %>
                </div>
              <% else %>
                <div class="border border-slate-200 rounded-xl p-4 bg-white">
                  <p class="text-slate-500">Il n'y a rien en attente, vous pouvez vous reposer :)</p>
                </div>
              <% end %>
            </div>
          </div>

          <div class="pt-4 mt-auto flex justify-end">
            <%= link_to interventions_path, class: "inline-flex items-center gap-2 text-primary font-medium hover:underline transition group" do %>
              <span>Voir toutes les interventions</span>
              <%= embedded_svg "icons/arrow_forward.svg", class: "w-5 h-5 fill-current transition-transform duration-200 ease-out group-hover:translate-x-1" %>
            <% end %>
          </div>

        </div>
      </div>
    </div>

    <div class="lg:col-span-5 <%= 'flex flex-col gap-8' if adherent %>">
      <div class="border shadow-sm p-6 rounded-2xl bg-white <%= adherent ? '' : 'h-full flex flex-col justify-between' %>">
        <div>
          <h2 class="font-black text-xl mb-6 flex items-center gap-3 uppercase">
            <span class="w-1.5 h-7 rounded-full bg-gradient-to-b from-[#40b3db] via-[#72cfe8] via-[#a48ad5] to-[#681b98]"></span>
            Actions rapides
          </h2>

          <div class="flex flex-col gap-4">
            <%= link_to new_intervention_path, class: "group flex items-center justify-between w-full rounded-full border border-slate-200 bg-white px-6 py-4 transition-all duration-300 hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5" do %>
              <div class="flex items-center gap-4">
                <%= embedded_svg "icons/add.svg", class: "w-6 h-6 text-violet-600" %>
                <span class="font-medium">
                  <%= current_user.agent? ? "Nouveau bon d'Intervention" : "Créer une Intervention" %>
                </span>
              </div>
              <%= embedded_svg "icons/arrow_forward.svg", class: "w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" %>
            <% end %>

            <% if current_user.manager_or_admin? %>
              <%= link_to new_tool_path, class: "group flex items-center justify-between w-full rounded-full border border-slate-200 bg-white px-6 py-4 transition-all duration-300 hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5" do %>
                <div class="flex items-center gap-4">
                  <%= embedded_svg "icons/box.svg", class: "w-6 h-6 text-violet-600" %>
                  <span class="font-medium">Ajouter un nouveau Matériel</span>
                </div>
                <%= embedded_svg "icons/arrow_forward.svg", class: "w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" %>
              <% end %>

              <%= link_to admin_create_new_user_path, class: "group flex items-center justify-between w-full rounded-full border border-slate-200 bg-white px-6 py-4 transition-all duration-300 hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5" do %>
                <div class="flex items-center gap-4">
                  <%= embedded_svg "icons/person_add.svg", class: "w-6 h-6 text-violet-600" %>
                  <span class="font-medium">Ajouter un nouvel Utilisateur</span>
                </div>
                <%= embedded_svg "icons/arrow_forward.svg", class: "w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" %>
              <% end %>
            <% elsif current_user.adhérent? %>
              <%= link_to dashboard_path, class: "group flex items-center justify-between w-full rounded-full border border-slate-200 bg-white px-6 py-4 transition-all duration-300 hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5" do %>
                <div class="flex items-center gap-4">
                  <%= embedded_svg "icons/bar_chart.svg", class: "w-6 h-6 text-violet-600" %>
                  <span class="font-medium">Voir le tableau de bord</span>
                </div>
                <%= embedded_svg "icons/arrow_forward.svg", class: "w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" %>
              <% end %>
            <% elsif current_user.agent? %>
              <%= link_to tools_path, class: "group flex items-center justify-between w-full rounded-full border border-slate-200 bg-white px-6 py-4 transition-all duration-300 hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5" do %>
                <div class="flex items-center gap-4">
                  <%= embedded_svg "icons/front_loader.svg", class: "w-6 h-6 text-violet-600" %>
                  <span class="font-medium">Réserver du matériel</span>
                </div>
                <%= embedded_svg "icons/arrow_forward.svg", class: "w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" %>
              <% end %>

              <%= link_to documentation_index_path, class: "group flex items-center justify-between w-full rounded-full border border-slate-200 bg-white px-6 py-4 transition-all duration-300 hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5" do %>
                <div class="flex items-center gap-4">
                  <%= embedded_svg "icons/menu_book.svg", class: "w-6 h-6 text-violet-600" %>
                  <span class="font-medium">Consulter le guide</span>
                </div>
                <%= embedded_svg "icons/arrow_forward.svg", class: "w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <%# Adhérent: mensajes debajo de las acciones rápidas, rellenando el hueco %>
      <% if adherent %>
        <%= render 'messages_block', extra_class: "flex-1" %>
      <% end %>
    </div>
  </div>

  <% unless adherent %>
    <%= render 'messages_block' %>
  <% end %>

</div>
