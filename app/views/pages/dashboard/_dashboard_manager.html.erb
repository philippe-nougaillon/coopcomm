    <canvas id="tempsTotalParAdhérentChart" class="max-h-64" data-turbo="false"></canvas>
  </div>
  <div class="flex-1 w-full sm:w-1/2 flex flex-col items-center border-3 rounded-xl p-8">
    <h2 class="text-2xl sm:whitespace-nowrap text-center">Temps total par agent</h2>
    <canvas id="tempsTotalParAgentChart" class="max-h-64" data-turbo="false"></canvas>
  </div>
  <div class="w-full sm:w-1/2 flex flex-col items-center border-3 rounded-xl p-8">
    <h2 class="text-2xl sm:whitespace-nowrap text-center">Nombre d'interventions par état et par mois</h2>
    <canvas id="workflowChart" class="max-h-64" data-turbo="false"></canvas>
  </div>
