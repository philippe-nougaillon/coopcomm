<script>
  /*
      Temps total par adhérent
  */
  function afficherTempsTotalParAdherent() {
      var dataTempsTotalParAdhérent = {
          labels: <%= @temps_total_par_adherent.keys.to_json.html_safe %>,
          datasets: [
              {
                  label: "Temps(h)",
                  backgroundColor: [
                      'rgba(153, 101, 255, 0.4)',
                      'rgba(255,159, 64, 0.4)',
                      'rgba(54, 162, 235, 0.4)',
                      'rgba(75, 192, 192, 0.4)',
                      'rgba(255, 205, 86, 0.4)',
                      'rgba(255, 99, 132, 0.4)',
                      'rgba(201, 203, 207, 0.4)',
                  ],
                  borderColor: [
                      'rgb(153, 102, 255)',
                      'rgb(255, 159, 64)',
                      'rgb(54, 162, 235)',
                      'rgb(75, 192, 192)',
                      'rgb(255, 205, 86)',
                      'rgb(255, 99, 132)',
                      'rgb(201, 203, 207)'
                  ],
                  borderWidth: 1,
                  data: <%= @temps_total_par_adherent.values.to_json.html_safe %>,
              },
          ],
      };

      var configTempsTotalParAdhérent = {
          type: "polarArea",
          data: dataTempsTotalParAdhérent,
          options: {},
      };

      var elementTempsTotalParAdhérent = document.getElementById("tempsTotalParAdhérentChart");
      if (elementTempsTotalParAdhérent) {
          new Chart(elementTempsTotalParAdhérent, configTempsTotalParAdhérent);
      }
  }

  /*
      Temps total par agent
  */
  function afficherTempsTotalParAgent() {
      var configTempsTotalParAgent = {
          data: {
              datasets: [{
                  type: 'bar',
                  label: "Temps total (h)",
                  backgroundColor: [
                      'rgba(54, 162, 235, 0.4)',
                  ],
                  borderColor: [
                      'rgb(54, 162, 235)',
                  ],
                  borderWidth: 1,
                  data: <%= @temps_total_par_agent.values.to_json.html_safe %>,
              }],
              // , {
              //   type: 'line',
              //   label: 'Limite mensuelle',
              //   data: Array(<%= @temps_total_par_agent.keys.count %>).fill(35*4),
              //   backgroundColor: 'rgba(255, 99, 132, 0.4)',
              //   borderColor: 'rgb(255, 99, 132)',
              //   borderWidth: 1,
              // }],
              labels: <%= @temps_total_par_agent.keys.to_json.html_safe %>,
          },
          options: {}
      };

      var elementTempsTotalParAgent = document.getElementById("tempsTotalParAgentChart");
      if (elementTempsTotalParAgent) {
          new Chart(elementTempsTotalParAgent, configTempsTotalParAgent);
      }
  }

  /*
    Quantité intervention par workflow par mois
  */
  function afficherWorkflowChart() {
      var dataWorkflowChart = <%= @data_workflow_chart.to_json.html_safe %>; // Passez les données depuis Rails au JS

      var optionsWorkflowChart = {
          responsive: true,
          plugins: {
              legend: {
                  position: 'top',
              },
              tooltip: {
                  mode: 'index',
                  intersect: false,
              }
          },
          scales: {
              x: {
                  stacked: true, // Barres empilées sur l'axe X
              },
              y: {
                  stacked: true, // Barres empilées sur l'axe Y
              }
          }
      }

      var configWorkflowChart = {
          type: "bar",
          data: dataWorkflowChart,
          options: optionsWorkflowChart
      };

      var elementWorkflowChart = document.getElementById("workflowChart");
      if (elementWorkflowChart) {
          new Chart(elementWorkflowChart, configWorkflowChart);
      }
  }

