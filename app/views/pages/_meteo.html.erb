<div class="w-64 flex flex-col justify-around items-center text-center p-6">
    <div class="text-md font-bold flex flex-col text-gray-900">
    <span class="uppercase"><%= l(forecast["datetime"].to_date, format: :calendar) %></span>
    <span class="font-normal text-gray-700 text-sm">à <%= forecast["datetime"].to_time.strftime("%H:%M") %></span>
    </div>
    <%= image_tag Meteo.get_icon_meteo(forecast["weather"]), size: 120 %>
    <p class="text-gray-700 mb-2"><%= Meteo.WEATHER[forecast["weather"]] %></p>
    <div class="text-3xl font-bold text-gray-900 mb-6">
    <p><%= forecast["temp2m"] %>ºC</p>
    </div>
    <div class="flex justify-between justify-center w-full">
        <div class="flex items-center text-gray-700 px-2 gap-1">
            <%= image_tag "meteo/wind.svg", size: 10 %>
            <p><%= forecast["wind10m"] %> km/h</p>
        </div>
    </div>
</div>