<% user = User.with_discarded.find_by(id: message.from_id) %>
<div class="flex flex-wrap lg:flex-nowrap items-center gap-4 border px-4 py-4">
  <div class="w-10">
    <% if user %>
      <%= render partial: 'partials/user_profile_picture', locals: {user: user} %>
    <% else %>
          <%= embedded_svg "icons/chat.svg", class: "icon text-primary", title: "chat" %>
    <% end %>
  </div>
  <div>
    <b><%= link_to_if user&.id, truncate(message.moderation, length: 100), messagerie_path(to_id: user&.id), class:'hover:underline hover:text-primary' %></b>
    <div>
      <small>
        il y a <%= time_ago_in_words message.created_at %>
      </small>
    </div>
    <%= user&.nom_prenom_role || "Message automatique" %>
  </div>
</div>