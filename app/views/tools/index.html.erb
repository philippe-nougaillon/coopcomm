<div class="w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!('Réservation de matériel') %></h1>
    <div class="w-full sm:w-fit flex flex-wrap sm:block justify-between gap-4">
      <% if policy(Tool).new? %>
        <%= link_to "Ajouter un Matériel", new_tool_path, data: { 'testid': "ajouter_outil_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:text-white!" %>
        <%= link_to "+ Matériel", new_tool_path, data: { 'testid': "ajouter_outil_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:text-white!" %>
      <% end %>
      <% if policy(Mouvement).new? %>
        <%= link_to "Panne", new_mouvement_path, data: { 'testid': "ajouter_panne" }, class: 'inline-flex btn btn-sm sm:btn-lg btn-outline btn-neutral' %>
      <% end %>
    </div>
  </div>
  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap items-start w-full gap-4 mt-8">
      <div class="w-full md:w-fit">
        <%= label_tag :search, "Rechercher" %>
        <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-sm w-full', placeholder: 'Nom / Description' %>
      </div>
      <div class="w-full md:w-fit">
        <%= label_tag :date %>
        <%= date_field_tag :date, params[:date], include_blank:true, onchange:'this.form.submit()', class: 'input input-sm w-full' %>
      </div>
      <div class="min-w-full md:min-w-36">
        <%= label_tag :type %>
        <%= select_tag :type, options_for_select(@types, params[:type]), include_blank: true, class: 'slim-select w-full', onchange: 'this.form.submit()' %>
      </div>
      <% if false %>
        <!-- Crash si un outil n'a pas de mouvement (il n'y a plus de mouvement créé à la création de l'outil)

        <div class="min-w-full md:min-w-36">
          <%= label_tag :etats, "État" %>
          <%= select_tag :etats, options_for_select(@états, params[:etats]), include_blank: true, class: 'slim-select w-full', onchange: 'this.form.submit()' %>
        </div>
        -->
      <% end %>
    </div>
  <% end %>
  <div class="divider"></div>

  <%= render partial: 'view_list' %>

</div>
