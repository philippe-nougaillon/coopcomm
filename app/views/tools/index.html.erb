<div class="w-full mb-24">
  <div class="flex flex-wrap justify-between items-center">
    <h1 class="text-4xl text-primary font-bold">Outils / Machines</h1>
    <% if policy(Tool).new? %>
      <%= link_to "Ajouter un Outil", new_tool_path, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:!text-white" %>
      <%= link_to "+", new_tool_path, class: "inline-flex sm:hidden btn btn-primary btn-outline hover:!text-white" %>
    <% end %>
  </div>

  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap items-start w-full gap-4 mt-8">
      <div class="w-full md:w-fit">
        <%= label_tag :search, "Rechercher" %>
        <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-bordered input-sm w-full', placeholder: 'Nom / Description' %>
      </div>

      <div class="w-full md:w-fit">
        <%= label_tag :date, 'Date' %>
        <%= datetime_field_tag :date, params[:date], include_blank:true, onchange:'this.form.submit()', class: 'input input-bordered input-sm w-full', placeholder: 'Nom / Description' %>
      </div>

      <div class="w-full sm:w-fit">
        <%= label_tag :vue %>
        <br>
        <div class="join">
          <%= radio_button_tag :vue, "calendrier", (params[:vue] == 'calendrier'), name: 'vue', id: 'btnradio1', autocomplete: 'off', onchange: 'this.form.submit()', class: 'hidden' %>
          <label class="btn btn-primary btn-outline btn-sm join-item <%= 'btn-active !text-white' if params[:vue] == 'calendrier' %>" for="btnradio1" title="Mode calendrier">
            <span class="material-symbols-outlined">
              calendar_month
            </span>
          </label>

          <%= radio_button_tag :vue, 'indisponible_carte', (params[:vue] == 'indisponible_carte'), name: 'vue', id: 'btnradio2', autocomplete: 'off', onchange: 'this.form.submit()', class: 'hidden' %>
          <label class="btn btn-primary btn-outline btn-sm join-item <%= 'btn-active !text-white' if params[:vue] == 'indisponible_carte' %>" for="btnradio2" title="Mode carte">
            <span class="material-symbols-outlined">
              map
            </span>
          </label>
        </div>
      </div>
    </div>
  <% end %>

  <div class="divider"></div>

  <% case params[:vue] %>
    <% when 'disponible', 'indisponible', 'calendrier' %>
      <%= render partial: 'view_list' %>
    <% when 'indisponible_carte' %>
      <%= render partial: 'view_map' %>
  <% end %>

</div>
