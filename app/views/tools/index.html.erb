<div class="w-full mb-24">
  <div class="flex flex-wrap justify-between items-center">
    <h1 class="text-4xl text-primary font-bold">Outils</h1>
    <% if policy(Tool).new? %>
      <%= link_to "Ajouter un Outil", new_tool_path, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:!text-white" %>
      <%= link_to "+", new_tool_path, class: "inline-flex sm:hidden btn btn-primary btn-outline hover:!text-white" %>
    <% end %>
  </div>

  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap items-start w-full gap-4 mt-8">
      <div class="w-full md:w-fit">
        <%= label_tag :search, "Rechercher" %>
        <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-bordered input-sm w-full', placeholder: 'Nom / Description' %>
      </div>

      <div class="w-full md:w-fit">
        <%= label_tag :quand, 'Quand ?' %>
        <%= datetime_field_tag :quand, params[:quand], include_blank:true, onchange:'this.form.submit()', class: 'input input-bordered input-sm w-full', placeholder: 'Nom / Description' %>
      </div>

      <div class="w-full sm:w-fit">
        <%= label_tag :vue %>
        <br>
        <%= radio_button_tag :vue, "tout", (params[:vue] == 'tout'), onchange:'this.form.submit()', class: 'radio radio-xs radio-primary' %>
        Tous
        <%= radio_button_tag :vue, "disponible", (params[:vue] == 'disponible'), onchange:'this.form.submit()', class: 'radio radio-xs radio-primary ml-2' %>    
        Disponibles
        <%= radio_button_tag :vue, "indisponible", (params[:vue] == 'indisponible'), onchange:'this.form.submit()', class: 'radio radio-xs radio-primary ml-2' %>
        Indisponibles
        <%= radio_button_tag :vue, "indisponible_carte", (params[:vue] == 'indisponible_carte'), onchange:'this.form.submit()', class: 'radio radio-xs radio-primary ml-2' %>
        Indisponibles (Carte)
      </div>
    </div>
  <% end %>

  <div class="divider"></div>

  <% case params[:vue] %>
    <% when 'disponible', 'indisponible', 'tout' %>
      <%= render partial: 'view_list' %>
    <% when 'indisponible_carte' %>
      <%= render partial: 'view_map' %>
  <% end %>

</div>
