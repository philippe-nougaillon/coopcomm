<div class="w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold"><%= page_title!('Matériels / Machines') %></h1>
    <% if policy(Tool).new? %>
      <%= link_to "Ajouter un Matériel", new_tool_path, data: { 'testid': "ajouter_outil_pc" }, class: "hidden sm:inline-flex btn btn-primary btn-outline btn-lg rounded hover:text-white!" %>
      <%= link_to "+", new_tool_path, data: { 'testid': "ajouter_outil_mobile" }, class: "inline-flex sm:hidden btn btn-primary btn-outline btn-sm hover:text-white!" %>
    <% end %>
  </div>

  <%= form_tag request.path, method: :get do %>
    <div class="flex flex-wrap items-start w-full gap-4 mt-8">
      <div class="w-full md:w-fit">
        <%= label_tag :search, "Rechercher" %>
        <%= text_field_tag :search, params[:search], include_blank:true, onchange:'this.form.submit()', class: 'input input-sm w-full', placeholder: 'Nom / Description' %>
      </div>

      <div class="w-full md:w-fit">
        <%= label_tag :date %>
        <%= datetime_field_tag :date, params[:date], include_blank:true, onchange:'this.form.submit()', class: 'input input-sm w-full' %>
      </div>

      <div class="min-w-full md:min-w-36">
        <%= label_tag :type %>
        <%= select_tag :type, options_for_select(@types, params[:type]), include_blank: true, class: 'w-full', onchange: 'this.form.submit()' %>
      </div>

      <div class="w-full sm:w-fit">
        <%= label_tag :vue, 'Mode' %>
        <br>
        <div class="join">
          <label class="btn btn-primary btn-outline btn-sm join-item <%= 'btn-active text-white!' if params[:vue] == 'calendrier' %>" for="btnradio1" title="Mode calendrier">
            <span class="material-symbols-outlined">
              calendar_month
            </span>
          </label>
          <%= radio_button_tag :vue, "calendrier", (params[:vue] == 'calendrier'), name: 'vue', id: 'btnradio1', autocomplete: 'off', onchange: 'this.form.submit()', class: 'hidden' %>

          <%= radio_button_tag :vue, 'indisponible_carte', (params[:vue] == 'indisponible_carte'), name: 'vue', id: 'btnradio2', autocomplete: 'off', onchange: 'this.form.submit()', class: 'hidden' %>
          <label class="btn btn-primary btn-outline btn-sm join-item <%= 'btn-active text-white!' if params[:vue] == 'indisponible_carte' %>" for="btnradio2" title="Mode carte (affiche la position des outils à date)">
            <span class="material-symbols-outlined">
              map
            </span>
          </label>
        </div>
      </div>
    </div>
  <% end %>

  <div class="divider"></div>

  <% case params[:vue] %>
    <% when 'calendrier', 'disponible', 'indisponible' %>
      <%= render partial: 'view_list' %>
    <% when 'indisponible_carte' %>
      <%= render partial: 'view_map' %>
  <% end %>

</div>

<script>
  // slimselect
  new SlimSelect({
    select: '#type',
    settings: {
      searchPlaceholder: 'Recherche',
      searchText: 'Pas de résultat',
      searchingText: 'Recherche...',
      allowDeselect: true,
    }
  })
</script>