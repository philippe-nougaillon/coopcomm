<tr id="<%= dom_id tool %>" class="hover:bg-base-300">
  <td>
    <% if tool.photo.present? %>
      <img src="<%= url_for(tool.photo) %>" class="h-10">  
    <% end %>
  </td>
  <td class="text-lg sm:text-2xl text-primary">
    <%= link_to tool.name.humanize, tool, class: 'text-primary hover:underline', title: (tool.description.blank? ? 'Aucune description' : tool.description) %>
  </td>

  <td>
    <%= tool.modèle %>
  </td>
  <td>
    <%= tool.marque %>
  </td>
  <td>
    <% if tool.mouvements.any? %> 
      <p class="font-bold badge badge-sm badge-<%= tool.mouvements.last.style %>"><%= tool.mouvements.last.état.humanize %></p>
    <% end %>
  </td>

  <% case params[:vue]%>
  <% when 'disponible' %>
    <td>
      <span class="material-symbols-outlined text-success">
        check_circle
      </span>
    </td>
  <% when 'indisponible' %>
    <td>
      <span class="material-symbols-outlined text-error">
        cancel
      </span>
    </td>
  <% when 'calendrier' %>
    <% (@date..@date_fin).each do | date | %>
      <td class="text-center <%= 'bg-yellow-50' if date == Date.today %>">
        <% interventions = tool.interventions.where(" ? BETWEEN DATE(interventions.début_prévue) AND DATE(interventions.fin_prévue) ", date) %>
        <% interventions_matin = interventions.where("début_prévue < ?", Time.parse(date.to_s + " 13:00")) %>
        <% interventions_soir = interventions.where("fin_prévue > ?", Time.parse(date.to_s + " 13:00")) %>

        <%= render 'interventions/intervention_slot', 
           interventions: interventions_matin, 
           tool_id: tool.id, 
           date: date, 
           margin_style: 'margin-right: 2px', 
           start_hour: 8, 
           end_hour: 13, 
           new_title: "Créer une intervention le #{date.day} au matin" %>

        <%= render 'interventions/intervention_slot', 
           interventions: interventions_soir, 
           tool_id: tool.id, 
           date: date, 
           margin_style: 'margin-left: 2px', 
           start_hour: 13, 
           start_minute: 5, 
           end_hour: 18, 
           new_title: "Créer une intervention le #{date.day} après-midi" %>
      </td>
    <% end %>

    <!--
    <%# if tool.disponible?(params[:quand] || DateTime.now) %>
      <span class="material-symbols-outlined text-success">
        check_circle
      </span>
    <%# elsif  %>
      <span class="material-symbols-outlined text-error">
        cancel
      </span>
    <%# end %>
    -->

  <% end %>
  <% if false %>
    <td>
      <div class="flex justify-end items-center gap-2">
        <% if policy(tool).show? %>
          <%= link_to tool, title: 'Voir' do %>
            <span class="material-symbols-outlined">
              visibility
            </span>
          <% end %>
        <% end %>
        <% if policy(tool).edit? %>
          <%= link_to edit_tool_path(tool), title: 'Modifier' do %>
            <span class="material-symbols-outlined">
              edit
            </span>
          <% end %>
        <% end %>
        <% if policy(tool).destroy? %>
          <%= button_to tool_path(tool), title: "Supprimer l'outil", method: :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cet outil ?" }, form: { class: "flex items-center" }, 'data-testid': "Supprimer l'outil" do %>
            <span class="material-symbols-outlined">
              delete
            </span>
          <% end %>
        <% end %>
      </div>
    </td>
  <% end %>
</tr>