

<tr id="<%= dom_id tool %>", class="hover:bg-base-200/60 transition-colors duration-150 border-b border-slate-100 align-middle">

    <td class="px-4 py-1.5 uppercase font-bold bg-slate-100 ">
    <%= link_to tool.name.humanize, tool, class: 'text-base font-bold text-primary hover:underline', title: (tool.description.blank? ? 'Aucune description' : tool.description) %>
  </td>
  <% tool.get_etats_from_mouvements(@date, @date_fin, current_user.id).each_with_index do | etat, index | %>
    <td class="text-center">

      <%= render 'tools/mouvement', 
                  etat:,
                  tool:,
                  index:,
                  date: @date + index.day
      %>
    </td>
  <% end %>
</tr>
