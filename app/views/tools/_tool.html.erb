<tr id="<%= dom_id tool %>">
  <td class="hidden sm:block">
    <% if tool.photo.present? %>
      <img src="<%= url_for(tool.photo) %>" class="h-10">
    <% end %>
  </td>
  <%# la couleur du <td> si dessous est nécessaire si la colonne reste affichée en scrollant, sinon les colonnes se superposeront %>
  <td class="sticky left-0 top-0 bg-slate-100 sm:text-xl text-primary bg-slate-50 break-words whitespace-normal max-w-[25vw]">
    <%= link_to tool.name.humanize, tool, class: 'text-primary hover:underline', title: (tool.description.blank? ? 'Aucune description' : tool.description) %>
  </td>
  <% if false %>
  <% end %>
  <% case params[:vue]%>
  <% when 'disponible' %>
    <td>
      <%= embedded_svg "icons/check_circle.svg", class: "text-success", title: "Outil disponible" %>
    </td>
  <% when 'indisponible' %>
    <td>
      <%= embedded_svg "icons/cancel.svg", class: " text-error", title: "Outil indisponible" %>
    </td>
  <% when 'calendrier' %>
    <% (@date..@date_fin).each do | date | %>
      <td class="text-center p-0! <%= date == Date.today ? 'border-x-1 border-x-cerise' : 'bg-slate-200' %>">
        <% 
          # On vérifie l'état juste avant la fin du créneau pour capter tout ce qui s'y passe
          heure_matin = Time.zone.parse("#{date} 12:59:59")
          heure_soir = Time.zone.parse("#{date} 17:59:59")

          mouvement_matin = tool.dernier_mouvement_a(heure_matin)
          mouvement_soir = tool.dernier_mouvement_a(heure_soir)
        %>
        <%= render 'mouvements/mouvement_slot', 
                  mouvement: mouvement_matin, 
                  tool_id: tool.id, 
                  date: date, 
                  margin_style: 'margin-right: 2px', 
                  start_hour: 8, 
                  end_hour: 13, 
                  new_title: "Réserver \"#{tool.name.humanize}\" le #{date.day} au matin" %>
        <%= render 'mouvements/mouvement_slot', 
                  mouvement: mouvement_soir, 
                  tool_id: tool.id, 
                  date: date, 
                  margin_style: 'margin-left: 2px', 
                  start_hour: 13, 
                  start_minute: 5, 
                  end_hour: 18, 
                  new_title: "Réserver \"#{tool.name.humanize}\" le #{date.day} après-midi" %>
      </td>
    <% end %>
  <% end %>
  <% if false %>
  <% end %>
</tr>