<%# app/views/tools/_document_form.html.erb %>
<div class="nested-form-wrapper flex items-center justify-between gap-3 bg-zinc-800/60 border border-zinc-800 px-4 py-3 rounded-lg relative" data-nested-documents-target="item">
  <div class="flex items-center gap-3">
    <%# Icono representativo de archivos del documento %>
    <div class="text-zinc-400">
      <%= embedded_svg "icons/document.svg", class: "w-5 h-5 text-zinc-400" %>
    </div>
    
    <div class="flex flex-col">
      <span class="text-sm font-semibold text-zinc-100">
        <%= form.object.category.present? ? form.object.category.tr('_', ' ').humanize : "Document" %>
      </span>
      <% if form.object.fichier.attached? %>
        <span class="text-xs text-zinc-500 font-normal mt-0.5"><%= form.object.fichier.filename %></span>
      <% end %>
    </div>
  </div>

  <%= form.hidden_field :_destroy %>

  <button type="button" data-action="nested-documents#remove" class="text-zinc-500 hover:text-red-400 bg-transparent hover:bg-zinc-700/50 p-1.5 rounded transition-colors" title="Supprimer">
    <%= embedded_svg "icons/trash.svg", class: "w-4 h-4 fill-current" %>
  </button>
</div>