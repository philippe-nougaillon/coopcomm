<div class="overflow-x-auto h-96">
  <table id="tools" class="table table-sm table-pin-rows">
    <thead class="bg-slate-100">
      <tr>
        <th></th>
        <th class="sticky left-0 top-0 z-10 bg-slate-100"><%= sort_link 'tools.name', 'Nom' %></th>
        <% if false %>
          <!--
          <th><%= sort_link 'tools.modèle', 'Modèle' %></th>
          <th><%= sort_link 'tools.marque', 'Marque' %></th>
          -->
        <th>État</th>
        <% end %>
        <% if params[:vue] == 'calendrier' %>
          <% (@date..@date_fin).each do |date| %>
            <th class="text-center <%= 'text-cerise' if date == Date.today %>">
              <div class="flex items-center">
                <%= l(date, format: :calendar).humanize %>
                <% if icon_meteo = MeteoConceptConnexion.get_icon_meteo_by_date(date, @forecasts["forecast"])%>
                  <%= image_tag icon_meteo, size: 50 %>
                <% end %>
              </div>
            </th>
          <% end %>
        <% else %>
          <th>Disponible ?</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <%= render @tools %>
    </tbody>
    <tfoot>
      <th></th>
    </tfoot>
  </table>
</div>

<div class="my-6">
  <%== pagy_info(@pagy) %>
  <%== pagy_nav(@pagy) %>
</div>