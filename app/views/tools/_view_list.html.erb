<div class="overflow-x-auto">
  <table id="tools" class="table table-sm">
    <thead class="bg-slate-100">
      <tr>
        <th></th>
        <th>Nom</th>
        <% if params[:vue] == 'calendrier' %>
          <% (@date..@date_fin).each do |date| %>
            <th class="-rotate-45 h-12 pb-8">
              <%= l(date, format: :calendar).humanize %>
            </th>
          <% end %>
        <% else %>
          <th>Disponible ?</th>
        <% end %>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <%= render @tools %>
    </tbody>
  </table>
</div>

<div class="my-6">
  <%== pagy_info(@pagy) %>
  <%== pagy_nav(@pagy) %>
</div>