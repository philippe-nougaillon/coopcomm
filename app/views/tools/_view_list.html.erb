<div class="overflow-visible">
  <div class="flex items-center gap-1 text-xs text-slate-400 px-4 py-2 bg-slate-50/50 border-b border-slate-100 md:hidden">
    <%= embedded_svg "icons/swipe.svg", class: "text-sm", title: "Faire glisser" %>
    <span>Faire glisser pour voir plus</span>
  </div>
  <div class="overflow-x-auto">
    <table id="tools" class="table table-sm w-full border-none">
      <thead class="bg-slate-100">
        <tr>
          <th class="sticky left-0 top-0 z-10 bg-slate-100"><%= sort_link 'tools.name', 'Nom' %></th>
          <% (@date..@date_fin).each do |date| %>
            <th class="text-center <%= 'text-purple-700 font-bold' if date == Date.today %>">
              <div class="flex flex-col items-center">
                <%= l(date, format: :calendar).humanize %>
                <% if @forecasts && icon_meteo = MeteoConceptConnexion.get_icon_meteo_by_date(date, @forecasts["forecast"])%>
                  <%= image_tag icon_meteo, size: 50, title: MeteoConceptConnexion.get_title(date, @forecasts["forecast"]) %>
                <% end %>
              </div>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% if @tools.present? %>
          <%= render @tools %>
        <% else %>
          <tr>
            <td colspan="<%= (@date..@date_fin).count + 1 %>" class="text-left md:text-center py-8 text-slate-400 text-base italic">
              Aucun résultat trouvé pour cette recherche.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy&.pages.to_i > 1 %>
    <div class="flex flex-col justify-between items-center gap-4 p-4 border-t border-slate-100 bg-slate-50/50 w-full rounded-b-xl">
      <div class="w-full sm:w-auto sm:flex-1 order-1 sm:order-2 flex justify-center">
        <%= pagy_nav(@pagy).html_safe %>
      </div>
      <div class="text-base font-semibold text-slate-500 text-center sm:text-right w-full sm:flex-1 order-2 sm:order-3">
        <%= pagy_info(@pagy).html_safe %>
      </div>
    </div>
  <% end %>
</div>