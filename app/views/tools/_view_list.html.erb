<div class="overflow-x-auto">
  <table id="tools" class="table table-sm">
    <thead class="bg-slate-100">
      <tr>
        <th><%= sort_link 'tools.icon_name', 'Type' %></th>
        <th>Photo</th>
        <th><%= sort_link 'tools.name', 'Nom' %></th>
        <th><%= sort_link 'tools.modèle', 'Modèle' %></th>
        <th><%= sort_link 'tools.marque', 'Marque' %></th>
        <% if params[:vue] == 'calendrier' %>
          <% (@date..@date_fin).each do |date| %>
            <th class="text-center <%= 'bg-yellow-100' if date == Date.today %>">
              <%= l(date, format: :calendar).humanize %>
            </th>
          <% end %>
        <% else %>
          <th>Disponible ?</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <%= render @tools %>
    </tbody>
    <tfoot>
      <th></th>
    </tfoot>
  </table>
</div>

<div class="my-6">
  <%== pagy_info(@pagy) %>
  <%== pagy_nav(@pagy) %>
</div>