<%= form_with(model: tool, class: "contents", html: { class: 'flex flex-col gap-2' }) do |form| %>
  <% if tool.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3 mb-4">
      <h2 class="!font-black">
        <%= pluralize(tool.errors.count, "erreur") %> empêche(nt) ce matériel d'être sauvegardé :
      </h2>

      <ul class="list-disc list-inside">
        <% tool.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="w-full">
    <%= form.label :name, 'Nom' %>
    <%= form.text_field :name, class: 'input input-bordered input-sm w-full', required: true %>
  </div>

  <div class="w-full">
    <%= form.label :description %>
    <%= form.text_area :description, class: "textarea textarea-bordered textarea-sm w-full" %>
  </div>

  <div class="w-full">
    <%= form.label :icon_name, "Type" %>
    <%= form.select :icon_name, options_for_select(Tool.icons.sort), {include_blank: true}, class: "input input-bordered input-sm w-full" %>
  </div>

  <div class="w-full">
    <%= form.label :modèle %>
    <%= form.text_field :modèle, class: 'input input-bordered input-sm w-full' %>
  </div>

  <div class="w-full">
    <%= form.label :marque %>
    <%= form.text_field :marque, class: 'input input-bordered input-sm w-full' %>
  </div>  

  <h3>Documents</h3>
  <% Document.categories.each_with_index do |category| %>
    <%= form.fields_for :documents, @tool.documents.build(category: category) do |document_fields| %>
      <h4><%= category %><h4>
      <%= document_fields.hidden_field :category, value: category %>
      <div class="w-full">
        <%= document_fields.file_field :fichier, accept: 'image/png,image/jpeg,.pdf', class: 'input input-bordered input-sm w-full' %>
      </div>
      <div class="flex w-full justify-between mb-2">
        <div class="sm:w-fit px-4">
          <div class="w-full">
            <%= document_fields.label :workflow_state, 'Statut' %>
            <%= document_fields.select :workflow_state, Document.workflow_spec.states.keys.to_a, {}, class: 'input input-bordered input-sm w-full' %>
          </div>
        </div>
      </div>

    <% end %>
  <% end %>

  <%= form.submit "Enregistrer", class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium cursor-pointer mt-4" %>
<% end %>
