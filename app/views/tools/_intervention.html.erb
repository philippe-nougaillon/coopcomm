<tr class="hover:bg-base-300">
  <td class="text-base">
  <% color_class = "text-#{intervention.style.split.first.split('-').last}" %>
  <%= link_to_if policy(intervention).edit?, 
                 intervention.description.humanize, 
                 intervention, 
                 class: "font-black #{color_class} hover:underline" %>
</td>
  <td><%= l(intervention.début, format: :long) if intervention.début %></td>
  <td><%= l(intervention.fin, format: :long) if intervention.fin %></td>
  <td><%= intervention.adherent.try(:nom_prénom) %></td>
</td>
