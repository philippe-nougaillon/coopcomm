<tr class="hover:bg-base-300">
  <td>
    <% if intervention.en_cours? %>
      <img src="/assets/images/icons/cancel.svg" class="icon text-error" alt="Annuler" title="Annuler l'intervention en cours">
    <% end %>
  </td>
  <td class="text-xl">
    <%= link_to_if policy(intervention).edit?, intervention.description.humanize, intervention, class: 'font-black text-primary hover:underline' %>
  </td>
  <td><%= l(intervention.début, format: :long) if intervention.début %></td>
  <td><%= l(intervention.fin, format: :long) if intervention.fin %></td>
  <td><%= intervention.adherent.try(:nom_prénom) %></td>
</td>