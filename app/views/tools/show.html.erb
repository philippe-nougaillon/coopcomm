<div class="mx-auto lg:w-2/3 w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold">
      <% if @tool.icon_name.present? %>
        <span class="material-symbols-outlined text-primary">
          <%= @tool.icon_name %>
        </span>
      <% end %>
      <%= page_title!(@tool.name) %>
      <%# test inutile par la suite, tous les outils devraient avoir un mouvement à leur création %>
      <% if @tool.mouvements.any? %> 
        <p class="font-bold badge badge-sm badge-<%= @tool.mouvements.last.style %>"><%= @tool.mouvements.last.état.humanize %></p>
      <% else %>
        <%# laissé temporairement, devrait être retiré par la suite lorsque tous les outils auront un mouvement à la création %>
        <% if @tool.disponible?(DateTime.now) %>
          <span class="material-symbols-outlined text-success cursor-help" title="Le matériel est disponible actuellement">
            check_circle
          </span>
        <% else %>
          <span class="material-symbols-outlined text-error cursor-help" title="Le matériel n'est pas disponible actuellement">
            cancel
          </span>
        <% end %>
      <% end %>
    </h1>

    <%= link_to "Ajouter une intervention avec ce matériel", new_intervention_path(tool_ids: @tool.id), class: 'btn btn-lg btn-outline btn-success hover:text-white!' %>
  </div>

  <div class="flex flex-wrap gap-4">
    <p class="my-2">
      <strong class="block text-slate-400 mb-1">Modèle</strong>
      <b><%= @tool.modèle %></b>
    </p>
    <p class="my-2">
      <strong class="block text-slate-400 mb-1">Marque</strong>
      <b><%= @tool.marque %></b>
    </p>
    <p class="my-2">
      <strong class="block text-slate-400 mb-1">Description</strong>
      <b><%= @tool.description %></b>
    </p>

    <% if @tool.photo.present? %>
      <img src="<%= url_for(@tool.photo) %>" class="h-60">  
    <% end %>
  
  </div>

  <div class="flex flex-wrap gap-2 mt-8">
    <% if policy(@tool).edit? %>
      <%= link_to "Modifier", edit_tool_path(@tool), class: "btn" %>
    <% end %>
    <% if policy(@tool).destroy? %>
      <% if @tool.interventions.any? %>
        <div class="btn cursor-not-allowed" title="Suppression impossible, l'outil est utilisé dans des interventions">
          <span class="material-symbols-outlined text-gray-500">
            delete
          </span>
        </div>
      <% else %>
        <%= button_to tool_path(@tool), method: :delete, id: "supprimer_outil", data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cet outil ?" }, class: "btn", 'data-testid': "Supprimer l'outil" do %>
          <span class="material-symbols-outlined">
            delete
          </span>
        <% end %>
      <% end %>
    <% end %>
    <%= link_to "Retour", tools_path, class: "btn" %>
  </div>

  <h2 class="text-2xl text-secondary mt-8">
    Disponibilités
  </h2>

  <%= form_tag tool_path(@tool), method: :get, class:'mb-2 mt-4' do %>
    <div class="flex gap-2">
      <label class="cursor-pointer flex items-center gap-1">
        <%= radio_button_tag :vue, 'calendrier', params[:vue] == 'calendrier', { id: 'vue_calendrier', class: 'radio radio-accent radio-sm', onchange: "this.form.submit();" } %>
        Calendrier
      </label>
      <label class="cursor-pointer flex items-center gap-1">
        <%= radio_button_tag :vue, 'liste', params[:vue] == 'liste', { id: 'vue_liste', class: 'radio radio-accent radio-sm', onchange: "this.form.submit();" } %>
        Liste des interventions
      </label>
    </div>
  <% end %>

  <% case params[:vue] %>
  <% when 'calendrier' %>
    <%= month_calendar do |date| %>
      <div class="flex justify-center">
        <p class="<%= date == Date.today ? 'bg-info px-2.5 py-1 rounded-full text-white font-black' : 'mb-2' %>">
          <%= date.day %>
        </p>
      </div>
      
      <% interventions = @tool.interventions.where(" ? BETWEEN DATE(interventions.début_prévue) AND DATE(interventions.fin_prévue) ", date) %>
      <% interventions_matin = interventions.where("début_prévue < ?", Time.parse(date.to_s + " 13:00")) %>
      <% interventions_soir = interventions.where("fin_prévue > ?", Time.parse(date.to_s + " 13:00")) %>
      
      <div class="text-center gap-4">
        <% if interventions_matin.any? %>
          <span class="mr-1 bg-red-300" style="padding-left: 15px" title="<%= interventions_matin.pluck(:description) %>"></span>
        <% else %>
          <%= link_to new_intervention_path(tool_ids: @tool.id, début_prévue: date, début_prévue_hour: 8, fin_prévue: date, fin_prévue_hour: 13), title: "Créer une intervention le #{date.day} au matin" do %>
            <span class="mr-1 bg-green-300" style="padding-left: 15px;"></span>
          <% end %>
        <% end %>

        <% if interventions_soir.any? %>
          <span class="bg-red-300" style="padding-left: 15px" title="<%= interventions_soir.pluck(:description) %>"></span>
        <% else %>
          <%= link_to new_intervention_path(tool_ids: @tool.id, début_prévue: date, début_prévue_hour: 13, début_prévue_minute: 5, fin_prévue: date, fin_prévue_hour: 18), title: "Créer une intervention le #{date.day} après-midi" do %>
            <span class="bg-green-300" style="padding-left: 15px;"></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% when 'liste' %>
    <div class="overflow-x-auto mt-8">
      <table class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th></th>
            <th>Intervention</th>
            <th>Du</th>
            <th>Au</th>
            <th>Adhérent</th>
            <th>Équipe</th>
          </tr>
        </thead>

        <tbody>
          <% if @tool.interventions.any? %>
            <%= render partial: 'intervention', collection: @tool.interventions.ordered %>
          <% else %>
            <tr>
              <td colspan=6>
                <i>L'outil n'est pas encore attribué à une intervention</i>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <h2 class="text-2xl text-secondary mt-8 mb-4">
    Documents
  </h2>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table class="table table-xs shadow">
        <thead class="bg-slate-100">
          <th>Type</th>
          <th>Fichier</th>
          <th>État</th>
          <th>Version</th>
          <th>MàJ il y a</th>
          <th></th>
        </thead>
        <tbody>
          <% if @tool.documents.any? %>
            <%= render @tool.documents %>
          <% else %>
            <tr>
              <td colspan=6>
                <i>Ce matériel n'a pas encore de document</i>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary">
      Mouvements
    </h2>
    <%= link_to "Ajouter un mouvement", new_mouvement_path(tool_id: @tool.id), class: 'btn btn-lg btn-outline btn-success hover:text-white!' %>
  </div>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table class="table table-xs shadow">
        <thead class="bg-slate-100">
          <th>État</th>
          <th>Intervention</th>
          <th>MàJ il y a</th>
        </thead>
        <tbody>
          <% if @tool.mouvements.any? %>
            <%= render @tool.mouvements.ordered %>
          <% else %>
            <tr>
              <td colspan=3>
                <i>Ce matériel n'a pas encore de mouvement</i>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
