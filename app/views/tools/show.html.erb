<div class="mx-auto lg:w-2/3 w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-2xl sm:text-4xl text-primary font-bold">
      <%= page_title!(@tool.name) %>
    </h1>

    <%= link_to "Ajouter une intervention avec ce matériel", new_intervention_path(tool_ids: @tool.id), class: 'btn btn-sm sm:btn-lg btn-outline btn-success hover:text-white!' %>
  </div>

  <div class="flex flex-wrap gap-8 mt-8">
    <% if @tool.photo.present? %>
      <img src="<%= url_for(@tool.photo) %>" class="h-60">  
    <% elsif @tool.icon_name.present? %>
      <span class="material-symbols-outlined text-warning !text-6xl">
        <%= @tool.icon_name %>
      </span>
    <% end %>
    <div class="flex flex-col flex-wrap">
      <p class="my-2">
        <strong class="block text-slate-400">État</strong>
        <% if @tool.mouvements.any? %>
          <p class="font-bold badge badge-sm badge-<%= @tool.mouvements.last.style %> mb-2">
            <%= @tool.mouvements.last.état.humanize %>
          </p>
        <% end %>
      </p>
      <p class="my-2">
        <strong class="block text-slate-400 mb-1">Modèle</strong>
        <b><%= @tool.modèle %></b>
      </p>
      <p class="my-2">
        <strong class="block text-slate-400 mb-1">Marque</strong>
        <b><%= @tool.marque %></b>
      </p>
      <p class="my-2">
        <strong class="block text-slate-400 mb-1">Description</strong>
        <b><%= @tool.description %></b>
      </p>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 mt-8">
    <% if policy(@tool).edit? %>
      <%= link_to "Modifier", edit_tool_path(@tool), class: "btn" %>
    <% end %>
    <% if policy(@tool).destroy? %>
      <% if @tool.interventions.any? %>
        <div class="btn cursor-not-allowed" title="Suppression impossible, l'outil est utilisé dans des interventions">
          <span class="material-symbols-outlined text-gray-500">
            delete
          </span>
        </div>
      <% else %>
        <%= button_to tool_path(@tool), method: :delete, id: "supprimer_outil", data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cet outil ?" }, class: "btn", 'data-testid': "Supprimer l'outil" do %>
          <span class="material-symbols-outlined">
            delete
          </span>
        <% end %>
      <% end %>
    <% end %>
    <%= link_to "Retour", tools_path, class: "btn" %>
  </div>

  <h2 class="text-2xl text-secondary mt-12">
    Disponibilités
  </h2>

  <%= form_tag tool_path(@tool), method: :get, class:'mb-2 mt-4' do %>
    <div class="flex gap-2">
      <label class="cursor-pointer flex items-center gap-1">
        <%= radio_button_tag :vue, 'calendrier', params[:vue] == 'calendrier', { id: 'vue_calendrier', class: 'radio radio-accent radio-sm', onchange: "this.form.submit();" } %>
        Calendrier
      </label>
      <label class="cursor-pointer flex items-center gap-1">
        <%= radio_button_tag :vue, 'liste', params[:vue] == 'liste', { id: 'vue_liste', class: 'radio radio-accent radio-sm', onchange: "this.form.submit();" } %>
        Liste des interventions
      </label>
    </div>
  <% end %>

  <% case params[:vue] %>
  <% when 'calendrier' %>
    <%= month_calendar do |date| %>
      <div class="flex justify-center">
        <p class="px-2.5 py-1 mb-1 <%= date == Date.today ? 'text-primary font-black' : '' %>">
          <%= date.day %>
        </p>
      </div>
      
      <% interventions = @tool.interventions.where(" ? BETWEEN DATE(interventions.début_prévue) AND DATE(interventions.fin_prévue) ", date) %>
      <% interventions_matin = interventions.where("début_prévue < ?", Time.parse(date.to_s + " 13:00")) %>
      <% interventions_soir = interventions.where("fin_prévue > ?", Time.parse(date.to_s + " 13:00")) %>
      
      <div class="text-center">
        <%= render 'interventions/intervention_slot', 
           interventions: interventions_matin, 
           tool_id: @tool.id, 
           date: date, 
           margin_style: 'margin-right: 2px', 
           start_hour: 8, 
           end_hour: 13, 
           new_title: "Créer une intervention le #{date.day} au matin" %>

        <%= render 'interventions/intervention_slot', 
           interventions: interventions_soir, 
           tool_id: @tool.id, 
           date: date, 
           margin_style: 'margin-left: 2px', 
           start_hour: 13, 
           start_minute: 5, 
           end_hour: 18, 
           new_title: "Créer une intervention le #{date.day} après-midi" %>
      </div>
    <% end %>
  <% when 'liste' %>
    <div class="overflow-x-auto mt-8">
      <table class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th></th>
            <th>Intervention</th>
            <th>Du</th>
            <th>Au</th>
            <th>Adhérent</th>
          </tr>
        </thead>

        <tbody>
          <% if @tool.interventions.any? %>
            <%= render partial: 'intervention', collection: @tool.interventions.ordered %>
          <% else %>
            <tr>
              <td colspan=6>
                <i>L'outil n'est pas encore attribué à une intervention</i>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <h2 class="text-2xl text-secondary mt-8 mb-4">
    Documents
  </h2>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table class="table table-xs shadow">
        <thead class="bg-slate-100">
          <th>Type</th>
          <th>Fichier</th>
          <th>État</th>
          <th>Version</th>
          <th>MàJ il y a</th>
          <th></th>
        </thead>
        <tbody>
          <% if @tool.documents.any? %>
            <%= render @tool.documents %>
          <% else %>
            <tr>
              <td colspan=6>
                <i>Ce matériel n'a pas encore de document</i>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex justify-between flex-wrap items-center mt-8 mb-4">
    <h2 class="text-2xl text-secondary">
      Mouvements
    </h2>
    <% if policy(Mouvement).new? %>
      <%= link_to "Ajouter un mouvement", new_mouvement_path(tool_id: @tool.id), class: 'btn btn-sm sm:btn-lg btn-outline btn-success hover:text-white!' %>
    <% end %>
  </div>
  <div class="mx-auto w-full">
    <div class="overflow-x-auto">
      <table class="table table-xs shadow">
        <thead class="bg-slate-100">
          <th>État</th>
          <th>Intervention</th>
          <th>MàJ il y a</th>
        </thead>
        <tbody>
          <% if @tool.mouvements.any? %>
            <%= render @tool.mouvements.ordered %>
          <% else %>
            <tr>
              <td colspan=3>
                <i>Ce matériel n'a pas encore de mouvement</i>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
