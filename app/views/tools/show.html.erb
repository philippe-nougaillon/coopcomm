<div class="mx-auto lg:w-2/3 w-full">
  <div class="flex flex-wrap justify-between items-center min-h-12 sm:min-h-16">
    <h1 class="text-4xl text-primary font-bold">
      <% if @tool.icon_name.present? %>
        <span class="material-symbols-outlined text-primary">
          <%= @tool.icon_name %>
        </span>
      <% end %>
      <%= @tool.name %>
      <% if @tool.disponible?(DateTime.now) %>
        <span class="material-symbols-outlined text-success">
          check_circle
        </span>
      <% end %>
    </h1>
  </div>

  <div class="flex flex-wrap gap-4">
    <p class="my-2">
      <strong class="block text-slate-400 mb-1">Modèle</strong>
      <b><%= @tool.modèle %></b>
    </p>
    <p class="my-2">
      <strong class="block text-slate-400 mb-1">Marque</strong>
      <b><%= @tool.marque %></b>
    </p>
    <p class="my-2">
      <strong class="block text-slate-400 mb-1">Description</strong>
      <b><%= @tool.description %></b>
    </p>
  </div>


  <div class="flex flex-wrap gap-2 mt-8">
    <%= link_to "Modifier", edit_tool_path(@tool), class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= button_to tool_path(@tool), method: :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cet outil ?" }, class: "rounded-lg py-3 px-5 bg-gray-100 font-medium", 'data-testid': "Supprimer l'outil", disabled: @tool.interventions.any? do %>
      <span class="material-symbols-outlined">
        delete
      </span>
    <% end %>
    <%= link_to "Retour", tools_path, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
  </div>

  <h2 class="text-2xl text-secondary mt-8 mb-4">
    Utilisations
    <%= link_to '+', new_intervention_path(tool_ids: @tool.id), class: 'btn btn-sm btn-outline btn-success hover:!text-white' %>
  </h2>

  <%= form_tag tool_path(@tool), method: :get, class:'mb-2' do %>
    <span>
      Vue :
      <%= radio_button_tag :vue, 'liste', params[:vue] == 'liste', { id: 'vue_liste', onchange: "this.form.submit();", class: 'radio radio-accent radio-sm' } %>
      <%= label_tag 'vue_liste', "Liste", class: 'cursor-pointer' %>
      <%= radio_button_tag :vue, 'calendrier', params[:vue] == 'calendrier', { id: 'vue_calendrier', onchange: "this.form.submit();", class: 'radio radio-accent radio-sm' } %>
      <%= label_tag 'vue_calendrier', "Calendrier", class: 'cursor-pointer' %>
    </span>
  <% end %>

  <% case params[:vue] %>
  <% when 'calendrier' %>
    <%= month_calendar do |date| %>
      <div class="flex justify-center">
        <p class="<%= date == Date.today ? 'badge badge-info' : '' %>">
          <%= date.day %>
        </p>
      </div>
      
      <% interventions = @tool.interventions.where(" ? BETWEEN DATE(interventions.début_prévue) AND DATE(interventions.fin_prévue) ", date) %>
      <% interventions_matin = interventions.where("début_prévue < ?", Time.parse(date.to_s + " 13:00")) %>
      <% interventions_soir = interventions.where("fin_prévue >= ?", Time.parse(date.to_s + " 13:00")) %>
      
      <div class="text-center">
        <% if interventions_matin.any? %>
          <span style="background-color: red; padding-left: 15px;"></span>
        <% else %>
          <%= link_to new_intervention_path(tool_ids: @tool.id, début_prévue: date, début_prévue_hour: 8, fin_prévue: date) do %>
            <span style="background-color: lightgreen; padding-left: 15px;"></span>
          <% end %>
        <% end %>

        <% if interventions_soir.any? %>
          <span style="background-color: red; padding-left: 15px;"></span>
        <% else %>
          <%= link_to new_intervention_path(tool_ids: @tool.id, début_prévue: date) do %>
            <span style="background-color: lightgreen; padding-left: 15px;"></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% when 'liste' %>
    <div class="overflow-x-auto mt-4">
      <table class="table table-sm">
        <thead class="bg-slate-100">
          <tr>
            <th></th>
            <th>Intervention</th>
            <th>Du</th>
            <th>Au</th>
            <th>Adhérent</th>
            <th>Équipe</th>
          </tr>
        </thead>

        <tbody>
          <%= render partial: 'intervention', collection: @tool.interventions.ordered %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
