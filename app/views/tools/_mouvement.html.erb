<% if etat == "L" %>
  <%= link_to reserve_tool_mouvements_path(
      tool_id: tool.id,
      date: date,
      user_id: current_user.id
    ),
    data: { turbo_method: :post },
    title: "Réserver \"#{tool.name.humanize}\" pour le #{date.strftime('%d/%m')}" do %>
    <span class="border-1 border-slate-400 rounded-sm bg-green-500 shadow-sm hover:opacity-75 h-4 inline-block align-middle"
          style="padding-left: 15px;">
    </span>
  <% end %>
<% elsif etat == "R" %>
  <%= link_to libere_tool_mouvements_path(
      tool_id: tool.id,
      date: date,
      user_id: current_user.id
    ),
    data: { turbo_method: :post },
    title: "Réservé par vous (cliquez pour libérer)" do %>
    <span class="border-1 border-slate-400 rounded-sm  bg-blue-600 hover:opacity-75 h-4 inline-block align-middle cursor-pointer shadow-sm"
          style="padding-left: 15px;">
    </span>
  <% end %>
<% elsif etat == "I" %>
  <% if current_user.manager_or_admin? && reservataire_id.present? %>
    <%= link_to libere_tool_mouvements_path(
        tool_id: tool.id,
        date: date,
        user_id: reservataire_id
      ),
      data: {
        turbo_method: :post,
        turbo_confirm: "Libérer la réservation d'un autre utilisateur pour le #{date.strftime('%d/%m')} ?"
      },
      title: "Réservé par qqn d'autre (cliquez pour libérer)" do %>
      <span class="border-1 border-slate-400 rounded-sm bg-blue-300 hover:opacity-75 h-4 inline-block align-middle cursor-pointer shadow-sm"
            style="padding-left: 15px;">
      </span>
    <% end %>
  <% else %>
    <span class="border-1 border-slate-400 rounded-sm bg-blue-300 h-4 inline-block align-middle cursor-default shadow-sm"
          style="padding-left: 15px;"
          title="Réservé par qqn d'autre">
    </span>
  <% end %>
<% elsif etat == "P" %>
  <span class="border-1 border-slate-400 rounded-sm bg-red-500 h-4 inline-block align-middle shadow-sm "
        style="padding-left: 15px;"
        title="En panne">
  </span>
<% end %>
