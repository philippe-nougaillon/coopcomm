<% if etat == "L" %>
  <%= link_to reserve_tool_mouvements_path(
      tool_id: tool.id,
      date: date,
      user_id: current_user.id
    ),
    data: { turbo_method: :post },
    title: "Réserver \"#{tool.name.humanize}\" pour le #{date.strftime('%d/%m')}" do %>
    <span class="border-1 border-slate-400 bg-green-500 hover:opacity-75 h-4 inline-block align-middle"
          style="padding-left: 15px;">
    </span>
  <% end %>
<% elsif etat == "R" %>
  <%= link_to libere_tool_mouvements_path(
      tool_id: tool.id,
      date: date,
      user_id: current_user.id
    ),
    data: { turbo_method: :post },
    title: "Réservé par vous (cliquez pour libérer)" do %>
    <span class="border-1 border-slate-400 bg-blue-600 hover:opacity-75 h-4 inline-block align-middle cursor-pointer"
          style="padding-left: 15px;">
    </span>
  <% end %>
<% elsif etat == "I" %>
  <span class="border-1 border-slate-400 bg-blue-300 h-4 inline-block align-middle cursor-default"
        style="padding-left: 15px;"
        title="Réservé par qqn d'autre">
  </span>
<% elsif etat == "P" %>
  <span class="border-1 border-slate-400 bg-red-500 h-4 inline-block align-middle"
        style="padding-left: 15px;"
        title="En panne">
  </span>
<% end %>