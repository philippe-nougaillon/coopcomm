<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f1f5f9; 
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #1e293b;
      }
      .email-wrapper {
        width: 100%;
        background-color: #f1f5f9;
        padding: 40px 0;
      }
      .email-card {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        border: 1px solid #e2e8f0;
      }
      .email-header {
        background-color: #ffffff; 
        padding: 24px;
        text-align: center;
      }
      .email-body {
        padding: 32px 28px;
        background-color: #ffffff;
        font-size: 15px;
        line-height: 1.6;
      }
      .email-signature {
        padding: 0 28px 24px;
        background-color: #ffffff;
        font-size: 15px;
        color: #475569;
      }
      .email-footer {
        background-color: #f8fafc;
        padding: 16px 24px;
        text-align: center;
        font-size: 12px;
        color: #64748b;
        border-top: 1px solid #e2e8f0;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-card">
        
        <div class="email-header">
          <img src="<%= image_url('/madmoselle.avif') %>" alt="Mad & Moselle" style="height: 95px; width: auto; max-width: 100%; display: inline-block; vertical-align: middle;" />
          <!-- 
          <span style="font-size: 22px; font-weight: bold; letter-spacing: 0.5px;">
            <span style="color: #47b5db;">Co</span><span style="color: #691E9A;">op</span><span style="color: #47b5db;">Comm</span><span style="color: #691E9A;">.</span>
          </span> 
          -->
        </div>

        <div class="email-body">
          <%= yield %>
        </div>

         <div class="email-signature">
          Cordialement,<br>
          L'équipe COOPCOMM
        </div>

        <div class="email-footer">
          Ce message a été envoyé automatiquement, merci de ne pas y répondre directement.
          <br>
          <strong> 
            <span style="color: #47b5db;">Co</span><span style="color: #691E9A;">op</span><span style="color: #47b5db;">Comm</span><span style="color: #691E9A;">.</span>
          </strong>
        </div>

      </div>
    </div>
  </body>
</html>